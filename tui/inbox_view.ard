use tinear/models/inbox
use tinear/tui/ui

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor
  }
}

fn row_text(value: Str, selected: Bool) ui::Widget {
  match selected {
    true => ui::text(value, style: ui::style(reverse: true)),
    false => ui::text(value),
  }
}

fn row_line(value: Str, selected: Bool) ui::Widget {
  match selected {
    true => ui::text_line(value, style: ui::style(reverse: true)),
    false => ui::text_line(value),
  }
}

fn render_item(item: inbox::Item, selected: Bool) ui::Widget {
  let children = [
    ui::sized_box_child(10, 1, row_text(item.target_id, selected)),
    row_text(" ", selected),
    row_text(item.actor_name, selected),
    row_text(" ", selected),
    row_text(item.type_label, selected),
    row_text("  ", selected),
    ui::expanded(row_line(item.title, selected)),
  ]
  match selected {
    true => ui::row(children: children, style: ui::style(reverse: true)),
    false => ui::row(children),
  }
}

fn render_rows(store: inbox::InboxStore, cursor: Int) ui::Widget {
  mut rows: [ui::Widget] = []
  for item, idx in store.items {
    rows.push(render_item(item, idx == cursor))
  }
  ui::focusable(ui::column_stretch(rows))
}

fn detail_placeholder(store: inbox::InboxStore, cursor: Int, on_dismiss: fn(ui::EventContext)) ui::Widget {
  let item = store.items.at(cursor)
  ui::dialog(
    title: "Inbox detail",
    child: ui::text("{item.target_id} — {item.title}\n\nDetail loading/rendering will be implemented next.\n\nEsc closes this placeholder."),
    width: 60,
    on_dismiss: on_dismiss,
  )
}

fn content(store: inbox::InboxStore, loading: Bool, error: Str, cursor: Int, detail_open: Bool, on_detail_dismiss: fn(ui::EventContext)) ui::Widget {
  if loading {
    ui::text("Loading inbox…")
  } else if not error.is_empty() {
    ui::text("Unable to load inbox", style: ui::style(bold: true))
  } else if store.items.size() == 0 {
    ui::center(ui::text("Inbox empty"))
  } else if detail_open {
    ui::overlay_modal(render_rows(store, cursor), detail_placeholder(store, cursor, on_detail_dismiss))
  } else {
    render_rows(store, cursor)
  }
}

fn new(api_key: Str) ui::Widget {
  mut store = inbox::new(api_key)
  mut loaded = false
  mut loading = false
  mut error = ""

  ui::stateful(fn(state: ui::State) ui::Widget {
    if not loaded {
      loading = true
      match store.load() {
        ok(_) => { error = "" },
        err(e) => { error = e },
      }
      loading = false
      loaded = true
    }

    let cursor = clamp_cursor(state.get_int("cursor"), store.items.size())
    let detail_open = state.get_bool("detail_open")
    ui::actions(
      child: ui::shortcuts(
        child: content(
          store: store,
          loading: loading,
          error: error,
          cursor: cursor,
          detail_open: detail_open,
          on_detail_dismiss: fn(ctx: ui::EventContext) {
            state.set_bool("detail_open", false)
            ui::request_frame(ctx)
          },
        ),
        bindings: [
          "Up": "inbox.previous",
          "k": "inbox.previous",
          "Down": "inbox.next",
          "j": "inbox.next",
          "Enter": "inbox.open_detail",
          "\r": "inbox.open_detail",
          "\n": "inbox.open_detail",
          "Ctrl+m": "inbox.open_detail",
          "Space": "inbox.open_detail",
          "Escape": "inbox.close_detail",
          "Esc": "inbox.close_detail",
          "r": "inbox.refresh",
        ],
      ),
      bindings: [
        "inbox.previous": fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          state.set_int("cursor", clamp_cursor(cursor - 1, store.items.size()))
          ui::EventResult::handled
        },
        "inbox.next": fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          state.set_int("cursor", clamp_cursor(cursor + 1, store.items.size()))
          ui::EventResult::handled
        },
        "inbox.refresh": fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          loading = true
          match store.load() {
            ok(_) => { error = "" },
            err(e) => { error = e },
          }
          loading = false
          loaded = true
          state.set_int("cursor", clamp_cursor(cursor, store.items.size()))
          ui::EventResult::handled
        },
        "inbox.open_detail": fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
          if store.items.size() > 0 {
            state.set_bool("detail_open", true)
            ui::request_frame(ctx)
          }
          ui::EventResult::handled
        },
        "inbox.close_detail": fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
          state.set_bool("detail_open", false)
          ui::request_frame(ctx)
          ui::EventResult::handled
        },
      ],
    )
  })
}
