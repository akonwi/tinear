use ard/async
use ard/maybe
use vaxis/ui

use tinear/models/inbox
use tinear/tui/refresh
use tinear/tui/text
use tinear/tui/toast

// Local state for the Inbox view.
//
// `list_scroll` is created once in `init` and stored here so the list's
// scroll position survives rebuilds. Same for `detail_scroll`.
//
// Detail-pane fields:
//   detail_request_id  the notification id we currently want to display
//                      (set when cursor moves to a new item)
//   detail_loaded_id   the notification id of the loaded detail (cache key)
//   detail             the loaded data, when present
//   detail_loading     true while a fetch is in flight for detail_request_id
//   detail_error       last detail-load error message (cleared on success)
struct View {
  items: [inbox::Item],
  cursor: Int,
  loading: Bool,
  error: Str,
  list_scroll: ui::ScrollPaneController,
  // Detail pane uses a ScrollController (single-axis) instead of a
  // ScrollPaneController (both axes) so its child gets a bounded cross-axis
  // width, which is what makes soft_wrap actually wrap.
  detail_scroll: ui::ScrollController,
  detail_request_id: Str,
  detail_loaded_id: Str,
  detail: inbox::Detail?,
  detail_loading: Bool,
  detail_error: Str,
}

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

// ── Async work ────────────────────────────────────────────────────────

// Background detail fetch. Late results are discarded if the user has
// since moved to a different item (detail_request_id no longer matches).
// Errors are surfaced inline in the detail pane (no toast — the pane
// itself is the dedicated slot for that failure mode).
fn fetch_detail(api_key: Str, target_id: Str, rt: ui::Runtime<View>) {
  async::start(fn() {
    let result = inbox::load_detail(api_key, target_id)
    rt.dispatch(fn(state: ui::State<View>) {
      state.set(fn(mut s: View) {
        if s.detail_request_id == target_id {
          match result {
            ok(d) => {
              s.detail = maybe::some(d)
              s.detail_loaded_id = target_id
              s.detail_loading = false
              s.detail_error = ""
            },
            err(e) => {
              s.detail_loading = false
              s.detail_error = e
            },
          }
        }
      })
    })
  })
}

// Request the detail for whatever item the cursor is currently on, if it
// differs from what's already loaded or in-flight. Safe to call from any
// action handler.
fn request_detail_for_cursor(
  api_key: Str, state: ui::State<View>, rt: ui::Runtime<View>,
) {
  let s = state.value()
  if s.items.size() > 0 {
    let target_id = s.items.at(s.cursor).notification_id
    let already_requested = s.detail_request_id == target_id
    let already_loaded = s.detail_loaded_id == target_id
    if not target_id.is_empty() and not already_requested and not already_loaded {
      state.set(fn(mut x: View) {
        x.detail_request_id = target_id
        x.detail_loading = true
        x.detail_error = ""
        x.detail = maybe::none()
      })
      fetch_detail(api_key, target_id, rt)
    }
  }
}

// Errors are surfaced inline via the error_pane the body renders when
// `view.error` is non-empty — no toast for load failures since the pane
// itself is the dedicated UI slot for that.
fn load_inbox(api_key: Str, rt: ui::Runtime<View>) {
  async::start(fn() {
    let result = inbox::load(api_key)
    rt.dispatch(fn(s: ui::State<View>) {
      s.set(fn(mut v: View) {
        match result {
          ok(items) => {
            v.items = items
            v.error = ""
            v.cursor = clamp_cursor(v.cursor, items.size())
          },
          err(e) => { v.error = e },
        }
        v.loading = false
      })
      // After the inbox lands, kick off a detail fetch for whatever item
      // ends up under the cursor (cursor 0 on first load).
      request_detail_for_cursor(api_key, s, rt)
    })
  })
}

// ── List rendering ────────────────────────────────────────────────────

// A single inbox row. Two lines per tile:
//   line 1 (title):    issue title, ellipsis-truncated to pane width
//   line 2 (subtitle): actor name + action (e.g. "alice commented")
//
// list_tile arranges title + subtitle in a vertical Flex internally.
fn render_row(theme: ui::Theme, item: inbox::Item, selected: Bool) ui::Widget {
  let title = ui::rich_text(
    [ui::span(item.title, fg: theme.foreground)],
    overflow: ui::TextOverflow::ellipsis,
    max_lines: 1,
  )
  let subtitle = ui::styled_text(
    "{item.actor_name} {item.type_label}",
    fg: theme.muted_foreground,
  )
  ui::list_tile(title: title, subtitle: subtitle, selected: selected)
}

fn list_rows(theme: ui::Theme, model: View) [ui::Widget] {
  mut rows: [ui::Widget] = []
  for item, idx in model.items {
    rows.push(render_row(theme, item, idx == model.cursor))
  }
  rows
}

// Width of the list pane (left side) in the split. Fixed at 36 cols for
// v1; future versions can make this responsive once we expose terminal
// size from the runtime.
let LIST_PANE_WIDTH: Int = 36

fn list_pane(theme: ui::Theme, model: View) ui::Widget {
  // scroll_pane lays its child out with unbounded width AND height (so
  // the child can be larger than the pane and scroll). That unbounded
  // width means the row inside each list_tile has no flex space to
  // hand to its `expanded(actor)` cell — the row collapses to its
  // intrinsic content width and the selected-row highlight ends up
  // only as wide as the text, not the pane.
  //
  // We pin the column's width with an inner sized_box so the
  // list_tiles get full-pane width and the highlight spans the whole
  // row. main_size: min keeps the column the height of its rows so
  // they sit at the top instead of stretching vertically.
  ui::scroll_pane(
    ui::sized_box(
      LIST_PANE_WIDTH,
      0,
      ui::column(
        list_rows(theme, model),
        main_size: ui::MainSize::min,
        cross_align: ui::CrossAlign::stretch,
      ),
    ),
    controller: model.list_scroll,
  )
}

// ── Detail rendering ──────────────────────────────────────────────────

// Header reminds the reader WHY they got the notification: who acted,
// what they did, and which item it's about. This is the context that
// gets lost if we lead with the full issue title.
fn detail_header(theme: ui::Theme, item: inbox::Item, d: inbox::Detail) ui::Widget {
  let context_line = "{item.actor_name} {item.type_label}"
  let id_label = match d.team_key.is_empty() {
    false => "{d.identifier} · {d.team_key}",
    true => d.identifier,
  }
  ui::column(
    [
      ui::styled_text(context_line, fg: theme.accent_text, attrs: ui::TextAttrs{ bold: true }),
      ui::styled_text(id_label, fg: theme.muted_foreground),
      ui::sized_box(0, 1, ui::text("")),
      ui::rich_text([ui::span(d.title, fg: theme.foreground, attrs: ui::TextAttrs{ bold: true })], soft_wrap: true),
    ],
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::start,
  )
}

fn priority_label(p: Int?) Str {
  match p {
    n => match n {
      0 => "No priority",
      1 => "Urgent",
      2 => "High",
      3 => "Medium",
      4 => "Low",
      _ => "Priority {n.to_str()}",
    },
    _ => "—",
  }
}

fn meta_row(theme: ui::Theme, label: Str, value: Str) ui::Widget {
  ui::row([
    ui::sized_box(12, 1, ui::styled_text(label, fg: theme.muted_foreground)),
    ui::expanded(ui::styled_text(value, fg: theme.foreground)),
  ])
}

// Compact metadata: just status and assignee. Keeping this short means
// the description (the thing the user actually wants to read) lands on
// screen without a scroll.
fn detail_meta(theme: ui::Theme, d: inbox::Detail) ui::Widget {
  ui::column(
    [
      meta_row(theme, "Status", d.state_name),
      meta_row(theme, "Assignee", d.assignee_name),
    ],
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::stretch,
  )
}

fn section_divider(theme: ui::Theme, label: Str) ui::Widget {
  ui::column(
    [
      ui::sized_box(0, 1, ui::text("")),
      ui::styled_text(label, fg: theme.muted_foreground, attrs: ui::TextAttrs{ bold: true }),
      ui::sized_box(0, 1, ui::text("")),
    ],
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::start,
  )
}

fn detail_description(theme: ui::Theme, body: Str) ui::Widget {
  match body.is_empty() {
    true => ui::styled_text("(no description)", fg: theme.muted_foreground),
    false => ui::rich_text([ui::span(body, fg: theme.foreground)], soft_wrap: true),
  }
}

fn render_comment(theme: ui::Theme, c: inbox::DetailComment) ui::Widget {
  let header = match c.created_at.is_empty() {
    false => "{c.author} · {c.created_at}",
    true => c.author,
  }
  ui::column(
    [
      ui::styled_text(header, fg: theme.muted_foreground),
      ui::rich_text([ui::span(c.body, fg: theme.foreground)], soft_wrap: true),
      ui::sized_box(0, 1, ui::text("")),
    ],
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::start,
  )
}

fn detail_comments(theme: ui::Theme, comments: [inbox::DetailComment]) [ui::Widget] {
  match comments.size() == 0 {
    true => [],
    false => {
      mut children: [ui::Widget] = [section_divider(theme, "Comments")]
      for c in comments {
        children.push(render_comment(theme, c))
      }
      children
    },
  }
}

fn render_history(theme: ui::Theme, h: inbox::DetailHistory) ui::Widget {
  let label = match h.from_state.is_empty() {
    false => "{h.from_state} → {h.to_state}",
    true => h.to_state,
  }
  let line = match h.created_at.is_empty() {
    false => "{label} · {h.created_at}",
    true => label,
  }
  ui::styled_text(line, fg: theme.muted_foreground)
}

fn detail_history(theme: ui::Theme, history: [inbox::DetailHistory]) [ui::Widget] {
  match history.size() == 0 {
    true => [],
    false => {
      mut children: [ui::Widget] = [section_divider(theme, "History")]
      for h in history {
        children.push(render_history(theme, h))
      }
      children
    },
  }
}

fn render_detail(
  theme: ui::Theme, item: inbox::Item, d: inbox::Detail, scroll: ui::ScrollController,
) ui::Widget {
  // Layout order: notification context, identifier, issue title, compact
  // metadata, then the *thing that triggered the notification* (the
  // specific comment/mention if present, else the issue description).
  // For comment/mention notifications the user wants to see THAT comment
  // immediately, not scroll past the whole issue body to find it.
  mut children: [ui::Widget] = [
    detail_header(theme, item, d),
    section_divider(theme, "Details"),
    detail_meta(theme, d),
  ]
  match d.triggering_comment {
    c => {
      children.push(section_divider(theme, "Comment"))
      children.push(render_comment(theme, c))
    },
    _ => {
      children.push(section_divider(theme, "Description"))
      children.push(detail_description(theme, d.description))
    },
  }
  if d.comments.size() > 0 {
    children.push(ui::sized_box(0, 1, ui::text("")))
    children.push(ui::styled_text(
      "{d.comments.size().to_str()} comments in thread — press Enter for the full issue",
      fg: theme.muted_foreground,
    ))
  }
  // scroll_view (single-axis) keeps the child's cross-axis (width)
  // bounded so soft_wrap can actually wrap title and comment text.
  // scroll_pane would unbound both axes and the wrapped text would
  // render on a single very long line.
  ui::scroll_view(
    ui::column(children, main_size: ui::MainSize::min, cross_align: ui::CrossAlign::stretch),
    controller: scroll,
  )
}

fn detail_pane(theme: ui::Theme, model: View) ui::Widget {
  if model.detail_loading {
    ui::center(ui::styled_text("Loading detail…", fg: theme.muted_foreground))
  } else if not model.detail_error.is_empty() {
    ui::center(
      ui::column(
        [
          ui::styled_text("Failed to load detail", fg: theme.danger_text),
          ui::sized_box(0, 1, ui::text("")),
          ui::rich_text([ui::span(model.detail_error, fg: theme.muted_foreground)], soft_wrap: true),
        ],
        main_size: ui::MainSize::min,
        cross_align: ui::CrossAlign::center,
      ),
    )
  } else if model.items.size() > 0 {
    let item = model.items.at(model.cursor)
    match model.detail {
      d => render_detail(theme, item, d, model.detail_scroll),
      _ => ui::center(ui::styled_text("Select a notification", fg: theme.muted_foreground)),
    }
  } else {
    ui::center(ui::styled_text("Select a notification", fg: theme.muted_foreground))
  }
}

// ── Split body ────────────────────────────────────────────────────────

fn render_split(theme: ui::Theme, model: View) ui::Widget {
  let separator = ui::sized_box(
    1,
    0,
    ui::decorated_box(
      ui::text(""),
      bg: theme.background,
      border: ui::Borders{ left: true },
      border_fg: theme.border,
      border_bg: theme.background,
    ),
  )
  // cross_align: stretch is critical here. ui::row defaults to
  // CrossAlign::center, which would loose-constrain each child's vertical
  // size, size them to their intrinsic content, and centre them in the
  // row — leaving the list and detail floating in the middle of the
  // body. We want both panes tall.
  ui::row(
    [
      ui::sized_box(LIST_PANE_WIDTH, 0, list_pane(theme, model)),
      separator,
      ui::expanded(ui::padding(detail_pane(theme, model), horizontal: 1)),
    ],
    cross_align: ui::CrossAlign::stretch,
  )
}

fn error_pane(theme: ui::Theme, err: Str) ui::Widget {
  ui::center(
    ui::column(
      [
        ui::styled_text(err, fg: theme.danger_text),
        ui::sized_box(0, 1, ui::text("")),
        ui::styled_text("press r to retry", fg: theme.muted_foreground),
      ],
      main_size: ui::MainSize::min,
      cross_align: ui::CrossAlign::center,
    ),
  )
}

// All body branches return a `column` so the outermost widget type at the
// build's body slot never changes between rebuilds — see
// `docs/widget-reconciliation.md` in vaxis-ard for context.
fn body(theme: ui::Theme, model: View) ui::Widget {
  match {
    model.loading => ui::column([
      ui::expanded(ui::center(ui::text("Loading inbox…"))),
    ]),
    not model.error.is_empty() => ui::column([
      ui::expanded(error_pane(theme, model.error)),
    ]),
    model.items.size() == 0 => ui::column([
      ui::expanded(ui::center(ui::styled_text("No notifications", fg: theme.muted_foreground))),
    ]),
    _ => ui::column([ui::expanded(render_split(theme, model))]),
  }
}

// ── Entry point ───────────────────────────────────────────────────────

fn new(
  api_key: Str,
  on_open: fn(inbox::Item),
  notify: fn(Str, Str, toast::ToastVariant),
  active: Bool,
) ui::Widget {
  ui::stateful(
    key: "inbox-view",
    init: fn(ctx: ui::BuildContext) View {
      // Kick the initial fetch from init. The earlier suspicion that
      // init dispatches had a cross-module monomorphization issue
      // turned out to be misdiagnosed: the real culprit was the
      // widget-reconciliation pitfall (an outer widget type that
      // changed across rebuilds caused state updates to look like
      // no-ops). With body() pinned to a stable outer widget type,
      // dispatch from init lands cleanly.
      let rt = ctx.runtime<View>()
      load_inbox(api_key, rt)
      View{
        items: [],
        cursor: 0,
        loading: true,
        error: "",
        list_scroll: ui::scroll_pane_controller(),
        detail_scroll: ui::scroll_controller(),
        detail_request_id: "",
        detail_loaded_id: "",
        detail: maybe::none(),
        detail_loading: false,
        detail_error: "",
      }
    },
    build: fn(ctx: ui::BuildContext, state: ui::State<View>) ui::Widget {
      let theme = ui::must_have_theme(ctx)
      let model = state.value()
      let rt = ctx.runtime<View>()

      // Only the active tab's focus_scope participates in auto_focus
      // and reclaim. Hidden tabs (kept mounted by indexed_stack) must
      // not pull focus onto themselves, or keystrokes would route to
      // a tab the user can't see.
      ui::shortcuts(
        ui::actions(
          ui::focus_scope(
            ui::focus(body(theme, model)),
            trap: false,
            auto_focus: active,
            reclaim_focus: active,
          ),
          [
            ui::action("inbox.next", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let next_cursor = clamp_cursor(model.cursor + 1, model.items.size())
              state.set(fn(mut s: View) { s.cursor = next_cursor })
              let _ = ui::scroll_pane_scroll_to(model.list_scroll, 0, next_cursor)
              let _ = ui::scroll_controller_scroll_to_start(model.detail_scroll)
              request_detail_for_cursor(api_key, state, rt)
              ui::EventResult::handled
            }),
            ui::action("inbox.prev", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let next_cursor = clamp_cursor(model.cursor - 1, model.items.size())
              state.set(fn(mut s: View) { s.cursor = next_cursor })
              let _ = ui::scroll_pane_scroll_to(model.list_scroll, 0, next_cursor)
              let _ = ui::scroll_controller_scroll_to_start(model.detail_scroll)
              request_detail_for_cursor(api_key, state, rt)
              ui::EventResult::handled
            }),
            ui::action("inbox.open", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              if model.cursor < model.items.size() {
                on_open(model.items.at(model.cursor))
              }
              ui::EventResult::handled
            }),
            ui::action("inbox.delete", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              if model.cursor < model.items.size() {
                let item = model.items.at(model.cursor)
                let id = item.notification_id
                let key = api_key
                // Fire-and-forget archive; on failure surface a toast.
                // A failed archive will also reappear on the next manual
                // refresh since we removed it locally.
                async::start(fn() {
                  match inbox::archive(key, id) {
                    ok(_) => (),
                    err(e) => notify(
                      "Couldn't archive notification",
                      e,
                      toast::ToastVariant::error,
                    ),
                  }
                })
                // Batch every post-delete mutation into ONE state.set so
                // the optimistic update is a single rebuild: drop the
                // row, clamp the cursor, and update the detail-pane
                // tracking fields based on the new cursor target.
                state.set(fn(mut s: View) {
                  mut remaining: [inbox::Item] = []
                  for it, idx in s.items {
                    if not (idx == model.cursor) {
                      remaining.push(it)
                    }
                  }
                  s.items = remaining
                  s.cursor = clamp_cursor(model.cursor, remaining.size())
                  if remaining.size() == 0 {
                    s.detail = maybe::none()
                    s.detail_loaded_id = ""
                    s.detail_request_id = ""
                    s.detail_loading = false
                    s.detail_error = ""
                  } else {
                    let new_target = remaining.at(s.cursor).notification_id
                    if not (s.detail_loaded_id == new_target) {
                      s.detail = maybe::none()
                      s.detail_request_id = new_target
                      s.detail_loading = true
                      s.detail_error = ""
                    }
                  }
                })
                // After the single state mutation, kick off a fetch for
                // the new cursor target if that detail isn't already
                // cached.
                let after = state.value()
                let needs_fetch = after.items.size() > 0 and after.detail_loading and not after.detail_request_id.is_empty()
                if needs_fetch {
                  fetch_detail(api_key, after.detail_request_id, rt)
                }
              }
              ui::EventResult::handled
            }),
            ui::action("inbox.refresh", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(fn(mut s: View) {
                s.loading = true
                s.error = ""
              })
              load_inbox(api_key, rt)
              ui::EventResult::handled
            }),
            // Detail-pane scrolling forwarded from list-focused shortcuts.
            ui::action("inbox.detail.line_down", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let _ = ui::scroll_controller_scroll_by_lines(model.detail_scroll, 1)
              ui::EventResult::handled
            }),
            ui::action("inbox.detail.line_up", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let _ = ui::scroll_controller_scroll_by_lines(model.detail_scroll, -1)
              ui::EventResult::handled
            }),
            // Coarse page-scroll approximation: scroll by 10 rows. Once
            // upstream exposes ScrollByPages on ScrollController we can
            // make this a real page.
            ui::action("inbox.detail.page_down", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let _ = ui::scroll_controller_scroll_by_lines(model.detail_scroll, 10)
              ui::EventResult::handled
            }),
            ui::action("inbox.detail.page_up", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              let _ = ui::scroll_controller_scroll_by_lines(model.detail_scroll, -10)
              ui::EventResult::handled
            }),
          ],
        ),
        [
          "j": "inbox.next",
          "Down": "inbox.next",
          "k": "inbox.prev",
          "Up": "inbox.prev",
          "Enter": "inbox.open",
          "Backspace": "inbox.delete",
          "r": "inbox.refresh",
          "l": "inbox.detail.line_down",
          "Right": "inbox.detail.line_down",
          "h": "inbox.detail.line_up",
          "Left": "inbox.detail.line_up",
          "Space": "inbox.detail.page_down",
          "Shift+Space": "inbox.detail.page_up",
        ],
      )
    },
  )
}
