use ard/decode

use tinear/tui/decode as decode_utils
use tinear/tui/screen
use tinear/tui/text
use tinear/vaxis

// ---- Scrollview --------------------------------------------------------
// A scrollable list-of-lines viewport with a vertical scrollbar on the
// right edge. The caller wraps content into `lines` each frame and
// tracks `scroll` (the index of the top visible line) on the struct.
// The rightmost column of `layout.width` is reserved for the scrollbar
// even when no overflow is present, so the visible area stays stable.

struct Scrollview {
  scroll: Int,
}

fn Scrollview::new() Scrollview {
  Scrollview{scroll: 0}
}

impl Scrollview {
  // Render `lines` inside `layout`, scrolled to `self.scroll`.
  // Out-of-range values are clamped so key handlers can set raw
  // values without worrying about bounds.
  fn draw(vx: vaxis::Vaxis, layout: screen::Layout, lines: [Str]) Void {
    let max_scroll = match lines.size() > layout.height {
      true => lines.size() - layout.height,
      false => 0,
    }
    let scroll = match self.scroll > max_scroll {
      true => max_scroll,
      false => match self.scroll < 0 {
        true => 0,
        false => self.scroll,
      },
    }
    let content_w = layout.width - 1
    let end = match scroll + layout.height > lines.size() {
      true => lines.size(),
      false => scroll + layout.height,
    }
    for line, idx in lines {
      if idx >= scroll and idx < end {
        let display = text::truncate_with_ellipsis(line, content_w)
        vaxis::window_draw_text(vaxis::root(vx), layout.x, layout.y + (idx - scroll), display)
      }
    }
    if lines.size() > layout.height {
      let bar_x = layout.x + layout.width - 1
      // Track
      for r in 0..(layout.height - 1) {
        vaxis::window_draw_text(vaxis::root(vx), bar_x, layout.y + r, "│")
      }
      // Thumb size, proportional to viewport / total.
      let total = lines.size()
      let raw_thumb = (layout.height * layout.height) / total
      let thumb_h = match raw_thumb < 1 {
        true => 1,
        false => raw_thumb,
      }
      let max_thumb_pos = layout.height - thumb_h
      let thumb_pos = match max_scroll == 0 {
        true => 0,
        false => (scroll * max_thumb_pos) / max_scroll,
      }
      for r in 0..(thumb_h - 1) {
        vaxis::window_draw_text(vaxis::root(vx), bar_x, layout.y + thumb_pos + r, "█")
      }
    }
  }
}

// ---- single comment renderer ------------------------------------------
// Renders one Linear Comment (a Dynamic with .body, .createdAt, .user)
// over two rows: header (cursor + trigger marker + user · date) and
// body (truncated to one line). Returns the next row to draw at.

fn draw_comment(vx: vaxis::Vaxis, comment: Dynamic, x: Int, y: Int, panel_width: Int, is_cursor: Bool, is_trigger: Bool) Int {
  let body = decode::run(comment, decode::field("body", decode::string)).expect("Missing body")
  let created = decode::run(comment, decode::field("createdAt", decode::nullable(decode::string)))
    .expect("Missing createdAt")
  let user_obj = decode_utils::optional_field(comment, "user")
  let user_name = match user_obj {
    u => decode_utils::user_display_name(u),
    _ => "—",
  }
  let date_str = match created {
    t => text::format_date(t),
    _ => "",
  }

  let cursor_mark = match is_cursor {
    true => "▸",
    false => " ",
  }
  let trigger_mark = match is_trigger {
    true => "*",
    false => " ",
  }
  let head = "{cursor_mark}{trigger_mark} {user_name} · {date_str}"
  vaxis::window_draw_text(vaxis::root(vx), x, y, head)
  let body_truncated = text::truncate_with_ellipsis(body, panel_width - 4)
  vaxis::window_draw_text(vaxis::root(vx), x + 3, y + 1, body_truncated)
  y + 3
}

// ---- CommentList -------------------------------------------------------
// Fixed-item-height list view over comments. Owns the comments
// themselves (fetched once and stable across frames, unlike a
// Scrollview's lines which are derived per-frame from
// description+width). Persistent state is cursor/top; callers replace
// `comments` after a refetch.

struct CommentList {
  comments: [Dynamic],
  cursor: Int,
  top: Int,
}

fn CommentList::new(comments: [Dynamic]) CommentList {
  CommentList{comments: comments, cursor: 0, top: 0}
}

// Each comment renders to a fixed number of cells via draw_comment
// (header + body + blank).
fn comment_item_height() Int { 3 }

impl CommentList {
  // Render the comments inside `layout`, scrolled to keep
  // `self.cursor` visible. The cursor marker only renders when
  // `active` is true. `self.top` is treated as a hint; the method
  // clamps it internally so callers can set raw values from key
  // handlers without worrying about bounds.
  fn draw(vx: vaxis::Vaxis, layout: screen::Layout, active: Bool) Void {
    if self.comments.size() == 0 {
      ()
    } else {
      let vc = layout.height / comment_item_height()
      let max_top = match self.comments.size() > vc {
        true => self.comments.size() - vc,
        false => 0,
      }
      // Adjust top to keep the cursor visible.
      let adjusted = match self.cursor < self.top {
        true => self.cursor,
        false => match self.cursor >= self.top + vc {
          true => self.cursor - vc + 1,
          false => self.top,
        },
      }
      // Clamp into a valid range.
      let top = match adjusted > max_top {
        true => max_top,
        false => match adjusted < 0 {
          true => 0,
          false => adjusted,
        },
      }
      let end_excl = match top + vc > self.comments.size() {
        true => self.comments.size(),
        false => top + vc,
      }
      mut row_y = layout.y
      for c, idx in self.comments {
        if idx >= top and idx < end_excl {
          let is_cursor = active and idx == self.cursor
          draw_comment(vx, c, layout.x, row_y, layout.width, is_cursor, false)
          row_y = row_y + comment_item_height()
        }
      }
      // Overflow indicators on the right-hand column.
      let arrow_x = layout.x + layout.width - 1
      if top > 0 {
        vaxis::window_draw_text(vaxis::root(vx), arrow_x, layout.y, "↑")
      }
      if end_excl < self.comments.size() {
        vaxis::window_draw_text(vaxis::root(vx), arrow_x, layout.y + layout.height - 1, "↓")
      }
    }
  }
}
