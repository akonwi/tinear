use cooper
use cooper/cui
use cooper/cui/renderer
use cooper/ui
use tinear/tui/cui_bridge
use tinear/tui/modal_host
use tinear/tui/scheduler
use tinear/tui/theme as tinear_theme
use tinear/tui/toast_host

// Shared shell state owned by the facade and described by the Shell component.
struct Model {
  screen: (mut ui::Box)?,
  screen_dispose: fn(),
  screen_attached: fn(),
  screen_view: cui::View?,
  generation: Int,
  modal_root: mut ui::Box,
  modal_dispose: fn(),
}

private struct ShellProps {
  model: mut Model,
}

private struct Shell {
  props: mut ShellProps,
}

private fn shell(props: mut ShellProps) mut Shell {
  (mut Shell{props: props})
}

impl cui::Component for Shell {
  fn mut render() cui::View {
    let model = self.props.model
    let children = mut List::new<cui::View>()
    match model.screen {
      screen => {
        children.push(
          cui_bridge::view(
            screen,
            model.screen_dispose,
            model.screen_attached,
            key: "screen-{model.generation}",
          ),
        )
      },
      _ => (),
    }
    match model.screen_view {
      screen_view => children.push(screen_view),
      _ => (),
    }
    children.push(cui_bridge::view(model.modal_root, model.modal_dispose, fn() {}, key: "modal"))
    cui::box(
      children.@,
      styles: ui::style(
        position: ui::Position::relative,
        width: ui::percent(100.0),
        height: ui::percent(100.0),
      ),
    )
  }
}

struct ApplicationShell {
  model: mut Model,
  cui: renderer::Renderer,
  modal: mut modal_host::ModalHost,
  toasts: mut toast_host::ToastHost,
  context: mut cooper::Runtime,
  disposed: Bool,
}

fn new(
  ctx: mut cooper::Runtime,
  application_root: mut cooper::Root,
  palette: tinear_theme::Theme,
  schedule: scheduler::Schedule,
) mut ApplicationShell {
  let toasts = toast_host::new(ctx, application_root, palette, schedule)
  let modal = modal_host::new(ctx, palette)
  let model = mut Model{
    screen: Maybe::new<mut ui::Box>(),
    screen_dispose: fn() {},
    screen_attached: fn() {},
    screen_view: Maybe::new<cui::View>(),
    generation: 0,
    modal_root: modal.root,
    modal_dispose: fn() {
      // Runtime teardown destroys the retained tree before unmount hooks run;
      // only close through live controls.
      if not modal.root.node_ref.is_destroyed() {
        let _ = modal.close()
      }
    },
  }
  let mounted = renderer::mount(ctx, application_root, cui::child(shell, ShellProps{model: model}))
  (mut ApplicationShell{
    model: model,
    cui: mounted,
    modal: modal,
    toasts: toasts,
    context: ctx,
    disposed: false,
  })
}

impl ApplicationShell {
  fn mut set_screen(screen: mut ui::Box, dispose: fn(), on_attached: fn()?) {
    if self.disposed {
      panic("cannot set the screen on a disposed application shell")
    }
    let attached = on_attached.or(fn() {})
    self.cui.update(fn() {
      self.model.generation =+ 1
      self.model.screen = Maybe::new<mut ui::Box>(screen)
      self.model.screen_dispose = dispose
      self.model.screen_attached = attached
      self.model.screen_view = Maybe::new<cui::View>()
    })
  }

  // Host a declarative screen; CUI lifecycle owns its disposal.
  fn mut set_view(view: cui::View) {
    if self.disposed {
      panic("cannot set the screen on a disposed application shell")
    }
    self.cui.update(fn() {
      self.model.generation =+ 1
      self.model.screen = Maybe::new<mut ui::Box>()
      self.model.screen_dispose = fn() {}
      self.model.screen_attached = fn() {}
      self.model.screen_view = Maybe::new(view)
    })
  }

  fn mut handle_key(received: mut cooper::KeyEvent, current_selection: ui::Selection?) Bool {
    if self.disposed or received.event_type == cooper::KeyEventType::release {
      false
    } else if self.modal.is_open() and received.matches("escape") {
      let _ = self.modal.dismiss()
      received.prevent_default()
      received.stop_propagation()
      true
    } else if received.matches("c", super: true) {
      match current_selection {
        selected => {
          if not selected.selected_text.is_empty() {
            self.context.clipboard.write(selected.selected_text)
          }
        },
        _ => (),
      }
      received.prevent_default()
      received.stop_propagation()
      true
    } else {
      false
    }
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      // Retires the screen and modal bridges synchronously, running each
      // bridge's dispose path before destroying its orphaned controls.
      self.cui.destroy()
      self.toasts.dispose()
    }
  }
}
