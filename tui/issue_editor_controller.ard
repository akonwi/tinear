use cooper
use cooper/cui
use cooper/ui
use tinear/models/issues
use tinear/services/issue_edit_service
use tinear/tui/modal_host
use tinear/tui/theme as tinear_theme

private fn begin_submission(guard: Chan<Bool>) Bool {
  select {
    guard.sender().send(true) => true,
    _ => false,
  }
}

private fn begin_editor_submission(session_guard: Chan<Bool>, operation_guard: Chan<Bool>) Bool {
  if not begin_submission(session_guard) {
    false
  } else if begin_submission(operation_guard) {
    true
  } else {
    clear_submission(session_guard)
    false
  }
}

private fn clear_submission(guard: Chan<Bool>) {
  select {
    guard.receiver().recv() => (),
    _ => (),
  }
}

fn submission_active(guard: Chan<Bool>) Bool {
  mut active = false
  select {
    guard.receiver().recv() => {
      active = true
      guard.sender().send(true)
    },
    _ => (),
  }
  active
}

private fn submit_chord(received: mut cooper::KeyEvent) Bool {
  received.matches("return", ctrl: true) or received.matches("m", ctrl: true) or received.matches("j", ctrl: true)
}

// One editing surface for both comment and description flows. The facade
// supplies the request, guards, and completion routing.
struct EditorProps {
  palette: tinear_theme::Theme,
  initial_value: Str,
  placeholder: Str,
  empty_error: Str,
  pending_label: Str,
  submit_guard: Chan<Bool>,
  begin: fn() Bool,
  finish: fn(),
  perform: fn(Str, Receiver<Bool>, fn(Str!Str)),
  on_success: fn(Str),
  is_current: fn() Bool,
  notify_error: fn(Str),
}

struct Editor {
  props: mut EditorProps,
  value: Str,
  status: Str,
  status_danger: Bool,
  stop: Chan<Bool>,
}

private fn editor(props: mut EditorProps) mut Editor {
  (mut Editor{
    props: props,
    value: props.initial_value,
    status: "",
    status_danger: false,
    stop: Chan::new<Bool>(),
  })
}

impl Editor {
  private fn mut set_status(message: Str, danger: Bool) {
    self.status = message
    self.status_danger = danger
  }

  private fn mut submit(ctx: cui::Context) {
    let body = self.value.trim()
    if body.is_empty() and not self.props.empty_error.is_empty() {
      self.set_status(self.props.empty_error, true)
    } else if (self.props.begin)() {
      self.set_status(self.props.pending_label, false)
      let payload = match self.props.empty_error.is_empty() {
        true => self.value,
        false => body,
      }
      // Bind this submission to the props that started it. Reconciliation
      // rewrites `self.props` in place whenever a later session reuses this
      // component identity, so reading them at completion time would resolve a
      // stale request against the newer session's guard, ticket, and callbacks.
      let finish = self.props.finish
      let on_success = self.props.on_success
      let is_current = self.props.is_current
      let notify_error = self.props.notify_error
      let handle = fn(result: Str!Str) {
        finish()
        match result {
          ok(value) => on_success(value),
          err(message) => {
            match is_current() {
              // Only the session still on screen may own the status line; a
              // superseded one reports through the toast instead.
              true => self.set_status("⚠ {message}", true),
              false => notify_error(message),
            }
          },
        }
      }
      // The service already completes on the UI thread. Routing directly
      // keeps late completions observable after the modal was replaced, which
      // component-scoped dispatch would suppress; invalidate_root is inert
      // once this component unmounts.
      (self.props.perform)(
        payload,
        self.stop.receiver(),
        fn(result: Str!Str) {
          handle(result)
          ctx.invalidate_root()
        },
      )
    }
  }
}

impl cui::Lifecycle for Editor {
  fn mut mounted(ctx: cui::Context) {}

  fn mut unmounting(ctx: cui::Context) {
    // Cancelling the request means the service may never complete, so release
    // the controller-owned operation guard here; otherwise it stays held for
    // the process lifetime and blocks every later editor. `finish` releases
    // only what this session acquired, so calling it unconditionally is safe
    // and a late completion's own release stays a no-op.
    (self.props.finish)()
    self.stop.close()
  }
}

impl cui::Component for Editor {
  fn mut render() cui::View {
    cui::box(
      [
        cui::text_area(
          self.value,
          placeholder: self.props.placeholder,
          wrap: ui::TextWrap::word,
          autofocus: true,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(11), flex_shrink: 0.0),
          on_input: fn(value: Str, ctx: cui::Context) {
            if not submission_active(self.props.submit_guard) {
              self.value = value
            }
          },
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
            if received.event_type != cooper::KeyEventType::release {
              if submission_active(self.props.submit_guard) {
                received.prevent_default()
                received.stop_propagation()
              } else if submit_chord(received) {
                self.submit(ctx)
                received.prevent_default()
                received.stop_propagation()
              }
            }
          },
        ),
        cui::text(
          self.status,
          selectable: false,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: match self.status_danger {
            true => ui::text_style(foreground: self.props.palette.danger, bold: true),
            false => ui::text_style(dim: true),
          },
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(14),
        flex_direction: ui::FlexDirection::column,
        gap: ui::cells(1),
      ),
    )
  }
}

struct Controller {
  context: mut cooper::Runtime,
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: issue_edit_service::Service,
  current_ticket: modal_host::Ticket?,
  operation_guard: Chan<Bool>,
  restore_focus: fn(),
  on_comments_changed: fn(Str, Bool),
  on_description_changed: fn(Str),
  notify_error: fn(Str, Str),
  disposed: Bool,
}

// One editor presentation. Every closure handed to the component binds to the
// session that created it, so a completion landing after its session was
// replaced resolves against its own guard and ticket rather than the newest
// session's. `holding` records whether this session actually acquired the
// shared operation guard, which is what makes release idempotent.
private struct Session {
  submit_guard: Chan<Bool>,
  ticket: modal_host::Ticket?,
  holding: Bool,
}

private fn session() mut Session {
  (mut Session{
    submit_guard: Chan::new<Bool>(1),
    ticket: Maybe::new<modal_host::Ticket>(),
    holding: false,
  })
}

fn new(
  ctx: mut cooper::Runtime,
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: issue_edit_service::Service,
  restore_focus: fn(),
  on_comments_changed: fn(Str, Bool),
  on_description_changed: fn(Str),
  notify_error: fn(Str, Str),
) mut Controller {
  (mut Controller{
    context: ctx,
    modal: modal,
    palette: palette,
    service: service,
    current_ticket: Maybe::new<modal_host::Ticket>(),
    operation_guard: Chan::new<Bool>(1),
    restore_focus: restore_focus,
    on_comments_changed: on_comments_changed,
    on_description_changed: on_description_changed,
    notify_error: notify_error,
    disposed: false,
  })
}

impl Controller {
  // Acquire both guards for one session and record the acquisition.
  private fn mut begin_session(active: mut Session) Bool {
    if active.holding {
      false
    } else if begin_editor_submission(active.submit_guard, self.operation_guard) {
      active.holding = true
      true
    } else {
      false
    }
  }

  // Idempotent: releases only the tokens this session acquired. Unmount
  // cleanup followed by a late completion therefore pops the shared operation
  // guard exactly once, and never the token a newer session is holding.
  private fn mut release_session(active: mut Session) {
    if active.holding {
      active.holding = false
      clear_submission(active.submit_guard)
      clear_submission(self.operation_guard)
    }
  }

  private fn mut present(
    title: Str,
    footer: Str,
    initial_value: Str,
    placeholder: Str,
    empty_error: Str,
    pending_label: Str,
    perform: fn(Str, Receiver<Bool>, fn(Str!Str)),
    on_success: fn(Str, Bool),
    error_title: Str,
  ) {
    let active = session()
    let view = cui::child(
      editor,
      EditorProps{
        // A disposed controller ignores late completions entirely.
        palette: self.palette,
        initial_value: initial_value,
        placeholder: placeholder,
        empty_error: empty_error,
        pending_label: pending_label,
        submit_guard: active.submit_guard,
        begin: fn() Bool {
          self.begin_session(active)
        },
        finish: fn() {
          self.release_session(active)
        },
        perform: perform,
        on_success: fn(value: Str) {
          if not self.disposed {
            // Close this session's own modal, never whichever modal happens to
            // be current, so a late completion cannot dismiss a newer editor.
            mut was_current = false
            match active.ticket {
              ticket => { was_current = self.close_ticket(ticket) },
              _ => (),
            }
            on_success(value, was_current)
          }
        },
        is_current: fn() Bool {
          match active.ticket {
            ticket => self.modal.is_current(ticket),
            _ => false,
          }
        },
        notify_error: fn(message: Str) {
          if not self.disposed {
            self.notify_error(error_title, message)
          }
        },
      },
      key: "editor",
    )
    let ticket = self.modal.present_view(title, view, footer, self.restore_focus, fn() Bool {
      not submission_active(active.submit_guard)
    })
    active.ticket = Maybe::new(ticket)
    self.current_ticket = Maybe::new(ticket)
  }

  private fn mut close_ticket(ticket: modal_host::Ticket) Bool {
    let was_current = self.modal.is_current(ticket)
    let _ = self.modal.close_if_current(ticket)
    was_current
  }

  fn mut open_comment(issue: issues::Issue, parent_id: Str, reply_author: Str) {
    if (not self.disposed) and not submission_active(self.operation_guard) {
      let title = match parent_id.is_empty() {
        true => "Comment on {issue.identifier}",
        false => "Reply to {reply_author} — {issue.identifier}",
      }
      let issue_id = issue.id
      self.present(
        title,
        "Ctrl+Enter post   Esc cancel",
        "",
        "Write a comment…",
        "Comment cannot be empty",
        "Posting…",
        fn(body: Str, stop: Receiver<Bool>, done: fn(Str!Str)) {
          (self.service.create_comment)(stop, issue_id, body, parent_id, done)
        },
        fn(comment_id: Str, was_current: Bool) {
          // `was_current` is this session's own currency, so a superseded
          // completion refreshes without stealing focus from a newer modal.
          self.on_comments_changed(comment_id, was_current)
        },
        "Post comment",
      )
    }
  }

  fn mut open_description(issue: issues::Issue) {
    if (not self.disposed) and not submission_active(self.operation_guard) {
      let issue_id = issue.id
      self.present(
        "Edit description — {issue.identifier}",
        "Ctrl+Enter save   Esc cancel",
        issue.description.or(""),
        "Describe the issue… (markdown)",
        "",
        "Saving…",
        fn(description: Str, stop: Receiver<Bool>, done: fn(Str!Str)) {
          (self.service.update_description)(
            stop,
            issue_id,
            description,
            fn(result: Void!Str) {
              done(
                match result {
                  ok(_) => Result::ok(description),
                  err(message) => Result::err(message),
                },
              )
            },
          )
        },
        fn(description: Str, was_current: Bool) {
          self.on_description_changed(description)
        },
        "Save description",
      )
    }
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      match self.current_ticket {
        ticket => {
          let _ = self.modal.close_if_current(ticket)
        },
        _ => (),
      }
      self.current_ticket = Maybe::new<modal_host::Ticket>()
    }
  }
}
