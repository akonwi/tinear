use cooper
use cooper/cui
use cooper/ui
use tinear/models/documents
use tinear/models/issues
use tinear/services/search_service
use tinear/tui/modal_host
use tinear/tui/scheduler
use tinear/tui/theme as tinear_theme

private fn hit_left(hit: search_service::Hit) Str {
  match hit {
    Issue(issue) => issue.identifier,
    DocMeta(_) => "doc",
  }
}

private fn hit_title(hit: search_service::Hit) Str {
  match hit {
    Issue(issue) => issue.title,
    DocMeta(document) => document.title,
  }
}

private fn hit_right(hit: search_service::Hit) Str {
  match hit {
    Issue(issue) => issue.state_name,
    DocMeta(document) => document.container,
  }
}

private fn hit_key(hit: search_service::Hit, index: Int) Str {
  match hit {
    Issue(issue) => "issue-{issue.id}-{index}",
    DocMeta(document) => "doc-{document.slug_id}-{index}",
  }
}

struct SearchProps {
  palette: tinear_theme::Theme,
  service: search_service::Service,
  schedule: scheduler::Schedule,
  on_open: fn(search_service::Hit),
}

struct Search {
  props: mut SearchProps,
  query: Str,
  hits: [search_service::Hit],
  cursor: Int,
  hovered: Int,
  loading: Bool,
  status: Str,
  status_danger: Bool,
  warning: Str,
  request: Int,
  cancel_debounce: fn(),
  stop: Chan<Bool>,
  results: mut cui::ScrollBoxRef,
}

private fn search(props: mut SearchProps) mut Search {
  (mut Search{
    props: props,
    query: "",
    hits: [],
    cursor: 0,
    hovered: -1,
    loading: false,
    status: "Type to search issues and docs",
    status_danger: false,
    warning: "",
    request: 0,
    cancel_debounce: fn() {},
    stop: Chan::new<Bool>(),
    results: cui::scroll_box_ref(),
  })
}

fn view(
  palette: tinear_theme::Theme,
  service: search_service::Service,
  schedule: scheduler::Schedule,
  on_open: fn(search_service::Hit),
) cui::View {
  cui::child(
    search,
    SearchProps{
      palette: palette,
      service: service,
      schedule: schedule,
      on_open: on_open,
    },
    key: "search",
  )
}

impl Search {
  private fn mut show_status(message: Str, danger: Bool) {
    self.status = message
    self.status_danger = danger
  }

  private fn mut reveal_cursor() {
    match self.results.current {
      panel => {
        let _ = panel.scroll_to(self.cursor)
      },
      _ => (),
    }
  }

  private fn mut select(index: Int) {
    if index >= 0 and index < self.hits.size() {
      self.cursor = index
      self.reveal_cursor()
    }
  }

  private fn mut move_cursor(delta: Int) {
    if (not self.loading) and self.hits.size() > 0 {
      mut next = self.cursor + delta
      if next < 0 {
        next = 0
      }
      if next >= self.hits.size() {
        next = self.hits.size() - 1
      }
      self.select(next)
    }
  }

  private fn mut activate() {
    if not self.loading {
      match self.hits.at(self.cursor) {
        hit => (self.props.on_open)(hit),
        _ => (),
      }
    }
  }

  private fn mut show_outcome(outcome: search_service::Outcome) {
    self.loading = false
    self.hits = outcome.hits
    self.cursor = 0
    self.hovered = -1
    self.warning = outcome.warning
    match self.results.current {
      panel => {
        let _ = panel.scroll_to(0)
      },
      _ => (),
    }
    match self.hits.size() == 0 {
      true => self.show_status("No results found", false),
      false => self.show_status("", false),
    }
  }

  private fn mut query_changed(value: Str, ctx: cui::Context) {
    (self.cancel_debounce)()
    self.query = value
    self.request =+ 1
    let request = self.request
    let query = value.trim()
    self.loading = not query.is_empty()
    self.hits = []
    self.cursor = 0
    self.hovered = -1
    self.warning = ""
    match self.results.current {
      panel => {
        let _ = panel.scroll_to(0)
      },
      _ => (),
    }
    if query.is_empty() {
      self.show_status("Type to search issues and docs", false)
    } else {
      self.show_status("Searching…", false)
      let dispatch = ctx.dispatch
      self.cancel_debounce = (self.props.schedule)(
        300,
        fn() {
          if self.request == request {
            (self.props.service.search)(
              self.stop.receiver(),
              query,
              fn(result: search_service::Outcome!Str) {
                let _ = dispatch(fn() {
                  if self.request == request {
                    match result {
                      ok(outcome) => self.show_outcome(outcome),
                      err(message) => {
                        self.loading = false
                        self.hits = []
                        self.show_status("Unable to search: {message}", true)
                      },
                    }
                  }
                })
              },
            )
          }
        },
      )
    }
  }

  private fn mut handle_key(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release {
      mut handled = true
      match {
        received.matches("down") => self.move_cursor(1),
        received.matches("up") => self.move_cursor(-1),
        received.matches("return") => self.activate(),
        _ => { handled = false },
      }
      if handled {
        received.prevent_default()
        received.stop_propagation()
      }
    }
  }

  private fn mut row(hit: search_service::Hit, index: Int) cui::View {
    let palette = self.props.palette
    let active = index == self.cursor
    let hovered = index == self.hovered
    cui::box(
      [
        cui::text(
          hit_left(hit),
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(width: ui::cells(11), height: ui::cells(1), flex_shrink: 0.0),
          text_style: match hit {
            Issue(_) => ui::text_style(bold: true),
            DocMeta(_) => ui::text_style(dim: true, bold: true),
          },
        ),
        cui::text(
          hit_title(hit),
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(width: ui::cells(1), height: ui::cells(1), flex_grow: 1.0),
        ),
        cui::text(
          hit_right(hit),
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(width: ui::cells(15), height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(dim: true),
        ),
      ],
      key: hit_key(hit, index),
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(1),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        overflow: ui::Overflow::hidden,
        background: match {
          active => palette.item_active_background,
          hovered => palette.item_hover_background,
          _ => palette.background,
        },
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
      ),
      on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
        if received.event_type == cooper::MouseEventType::move {
          self.hovered = index
        } else if received.event_type == cooper::MouseEventType::out and self.hovered == index {
          self.hovered = -1
        } else if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
          self.select(index)
          self.activate()
          received.stop_propagation()
        }
      },
    )
  }
}

impl cui::Lifecycle for Search {
  fn mut mounted(ctx: cui::Context) {}

  fn mut unmounting(ctx: cui::Context) {
    (self.cancel_debounce)()
    self.cancel_debounce = fn() {}
    self.stop.close()
  }
}

impl cui::Component for Search {
  fn mut render() cui::View {
    let status_display = match self.status.is_empty() {
      true => ui::Display::none,
      false => ui::Display::flex,
    }
    let warning_display = match self.warning.is_empty() {
      true => ui::Display::none,
      false => ui::Display::flex,
    }
    let rows = mut List::new<cui::View>()
    rows.push(
      cui::text(
        self.status,
        selectable: false,
        styles: ui::style(
          display: status_display,
          width: ui::percent(100.0),
          height: ui::cells(1),
          flex_shrink: 0.0,
        ),
        text_style: match self.status_danger {
          true => ui::text_style(foreground: self.props.palette.danger, bold: true),
          false => ui::text_style(dim: true),
        },
      ),
    )
    for hit, index in self.hits {
      rows.push(self.row(hit, index))
    }

    cui::box(
      [
        cui::input(
          self.query,
          placeholder: "Search issues and docs…",
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          autofocus: true,
          on_input: fn(value: Str, ctx: cui::Context) {
            self.query_changed(value, ctx)
          },
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
            self.handle_key(received)
          },
        ),
        cui::text(
          "────────────────────────────────────────────────────────────────────────",
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::clip,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(dim: true),
        ),
        cui::scroll_box(
          rows.@,
          ref: self.results,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_grow: 1.0),
        ),
        cui::text(
          self.warning,
          selectable: false,
          styles: ui::style(
            display: warning_display,
            width: ui::percent(100.0),
            height: ui::cells(1),
            flex_shrink: 0.0,
          ),
          text_style: ui::text_style(dim: true),
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(12),
        flex_direction: ui::FlexDirection::column,
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}

struct Controller {
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: search_service::Service,
  schedule: scheduler::Schedule,
  restore_focus: fn(),
  on_open_issue: fn(issues::Issue),
  on_open_document: fn(documents::DocMeta),
  current_ticket: modal_host::Ticket?,
  disposed: Bool,
}

fn new(
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: search_service::Service,
  schedule: scheduler::Schedule,
  restore_focus: fn(),
  on_open_issue: fn(issues::Issue),
  on_open_document: fn(documents::DocMeta),
) mut Controller {
  (mut Controller{
    modal: modal,
    palette: palette,
    service: service,
    schedule: schedule,
    restore_focus: restore_focus,
    on_open_issue: on_open_issue,
    on_open_document: on_open_document,
    current_ticket: Maybe::new<modal_host::Ticket>(),
    disposed: false,
  })
}

impl Controller {
  private fn mut close_current() {
    match self.current_ticket {
      ticket => {
        let _ = self.modal.close_if_current(ticket)
      },
      _ => (),
    }
    self.current_ticket = Maybe::new<modal_host::Ticket>()
  }

  private fn mut open_hit(hit: search_service::Hit) {
    match hit {
      Issue(issue) => (self.on_open_issue)(issue),
      DocMeta(document) => (self.on_open_document)(document),
    }
  }

  fn mut open(context: mut cooper::Runtime) {
    if not self.disposed {
      let ticket = self.modal.present_view(
        "Search",
        view(self.palette, self.service, self.schedule, fn(hit: search_service::Hit) {
          self.close_current()
          self.open_hit(hit)
        }),
        "↑↓ select   Enter open   Esc close",
        self.restore_focus,
        fn() Bool {
          true
        },
      )
      self.current_ticket = Maybe::new(ticket)
    }
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      self.close_current()
    }
  }
}
