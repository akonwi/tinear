use ard/async

use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi
use tinear/models/issues

// Compose-comment modal body.
//
// Owns its own state for the in-progress text, sending status, and
// error message. The hosting view passes:
//   - api_key          — for issues::create_comment
//   - issue            — the issue we're commenting on
//   - refresh_comments — caller-supplied callback that refreshes
//                        whatever list of comments the host view
//                        renders. Already dispatches onto the host's
//                        UI state; we just invoke it on success.
//   - close            — modal-dismiss callback from show_modal,
//                        invoked on success and from the modal
//                        frame's on_dismiss (Esc).
//
// Ctrl+Enter / Ctrl+m / Ctrl+j submit. The Shortcuts wrapping the
// body intercepts those during the capture phase so the TextArea
// (which would otherwise consume them on the target phase) never
// sees them. Plain Enter inserts a newline (TextArea handles it).

struct Compose {
  text: Str,
  sending: Bool,
  error: Str,
}

fn submit(
  ctx: mut ffi::StateCtx,
  api_key: Str,
  issue: issues::Issue,
  parent_id: Str,
  text: Str,
  refresh_comments: fn(),
  close: fn(),
) {
  let trimmed = text.trim()
  if trimmed.is_empty() {
    {}
  } else {
    ffi::Update<Compose>(ctx, fn(state) {
      state.sending = true
      state.error = ""
    })
    async::start(fn() {
      let result = issues::create_comment(api_key, issue.id, trimmed, parent_id)
      match result {
        ok(_) => {
          // Reload the host's comments, then close. refresh_comments
          // dispatches onto the host's UI state internally, so it's
          // safe to call from this background fiber. So is close.
          refresh_comments()
          close()
        },
        err(e) => {
          ffi::Dispatch(ctx, fn() {
            ffi::Update<Compose>(ctx, fn(state) {
              state.sending = false
              state.error = e
            })
          })
        },
      }
    })
  }
}

// Body widget for the modal. The caller wraps this in
// modal::show_modal(title, child: this, footer, on_dismiss).
// parent_id: "" composes a top-level comment; a top-level comment's id
// composes a threaded reply under it.
fn new(api_key: Str, issue: issues::Issue, parent_id: Str, refresh_comments: fn(), close: fn()) ui::Widget {
  ffi::Stateful{
    Key: "compose:{issue.identifier}:{parent_id}",
    Init: fn() Any {
      Compose{
        text: "",
        sending: false,
        error: "",
      }
    },
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      let theme = ui::MustDepend<ui::Theme>(ctx)
      let model = ffi::StateValue<Compose>(c)

      let do_submit = fn() {
        let current = ffi::StateValue<Compose>(c)
        if not current.sending {
          submit(c, api_key, issue, parent_id, current.text, refresh_comments, close)
        }
      }

      // Always render an error slot (empty when no error) and a
      // sending slot (empty when not sending) so the widget shape
      // stays stable across state transitions — avoids the
      // type-changing reconciliation pitfall.
      let error_widget: ui::Widget = match model.error.is_empty() {
        true => ui::SizedBox{},
        false => {
          ui::Padding(
            ui::Insets{Bottom: 1},
            ui::Text{Value: "⚠ {model.error}", Style: ui::Style{Foreground: theme.DangerText}},
          )
        },
      }
      let sending_widget: ui::Widget = match model.sending {
        true => {
          ui::Padding(
            ui::Insets{Top: 1},
            ui::Text{Value: "Sending…", Style: ui::Style{Foreground: theme.MutedForeground}},
          )
        },
        false => ui::SizedBox{},
      }

      mut body_children: [ui::Widget] = [
        error_widget,
        ui::FocusScope{
          AutoFocus: true,
          Child: ui::TextArea{
            Value: model.text,
            Placeholder: match parent_id.is_empty() {
              true => "Write a comment…",
              false => "Write a reply…",
            },
            MinWidth: 60,
            MinHeight: 6,
            SoftWrap: true,
            OnChanged: fn(ev: ui::EventContext, value: Str) {
              ffi::Update<Compose>(c, fn(state) {
                state.text = value
                state.error = ""
              })
            },
          },
        },
        sending_widget,
      ]
      let body = ui::Flex{
        Axis: ui::Vertical,
        MainAxisSize: ui::MainAxisSizeMin,
        CrossAxisAlignment: ui::CrossAxisStretch,
        Children: body_children,
      }

      ui::Shortcuts{
        Bindings: [
          "Ctrl+Enter": ffi::Intent("compose.submit"),
          "Ctrl+m": ffi::Intent("compose.submit"),
          "Ctrl+j": ffi::Intent("compose.submit"),
        ],
        Child: ui::Actions{
          Bindings: [
            "compose.submit": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
              do_submit()
              ui::EventHandled
            },
          ],
          Child: body,
        },
      }
    },
  }
}
