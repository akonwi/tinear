use ard/async
use ard/maybe
use vaxis/ui

use tinear/models/issues

// Compose-comment modal body.
//
// Owns its own state for the in-progress text, sending status, and
// error message. The hosting view passes:
//   - api_key          — for issues::create_comment
//   - issue            — the issue we're commenting on
//   - refresh_comments — caller-supplied callback that refreshes
//                        whatever list of comments the host view
//                        renders. Already closes over the host's
//                        runtime; we just invoke it on success.
//   - close            — modal-dismiss callback from show_modal,
//                        invoked on success and from the modal
//                        frame's on_dismiss (Esc).
//
// Ctrl+Enter / Ctrl+m / Ctrl+j submit. The Shortcuts wrapping the
// body intercepts those during the capture phase so the text_area
// (which would otherwise consume them on the target phase) never
// sees them. Plain Enter inserts a newline (text_area handles it).

struct Compose {
  text: Str,
  sending: Bool,
  error: Str,
}

fn submit(
  api_key: Str, issue: issues::Issue, text: Str,
  state: ui::State<Compose>, rt: ui::Runtime<Compose>,
  refresh_comments: fn(), close: fn(),
) {
  let trimmed = text.trim()
  if trimmed.is_empty() {
    ()
  } else {
    state.set(fn(mut next: Compose) {
      next.sending = true
      next.error = ""
    })
    let _ = async::start(fn() {
      let result = issues::create_comment(api_key, issue.id, trimmed)
      match result {
        ok(_) => {
          // Reload the host's comments, then close. refresh_comments
          // already does its own rt.dispatch internally so it's safe
          // to call from this background fiber.
          refresh_comments()
          close()
        },
        err(e) => {
          rt.dispatch(fn(s: ui::State<Compose>) {
            s.set(fn(mut next: Compose) {
              next.sending = false
              next.error = e
            })
          })
        },
      }
    })
  }
}

// Body widget for the modal. The caller wraps this in
// modal::show_modal(title, child: this, footer, on_dismiss).
fn new(
  api_key: Str,
  issue: issues::Issue,
  refresh_comments: fn(),
  close: fn(),
) ui::Widget {
  ui::stateful(
    key: "compose:{issue.id}",
    init: fn(_ctx: ui::BuildContext) Compose {
      Compose{ text: "", sending: false, error: "" }
    },
    build: fn(ctx: ui::BuildContext, state: ui::State<Compose>) ui::Widget {
      let theme = ui::must_have_theme(ctx)
      let model = state.value()
      let rt = ctx.runtime<Compose>()

      let do_submit = fn() {
        if not model.sending {
          submit(
            api_key, issue, model.text,
            state, rt, refresh_comments, close,
          )
        }
      }

      // Always render an error slot (empty when no error) and a
      // sending slot (empty when not sending) so the widget shape
      // stays stable across state transitions — avoids the
      // type-changing reconciliation pitfall.
      let error_widget = match model.error.is_empty() {
        true => ui::sized_box(0, 0, ui::text("")),
        false => ui::padding(
          ui::styled_text(
            "\u26a0 {model.error}", fg: theme.danger_text,
          ),
          bottom: 1,
        ),
      }
      let sending_widget = match model.sending {
        true => ui::padding(
          ui::styled_text("Sending\u2026", fg: theme.muted_foreground),
          top: 1,
        ),
        false => ui::sized_box(0, 0, ui::text("")),
      }

      let body = ui::column(
        [
          error_widget,
          ui::focus_scope(
            ui::text_area(
              value: model.text,
              placeholder: "Write a comment\u2026",
              min_width: 60,
              min_height: 6,
              soft_wrap: true,
              on_changed: fn(_ctx: ui::EventContext, value: Str) {
                state.set(fn(mut next: Compose) {
                  next.text = value
                  next.error = ""
                })
              },
            ),
            trap: false,
            auto_focus: true,
          ),
          sending_widget,
        ],
        main_size: ui::MainSize::min,
        cross_align: ui::CrossAlign::stretch,
      )

      ui::shortcuts(
        ui::actions(
          body,
          [
            ui::action("compose.submit", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              do_submit()
              ui::EventResult::handled
            }),
          ],
        ),
        [
          "Ctrl+Enter": "compose.submit",
          "Ctrl+m":     "compose.submit",
          "Ctrl+j":     "compose.submit",
        ],
      )
    },
  )
}
