use cooper/core/node

// Cooper currently exposes subtree focus inspection only through retained
// nodes. Keep that pinned-framework dependency isolated here; replace it with
// a public focus-within API when one is available.
// Whether this retained subtree currently owns keyboard focus.
fn within(target: mut node::Node) Bool {
  mut found = target.is_focused()
  for child in target.children {
    if within(child) {
      found = true
    }
  }
  found
}
