use tinear/tui/ui

extern type AppHandle = "*tinear.UiTestApp"
extern fn _test_app(root: ui::Widget) AppHandle = "tinear.UiTestNew"
extern fn _test_pump(app: AppHandle, width: Int, height: Int) Void = "tinear.UiTestPump"
extern fn _test_key(app: AppHandle, text: Str) Void = "tinear.UiTestKey"
extern fn _test_enter(app: AppHandle) Void = "tinear.UiTestEnter"
extern fn _test_ctrl_j(app: AppHandle) Void = "tinear.UiTestCtrlJ"
extern fn _test_escape(app: AppHandle) Void = "tinear.UiTestEscape"
extern fn _test_up(app: AppHandle) Void = "tinear.UiTestUp"
extern fn _test_down(app: AppHandle) Void = "tinear.UiTestDown"
extern fn _test_left(app: AppHandle) Void = "tinear.UiTestLeft"
extern fn _test_right(app: AppHandle) Void = "tinear.UiTestRight"
extern fn _test_tab(app: AppHandle) Void = "tinear.UiTestTab"
extern fn _test_shift_tab(app: AppHandle) Void = "tinear.UiTestShiftTab"
extern fn _test_click(app: AppHandle, x: Int, y: Int) Void = "tinear.UiTestClick"
extern fn _test_contains(app: AppHandle, text: Str) Bool = "tinear.UiTestContains"
extern fn _test_text(app: AppHandle) Str = "tinear.UiTestText"
extern fn _test_cell_grapheme(app: AppHandle, x: Int, y: Int) Str = "tinear.UiTestCellGrapheme"
extern fn _test_cell_reverse(app: AppHandle, x: Int, y: Int) Bool = "tinear.UiTestCellReverse"
extern fn _test_should_quit(app: AppHandle) Bool = "tinear.UiTestShouldQuit"

struct App {
  handle: AppHandle,
}

fn app(root: ui::Widget) App {
  App{handle: _test_app(root)}
}

impl App {
  fn pump(width: Int, height: Int) {
    _test_pump(app: self.handle, width: width, height: height)
  }

  fn key(text: Str) {
    _test_key(self.handle, text)
  }

  fn enter() {
    _test_enter(self.handle)
  }

  fn ctrl_j() {
    _test_ctrl_j(self.handle)
  }

  fn escape() {
    _test_escape(self.handle)
  }

  fn up() {
    _test_up(self.handle)
  }

  fn down() {
    _test_down(self.handle)
  }

  fn left() {
    _test_left(self.handle)
  }

  fn right() {
    _test_right(self.handle)
  }

  fn tab() {
    _test_tab(self.handle)
  }

  fn shift_tab() {
    _test_shift_tab(self.handle)
  }

  fn click(x: Int, y: Int) {
    _test_click(app: self.handle, x: x, y: y)
  }

  fn contains(text: Str) Bool {
    _test_contains(self.handle, text)
  }

  fn text() Str {
    _test_text(self.handle)
  }

  fn cell_grapheme(x: Int, y: Int) Str {
    _test_cell_grapheme(app: self.handle, x: x, y: y)
  }

  fn cell_reverse(x: Int, y: Int) Bool {
    _test_cell_reverse(app: self.handle, x: x, y: y)
  }

  fn should_quit() Bool {
    _test_should_quit(self.handle)
  }
}
