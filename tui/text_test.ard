use ard/testing

use tinear/tui/text

test fn test_truncate_preserves_valid_utf8_prefix() Void!Str {
  testing::assert(
    text::truncate("a€b", 4) == "a€",
    "truncate should keep whole runes within byte budget",
  )
}

test fn test_truncate_drops_first_rune_when_it_exceeds_budget() Void!Str {
  testing::assert(text::truncate("€abc", 2) == "", "truncate should preserve prefix semantics")
}
