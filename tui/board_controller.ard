use cooper/box
use cooper/event
use cooper/geometry
use cooper/runtime
use cooper/scroll_box
use cooper/style
use cooper/text
use tinear/models/issue_state
use tinear/models/issues
use tinear/services/board_service
use tinear/tui/issue_field_picker_controller
use tinear/tui/lifecycle
use tinear/tui/scheduler
use tinear/tui/shell_controller
use tinear/tui/theme as tinear_theme

let COLUMN_WIDTH: Int = 38
let COLUMN_GAP: Int = 2
let CARD_HEIGHT: Int = 5
let COMPLETED_COLUMN_CAP: Int = 10
let COLUMN_RULE: Str = "──────────────────────────────────────"
let DROP_COLUMN_RULE: Str = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

struct CardRecord {
  issue_id: Str,
  root: mut box::Box,
  surface: mut box::Box,
  id_line: mut text::Text,
  title: mut text::Text,
  metadata: mut text::Text,
  remove_mouse: fn(),
}

struct ColumnRecord {
  key: Str,
  root: mut box::Box,
  header_label: mut text::Text,
  header_rule: mut text::Text,
  scroll: mut scroll_box::ScrollBox,
  cards: [CardRecord],
  remove_mouse: fn(),
}

struct BoardController {
  root: mut box::Box,
  context: mut runtime::Runtime,
  status: mut text::Text,
  outer_scroll: mut scroll_box::ScrollBox,
  columns_row: mut box::Box,
  drag_layer: mut box::Box,
  drag_ghost: mut box::Box,
  drag_ghost_id: mut text::Text,
  drag_ghost_title: mut text::Text,
  drag_ghost_metadata: mut text::Text,
  remove_drag_layer_mouse: fn(),
  remove_focus_blur: fn(),
  remove_terminal_focus: fn(),
  drag_offset_x: Int,
  drag_offset_y: Int,
  drag_width: Int,
  drag_height: Int,
  columns: [issues::BoardColumn],
  column_records: [ColumnRecord],
  column_index: Int,
  card_index: Int,
  hovered_issue_id: Str,
  pointer_issue_id: Str,
  pointer_start_x: Int,
  pointer_start_y: Int,
  suppress_open_issue_id: Str,
  dragging_issue_id: Str,
  drag_target_key: Str,
  drag_generation: Int,
  moving_issue_id: Str,
  failed_move_issue_id: Str,
  move_generation: Int,
  move_snapshot: [issues::BoardColumn]?,
  refresh_pending: Bool,
  refresh_pending_silent: Bool,
  load_in_flight: Bool,
  load_silent: Bool,
  generation: Int,
  scope: mut lifecycle::Scope,
  service: board_service::Service,
  schedule: scheduler::Schedule,
  cancel_refresh: fn(),
  cancel_failed_move: fn(),
  on_open_issue: fn(Str),
  on_pick_field: fn(issue_field_picker_controller::Field, issues::Issue),
  on_issue_moved: fn(issues::Issue),
  notify_error: fn(Str, Str),
  palette: tinear_theme::Theme,
}

private fn column_key(column: issues::BoardColumn) Str {
  column.raw_state_name
}

private fn status_style(display: style::Display) style::Style {
  style::new(
    display: display,
    width: style::percent(100.0),
    height: style::cells(1),
    flex_shrink: 0.0,
  )
}

private fn board_style(display: style::Display) style::Style {
  style::new(
    display: display,
    width: style::percent(100.0),
    height: style::cells(1),
    flex_grow: 1.0,
  )
}

private fn drag_layer_style(display: style::Display) style::Style {
  style::new(
    display: display,
    position: style::Position::absolute,
    left: style::cells(0),
    top: style::cells(0),
    width: style::percent(100.0),
    height: style::percent(100.0),
    overflow: style::Overflow::hidden,
    z_index: 100,
  )
}

private fn drag_ghost_style(
  left: Int,
  top: Int,
  width: Int,
  height: Int,
  palette: tinear_theme::Theme,
) style::Style {
  style::new(
    position: style::Position::absolute,
    left: style::cells(left),
    top: style::cells(top),
    width: style::cells(width),
    height: style::cells(height),
    padding: style::Edges{
      top: style::cells(0),
      right: style::cells(1),
      bottom: style::cells(0),
      left: style::cells(1),
    },
    overflow: style::Overflow::hidden,
    background: palette.item_active_background,
    z_index: 1,
  )
}

private fn absolute(value: Int) Int {
  match value < 0 {
    true => 0 - value,
    false => value,
  }
}

private fn wheel_step(value: Int) Int {
  match value < 0 {
    true => -3,
    false => 3,
  }
}

private fn clamp_position(value: Int, maximum: Int) Int {
  let safe_maximum = match maximum < 0 {
    true => 0,
    false => maximum,
  }
  if value < 0 {
    0
  } else if value > safe_maximum {
    safe_maximum
  } else {
    value
  }
}

private fn columns_row_style(count: Int) style::Style {
  let gaps = match count > 0 {
    true => count - 1,
    false => 0,
  }
  style::new(
    width: style::cells(count * COLUMN_WIDTH + gaps * COLUMN_GAP),
    height: style::percent(100.0),
    flex_direction: style::FlexDirection::row,
    align_items: style::Align::stretch,
    gap: style::cells(COLUMN_GAP),
  )
}

private fn priority_style(priority: Int?, palette: tinear_theme::Theme) text::SpanStyle {
  match priority {
    value => {
      match value {
        1 => text::span_style(foreground: palette.danger, bold: true),
        2 => text::span_style(foreground: palette.warning, bold: true),
        4 => text::span_style(dim: true),
        _ => text::span_style(),
      }
    },
    _ => text::span_style(),
  }
}

private fn card_metadata(issue: issues::Issue) Str {
  let has_cycle = not issue.cycle_label.is_empty() and not issue.cycle_label == "—"
  let has_project = not issue.project_name.is_empty() and not issue.project_name == "—"
  match {
    has_cycle and has_project => "{issue.cycle_label} · {issue.project_name}",
    has_cycle => issue.cycle_label,
    has_project => issue.project_name,
    _ => "",
  }
}

private fn id_content(
  issue: issues::Issue,
  palette: tinear_theme::Theme,
  active: Bool?,
  hovered: Bool?,
) text::StyledText {
  let is_active = active.or(false)
  let is_hovered = hovered.or(false)
  let foreground = match {
    is_active => palette.item_active_foreground,
    is_hovered => palette.item_hover_foreground,
    _ => palette.foreground,
  }
  text::styled_text(
    [
      text::span(
        issue_state::priority_glyph(issue.priority),
        style: match is_active or is_hovered {
          true => text::span_style(foreground: foreground, bold: true),
          false => priority_style(issue.priority, palette),
        },
      ),
      text::span(" {issue.identifier}", style: text::span_style(foreground: foreground, bold: true)),
    ],
  )
}

private fn header_content(column: issues::BoardColumn, selected: Bool, palette: tinear_theme::Theme) text::StyledText {
  text::styled_text(
    [
      text::span(
        column.name,
        style: match selected {
          true => text::span_style(foreground: palette.accent, bold: true),
          false => text::span_style(bold: true),
        },
      ),
      text::span("  {column.issues.size()}", style: text::span_style(dim: true)),
    ],
  )
}

private fn target_for(column: issues::BoardColumn) board_service::StateTarget {
  board_service::StateTarget{
    raw_name: column.raw_state_name,
    name: column.name,
    state_type: column.state_type,
    position: column.position,
  }
}

private fn issue_with_state(issue: issues::Issue, state_id: Str, target: board_service::StateTarget) issues::Issue {
  issues::Issue{
    id: issue.id,
    identifier: issue.identifier,
    title: issue.title,
    description: issue.description,
    priority: issue.priority,
    state_id: state_id,
    state_name: target.name,
    state_type: target.state_type,
    state_position: target.position,
    team_id: issue.team_id,
    team_name: issue.team_name,
    team_key: issue.team_key,
    project_id: issue.project_id,
    project_name: issue.project_name,
    assignee_id: issue.assignee_id,
    assignee_name: issue.assignee_name,
    cycle_id: issue.cycle_id,
    cycle_label: issue.cycle_label,
    url: issue.url,
  }
}

private fn apply_confirmed_state(
  columns: [issues::BoardColumn],
  issue_id: Str,
  state: issues::WorkflowState,
) [issues::BoardColumn] {
  let updated = mut List::new<issues::BoardColumn>()
  let target = board_service::StateTarget{
    raw_name: state.raw_name,
    name: state.name,
    state_type: state.state_type,
    position: state.position,
  }
  for column in columns {
    let cards = mut List::new<issues::Issue>()
    for issue in column.issues {
      match issue.id == issue_id {
        true => cards.push(issue_with_state(issue, state.id, target)),
        false => cards.push(issue),
      }
    }
    updated.push(
      issues::BoardColumn{
        raw_state_name: column.raw_state_name,
        name: column.name,
        state_type: column.state_type,
        position: column.position,
        issues: cards.@,
      },
    )
  }
  updated.@
}

private fn move_between_columns(
  columns: [issues::BoardColumn],
  issue_id: Str,
  target_key: Str,
  target_state_id: Str,
) [issues::BoardColumn]!Str {
  mut moving: issues::Issue? = Maybe::new()
  mut target: issues::BoardColumn? = Maybe::new()
  for column in columns {
    if column_key(column) == target_key {
      target = Maybe::new(column)
    }
    for issue in column.issues {
      if issue.id == issue_id {
        moving = Maybe::new(issue)
      }
    }
  }
  let selected = try moving -> _ { Result::err("The dragged issue is no longer on the board") }
  let destination = try target -> _ { Result::err("The target status is no longer on the board") }
  let moved = issue_with_state(selected, target_state_id, target_for(destination))
  let updated = mut List::new<issues::BoardColumn>()
  for column in columns {
    let cards = mut List::new<issues::Issue>()
    let is_target = column_key(column) == target_key
    let reserves_completed_slot = is_target and column.state_type == "completed"
    for issue in column.issues {
      if (not issue.id == issue_id) and ((not reserves_completed_slot) or cards.size() < COMPLETED_COLUMN_CAP - 1) {
        cards.push(issue)
      }
    }
    if is_target {
      cards.push(moved)
    }
    updated.push(
      issues::BoardColumn{
        raw_state_name: column.raw_state_name,
        name: column.name,
        state_type: column.state_type,
        position: column.position,
        issues: cards.@,
      },
    )
  }
  Result::ok(updated.@)
}

fn new(
  ctx: mut runtime::Runtime,
  palette: tinear_theme::Theme,
  service: board_service::Service,
  schedule: scheduler::Schedule,
  on_open_issue: fn(Str),
  on_pick_field: fn(issue_field_picker_controller::Field, issues::Issue),
  on_issue_moved: fn(issues::Issue),
  notify_error: fn(Str, Str),
) mut BoardController {
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      overflow: style::Overflow::hidden,
    ),
  )
  let status = text::new(
    ctx,
    content: "Loading My Issues…",
    selectable: false,
    styles: status_style(style::Display::flex),
    text_style: text::style(dim: true),
  )
  let outer_scroll = scroll_box::new(ctx, styles: board_style(style::Display::none))
  let columns_row = box::new(ctx, styles: columns_row_style(0))
  outer_scroll.add(columns_row)
  let drag_layer = box::new(ctx, styles: drag_layer_style(style::Display::none))
  let drag_ghost = box::new(
    ctx,
    styles: drag_ghost_style(0, 0, COLUMN_WIDTH, CARD_HEIGHT - 1, palette),
  )
  let drag_ghost_id = text::new(
    ctx,
    content: "",
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
  )
  let drag_ghost_title = text::new(
    ctx,
    content: "",
    selectable: false,
    wrap: text::TextWrap::word,
    overflow: text::TextOverflow::ellipsis,
    styles: style::new(width: style::percent(100.0), height: style::cells(2), flex_shrink: 0.0),
    text_style: text::style(foreground: palette.item_active_foreground, bold: true),
  )
  let drag_ghost_metadata = text::new(
    ctx,
    content: "",
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
    styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    text_style: text::style(foreground: palette.item_active_foreground, dim: true),
  )
  drag_ghost.add(drag_ghost_id)
  drag_ghost.add(drag_ghost_title)
  drag_ghost.add(drag_ghost_metadata)
  drag_layer.add(drag_ghost)
  root.add(status)
  root.add(outer_scroll)
  root.add(drag_layer)
  let controller = mut BoardController{
    root: root,
    context: ctx,
    status: status,
    outer_scroll: outer_scroll,
    columns_row: columns_row,
    drag_layer: drag_layer,
    drag_ghost: drag_ghost,
    drag_ghost_id: drag_ghost_id,
    drag_ghost_title: drag_ghost_title,
    drag_ghost_metadata: drag_ghost_metadata,
    remove_drag_layer_mouse: fn() {},
    remove_focus_blur: fn() {},
    remove_terminal_focus: fn() {},
    drag_offset_x: 0,
    drag_offset_y: 0,
    drag_width: COLUMN_WIDTH,
    drag_height: CARD_HEIGHT - 1,
    columns: [],
    column_records: [],
    column_index: 0,
    card_index: 0,
    hovered_issue_id: "",
    pointer_issue_id: "",
    pointer_start_x: 0,
    pointer_start_y: 0,
    suppress_open_issue_id: "",
    dragging_issue_id: "",
    drag_target_key: "",
    drag_generation: 0,
    moving_issue_id: "",
    failed_move_issue_id: "",
    move_generation: 0,
    move_snapshot: Maybe::new<[issues::BoardColumn]>(),
    refresh_pending: false,
    refresh_pending_silent: true,
    load_in_flight: false,
    load_silent: true,
    generation: 0,
    scope: lifecycle::new(),
    service: service,
    schedule: schedule,
    cancel_refresh: fn() {},
    cancel_failed_move: fn() {},
    on_open_issue: on_open_issue,
    on_pick_field: on_pick_field,
    on_issue_moved: on_issue_moved,
    notify_error: notify_error,
    palette: palette,
  }
  controller.remove_drag_layer_mouse = drag_layer.on_mouse(fn(received: mut event::MouseEvent) {
    if received.event_type == event::MouseEventType::drop and received.button == event::MouseButton::left {
      controller.drop_on_column(controller.column_key_at(received.x, received.y))
      received.stop_propagation()
    } else if received.event_type == event::MouseEventType::scroll and not controller.dragging_issue_id.is_empty() {
      controller.scroll_during_drag(received)
      received.stop_propagation()
    }
  })
  controller.remove_focus_blur = outer_scroll.on_blur(fn() {
    controller.pointer_issue_id = ""
    controller.suppress_open_issue_id = ""
    controller.clear_drag_visuals()
    controller.run_pending_refresh()
  })
  controller.remove_terminal_focus = ctx.on_terminal_focus(fn(value: event::TerminalFocus) {
    if value == event::TerminalFocus::lost {
      controller.pointer_issue_id = ""
      controller.suppress_open_issue_id = ""
      controller.clear_drag_visuals()
      controller.run_pending_refresh()
    }
  })
  controller
}

impl BoardController {
  fn selected_issue_id() Str {
    match self.columns.at(self.column_index) {
      column => {
        match column.issues.at(self.card_index) {
          issue => issue.id,
          _ => "",
        }
      },
      _ => "",
    }
  }

  private fn selected_issue() issues::Issue? {
    match self.columns.at(self.column_index) {
      column => column.issues.at(self.card_index),
      _ => Maybe::new<issues::Issue>(),
    }
  }

  private fn issue_by_id(issue_id: Str) issues::Issue? {
    mut found: issues::Issue? = Maybe::new()
    for column in self.columns {
      for issue in column.issues {
        if issue.id == issue_id {
          found = Maybe::new(issue)
        }
      }
    }
    found
  }

  private fn column_by_key(key: Str) issues::BoardColumn? {
    mut found: issues::BoardColumn? = Maybe::new()
    for column in self.columns {
      if column_key(column) == key {
        found = Maybe::new(column)
      }
    }
    found
  }

  private fn mut arm_drag(issue_id: Str, width: Int, height: Int, offset_x: Int, offset_y: Int) {
    match self.issue_by_id(issue_id) {
      issue => {
        self.drag_offset_x = offset_x
        self.drag_offset_y = offset_y
        self.drag_width = width
        self.drag_height = height
        self.drag_ghost_id.set_content(id_content(issue, self.palette, true, false))
        self.drag_ghost_title.set_content(issue.title)
        self.drag_ghost_metadata.set_content(card_metadata(issue))
      },
      _ => (),
    }
  }

  private fn mut move_drag_ghost(x: Int, y: Int) {
    let screen = self.root.layout().screen
    let left = clamp_position(x - screen.x - self.drag_offset_x, screen.width - self.drag_width)
    let top = clamp_position(y - screen.y - self.drag_offset_y, screen.height - self.drag_height)
    self.drag_ghost.set_style(
      drag_ghost_style(left, top, self.drag_width, self.drag_height, self.palette),
    )
    self.drag_layer.set_style(drag_layer_style(style::Display::flex))
  }

  private fn passed_drag_threshold(x: Int, y: Int) Bool {
    absolute(x - self.pointer_start_x) >= 2 or absolute(y - self.pointer_start_y) >= 2
  }

  private fn mut create_card(issue: issues::Issue) CardRecord {
    let root = box::new(
      self.context,
      styles: style::new(
        width: style::percent(100.0),
        height: style::cells(CARD_HEIGHT),
        flex_shrink: 0.0,
        flex_direction: style::FlexDirection::row,
        overflow: style::Overflow::hidden,
      ),
    )
    let surface = box::new(
      self.context,
      styles: style::new(
        width: style::cells(1),
        height: style::cells(CARD_HEIGHT - 1),
        flex_grow: 1.0,
        background: self.palette.background,
        padding: style::Edges{
          top: style::cells(0),
          right: style::cells(1),
          bottom: style::cells(0),
          left: style::cells(1),
        },
      ),
    )
    let id_line = text::new(
      self.context,
      content: id_content(issue, self.palette, false, false),
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::ellipsis,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    )
    let title = text::new(
      self.context,
      content: issue.title,
      selectable: false,
      wrap: text::TextWrap::word,
      overflow: text::TextOverflow::ellipsis,
      styles: style::new(width: style::percent(100.0), height: style::cells(2), flex_shrink: 0.0),
    )
    let metadata = text::new(
      self.context,
      content: card_metadata(issue),
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::ellipsis,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      text_style: text::style(dim: true),
    )
    surface.add(id_line)
    surface.add(title)
    surface.add(metadata)
    root.add(surface)
    let issue_id = issue.id
    let remove_mouse = surface.on_mouse(fn(received: mut event::MouseEvent) {
      if received.event_type == event::MouseEventType::move {
        self.set_hovered(issue_id)
      } else if received.event_type == event::MouseEventType::out {
        self.clear_hovered(issue_id)
      } else if received.event_type == event::MouseEventType::down and received.button == event::MouseButton::left {
        if self.load_in_flight {
          self.generation =+ 1
          self.load_in_flight = false
          self.queue_refresh(self.load_silent)
        }
        let _ = self.outer_scroll.focus()
        self.select_issue(issue_id)
        self.pointer_issue_id = issue_id
        self.suppress_open_issue_id = ""
        self.dragging_issue_id = ""
        self.drag_target_key = ""
        self.drag_generation =+ 1
        received.prevent_default()
        let bounds = surface.layout().screen
        self.pointer_start_x = received.x
        self.pointer_start_y = received.y
        self.arm_drag(issue_id, bounds.width, bounds.height, received.local_x, received.local_y)
        received.stop_propagation()
      } else if received.event_type == event::MouseEventType::drag and received.button == event::MouseButton::left {
        if self.pointer_issue_id == issue_id and self.passed_drag_threshold(received.x, received.y) {
          self.suppress_open_issue_id = issue_id
          if self.moving_issue_id.is_empty() {
            let started = self.dragging_issue_id.is_empty()
            self.dragging_issue_id = issue_id
            self.move_drag_ghost(received.x, received.y)
            let previous_target = self.drag_target_key
            self.update_drag_target(received.x, received.y)
            if started and previous_target == self.drag_target_key {
              self.refresh_selection_styles()
            }
          }
        }
        received.stop_propagation()
      } else if received.event_type == event::MouseEventType::drag_end and received.button == event::MouseButton::left {
        if self.dragging_issue_id == issue_id {
          let generation = self.drag_generation
          let _ = self.context.dispatch(fn() {
            if self.drag_generation == generation and self.dragging_issue_id == issue_id {
              self.clear_drag_visuals()
              self.run_pending_refresh()
            }
          })
        }
        received.stop_propagation()
      } else if received.event_type == event::MouseEventType::up and received.button == event::MouseButton::left {
        if self.pointer_issue_id == issue_id {
          let suppress_open = self.suppress_open_issue_id == issue_id
          self.pointer_issue_id = ""
          self.suppress_open_issue_id = ""
          if not suppress_open {
            self.select_issue(issue_id)
            self.open_selected()
          }
          self.run_pending_refresh()
        }
        received.stop_propagation()
      }
    })
    CardRecord{
      issue_id: issue.id,
      root: root,
      surface: surface,
      id_line: id_line,
      title: title,
      metadata: metadata,
      remove_mouse: remove_mouse,
    }
  }

  private fn mut reconcile_cards(
    scroll: mut scroll_box::ScrollBox,
    previous: [CardRecord],
    values: [issues::Issue],
  ) [CardRecord] {
    for card in previous {
      let _ = scroll.remove(card.root)
    }
    let next = mut List::new<CardRecord>()
    for issue in values {
      mut found: CardRecord? = Maybe::new()
      for card in previous {
        if card.issue_id == issue.id {
          found = Maybe::new(card)
        }
      }
      let card = match found {
        existing => existing,
        _ => self.create_card(issue),
      }
      card.id_line.set_content(id_content(issue, self.palette, false, false))
      card.title.set_content(issue.title)
      card.metadata.set_content(card_metadata(issue))
      next.push(card)
      scroll.add(card.root)
    }
    for old in previous {
      mut retained = false
      for card in next {
        if card.issue_id == old.issue_id {
          retained = true
        }
      }
      if not retained {
        old.remove_mouse()
        old.root.destroy(recursive: true)
      }
    }
    next.@
  }

  private fn mut create_column(column: issues::BoardColumn) ColumnRecord {
    let root = box::new(
      self.context,
      styles: style::new(
        width: style::cells(COLUMN_WIDTH),
        height: style::percent(100.0),
        flex_shrink: 0.0,
        overflow: style::Overflow::hidden,
      ),
    )
    let header_label = text::new(
      self.context,
      content: "",
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::ellipsis,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
    )
    let header_rule = text::new(
      self.context,
      content: COLUMN_RULE,
      selectable: false,
      wrap: text::TextWrap::none,
      overflow: text::TextOverflow::clip,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_shrink: 0.0),
      text_style: text::style(dim: true),
    )
    let scroll = scroll_box::new(
      self.context,
      styles: style::new(width: style::percent(100.0), height: style::cells(1), flex_grow: 1.0),
    )
    root.add(header_label)
    root.add(header_rule)
    root.add(scroll)
    let key = column_key(column)
    let remove_mouse = root.on_mouse(fn(received: mut event::MouseEvent) {
      if received.event_type == event::MouseEventType::drop and received.button == event::MouseButton::left {
        self.drop_on_column(key)
        received.stop_propagation()
      }
    })
    ColumnRecord{
      key: key,
      root: root,
      header_label: header_label,
      header_rule: header_rule,
      scroll: scroll,
      cards: [],
      remove_mouse: remove_mouse,
    }
  }

  private fn mut reconcile_columns() {
    self.hovered_issue_id = ""
    let previous = self.column_records
    for column in previous {
      let _ = self.columns_row.remove(column.root)
    }
    let next = mut List::new<ColumnRecord>()
    for column in self.columns {
      let key = column_key(column)
      mut found: ColumnRecord? = Maybe::new()
      for existing in previous {
        if existing.key == key {
          found = Maybe::new(existing)
        }
      }
      let base = match found {
        existing => existing,
        _ => self.create_column(column),
      }
      base.header_label.set_content(header_content(column, false, self.palette))
      let cards = self.reconcile_cards(base.scroll, base.cards, column.issues)
      let updated = ColumnRecord{
        key: key,
        root: base.root,
        header_label: base.header_label,
        header_rule: base.header_rule,
        scroll: base.scroll,
        cards: cards,
        remove_mouse: base.remove_mouse,
      }
      next.push(updated)
      self.columns_row.add(updated.root)
    }
    for old in previous {
      mut retained = false
      for column in next {
        if column.key == old.key {
          retained = true
        }
      }
      if not retained {
        old.remove_mouse()
        for card in old.cards {
          card.remove_mouse()
        }
        old.root.destroy(recursive: true)
      }
    }
    self.column_records = next.@
    self.columns_row.set_style(columns_row_style(self.column_records.size()))
    self.refresh_selection_styles()
  }

  private fn issue_column_key(issue_id: Str) Str {
    mut found = ""
    for column in self.columns {
      for issue in column.issues {
        if issue.id == issue_id {
          found = column_key(column)
        }
      }
    }
    found
  }

  private fn column_key_at(x: Int, y: Int) Str {
    let viewport = self.outer_scroll.layout().screen
    mut found = ""
    mut closest = COLUMN_GAP + 1
    if geometry::contains(viewport, x, y) {
      for column in self.column_records {
        let visible = geometry::intersect(column.root.layout().screen, viewport)
        if visible.width > 0 and visible.height > 0 and y >= visible.y and y < visible.y + visible.height {
          let distance = match {
            x < visible.x => visible.x - x,
            x >= visible.x + visible.width => x - (visible.x + visible.width - 1),
            _ => 0,
          }
          if distance < closest and distance <= COLUMN_GAP {
            closest = distance
            found = column.key
          }
        }
      }
    }
    found
  }

  private fn mut scroll_during_drag(received: mut event::MouseEvent) {
    mut changed = false
    if received.scroll_x != 0 {
      changed = self.outer_scroll.scroll_by_x(wheel_step(received.scroll_x)) or changed
    }
    if received.scroll_y != 0 {
      if received.modifiers.shift {
        changed = self.outer_scroll.scroll_by_x(wheel_step(received.scroll_y)) or changed
      } else {
        let key = self.column_key_at(received.x, received.y)
        for column in self.column_records {
          if column.key == key {
            changed = column.scroll.scroll_by(wheel_step(received.scroll_y)) or changed
          }
        }
      }
    }
    if changed {
      let x = received.x
      let y = received.y
      let generation = self.drag_generation
      let _ = self.context.dispatch(fn() {
        if self.drag_generation == generation and not self.dragging_issue_id.is_empty() {
          self.update_drag_target(x, y)
        }
      })
    }
  }

  private fn mut update_drag_target(x: Int, y: Int) {
    let source = self.issue_column_key(self.dragging_issue_id)
    let hovered = self.column_key_at(x, y)
    let target = match hovered == source {
      true => "",
      false => hovered,
    }
    if not self.drag_target_key == target {
      self.drag_target_key = target
      self.refresh_selection_styles()
    }
  }

  private fn mut clear_drag_visuals() {
    self.drag_generation =+ 1
    self.dragging_issue_id = ""
    self.drag_target_key = ""
    self.hovered_issue_id = ""
    self.drag_layer.set_style(drag_layer_style(style::Display::none))
    self.refresh_selection_styles()
  }

  private fn mut confirm_move(issue_id: Str, state: issues::WorkflowState) {
    self.replace_columns(apply_confirmed_state(self.columns, issue_id, state), true)
  }

  private fn mut show_move_failure(issue_id: Str, generation: Int) {
    self.cancel_failed_move()
    self.failed_move_issue_id = issue_id
    self.refresh_selection_styles()
    self.cancel_failed_move = self.schedule(4000, fn() {
      if (not self.scope.disposed) and self.move_generation == generation and self.failed_move_issue_id == issue_id {
        self.failed_move_issue_id = ""
        self.refresh_selection_styles()
      }
    })
  }

  private fn mut drop_on_column(target_key: Str) {
    let issue_id = self.dragging_issue_id
    let source_key = self.issue_column_key(issue_id)
    self.clear_drag_visuals()
    if (not issue_id.is_empty()) and (not source_key.is_empty()) and (not target_key == source_key) and self.moving_issue_id.is_empty() {
      match self.issue_by_id(issue_id) {
        issue => {
          match self.column_by_key(target_key) {
            target_column => {
              match move_between_columns(self.columns, issue.id, target_key, "") {
                ok(columns) => {
                  let previous = self.columns
                  self.cancel_failed_move()
                  self.failed_move_issue_id = ""
                  self.move_generation =+ 1
                  let move_generation = self.move_generation
                  self.generation =+ 1
                  self.moving_issue_id = issue.id
                  self.move_snapshot = Maybe::new(previous)
                  self.replace_columns(columns, false)
                  self.select_issue(issue.id)
                  self.service.move(
                    self.scope.stop.receiver(),
                    board_service::MoveRequest{
                      issue_id: issue.id,
                      team_id: issue.team_id,
                      target: target_for(target_column),
                    },
                    fn(result: board_service::MoveResult!Str) {
                      if (not self.scope.disposed) and move_generation == self.move_generation {
                        self.moving_issue_id = ""
                        match result {
                          ok(moved) => {
                            self.move_snapshot = Maybe::new<[issues::BoardColumn]>()
                            self.confirm_move(issue.id, moved.state)
                            self.queue_refresh(true)
                            self.on_issue_moved(issue_with_state(issue, moved.state.id, target_for(target_column)))
                          },
                          err(message) => {
                            match self.move_snapshot {
                              snapshot => self.replace_columns(snapshot, true),
                              _ => self.refresh_selection_styles(),
                            }
                            self.move_snapshot = Maybe::new<[issues::BoardColumn]>()
                            self.show_move_failure(issue.id, move_generation)
                            self.notify_error("Couldn't move {issue.identifier}", message)
                          },
                        }
                        self.run_pending_refresh()
                      }
                    },
                  )
                },
                err(message) => self.notify_error("Couldn't move {issue.identifier}", message),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
    self.run_pending_refresh()
  }

  private fn mut set_hovered(issue_id: Str) {
    if not self.hovered_issue_id == issue_id {
      self.hovered_issue_id = issue_id
      self.refresh_selection_styles()
    }
  }

  private fn mut clear_hovered(issue_id: Str) {
    if self.hovered_issue_id == issue_id {
      self.hovered_issue_id = ""
      self.refresh_selection_styles()
    }
  }

  private fn mut refresh_selection_styles() {
    let selected = self.selected_issue_id()
    for column, column_index in self.column_records {
      match self.columns.at(column_index) {
        value => {
          let drop_target = column.key == self.drag_target_key
          let selected_column = column_index == self.column_index and self.dragging_issue_id.is_empty()
          column.header_label.set_content(
            header_content(value, selected_column or drop_target, self.palette),
          )
          column.header_rule.set_content(
            match drop_target {
              true => DROP_COLUMN_RULE,
              false => COLUMN_RULE,
            },
          )
          column.header_rule.set_text_style(
            match drop_target {
              true => text::style(foreground: self.palette.accent, bold: true),
              false => text::style(dim: true),
            },
          )
        },
        _ => (),
      }
      for card in column.cards {
        for issue in self.columns.at(column_index).expect("column").issues {
          if issue.id == card.issue_id {
            let active = card.issue_id == selected
            let hovered = (not active) and card.issue_id == self.hovered_issue_id
            let is_dragging = card.issue_id == self.dragging_issue_id
            let is_moving = card.issue_id == self.moving_issue_id
            let move_failed = card.issue_id == self.failed_move_issue_id
            let foreground = match {
              active and not is_dragging => self.palette.item_active_foreground,
              hovered => self.palette.item_hover_foreground,
              _ => self.palette.foreground,
            }
            let background = match {
              active and not is_dragging => self.palette.item_active_background,
              hovered => self.palette.item_hover_background,
              _ => self.palette.background,
            }
            let surface_style = mut card.surface.style()
            surface_style.background = Maybe::new(background)
            card.surface.set_style(surface_style.@)
            if is_dragging {
              card.id_line.set_content(
                text::styled_text(
                  [
                    text::span("  ↳ {issue.identifier} · drop on a column", style: text::span_style(dim: true)),
                  ],
                ),
              )
              card.title.set_content("")
              card.title.set_text_style(text::style(dim: true))
              card.metadata.set_content("")
              card.metadata.set_text_style(text::style(dim: true))
            } else {
              card.id_line.set_content(id_content(issue, self.palette, active, hovered))
              card.title.set_content(issue.title)
              card.title.set_text_style(text::style(foreground: foreground, bold: active))
              card.metadata.set_content(
                match {
                  move_failed => "! move failed",
                  is_moving => "⋯ updating…",
                  _ => card_metadata(issue),
                },
              )
              card.metadata.set_text_style(
                match move_failed {
                  true => text::style(foreground: self.palette.danger, bold: true),
                  false => text::style(foreground: foreground, dim: is_moving or (not active) and (not hovered)),
                },
              )
            }
          }
        }
      }
    }
  }

  private fn mut show_status(message: Str, error: Bool) {
    self.status.set_content(
      match message.is_empty() {
        true => "",
        false => "  {message}",
      },
    )
    self.status.set_text_style(
      match error {
        true => text::style(foreground: self.palette.danger, bold: true),
        false => text::style(dim: true),
      },
    )
    self.status.set_style(
      status_style(
        match message.is_empty() {
          true => style::Display::none,
          false => style::Display::flex,
        },
      ),
    )
    self.outer_scroll.set_style(
      board_style(
        match message.is_empty() {
          true => style::Display::flex,
          false => style::Display::none,
        },
      ),
    )
  }

  private fn mut reveal_selection() {
    match self.column_records.at(self.column_index) {
      column => {
        let _ = self.outer_scroll.scroll_child_into_view(column.root)
        match column.cards.at(self.card_index) {
          card => {
            let _ = column.scroll.scroll_child_into_view(card.root)
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut restore_reconciled_selection() {
    let _ = self.outer_scroll.scroll_to_x(self.column_index * (COLUMN_WIDTH + COLUMN_GAP))
    match self.column_records.at(self.column_index) {
      column => {
        let _ = column.scroll.scroll_to(self.card_index * CARD_HEIGHT)
      },
      _ => (),
    }
  }

  private fn mut replace_columns(columns: [issues::BoardColumn], preserve_selection: Bool) {
    self.drag_generation =+ 1
    self.pointer_issue_id = ""
    self.suppress_open_issue_id = ""
    self.dragging_issue_id = ""
    self.drag_target_key = ""
    self.drag_layer.set_style(drag_layer_style(style::Display::none))
    let previous_id = match preserve_selection {
      true => self.selected_issue_id(),
      false => "",
    }
    self.columns = columns
    self.column_index = 0
    self.card_index = 0
    if not previous_id.is_empty() {
      for column, column_index in self.columns {
        for issue, card_index in column.issues {
          if issue.id == previous_id {
            self.column_index = column_index
            self.card_index = card_index
          }
        }
      }
    }
    self.reconcile_columns()
    match self.columns.size() {
      0 => self.show_status("No assigned issues", false),
      _ => {
        self.show_status("", false)
        self.restore_reconciled_selection()
      },
    }
  }

  private fn mut queue_refresh(silent: Bool) {
    if not self.refresh_pending {
      self.refresh_pending_silent = silent
    } else if not silent {
      self.refresh_pending_silent = false
    }
    self.refresh_pending = true
  }

  private fn mut run_pending_refresh() {
    if self.refresh_pending and self.pointer_issue_id.is_empty() and self.dragging_issue_id.is_empty() and self.moving_issue_id.is_empty() {
      let silent = self.refresh_pending_silent
      self.refresh_pending = false
      self.refresh_pending_silent = true
      self.refresh(silent)
    }
  }

  private fn mut schedule_refresh() {
    self.cancel_refresh()
    self.cancel_refresh = self.schedule(5 * 60 * 1000, fn() {
      if not self.scope.disposed {
        self.refresh(true)
        self.schedule_refresh()
      }
    })
  }

  fn mut start() {
    if (not self.scope.disposed) and self.generation == 0 {
      self.refresh(false)
      self.schedule_refresh()
    }
  }

  fn mut refresh(silent: Bool) {
    if not self.scope.disposed {
      if not self.moving_issue_id.is_empty() or not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
        self.queue_refresh(silent)
      } else {
        self.generation =+ 1
        let generation = self.generation
        self.load_in_flight = true
        self.load_silent = silent
        if not silent {
          self.show_status("Loading My Issues…", false)
        }
        self.service.load(self.scope.stop.receiver(), fn(result: [issues::BoardColumn]!Str) {
          if (not self.scope.disposed) and generation == self.generation {
            self.load_in_flight = false
            if not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
              self.queue_refresh(silent)
            } else {
              match result {
                ok(columns) => self.replace_columns(columns, silent),
                err(message) => {
                  if self.columns.size() == 0 {
                    self.show_status(message, true)
                  } else {
                    self.show_status("", false)
                    self.notify_error("Couldn't refresh My Issues", message)
                  }
                },
              }
            }
          }
        })
      }
    }
  }

  fn mut select_issue(issue_id: Str) {
    for column, column_index in self.columns {
      for issue, card_index in column.issues {
        if issue.id == issue_id {
          self.column_index = column_index
          self.card_index = card_index
        }
      }
    }
    self.refresh_selection_styles()
    self.reveal_selection()
  }

  private fn mut move_horizontal(delta: Int) {
    if self.columns.size() > 0 {
      let cleared_hover = not self.hovered_issue_id.is_empty()
      self.hovered_issue_id = ""
      mut next = self.column_index + delta
      mut searching = true
      while searching {
        if next < 0 or next >= self.columns.size() {
          searching = false
        } else if self.columns.at(next).expect("column").issues.size() > 0 {
          searching = false
        } else {
          next = next + delta
        }
      }
      if next >= 0 and next < self.columns.size() and next != self.column_index {
        self.column_index = next
        let count = self.columns.at(next).expect("column").issues.size()
        if self.card_index >= count {
          self.card_index = count - 1
        }
        self.refresh_selection_styles()
        self.reveal_selection()
      } else if cleared_hover {
        self.refresh_selection_styles()
      }
    }
  }

  private fn mut move_vertical(delta: Int) {
    let cleared_hover = not self.hovered_issue_id.is_empty()
    self.hovered_issue_id = ""
    match self.columns.at(self.column_index) {
      column => {
        if column.issues.size() > 0 {
          mut next = self.card_index + delta
          if next < 0 {
            next = 0
          }
          if next >= column.issues.size() {
            next = column.issues.size() - 1
          }
          if next != self.card_index {
            self.card_index = next
            self.refresh_selection_styles()
            self.reveal_selection()
          } else if cleared_hover {
            self.refresh_selection_styles()
          }
        }
      },
      _ => (),
    }
  }

  private fn mut open_selected() {
    match self.selected_issue() {
      issue => self.on_open_issue(issue.identifier),
      _ => (),
    }
  }

  private fn mut pick_selected(field: issue_field_picker_controller::Field) {
    match self.selected_issue() {
      issue => {
        if not issue.id == self.moving_issue_id {
          self.on_pick_field(field, issue)
        }
      },
      _ => (),
    }
  }

  fn mut focus() {
    if not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
      self.pointer_issue_id = ""
      self.suppress_open_issue_id = ""
      self.clear_drag_visuals()
      self.run_pending_refresh()
    }
    let _ = self.outer_scroll.focus()
  }

  fn mut handle_key(received: mut event::KeyEvent) Bool {
    if self.scope.disposed or received.event_type == event::KeyEventType::release {
      false
    } else if not self.dragging_issue_id.is_empty() {
      if received.matches("escape") {
        self.pointer_issue_id = ""
        self.suppress_open_issue_id = ""
        self.clear_drag_visuals()
        self.run_pending_refresh()
      }
      true
    } else {
      mut handled = true
      match {
        received.matches("j") or received.matches("down") => self.move_vertical(1),
        received.matches("k") or received.matches("up") => self.move_vertical(-1),
        received.matches("l") or received.matches("right") => self.move_horizontal(1),
        received.matches("h") or received.matches("left") => self.move_horizontal(-1),
        received.matches("return") => self.open_selected(),
        received.matches("r") => self.refresh(false),
        received.matches("s") => self.pick_selected(issue_field_picker_controller::Field::state),
        received.matches("y") => self.pick_selected(issue_field_picker_controller::Field::cycle),
        received.matches("p") => self.pick_selected(issue_field_picker_controller::Field::priority),
        received.matches("a") => self.pick_selected(issue_field_picker_controller::Field::assignee),
        received.matches("p", shift: true) => {
          self.pick_selected(issue_field_picker_controller::Field::project)
        },
        _ => { handled = false },
      }
      handled
    }
  }

  fn mut screen() shell_controller::Screen {
    shell_controller::Screen{
      root: self.root,
      focus: fn() {
        self.focus()
      },
      handle_key: fn(received: mut event::KeyEvent) Bool {
        self.handle_key(received)
      },
      dispose: fn() {
        self.dispose()
      },
    }
  }

  fn mut dispose() {
    if not self.scope.disposed {
      if not self.dragging_issue_id.is_empty() {
        self.clear_drag_visuals()
      }
      self.cancel_refresh()
      self.cancel_failed_move()
      self.scope.dispose()
      self.drag_generation =+ 1
      self.move_generation =+ 1
      self.refresh_pending = false
      self.load_in_flight = false
      self.remove_drag_layer_mouse()
      self.remove_focus_blur()
      self.remove_terminal_focus()
      for column in self.column_records {
        column.remove_mouse()
        for card in column.cards {
          card.remove_mouse()
        }
      }
      self.column_records = []
    }
  }
}
