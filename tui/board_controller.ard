use cooper
use cooper/cui
use cooper/ui
use tinear/models/issue_state
use tinear/models/issues
use tinear/services/board_service
use tinear/tui/issue_field_picker_controller
use tinear/tui/scheduler
use tinear/tui/shell_controller
use tinear/tui/theme as tinear_theme

let COLUMN_WIDTH: Int = 38
let COLUMN_GAP: Int = 2
let CARD_HEIGHT: Int = 5
let COMPLETED_COLUMN_CAP: Int = 10
let COLUMN_RULE: Str = "──────────────────────────────────────"
let DROP_COLUMN_RULE: Str = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

// Retained geometry handles. Drag and drop needs screen bounds for cards and
// columns, so each keeps a ref into the described tree.
struct CardRecord {
  issue_id: Str,
  root: mut cui::BoxRef,
  surface: mut cui::BoxRef,
}

struct ColumnRecord {
  key: Str,
  root: mut cui::BoxRef,
  scroll: mut cui::ScrollBoxRef,
  cards: [CardRecord],
}

struct BoardController {
  context: mut cooper::Runtime,
  root: mut cui::BoxRef,
  status: Str,
  status_error: Bool,
  outer_scroll: mut cui::ScrollBoxRef,
  drag_ghost_id: ui::TextContent,
  drag_ghost_title: Str,
  drag_ghost_metadata: Str,
  drag_ghost_left: Int,
  drag_ghost_top: Int,
  drag_visible: Bool,
  remove_terminal_focus: fn(),
  drag_offset_x: Int,
  drag_offset_y: Int,
  drag_width: Int,
  drag_height: Int,
  columns: [issues::BoardColumn],
  column_records: [ColumnRecord],
  column_index: Int,
  card_index: Int,
  hovered_issue_id: Str,
  pointer_issue_id: Str,
  pointer_start_x: Int,
  pointer_start_y: Int,
  suppress_open_issue_id: Str,
  dragging_issue_id: Str,
  drag_target_key: Str,
  drag_generation: Int,
  moving_issue_id: Str,
  failed_move_issue_id: Str,
  move_generation: Int,
  move_snapshot: [issues::BoardColumn]?,
  refresh_pending: Bool,
  refresh_pending_silent: Bool,
  load_in_flight: Bool,
  load_silent: Bool,
  generation: Int,
  stop: Chan<Bool>,
  disposed: Bool,
  pending_focus: Bool,
  invalidate: fn(),
  service: board_service::Service,
  schedule: scheduler::Schedule,
  cancel_refresh: fn(),
  cancel_failed_move: fn(),
  on_open_issue: fn(Str),
  on_pick_field: fn(issue_field_picker_controller::Field, issues::Issue),
  on_issue_moved: fn(issues::Issue),
  notify_error: fn(Str, Str),
  palette: tinear_theme::Theme,
}

private fn column_key(column: issues::BoardColumn) Str {
  column.raw_state_name
}

private fn status_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    width: ui::percent(100.0),
    height: ui::cells(1),
    flex_shrink: 0.0,
  )
}

private fn board_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    width: ui::percent(100.0),
    height: ui::cells(1),
    flex_grow: 1.0,
  )
}

private fn drag_layer_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    position: ui::Position::absolute,
    left: ui::cells(0),
    top: ui::cells(0),
    width: ui::percent(100.0),
    height: ui::percent(100.0),
    overflow: ui::Overflow::hidden,
    z_index: 100,
  )
}

private fn drag_ghost_style(
  left: Int,
  top: Int,
  width: Int,
  height: Int,
  palette: tinear_theme::Theme,
) ui::Style {
  ui::style(
    position: ui::Position::absolute,
    left: ui::cells(left),
    top: ui::cells(top),
    width: ui::cells(width),
    height: ui::cells(height),
    padding: ui::Edges{
      top: ui::cells(0),
      right: ui::cells(1),
      bottom: ui::cells(0),
      left: ui::cells(1),
    },
    overflow: ui::Overflow::hidden,
    background: palette.item_active_background,
    z_index: 1,
  )
}

private fn absolute(value: Int) Int {
  match value < 0 {
    true => 0 - value,
    false => value,
  }
}

private fn wheel_step(value: Int) Int {
  match value < 0 {
    true => -3,
    false => 3,
  }
}

private fn clamp_position(value: Int, maximum: Int) Int {
  let safe_maximum = match maximum < 0 {
    true => 0,
    false => maximum,
  }
  if value < 0 {
    0
  } else if value > safe_maximum {
    safe_maximum
  } else {
    value
  }
}

private fn columns_row_style(count: Int) ui::Style {
  let gaps = match count > 0 {
    true => count - 1,
    false => 0,
  }
  ui::style(
    width: ui::cells(count * COLUMN_WIDTH + gaps * COLUMN_GAP),
    height: ui::percent(100.0),
    flex_direction: ui::FlexDirection::row,
    align_items: ui::Align::stretch,
    gap: ui::cells(COLUMN_GAP),
  )
}

private fn priority_style(priority: Int?, palette: tinear_theme::Theme) ui::SpanStyle {
  match priority {
    value => {
      match value {
        1 => ui::span_style(foreground: palette.danger, bold: true),
        2 => ui::span_style(foreground: palette.warning, bold: true),
        4 => ui::span_style(dim: true),
        _ => ui::span_style(),
      }
    },
    _ => ui::span_style(),
  }
}

private fn card_metadata(issue: issues::Issue) Str {
  let has_cycle = not issue.cycle_label.is_empty() and not issue.cycle_label == "—"
  let has_project = not issue.project_name.is_empty() and not issue.project_name == "—"
  match {
    has_cycle and has_project => "{issue.cycle_label} · {issue.project_name}",
    has_cycle => issue.cycle_label,
    has_project => issue.project_name,
    _ => "",
  }
}

private fn id_content(
  issue: issues::Issue,
  palette: tinear_theme::Theme,
  active: Bool?,
  hovered: Bool?,
) ui::StyledText {
  let is_active = active.or(false)
  let is_hovered = hovered.or(false)
  let foreground = match {
    is_active => palette.item_active_foreground,
    is_hovered => palette.item_hover_foreground,
    _ => palette.foreground,
  }
  ui::styled_text(
    [
      ui::span(
        issue_state::priority_glyph(issue.priority),
        style: match is_active or is_hovered {
          true => ui::span_style(foreground: foreground, bold: true),
          false => priority_style(issue.priority, palette),
        },
      ),
      ui::span(" {issue.identifier}", style: ui::span_style(foreground: foreground, bold: true)),
    ],
  )
}

private fn header_content(column: issues::BoardColumn, selected: Bool, palette: tinear_theme::Theme) ui::StyledText {
  ui::styled_text(
    [
      ui::span(
        column.name,
        style: match selected {
          true => ui::span_style(foreground: palette.accent, bold: true),
          false => ui::span_style(bold: true),
        },
      ),
      ui::span("  {column.issues.size()}", style: ui::span_style(dim: true)),
    ],
  )
}

private fn target_for(column: issues::BoardColumn) board_service::StateTarget {
  board_service::StateTarget{
    raw_name: column.raw_state_name,
    name: column.name,
    state_type: column.state_type,
    position: column.position,
  }
}

private fn issue_with_state(issue: issues::Issue, state_id: Str, target: board_service::StateTarget) issues::Issue {
  issues::Issue{
    id: issue.id,
    identifier: issue.identifier,
    title: issue.title,
    description: issue.description,
    priority: issue.priority,
    state_id: state_id,
    state_name: target.name,
    state_type: target.state_type,
    state_position: target.position,
    team_id: issue.team_id,
    team_name: issue.team_name,
    team_key: issue.team_key,
    project_id: issue.project_id,
    project_name: issue.project_name,
    assignee_id: issue.assignee_id,
    assignee_name: issue.assignee_name,
    cycle_id: issue.cycle_id,
    cycle_label: issue.cycle_label,
    url: issue.url,
  }
}

private fn apply_confirmed_state(
  columns: [issues::BoardColumn],
  issue_id: Str,
  state: issues::WorkflowState,
) [issues::BoardColumn] {
  let updated = mut List::new<issues::BoardColumn>()
  let target = board_service::StateTarget{
    raw_name: state.raw_name,
    name: state.name,
    state_type: state.state_type,
    position: state.position,
  }
  for column in columns {
    let cards = mut List::new<issues::Issue>()
    for issue in column.issues {
      match issue.id == issue_id {
        true => cards.push(issue_with_state(issue, state.id, target)),
        false => cards.push(issue),
      }
    }
    updated.push(
      issues::BoardColumn{
        raw_state_name: column.raw_state_name,
        name: column.name,
        state_type: column.state_type,
        position: column.position,
        issues: cards.@,
      },
    )
  }
  updated.@
}

private fn move_between_columns(
  columns: [issues::BoardColumn],
  issue_id: Str,
  target_key: Str,
  target_state_id: Str,
) [issues::BoardColumn]!Str {
  mut moving: issues::Issue? = Maybe::new()
  mut target: issues::BoardColumn? = Maybe::new()
  for column in columns {
    if column_key(column) == target_key {
      target = Maybe::new(column)
    }
    for issue in column.issues {
      if issue.id == issue_id {
        moving = Maybe::new(issue)
      }
    }
  }
  let selected = try moving -> _ { Result::err("The dragged issue is no longer on the board") }
  let destination = try target -> _ { Result::err("The target status is no longer on the board") }
  let moved = issue_with_state(selected, target_state_id, target_for(destination))
  let updated = mut List::new<issues::BoardColumn>()
  for column in columns {
    let cards = mut List::new<issues::Issue>()
    let is_target = column_key(column) == target_key
    let reserves_completed_slot = is_target and column.state_type == "completed"
    for issue in column.issues {
      if (not issue.id == issue_id) and ((not reserves_completed_slot) or cards.size() < COMPLETED_COLUMN_CAP - 1) {
        cards.push(issue)
      }
    }
    if is_target {
      cards.push(moved)
    }
    updated.push(
      issues::BoardColumn{
        raw_state_name: column.raw_state_name,
        name: column.name,
        state_type: column.state_type,
        position: column.position,
        issues: cards.@,
      },
    )
  }
  Result::ok(updated.@)
}

fn new(
  ctx: mut cooper::Runtime,
  palette: tinear_theme::Theme,
  service: board_service::Service,
  schedule: scheduler::Schedule,
  on_open_issue: fn(Str),
  on_pick_field: fn(issue_field_picker_controller::Field, issues::Issue),
  on_issue_moved: fn(issues::Issue),
  notify_error: fn(Str, Str),
) mut BoardController {
  let controller = mut BoardController{
    context: ctx,
    root: cui::box_ref(),
    status: "Loading My Issues…",
    status_error: false,
    outer_scroll: cui::scroll_box_ref(),
    drag_ghost_id: "",
    drag_ghost_title: "",
    drag_ghost_metadata: "",
    drag_ghost_left: 0,
    drag_ghost_top: 0,
    drag_visible: false,
    remove_terminal_focus: fn() {},
    drag_offset_x: 0,
    drag_offset_y: 0,
    drag_width: COLUMN_WIDTH,
    drag_height: CARD_HEIGHT - 1,
    columns: [],
    column_records: [],
    column_index: 0,
    card_index: 0,
    hovered_issue_id: "",
    pointer_issue_id: "",
    pointer_start_x: 0,
    pointer_start_y: 0,
    suppress_open_issue_id: "",
    dragging_issue_id: "",
    drag_target_key: "",
    drag_generation: 0,
    moving_issue_id: "",
    failed_move_issue_id: "",
    move_generation: 0,
    move_snapshot: Maybe::new<[issues::BoardColumn]>(),
    refresh_pending: false,
    refresh_pending_silent: true,
    load_in_flight: false,
    load_silent: true,
    generation: 0,
    stop: Chan::new<Bool>(),
    disposed: false,
    pending_focus: false,
    invalidate: fn() {},
    service: service,
    schedule: schedule,
    cancel_refresh: fn() {},
    cancel_failed_move: fn() {},
    on_open_issue: on_open_issue,
    on_pick_field: on_pick_field,
    on_issue_moved: on_issue_moved,
    notify_error: notify_error,
    palette: palette,
  }
  controller.remove_terminal_focus = ctx.on_terminal_focus(fn(value: cooper::TerminalFocus) {
    if value == cooper::TerminalFocus::lost {
      controller.pointer_issue_id = ""
      controller.suppress_open_issue_id = ""
      controller.clear_drag_visuals()
      controller.run_pending_refresh()
    }
  })
  controller
}

impl BoardController {
  fn selected_issue_id() Str {
    match self.columns.at(self.column_index) {
      column => {
        match column.issues.at(self.card_index) {
          issue => issue.id,
          _ => "",
        }
      },
      _ => "",
    }
  }

  private fn selected_issue() issues::Issue? {
    match self.columns.at(self.column_index) {
      column => column.issues.at(self.card_index),
      _ => Maybe::new<issues::Issue>(),
    }
  }

  private fn issue_by_id(issue_id: Str) issues::Issue? {
    mut found: issues::Issue? = Maybe::new()
    for column in self.columns {
      for issue in column.issues {
        if issue.id == issue_id {
          found = Maybe::new(issue)
        }
      }
    }
    found
  }

  private fn column_by_key(key: Str) issues::BoardColumn? {
    mut found: issues::BoardColumn? = Maybe::new()
    for column in self.columns {
      if column_key(column) == key {
        found = Maybe::new(column)
      }
    }
    found
  }

  private fn mut arm_drag(issue_id: Str, width: Int, height: Int, offset_x: Int, offset_y: Int) {
    match self.issue_by_id(issue_id) {
      issue => {
        self.drag_offset_x = offset_x
        self.drag_offset_y = offset_y
        self.drag_width = width
        self.drag_height = height
        self.drag_ghost_id = id_content(issue, self.palette, true, false)
        self.drag_ghost_title = issue.title
        self.drag_ghost_metadata = card_metadata(issue)
      },
      _ => (),
    }
  }

  private fn mut move_drag_ghost(x: Int, y: Int) {
    match self.root.current {
      panel => {
        let screen = panel.layout().screen
        self.drag_ghost_left = clamp_position(
          x - screen.x - self.drag_offset_x,
          screen.width - self.drag_width,
        )
        self.drag_ghost_top = clamp_position(
          y - screen.y - self.drag_offset_y,
          screen.height - self.drag_height,
        )
        self.drag_visible = true
        (self.invalidate)()
      },
      _ => (),
    }
  }

  private fn passed_drag_threshold(x: Int, y: Int) Bool {
    absolute(x - self.pointer_start_x) >= 2 or absolute(y - self.pointer_start_y) >= 2
  }

  // Pointer, drag, and click-to-open handling for one card. The view supplies
  // the record so bounds can be read from its surface ref.
  fn mut handle_card_mouse(
    received: mut cooper::MouseEvent,
    issue_id: Str,
    record: CardRecord,
  ) {
    if received.event_type == cooper::MouseEventType::move {
      self.set_hovered(issue_id)
    } else if received.event_type == cooper::MouseEventType::out {
      self.clear_hovered(issue_id)
    } else if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
      if self.load_in_flight {
        self.generation =+ 1
        self.load_in_flight = false
        self.queue_refresh(self.load_silent)
      }
      self.focus()
      self.select_issue(issue_id)
      self.pointer_issue_id = issue_id
      self.suppress_open_issue_id = ""
      self.dragging_issue_id = ""
      self.drag_target_key = ""
      self.drag_generation =+ 1
      received.prevent_default()
      let bounds = match record.surface.current {
        panel => panel.layout().screen,
        _ => ui::Rect{x: 0, y: 0, width: COLUMN_WIDTH, height: CARD_HEIGHT - 1},
      }
      self.pointer_start_x = received.x
      self.pointer_start_y = received.y
      self.arm_drag(issue_id, bounds.width, bounds.height, received.local_x, received.local_y)
      received.stop_propagation()
    } else if received.event_type == cooper::MouseEventType::drag and received.button == cooper::MouseButton::left {
      if self.pointer_issue_id == issue_id and self.passed_drag_threshold(received.x, received.y) {
        self.suppress_open_issue_id = issue_id
        if self.moving_issue_id.is_empty() {
          let started = self.dragging_issue_id.is_empty()
          self.dragging_issue_id = issue_id
          self.move_drag_ghost(received.x, received.y)
          let previous_target = self.drag_target_key
          self.update_drag_target(received.x, received.y)
          if started and previous_target == self.drag_target_key {
            self.refresh_selection_styles()
          }
        }
      }
      received.stop_propagation()
    } else if received.event_type == cooper::MouseEventType::drag_end and received.button == cooper::MouseButton::left {
      if self.dragging_issue_id == issue_id {
        let generation = self.drag_generation
        let _ = self.context.dispatch(fn() {
          if self.drag_generation == generation and self.dragging_issue_id == issue_id {
            self.clear_drag_visuals()
            self.run_pending_refresh()
          }
        })
      }
      received.stop_propagation()
    } else if received.event_type == cooper::MouseEventType::up and received.button == cooper::MouseButton::left {
      if self.pointer_issue_id == issue_id {
        let suppress_open = self.suppress_open_issue_id == issue_id
        self.pointer_issue_id = ""
        self.suppress_open_issue_id = ""
        if not suppress_open {
          self.select_issue(issue_id)
          self.open_selected()
        }
        self.run_pending_refresh()
      }
      received.stop_propagation()
    }
  }

  private fn mut create_card(issue: issues::Issue) CardRecord {
    CardRecord{issue_id: issue.id, root: cui::box_ref(), surface: cui::box_ref()}
  }

  private fn mut reconcile_cards(previous: [CardRecord], values: [issues::Issue]) [CardRecord] {
    let next = mut List::new<CardRecord>()
    for issue in values {
      mut found: CardRecord? = Maybe::new()
      for card in previous {
        if card.issue_id == issue.id {
          found = Maybe::new(card)
        }
      }
      next.push(
        match found {
          existing => existing,
          _ => self.create_card(issue),
        },
      )
    }
    next.@
  }

  private fn mut create_column(column: issues::BoardColumn) ColumnRecord {
    ColumnRecord{
      key: column_key(column),
      root: cui::box_ref(),
      scroll: cui::scroll_box_ref(),
      cards: [],
    }
  }

  // Records only track identity and refs; the view describes the controls.
  private fn mut reconcile_columns() {
    self.hovered_issue_id = ""
    let previous = self.column_records
    let next = mut List::new<ColumnRecord>()
    for column in self.columns {
      let key = column_key(column)
      mut found: ColumnRecord? = Maybe::new()
      for existing in previous {
        if existing.key == key {
          found = Maybe::new(existing)
        }
      }
      let base = match found {
        existing => existing,
        _ => self.create_column(column),
      }
      next.push(
        ColumnRecord{
          key: key,
          root: base.root,
          scroll: base.scroll,
          cards: self.reconcile_cards(base.cards, column.issues),
        },
      )
    }
    self.column_records = next.@
    (self.invalidate)()
  }

  private fn issue_column_key(issue_id: Str) Str {
    mut found = ""
    for column in self.columns {
      for issue in column.issues {
        if issue.id == issue_id {
          found = column_key(column)
        }
      }
    }
    found
  }

  private fn column_key_at(x: Int, y: Int) Str {
    let viewport = match self.outer_scroll.current {
      panel => panel.layout().screen,
      _ => ui::Rect{x: 0, y: 0, width: 0, height: 0},
    }
    mut found = ""
    mut closest = COLUMN_GAP + 1
    if ui::contains(viewport, x, y) {
      for column in self.column_records {
        let column_bounds = match column.root.current {
          panel => panel.layout().screen,
          _ => ui::Rect{x: 0, y: 0, width: 0, height: 0},
        }
        let visible = ui::intersect(column_bounds, viewport)
        if visible.width > 0 and visible.height > 0 and y >= visible.y and y < visible.y + visible.height {
          let distance = match {
            x < visible.x => visible.x - x,
            x >= visible.x + visible.width => x - (visible.x + visible.width - 1),
            _ => 0,
          }
          if distance < closest and distance <= COLUMN_GAP {
            closest = distance
            found = column.key
          }
        }
      }
    }
    found
  }

  private fn mut scroll_board_x(delta: Int) Bool {
    match self.outer_scroll.current {
      panel => panel.scroll_by_x(delta),
      _ => false,
    }
  }

  private fn mut scroll_during_drag(received: mut cooper::MouseEvent) {
    mut changed = false
    if received.scroll_x != 0 {
      changed = self.scroll_board_x(wheel_step(received.scroll_x)) or changed
    }
    if received.scroll_y != 0 {
      if received.modifiers.shift {
        changed = self.scroll_board_x(wheel_step(received.scroll_y)) or changed
      } else {
        let key = self.column_key_at(received.x, received.y)
        for column in self.column_records {
          if column.key == key {
            match column.scroll.current {
              panel => { changed = panel.scroll_by(wheel_step(received.scroll_y)) or changed },
              _ => (),
            }
          }
        }
      }
    }
    if changed {
      let x = received.x
      let y = received.y
      let generation = self.drag_generation
      let _ = self.context.dispatch(fn() {
        if self.drag_generation == generation and not self.dragging_issue_id.is_empty() {
          self.update_drag_target(x, y)
        }
      })
    }
  }

  private fn mut update_drag_target(x: Int, y: Int) {
    let source = self.issue_column_key(self.dragging_issue_id)
    let hovered = self.column_key_at(x, y)
    let target = match hovered == source {
      true => "",
      false => hovered,
    }
    if not self.drag_target_key == target {
      self.drag_target_key = target
      self.refresh_selection_styles()
    }
  }

  private fn mut clear_drag_visuals() {
    self.drag_generation =+ 1
    self.dragging_issue_id = ""
    self.drag_target_key = ""
    self.hovered_issue_id = ""
    self.drag_visible = false
    self.refresh_selection_styles()
  }

  private fn mut confirm_move(issue_id: Str, state: issues::WorkflowState) {
    self.replace_columns(apply_confirmed_state(self.columns, issue_id, state), true)
  }

  private fn mut show_move_failure(issue_id: Str, generation: Int) {
    (self.cancel_failed_move)()
    self.failed_move_issue_id = issue_id
    self.refresh_selection_styles()
    self.cancel_failed_move = self.schedule(4000, fn() {
      if (not self.disposed) and self.move_generation == generation and self.failed_move_issue_id == issue_id {
        self.failed_move_issue_id = ""
        self.refresh_selection_styles()
      }
    })
  }

  private fn mut drop_on_column(target_key: Str) {
    let issue_id = self.dragging_issue_id
    let source_key = self.issue_column_key(issue_id)
    self.clear_drag_visuals()
    if (not issue_id.is_empty()) and (not source_key.is_empty()) and (not target_key == source_key) and self.moving_issue_id.is_empty() {
      match self.issue_by_id(issue_id) {
        issue => {
          match self.column_by_key(target_key) {
            target_column => {
              match move_between_columns(self.columns, issue.id, target_key, "") {
                ok(columns) => {
                  let previous = self.columns
                  (self.cancel_failed_move)()
                  self.failed_move_issue_id = ""
                  self.move_generation =+ 1
                  let move_generation = self.move_generation
                  self.generation =+ 1
                  self.moving_issue_id = issue.id
                  self.move_snapshot = Maybe::new(previous)
                  self.replace_columns(columns, false)
                  self.select_issue(issue.id)
                  self.service.move(
                    self.stop.receiver(),
                    board_service::MoveRequest{
                      issue_id: issue.id,
                      team_id: issue.team_id,
                      target: target_for(target_column),
                    },
                    fn(result: board_service::MoveResult!Str) {
                      if (not self.disposed) and move_generation == self.move_generation {
                        self.moving_issue_id = ""
                        match result {
                          ok(moved) => {
                            self.move_snapshot = Maybe::new<[issues::BoardColumn]>()
                            self.confirm_move(issue.id, moved.state)
                            self.queue_refresh(true)
                            self.on_issue_moved(issue_with_state(issue, moved.state.id, target_for(target_column)))
                          },
                          err(message) => {
                            match self.move_snapshot {
                              snapshot => self.replace_columns(snapshot, true),
                              _ => self.refresh_selection_styles(),
                            }
                            self.move_snapshot = Maybe::new<[issues::BoardColumn]>()
                            self.show_move_failure(issue.id, move_generation)
                            self.notify_error("Couldn't move {issue.identifier}", message)
                          },
                        }
                        self.run_pending_refresh()
                      }
                    },
                  )
                },
                err(message) => self.notify_error("Couldn't move {issue.identifier}", message),
              }
            },
            _ => (),
          }
        },
        _ => (),
      }
    }
    self.run_pending_refresh()
  }

  private fn mut set_hovered(issue_id: Str) {
    if not self.hovered_issue_id == issue_id {
      self.hovered_issue_id = issue_id
      self.refresh_selection_styles()
    }
  }

  private fn mut clear_hovered(issue_id: Str) {
    if self.hovered_issue_id == issue_id {
      self.hovered_issue_id = ""
      self.refresh_selection_styles()
    }
  }

  private fn mut refresh_selection_styles() {
    // Card and column appearance is derived in the view; just request a render.
    (self.invalidate)()
  }

  private fn mut show_status(message: Str, error: Bool) {
    self.status = message
    self.status_error = error
  }

  private fn mut reveal_selection() {
    match self.column_records.at(self.column_index) {
      column => {
        match column.root.current {
          panel => {
            match self.outer_scroll.current {
              scroll => {
                let _ = scroll.scroll_child_into_view(panel)
              },
              _ => (),
            }
          },
          _ => (),
        }
        match column.cards.at(self.card_index) {
          card => {
            match card.root.current {
              panel => {
                match column.scroll.current {
                  scroll => {
                    let _ = scroll.scroll_child_into_view(panel)
                  },
                  _ => (),
                }
              },
              _ => (),
            }
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut restore_reconciled_selection() {
    match self.outer_scroll.current {
      panel => {
        let _ = panel.scroll_to_x(self.column_index * (COLUMN_WIDTH + COLUMN_GAP))
      },
      _ => (),
    }
    match self.column_records.at(self.column_index) {
      column => {
        match column.scroll.current {
          panel => {
            let _ = panel.scroll_to(self.card_index * CARD_HEIGHT)
          },
          _ => (),
        }
      },
      _ => (),
    }
  }

  private fn mut replace_columns(columns: [issues::BoardColumn], preserve_selection: Bool) {
    self.drag_generation =+ 1
    self.pointer_issue_id = ""
    self.suppress_open_issue_id = ""
    self.dragging_issue_id = ""
    self.drag_target_key = ""
    self.drag_visible = false
    let previous_id = match preserve_selection {
      true => self.selected_issue_id(),
      false => "",
    }
    self.columns = columns
    self.column_index = 0
    self.card_index = 0
    if not previous_id.is_empty() {
      for column, column_index in self.columns {
        for issue, card_index in column.issues {
          if issue.id == previous_id {
            self.column_index = column_index
            self.card_index = card_index
          }
        }
      }
    }
    self.reconcile_columns()
    match self.columns.size() {
      0 => self.show_status("No assigned issues", false),
      _ => {
        self.show_status("", false)
        self.restore_reconciled_selection()
      },
    }
  }

  private fn mut queue_refresh(silent: Bool) {
    if not self.refresh_pending {
      self.refresh_pending_silent = silent
    } else if not silent {
      self.refresh_pending_silent = false
    }
    self.refresh_pending = true
  }

  private fn mut run_pending_refresh() {
    if self.refresh_pending and self.pointer_issue_id.is_empty() and self.dragging_issue_id.is_empty() and self.moving_issue_id.is_empty() {
      let silent = self.refresh_pending_silent
      self.refresh_pending = false
      self.refresh_pending_silent = true
      self.refresh(silent)
    }
  }

  private fn mut schedule_refresh() {
    (self.cancel_refresh)()
    self.cancel_refresh = self.schedule(5 * 60 * 1000, fn() {
      if not self.disposed {
        self.refresh(true)
        self.schedule_refresh()
      }
    })
  }

  fn mut start() {
    if (not self.disposed) and self.generation == 0 {
      self.refresh(false)
      self.schedule_refresh()
    }
  }

  fn mut refresh(silent: Bool) {
    if not self.disposed {
      if not self.moving_issue_id.is_empty() or not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
        self.queue_refresh(silent)
      } else {
        self.generation =+ 1
        let generation = self.generation
        self.load_in_flight = true
        self.load_silent = silent
        if not silent {
          self.show_status("Loading My Issues…", false)
        }
        self.service.load(self.stop.receiver(), fn(result: [issues::BoardColumn]!Str) {
          if (not self.disposed) and generation == self.generation {
            self.load_in_flight = false
            if not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
              self.queue_refresh(silent)
            } else {
              match result {
                ok(columns) => self.replace_columns(columns, silent),
                err(message) => {
                  if self.columns.size() == 0 {
                    self.show_status(message, true)
                  } else {
                    self.show_status("", false)
                    self.notify_error("Couldn't refresh My Issues", message)
                  }
                },
              }
              (self.invalidate)()
              self.retry_focus()
            }
          }
        })
      }
    }
  }

  fn mut select_issue(issue_id: Str) {
    for column, column_index in self.columns {
      for issue, card_index in column.issues {
        if issue.id == issue_id {
          self.column_index = column_index
          self.card_index = card_index
        }
      }
    }
    self.refresh_selection_styles()
    self.reveal_selection()
  }

  private fn mut move_horizontal(delta: Int) {
    if self.columns.size() > 0 {
      let cleared_hover = not self.hovered_issue_id.is_empty()
      self.hovered_issue_id = ""
      mut next = self.column_index + delta
      mut searching = true
      while searching {
        if next < 0 or next >= self.columns.size() {
          searching = false
        } else if self.columns.at(next).expect("column").issues.size() > 0 {
          searching = false
        } else {
          next = next + delta
        }
      }
      if next >= 0 and next < self.columns.size() and next != self.column_index {
        self.column_index = next
        let count = self.columns.at(next).expect("column").issues.size()
        if self.card_index >= count {
          self.card_index = count - 1
        }
        self.refresh_selection_styles()
        self.reveal_selection()
      } else if cleared_hover {
        self.refresh_selection_styles()
      }
    }
  }

  private fn mut move_vertical(delta: Int) {
    let cleared_hover = not self.hovered_issue_id.is_empty()
    self.hovered_issue_id = ""
    match self.columns.at(self.column_index) {
      column => {
        if column.issues.size() > 0 {
          mut next = self.card_index + delta
          if next < 0 {
            next = 0
          }
          if next >= column.issues.size() {
            next = column.issues.size() - 1
          }
          if next != self.card_index {
            self.card_index = next
            self.refresh_selection_styles()
            self.reveal_selection()
          } else if cleared_hover {
            self.refresh_selection_styles()
          }
        }
      },
      _ => (),
    }
  }

  private fn mut open_selected() {
    match self.selected_issue() {
      issue => self.on_open_issue(issue.identifier),
      _ => (),
    }
  }

  private fn mut pick_selected(field: issue_field_picker_controller::Field) {
    match self.selected_issue() {
      issue => {
        if not issue.id == self.moving_issue_id {
          self.on_pick_field(field, issue)
        }
      },
      _ => (),
    }
  }

  // While a status banner is up the scroll box is described `display: none`,
  // which is not focusable, so the claim is remembered and retried after the
  // commit that first reveals the board.
  private fn mut apply_focus() Bool {
    mut applied = false
    match self.outer_scroll.current {
      panel => {
        applied = panel.focus()
      },
      _ => (),
    }
    if applied {
      self.pending_focus = false
    }
    applied
  }

  private fn mut retry_focus() {
    if self.pending_focus and (not self.disposed) {
      let _ = self.context.dispatch(fn() {
        if self.pending_focus and (not self.disposed) {
          let _ = self.apply_focus()
        }
      })
    }
  }

  fn mut focus() {
    if not self.pointer_issue_id.is_empty() or not self.dragging_issue_id.is_empty() {
      self.pointer_issue_id = ""
      self.suppress_open_issue_id = ""
      self.clear_drag_visuals()
      self.run_pending_refresh()
    }
    self.pending_focus = true
    let _ = self.apply_focus()
  }

  fn mut handle_key(received: mut cooper::KeyEvent) Bool {
    if self.disposed or received.event_type == cooper::KeyEventType::release {
      false
    } else if not self.dragging_issue_id.is_empty() {
      if received.matches("escape") {
        self.pointer_issue_id = ""
        self.suppress_open_issue_id = ""
        self.clear_drag_visuals()
        self.run_pending_refresh()
      }
      true
    } else {
      mut handled = true
      match {
        received.matches("j") or received.matches("down") => self.move_vertical(1),
        received.matches("k") or received.matches("up") => self.move_vertical(-1),
        received.matches("l") or received.matches("right") => self.move_horizontal(1),
        received.matches("h") or received.matches("left") => self.move_horizontal(-1),
        received.matches("return") => self.open_selected(),
        received.matches("r") => self.refresh(false),
        received.matches("s") => self.pick_selected(issue_field_picker_controller::Field::state),
        received.matches("y") => self.pick_selected(issue_field_picker_controller::Field::cycle),
        received.matches("p") => self.pick_selected(issue_field_picker_controller::Field::priority),
        received.matches("a") => self.pick_selected(issue_field_picker_controller::Field::assignee),
        received.matches("p", shift: true) => {
          self.pick_selected(issue_field_picker_controller::Field::project)
        },
        _ => { handled = false },
      }
      if handled {
        // Key routing happens outside CUI, so request a render explicitly.
        (self.invalidate)()
      }
      handled
    }
  }

  fn mut view() cui::View {
    cui::child(board_view, BoardProps{controller: self}, key: "board")
  }

  fn mut screen() shell_controller::Screen {
    shell_controller::declarative_screen(
      view: self.view(),
      focus: fn() {
        self.focus()
      },
      handle_key: fn(received: mut cooper::KeyEvent) Bool {
        self.handle_key(received)
      },
      dispose: fn() {
        self.dispose()
      },
    )
  }

  fn mut dispose() {
    if not self.disposed {
      if not self.dragging_issue_id.is_empty() {
        self.clear_drag_visuals()
      }
      (self.cancel_refresh)()
      (self.cancel_failed_move)()
      self.disposed = true
      self.stop.close()
      self.drag_generation =+ 1
      self.move_generation =+ 1
      self.refresh_pending = false
      self.load_in_flight = false
      (self.remove_terminal_focus)()
      self.remove_terminal_focus = fn() {}
      self.column_records = []
    }
  }
}

struct BoardProps {
  controller: mut BoardController,
}

struct BoardView {
  props: mut BoardProps,
  remove_blur: fn(),
}

private fn board_view(props: mut BoardProps) mut BoardView {
  (mut BoardView{props: props, remove_blur: fn() {}})
}

impl cui::Lifecycle for BoardView {
  fn mut mounted(ctx: cui::Context) {
    // The render request is bound at mount instead of injected at
    // construction, so no `notify` wiring is needed from hosts or tests.
    self.props.controller.invalidate = ctx.invalidate_root
    // Blur has no declarative counterpart; attach to the retained scroll box
    // so an interrupted drag is cleared when the board loses focus.
    match self.props.controller.outer_scroll.current {
      panel => {
        self.remove_blur = panel.node().on_blur(fn() {
          let controller = self.props.controller
          controller.pointer_issue_id = ""
          controller.suppress_open_issue_id = ""
          controller.clear_drag_visuals()
          controller.run_pending_refresh()
        })
      },
      _ => (),
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    self.props.controller.invalidate = fn() {}
    (self.remove_blur)()
    self.remove_blur = fn() {}
  }
}

impl BoardView {
  private fn mut card(issue: issues::Issue, record: CardRecord) cui::View {
    let controller = self.props.controller
    let palette = controller.palette
    let issue_id = record.issue_id
    let active = issue_id == controller.selected_issue_id()
    let hovered = (not active) and issue_id == controller.hovered_issue_id
    let is_dragging = issue_id == controller.dragging_issue_id
    let is_moving = issue_id == controller.moving_issue_id
    let move_failed = issue_id == controller.failed_move_issue_id
    let foreground = match {
      active and not is_dragging => palette.item_active_foreground,
      hovered => palette.item_hover_foreground,
      _ => palette.foreground,
    }
    let background = match {
      active and not is_dragging => palette.item_active_background,
      hovered => palette.item_hover_background,
      _ => palette.background,
    }
    let id_line = match is_dragging {
      true => {
        ui::styled_text(
          [ui::span("  ↳ {issue.identifier} · drop on a column", style: ui::span_style(dim: true))],
        )
      },
      false => id_content(issue, palette, active, hovered),
    }
    let title = match is_dragging {
      true => "",
      false => issue.title,
    }
    let metadata = match {
      is_dragging => "",
      move_failed => "! move failed",
      is_moving => "⋯ updating…",
      _ => card_metadata(issue),
    }
    cui::box(
      [
        cui::box(
          [
            cui::text(
              id_line,
              selectable: false,
              wrap: ui::TextWrap::none,
              overflow: ui::TextOverflow::ellipsis,
              styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
            ),
            cui::text(
              title,
              selectable: false,
              wrap: ui::TextWrap::word,
              overflow: ui::TextOverflow::ellipsis,
              styles: ui::style(width: ui::percent(100.0), height: ui::cells(2), flex_shrink: 0.0),
              text_style: match is_dragging {
                true => ui::text_style(dim: true),
                false => ui::text_style(foreground: foreground, bold: active),
              },
            ),
            cui::text(
              metadata,
              selectable: false,
              wrap: ui::TextWrap::none,
              overflow: ui::TextOverflow::ellipsis,
              styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
              text_style: match {
                is_dragging => ui::text_style(dim: true),
                move_failed => ui::text_style(foreground: palette.danger, bold: true),
                _ => {
                  ui::text_style(
                    foreground: foreground,
                    dim: is_moving or (not active) and not hovered,
                  )
                },
              },
            ),
          ],
          ref: record.surface,
          styles: ui::style(
            width: ui::cells(1),
            height: ui::cells(CARD_HEIGHT - 1),
            flex_grow: 1.0,
            background: background,
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(1),
              bottom: ui::cells(0),
              left: ui::cells(1),
            },
          ),
          on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
            controller.handle_card_mouse(received, issue_id, record)
          },
        ),
      ],
      key: "card-{issue_id}",
      ref: record.root,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(CARD_HEIGHT),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        overflow: ui::Overflow::hidden,
      ),
    )
  }

  private fn mut column(value: issues::BoardColumn, index: Int, record: ColumnRecord) cui::View {
    let controller = self.props.controller
    let palette = controller.palette
    let key = record.key
    let drop_target = key == controller.drag_target_key
    let selected_column = index == controller.column_index and controller.dragging_issue_id.is_empty()
    let cards = mut List::new<cui::View>()
    for issue in value.issues {
      for card in record.cards {
        if card.issue_id == issue.id {
          cards.push(self.card(issue, card))
        }
      }
    }
    cui::box(
      [
        cui::text(
          header_content(value, selected_column or drop_target, palette),
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
        ),
        cui::text(
          match drop_target {
            true => DROP_COLUMN_RULE,
            false => COLUMN_RULE,
          },
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::clip,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: match drop_target {
            true => ui::text_style(foreground: palette.accent, bold: true),
            false => ui::text_style(dim: true),
          },
        ),
        cui::scroll_box(
          cards.@,
          ref: record.scroll,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_grow: 1.0),
        ),
      ],
      key: "column-{key}",
      ref: record.root,
      styles: ui::style(
        width: ui::cells(COLUMN_WIDTH),
        height: ui::percent(100.0),
        flex_shrink: 0.0,
        overflow: ui::Overflow::hidden,
      ),
      on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
        if received.event_type == cooper::MouseEventType::drop and received.button == cooper::MouseButton::left {
          controller.drop_on_column(key)
          received.stop_propagation()
        }
      },
    )
  }
}

impl cui::Component for BoardView {
  fn mut render() cui::View {
    let controller = self.props.controller
    let palette = controller.palette
    // The board is hidden whenever a status message occupies the screen.
    let loaded = controller.status.is_empty()
    let columns = mut List::new<cui::View>()
    for value, index in controller.columns {
      for record in controller.column_records {
        if record.key == column_key(value) {
          columns.push(self.column(value, index, record))
        }
      }
    }
    cui::box(
      [
        cui::text(
          match controller.status.is_empty() {
            true => "",
            false => "  {controller.status}",
          },
          selectable: false,
          styles: status_style(
            match controller.status.is_empty() {
              true => ui::Display::none,
              false => ui::Display::flex,
            },
          ),
          text_style: match controller.status_error {
            true => ui::text_style(foreground: palette.danger, bold: true),
            false => ui::text_style(dim: true),
          },
        ),
        cui::scroll_box(
          [cui::box(columns.@, styles: columns_row_style(controller.column_records.size()))],
          ref: controller.outer_scroll,
          styles: board_style(
            match loaded {
              true => ui::Display::flex,
              false => ui::Display::none,
            },
          ),
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {},
        ),
        cui::box(
          [
            cui::box(
              [
                cui::text(
                  controller.drag_ghost_id,
                  selectable: false,
                  wrap: ui::TextWrap::none,
                  overflow: ui::TextOverflow::ellipsis,
                  styles: ui::style(
                    width: ui::percent(100.0),
                    height: ui::cells(1),
                    flex_shrink: 0.0,
                  ),
                ),
                cui::text(
                  controller.drag_ghost_title,
                  selectable: false,
                  wrap: ui::TextWrap::word,
                  overflow: ui::TextOverflow::ellipsis,
                  styles: ui::style(
                    width: ui::percent(100.0),
                    height: ui::cells(2),
                    flex_shrink: 0.0,
                  ),
                  text_style: ui::text_style(
                    foreground: palette.item_active_foreground,
                    bold: true,
                  ),
                ),
                cui::text(
                  controller.drag_ghost_metadata,
                  selectable: false,
                  wrap: ui::TextWrap::none,
                  overflow: ui::TextOverflow::ellipsis,
                  styles: ui::style(
                    width: ui::percent(100.0),
                    height: ui::cells(1),
                    flex_shrink: 0.0,
                  ),
                  text_style: ui::text_style(
                    foreground: palette.item_active_foreground,
                    dim: true,
                  ),
                ),
              ],
              styles: drag_ghost_style(
                controller.drag_ghost_left,
                controller.drag_ghost_top,
                controller.drag_width,
                controller.drag_height,
                palette,
              ),
            ),
          ],
          styles: drag_layer_style(
            match controller.drag_visible {
              true => ui::Display::flex,
              false => ui::Display::none,
            },
          ),
          on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
            if received.event_type == cooper::MouseEventType::drop and received.button == cooper::MouseButton::left {
              controller.drop_on_column(controller.column_key_at(received.x, received.y))
              received.stop_propagation()
            } else if received.event_type == cooper::MouseEventType::scroll and not controller.dragging_issue_id.is_empty() {
              controller.scroll_during_drag(received)
              received.stop_propagation()
            }
          },
        ),
      ],
      ref: controller.root,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}
