use tinear/tui/core/stack
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/tui/inbox_screen
use tinear/tui/my_issues_screen
use tinear/tui/tab_bar
use tinear/vaxis

// Tabbed shell for the next TUI.
//
// Owns authenticated child state: top-level tabs and the inbox screen.
struct TabbedScreen {
  tabs: tab_bar::TabBar,
  inbox: inbox_screen::InboxScreen,
  my_issues: my_issues_screen::MyIssuesScreen,
}

fn new(api_key: Str) TabbedScreen {
  TabbedScreen{
    tabs: tab_bar::new(["Inbox", "My Issues"]),
    inbox: inbox_screen::new(api_key),
    my_issues: my_issues_screen::new(api_key),
  }
}

fn key_hints(labels: [Str]) view::View {
  mut children: [view::View] = []

  for label, idx in labels {
    if idx > 0 {
      children.push(stack::Spacer::h(2))
    }
    children.push(text::new(label))
  }

  stack::hstack(children)
}

fn is_tab_key(key: vaxis::KeyEvent) Bool {
  key.name == "Tab"
}

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out = out + ch
    }
  }
  out
}

struct HorizontalRule {}

impl view::View for HorizontalRule {
  fn init(ctx: view::Context) {}
  fn handle_event(ctx: view::Context, event: vaxis::Event) {}

  fn render(mut frame: view::Frame) {
    frame.draw_text(0, 0, repeat("─", frame.width()))
  }
}

impl view::View for TabbedScreen {
  fn mut init(ctx: view::Context) {
    self.tabs.init(ctx)
    self.inbox.init(ctx)
    self.my_issues.init(ctx)
  }

  fn mut handle_event(ctx: view::Context, event: vaxis::Event) {
    match event {
      KeyEvent(key) => {
        match {
          is_tab_key(key)  => {
            self.tabs.handle_key(key)
            ctx.redraw()
          },
          _ => {
            match self.tabs.selected_label() {
              "Inbox" => self.inbox.handle_key(ctx, key),
              "My Issues" => self.my_issues.handle_key(ctx, key),
              _ => (),
            }
          },
        }
      },
      CustomEvent(_) => self.inbox.handle_event(ctx, event),
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    let body: view::View = match self.tabs.selected_label() {
      "Inbox" => self.inbox,
      "My Issues" => self.my_issues,
      _ => text::new("Coming soon"),
    }

    let hints = key_hints(["↑↓ select", "r refresh", "↵ open"])

    // Screen layout: tabs fixed at top, separator line underneath,
    // body fills the middle, hints fixed at the bottom.
    stack::vsplit(
      [
        stack::fixed(self.tabs, 1),
        stack::fixed(HorizontalRule{}, 1),
        stack::fill(body, 1),
        stack::fixed(hints, 1),
      ],
    ).render(frame)
  }
}
