use ard/decode

use tinear/tui/core/stack
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/tui/inbox_screen
use tinear/tui/my_issues_screen
use tinear/tui/tab_bar
use tinear/vaxis

// Tabbed shell for the next TUI.
//
// Owns authenticated child state: top-level tabs and the inbox screen.
struct TabbedScreen {
  tabs: mut tab_bar::TabBar,
  inbox: mut inbox_screen::InboxScreen,
  my_issues: mut my_issues_screen::MyIssuesScreen,
  issue_tab_ids: [Str],
}

fn new(api_key: Str) TabbedScreen {
  mut tabs = tab_bar::new(["Inbox", "My Issues"])
  mut inbox = inbox_screen::new(api_key)
  inbox.active = true
  mut my_issues = my_issues_screen::new(api_key)
  my_issues.active = false
  TabbedScreen{
    tabs: tabs,
    inbox: inbox,
    my_issues: my_issues,
    issue_tab_ids: [],
  }
}

fn key_hints(labels: [Str]) view::View {
  mut children: [view::View] = []

  for label, idx in labels {
    if idx > 0 {
      children.push(stack::Spacer::h(2))
    }
    children.push(text::new(label))
  }

  stack::hstack(children)
}

fn is_tab_key(key: vaxis::KeyEvent) Bool {
  key.name == "Tab"
}

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out = out + ch
    }
  }
  out
}

struct HorizontalRule {}

impl view::View for HorizontalRule {
  fn init(ctx: view::Context) {}
  fn handle_event(ctx: view::Context, mut event: view::Event) {}

  fn render(mut frame: view::Frame) {
    frame.draw_text(0, 0, repeat("─", frame.width()))
  }
}

impl TabbedScreen {
  fn mut sync_active_child() {
    let active = self.tabs.selected_label()
    self.inbox.active = active == "Inbox"
    self.my_issues.active = active == "My Issues"
  }

  fn mut open_empty_issue_tab(issue_id: Str) {
    // Re-select an existing issue tab instead of opening duplicates.
    mut found = false
    for existing, idx in self.issue_tab_ids {
      if existing == issue_id {
        self.tabs.select(idx + 2)
        found = true
      }
    }

    if not found {
      mut ids = self.issue_tab_ids
      ids.push(issue_id)
      self.issue_tab_ids = ids
      self.tabs.push_and_select(issue_id)
    }
    self.sync_active_child()
  }

  fn issue_tab_body(label: Str) view::View {
    text::new("Issue {label} details will load here")
  }
}

impl view::View for TabbedScreen {
  fn mut init(ctx: view::Context) {
    ctx.add_child(self.tabs)
    ctx.add_child(self.inbox)
    ctx.add_child(self.my_issues)
  }

  fn mut handle_event(ctx: view::Context, mut event: view::Event) {
    match event.raw {
      KeyEvent(key) => {
        if is_tab_key(key) {
          self.tabs.handle_key(key)
          self.sync_active_child()
          ctx.redraw()
          event.stop()
        }
      },
      CustomEvent(custom) => {
        if custom.name == "issue.selected" {
          match custom.payload {
            payload => {
              let issue_id = decode::run(payload, decode::string).expect("issue.selected payload must be a string")
              self.open_empty_issue_tab(issue_id)
              event.stop()
            },
            _ => (),
          }
        }
      },
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    let selected = self.tabs.selected_label()
    let body: view::View = match selected {
      "Inbox" => view::child(1),
      "My Issues" => view::child(2),
      _ => self.issue_tab_body(selected),
    }

    let hints = match selected {
      "My Issues" => key_hints(["↑↓←→ select", "s status", "y cycle", "r refresh"]),
      _ => key_hints(["↑↓ select", "r refresh", "↵ open"]),
    }

    // Screen layout: tabs fixed at top, separator line underneath,
    // body fills the middle, hints fixed at the bottom.
    stack::vsplit(
      [
        stack::fixed(view::child(0), 1),
        stack::fixed(HorizontalRule{}, 1),
        stack::fill(body, 1),
        stack::fixed(hints, 1),
      ],
    ).render(frame)
  }
}
