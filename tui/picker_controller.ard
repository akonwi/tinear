use cooper
use cooper/cui
use cooper/ui
use go:strings
use tinear/tui/theme as tinear_theme

let RESULT_RULE: Str = "────────────────────────────────────────────────────────────────────────────────"
let FILTER_THRESHOLD: Int = 5
let MAX_VISIBLE_RESULT_ROWS: Int = 12

struct Option {
  id: Str,
  label: Str,
  description: Str,
}

struct PickerProps {
  palette: tinear_theme::Theme,
  placeholder: Str,
  options: [Option],
  selected_id: Str,
  on_select: fn(Option),
}

struct Picker {
  props: mut PickerProps,
  query: Str,
  filtered: [Option],
  cursor: Int,
  hovered_id: Str,
  results: mut cui::ScrollBoxRef,
}

private fn matches(option: Option, query: Str) Bool {
  let normalized = strings::ToLower(query.trim())
  normalized.is_empty() or strings::ToLower(option.label).contains(normalized) or strings::ToLower(option.description).contains(normalized)
}

private fn row_height(option: Option) Int {
  match option.description.is_empty() {
    true => 1,
    false => 2,
  }
}

private fn filterable(options: [Option]) Bool {
  options.size() > FILTER_THRESHOLD
}

private fn visible_result_rows(options: [Option]) Int {
  mut rows = 0
  for option in options {
    rows = rows + row_height(option)
  }
  if rows < 1 {
    1
  } else if rows > MAX_VISIBLE_RESULT_ROWS {
    MAX_VISIBLE_RESULT_ROWS
  } else {
    rows
  }
}

private fn root_style(options: [Option], has_filter: Bool) ui::Style {
  let filter_rows = match has_filter {
    true => 2,
    false => 0,
  }
  ui::style(
    width: ui::percent(100.0),
    height: ui::cells(visible_result_rows(options) + filter_rows),
    flex_direction: ui::FlexDirection::column,
    overflow: ui::Overflow::hidden,
  )
}

private fn filter_control_style(display: ui::Display) ui::Style {
  ui::style(display: display, width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0)
}

private fn filter_options(options: [Option], query: Str) [Option] {
  let filtered = mut List::new<Option>()
  for option in options {
    if matches(option, query) {
      filtered.push(option)
    }
  }
  filtered.@
}

private fn picker(props: mut PickerProps) mut Picker {
  let filtered = filter_options(props.options, "")
  mut cursor = 0
  if not props.selected_id.is_empty() {
    for option, index in filtered {
      if option.id == props.selected_id {
        cursor = index
      }
    }
  }
  (mut Picker{
    props: props,
    query: "",
    filtered: filtered,
    cursor: cursor,
    hovered_id: "",
    results: cui::scroll_box_ref(),
  })
}

fn view(
  palette: tinear_theme::Theme,
  placeholder: Str,
  options: [Option],
  selected_id: Str,
  on_select: fn(Option),
  key: Str?,
) cui::View {
  cui::child(
    picker,
    PickerProps{
      palette: palette,
      placeholder: placeholder,
      options: options,
      selected_id: selected_id,
      on_select: on_select,
    },
    key: key.or("picker"),
  )
}

impl Picker {
  private fn selected_offset() Int {
    mut offset = 0
    for option, index in self.filtered {
      if index < self.cursor {
        offset = offset + row_height(option)
      }
    }
    offset
  }

  private fn mut apply_filter(value: Str) {
    self.query = value
    self.filtered = filter_options(self.props.options, value)
    self.cursor = 0
    self.hovered_id = ""
    match self.results.current {
      panel => {
        let _ = panel.scroll_to(0)
      },
      _ => (),
    }
  }

  private fn mut move_cursor(delta: Int) {
    if self.filtered.size() > 0 {
      mut next = self.cursor + delta
      if next < 0 {
        next = 0
      }
      if next >= self.filtered.size() {
        next = self.filtered.size() - 1
      }
      self.cursor = next
      self.hovered_id = ""
      match self.results.current {
        panel => {
          let _ = panel.scroll_to(self.selected_offset())
        },
        _ => (),
      }
    }
  }

  private fn mut activate() {
    match self.filtered.at(self.cursor) {
      option => (self.props.on_select)(option),
      _ => (),
    }
  }

  private fn mut select_id(option_id: Str) {
    for option, index in self.filtered {
      if option.id == option_id {
        self.cursor = index
      }
    }
  }

  private fn mut handle_navigation(received: mut cooper::KeyEvent, vim_keys: Bool) {
    if received.event_type != cooper::KeyEventType::release {
      mut handled = true
      match {
        received.matches("down") or vim_keys and received.matches("j") => self.move_cursor(1),
        received.matches("up") or vim_keys and received.matches("k") => self.move_cursor(-1),
        received.matches("return") or vim_keys and received.matches("space") => self.activate(),
        _ => { handled = false },
      }
      if handled {
        received.prevent_default()
        received.stop_propagation()
      }
    }
  }

  private fn mut row(option: Option, index: Int) cui::View {
    let palette = self.props.palette
    let active = index == self.cursor
    let hovered = (not active) and option.id == self.hovered_id
    let foreground = match {
      active => palette.item_active_foreground,
      hovered => palette.item_hover_foreground,
      _ => palette.foreground,
    }
    let background = match {
      active => palette.item_active_background,
      hovered => palette.item_hover_background,
      _ => palette.background,
    }
    let option_id = option.id
    let content = mut List::new<cui::View>()
    content.push(
      cui::text(
        option.label,
        selectable: false,
        wrap: ui::TextWrap::none,
        overflow: ui::TextOverflow::ellipsis,
        styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
        text_style: ui::text_style(foreground: foreground, bold: active),
      ),
    )
    if not option.description.is_empty() {
      content.push(
        cui::text(
          option.description,
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(foreground: foreground, dim: (not active) and not hovered),
        ),
      )
    }
    cui::box(
      [
        cui::box(
          content.@,
          styles: ui::style(
            width: ui::cells(1),
            height: ui::cells(row_height(option)),
            flex_grow: 1.0,
            background: background,
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(1),
              bottom: ui::cells(0),
              left: ui::cells(1),
            },
          ),
          on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
            if received.event_type == cooper::MouseEventType::move {
              self.hovered_id = option_id
            } else if received.event_type == cooper::MouseEventType::out {
              if self.hovered_id == option_id {
                self.hovered_id = ""
              }
            } else if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
              self.select_id(option_id)
              self.activate()
              received.stop_propagation()
            }
          },
        ),
      ],
      key: "row-{option.id}",
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(row_height(option)),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}

impl cui::Lifecycle for Picker {
  fn mut mounted(ctx: cui::Context) {
    match self.results.current {
      panel => {
        let _ = panel.scroll_to(self.selected_offset())
      },
      _ => (),
    }
  }

  fn mut unmounting(ctx: cui::Context) {}
}

impl cui::Component for Picker {
  fn mut render() cui::View {
    let has_filter = filterable(self.props.options)
    let filter_display = match has_filter {
      true => ui::Display::flex,
      false => ui::Display::none,
    }

    let rows = mut List::new<cui::View>()
    if self.filtered.size() == 0 {
      rows.push(
        cui::text(
          "  No matches",
          selectable: false,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(dim: true),
        ),
      )
    }
    for option, index in self.filtered {
      rows.push(self.row(option, index))
    }

    cui::box(
      [
        cui::input(
          self.query,
          placeholder: self.props.placeholder,
          styles: filter_control_style(filter_display),
          autofocus: has_filter,
          on_input: fn(value: Str, ctx: cui::Context) {
            self.apply_filter(value)
          },
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
            self.handle_navigation(received, false)
          },
        ),
        cui::text(
          RESULT_RULE,
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::clip,
          styles: filter_control_style(filter_display),
          text_style: ui::text_style(dim: true),
        ),
        cui::scroll_box(
          rows.@,
          ref: self.results,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_grow: 1.0),
        ),
      ],
      on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
        if not has_filter {
          self.handle_navigation(received, true)
        }
      },
      autofocus: not has_filter,
      styles: root_style(self.filtered, has_filter),
    )
  }
}
