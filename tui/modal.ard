use go:go.rockorager.dev/vaxis/ui

// A pending modal request. The app root keeps a single `ModalDef?` in
// state; setting it to some(def) presents the modal, setting it back to
// none dismisses it.
//
// `build` is invoked at render time with:
//   - the current theme (the theme can change between requests, so we
//     don't bake it in at request time)
//   - a `close` callback the modal can call to dismiss itself
//
// The builder usually constructs `modal::show_modal(theme, title, ...)`
// internally; nothing forces that, but it's the conventional shape.
struct ModalDef {
  build: fn(ui::Theme, fn()) ui::Widget,
}

// Reusable modal frame: bordered surface with a title, body, and a
// footer for keyboard hints. Used by pickers, compose, and search.
//
// What it gives you for free:
//   - bordered themed surface (theme.Border edges, theme.Surface fill)
//   - bold title row with dividers separating title / body / footer
//   - 1-row top + bottom internal padding, 1-col internal horizontal
//     padding so content isn't flush with the border
//   - focus trap (FocusScope with Trap and AutoFocus)
//   - Escape -> on_dismiss, by handling the upstream DismissIntent
//     rather than re-binding the key (avoids fighting the app-level
//     Shortcuts; same trick we use for Tab elsewhere)
//
// What you still own:
//   - mounting the result over the rest of the app via the overlay
//   - keybindings inside the body (up/down/enter for pickers, etc.)
//
// The caller's `child` MUST include at least one focusable widget.
// Without one, the modal's FocusScope AutoFocus has no target and
// focus stays on whatever was focused before the modal opened,
// causing keystrokes to bypass the modal body's shortcuts/actions.
//
// We intentionally do NOT wrap `child` in a focusable here. Doing so
// would put the focusable ABOVE any shortcuts/actions the body
// installs, and events bubble up from the focused element — so the
// body's own handlers would never fire.
//
// Width: none (the default) hugs the content. Pass an Int to fix the
// modal's width.
fn show_modal(
  theme: ui::Theme,
  title: Str,
  child: ui::Widget,
  footer: ui::Widget,
  width: Int?,
  on_dismiss: fn(ui::EventContext),
) ui::Widget {
  let surface_style = ui::Style{Foreground: theme.Border, Background: theme.Surface}
  mut content_children: [ui::Widget] = [
    ui::SizedBox{Height: 1},
    ui::Padding(
      ui::Symmetric(1, 0),
      ui::Text{Value: title, Style: ui::Style{Foreground: theme.Foreground, Attribute: ui::AttrBold}},
    ),
    ui::Padding(ui::Symmetric(1, 0), ui::Divider{Style: surface_style}),
    ui::Padding(ui::Symmetric(1, 0), child),
    ui::Padding(ui::Symmetric(1, 0), ui::Divider{Style: surface_style}),
    ui::Padding(ui::Symmetric(1, 0), footer),
    ui::SizedBox{Height: 1},
  ]
  let content = ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    CrossAxisAlignment: ui::CrossAxisStretch,
    Children: content_children,
  }
  
  let bordered = ui::DecoratedBox(
    ui::Decoration{
      Style: ui::Style{Background: theme.Surface},
      Border: ui::BorderAll(ui::Style{Foreground: theme.Border, Background: theme.Surface}),
    },
    content,
  )
  let sized: ui::Widget = match width {
    w => {
      ui::ConstrainedBox{
        Constraints: ui::Constraints{
          MinWidth: w,
          MaxWidth: w,
          MaxHeight: ui::Unbounded,
        },
        Child: bordered,
      }
    },
    _ => bordered,
  }
  // ReclaimFocus so that swapping the body subtree (e.g. loading view
  // -> picker body, when the caller calls show_modal again with the
  // same title) snaps focus back into the modal instead of leaving it
  // on the focused element that just got disposed.
  ui::Actions{
    Bindings: [
      "vaxis.dismiss": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        on_dismiss(ev)
        ui::EventHandled
      },
    ],
    Child: ui::FocusScope{
      Trap: true,
      AutoFocus: true,
      ReclaimFocus: true,
      Child: sized,
    },
  }
}
