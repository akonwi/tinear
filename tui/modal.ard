use tinear/tui/ui

fn dialog(title: Str, child: ui::Widget, footer: ui::Widget, width: Int, on_dismiss: fn(ui::EventContext)) ui::Widget {
  let separator = ui::divider(style: ui::style(foreground: "border"))
  let content = ui::column_min([
    ui::sized_box(1, 1),
    ui::padding_horizontal(1, ui::text(title)),
    ui::padding_horizontal(1, separator),
    ui::padding_horizontal(1, child),
    ui::padding_horizontal(1, separator),
    ui::padding_horizontal(1, footer),
    ui::sized_box(1, 1),
  ])

  ui::actions(
    child: ui::shortcuts(
      child: ui::focusable(ui::center(ui::box(
        ui::constrained_width(width, content),
        border: ui::border(
          top: true,
          right: true,
          bottom: true,
          left: true,
          style: ui::style(foreground: "border"),
        ),
      ))),
      bindings: [
        "Escape": "modal.dismiss",
        "Esc": "modal.dismiss",
      ],
    ),
    bindings: [
      "modal.dismiss": fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
        on_dismiss(ctx)
        ui::EventResult::handled
      },
    ],
  )
}
