use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi

// Transient overlay notifications.
//
// The data live in AppState (caller-owned: list of Toast + a
// monotonically increasing id counter). This module renders the list
// and animates each entry. Adding/removing toasts is the caller's
// responsibility; see `main.ard` for the `notify` helper that wraps
// the lifecycle.

enum ToastVariant {
  info,
  success,
  error,
}

struct Toast {
  id: Int,
  title: Str,
  description: Str,
  variant: ToastVariant,
  ttl_ms: Int,
}

// ── Helpers ───────────────────────────────────────────────────────────

fn variant_color(theme: ui::Theme, v: ToastVariant) ui::Color {
  match v {
    ToastVariant::info => theme.Primary,
    ToastVariant::success => theme.Success,
    ToastVariant::error => theme.Danger,
  }
}

// Approximate the toast's natural rendered width. The exact size at
// layout time is unknown at build time, so we estimate from the
// underlying string lengths: borders (2) + horizontal padding (2 * 2)
// + the wider of title or description.
fn natural_width(toast: Toast) Int {
  let title_w = toast.title.size()
  let desc_w = toast.description.size()
  let content_w = match title_w >= desc_w {
    true => title_w,
    false => desc_w,
  }
  content_w + 6
}

// Map animation progress (0..1, linear over the toast's full TTL) to
// the VISIBLE width of the outer container. The toast itself stays at
// its natural size; we wrap it in a SizedBox whose width animates
// 0 → natural → 0, with the toast right-aligned inside. As width grows
// during slide-in, the toast appears to unfurl from the right edge.
fn reveal_width(progress: Float64, max_width: Int) Int {
  let slide_phase = 0.05
  let max_w = max_width.to_f64()
  if progress < slide_phase {
    let t = progress / slide_phase
    (t * max_w).to_int()
  } else if progress > 1.0 - slide_phase {
    let t = (1.0 - progress) / slide_phase
    (t * max_w).to_int()
  } else {
    max_width
  }
}

// ── Rendering ─────────────────────────────────────────────────────────

// Build the visible cell rectangle: title + optional dim description
// inside a bordered box. The border is colored per variant — it's the
// only variant signal.
fn render_body(theme: ui::Theme, toast: Toast) ui::Widget {
  let border_color = variant_color(theme, toast.variant)
  let col_children: mut [ui::Widget] = mut [ui::Text{Value: toast.title, Style: ui::Style{Foreground: theme.Foreground}}]
  if not toast.description.is_empty() {
    col_children.push(
      ui::Text{
        Value: toast.description,
        Style: ui::Style{Foreground: theme.MutedForeground, Attribute: ui::AttrDim},
      },
    )
  }
  let body_column = ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    CrossAxisAlignment: ui::CrossAxisStart,
    Children: deref col_children,
  }

  // Interior padding: horizontal 2 gives the title breathing room from
  // the left/right edges; vertical 1 keeps it off the border lines.
  ui::DecoratedBox(
    ui::Decoration{
      Style: ui::Style{Foreground: theme.Foreground, Background: theme.Surface},
      Border: ui::BorderAll(ui::Style{Foreground: border_color, Background: theme.Surface}),
    },
    ui::Padding(ui::Symmetric(2, 1), body_column),
  )
}

// Each toast is its own stateful widget so it owns its own
// AnimationController running linearly over the full ttl_ms.
//
// Reveal animation: the toast is wrapped in a SizedBox whose width
// animates 0 → natural_width → 0 over the first/last 5% of the TTL,
// right-aligned so the growing window exposes the toast from its right
// edge.
fn render_animated(theme: ui::Theme, toast: Toast) ui::Widget {
  let max_w = natural_width(toast)
  ffi::Stateful{
    Init: fn() Any {
      toast
    },
    Animate: true,
    AnimateMs: toast.ttl_ms,
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      let anim = ffi::Animation(c)
      anim.Forward()
      let progress = anim.Value()
      let visible_w = reveal_width(progress, max_w)
      mut row_children: [ui::Widget] = [render_body(theme, toast)]
      ui::SizedBox{
        Width: visible_w,
        Child: ui::Flex{
          Axis: ui::Horizontal,
          MainAxisAlignment: ui::MainAxisEnd,
          Children: row_children,
        },
      }
    },
  }
}

// Stack of toasts, newest at the bottom. Right-aligned within the
// overlay region so the slide animation reads as coming from the
// screen edge.
fn render_stack(theme: ui::Theme, toasts: [Toast]) ui::Widget {
  let children: mut [ui::Widget] = mut []
  for t, idx in toasts {
    if idx > 0 {
      children.push(ui::SizedBox{Height: 1})
    }
    children.push(render_animated(theme, t))
  }
  ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    CrossAxisAlignment: ui::CrossAxisEnd,
    Children: deref children,
  }
}
