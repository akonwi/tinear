use vaxis
use vaxis/ui

// Transient overlay notifications.
//
// The data live in AppState (caller-owned: list of Toast + a monotonically
// increasing id counter). This module renders the list and animates each
// entry. Adding/removing toasts is the caller's responsibility; see
// `main.ard` for the `notify` helper that wraps the lifecycle.

enum ToastVariant {
  info,
  success,
  error,
}

struct Toast {
  id: Int,
  title: Str,
  description: Str,
  variant: ToastVariant,
  ttl_ms: Int,
}

struct ViewState {
  anim: ui::AnimationController,
}

// ── Helpers ───────────────────────────────────────────────────────────

fn variant_color(theme: ui::Theme, v: ToastVariant) vaxis::Color {
  match v {
    ToastVariant::info => theme.primary,
    ToastVariant::success => theme.success,
    ToastVariant::error => theme.danger,
  }
}

// Map animation progress (0..1, linear over the toast's full TTL) to a
// right-side padding amount in cells. The first and last `slide_phase`
// fraction of the lifecycle slides the toast in and out by `slide_cells`.
fn slide_offset(progress: Float) Int {
  let slide_phase = Float::from_int(5) / Float::from_int(100)  // 0.05
  let slide_cells = Float::from_int(15)
  let one = Float::from_int(1)
  if progress < slide_phase {
    let t = progress / slide_phase
    ui::float_to_int((one - t) * slide_cells)
  } else if progress > one - slide_phase {
    let t = (progress - (one - slide_phase)) / slide_phase
    ui::float_to_int(t * slide_cells)
  } else {
    0
  }
}

// ── Rendering ─────────────────────────────────────────────────────────

// Build the visible cell rectangle: title + optional dim description
// inside a bordered box. The border is colored per variant — it's the
// only variant signal, so the color picks (info/primary, success,
// error/danger) need to be visually distinct against theme.surface.
fn render_body(theme: ui::Theme, toast: Toast) ui::Widget {
  let border_color = variant_color(theme, toast.variant)
  mut col_children: [ui::Widget] = [
    ui::styled_text(toast.title, fg: theme.foreground),
  ]
  if not toast.description.is_empty() {
    col_children.push(ui::styled_text(
      toast.description,
      fg: theme.muted_foreground,
      attrs: ui::TextAttrs{ dim: true },
    ))
  }
  let body_column = ui::column(
    col_children,
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::start,
  )
  // Interior padding inside the decorated_box.
  //
  // The minimum to keep the border from overlapping the content is
  // `all: 1` (decorated_box sizes itself to its child and paints the
  // border at the edges of its rect). horizontal: 2 gives the title
  // text a little more breathing room from the left/right edges; the
  // vertical 1 is just enough to keep the title off the border lines.
  ui::decorated_box(
    ui::padding(body_column, horizontal: 2, vertical: 1),
    bg: theme.surface,
    fg: theme.foreground,
    border: ui::borders_all(),
    border_fg: border_color,
    border_bg: theme.surface,
  )
}

// Each toast is its own stateful widget so it owns its own AnimationController.
// The controller runs over the full ttl_ms and the slide-out completes
// exactly as the parent removes this entry from the state list — keeping
// the unmount timing aligned with the end of the animation.
fn render_animated(theme: ui::Theme, toast: Toast) ui::Widget {
  ui::stateful(
    key: "toast-{toast.id.to_str()}",
    init: fn(ctx: ui::BuildContext) ViewState {
      let anim = ui::animation_controller(ctx, toast.ttl_ms, curve: ui::AnimationCurve::linear)
      ui::anim_forward(anim)
      ViewState{ anim: anim }
    },
    build: fn(_ctx: ui::BuildContext, state: ui::State<ViewState>) ui::Widget {
      let progress = ui::anim_value(state.value().anim)
      let right_pad = slide_offset(progress)
      ui::padding(render_body(theme, toast), right: right_pad)
    },
  )
}

// Stack of toasts, newest at the bottom. Right-aligned within the
// overlay region so the slide animation reads as coming from the screen
// edge.
fn render_stack(theme: ui::Theme, toasts: [Toast]) ui::Widget {
  mut children: [ui::Widget] = []
  for t, idx in toasts {
    if idx > 0 {
      children.push(ui::sized_box(0, 1, ui::text("")))
    }
    children.push(render_animated(theme, t))
  }
  ui::column(
    children,
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::end,
  )
}
