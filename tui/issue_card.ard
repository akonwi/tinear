use ard/decode

use tinear/tui/core/view
use tinear/tui/state
use tinear/tui/text
use tinear/vaxis

// Issue card used by the My Issues board.
//
// The parent gives the card a fixed-width frame. The card draws its content
// within that width, optionally paints a full-card reverse-video background
// when selected, and reserves divider/blank space when another card follows.
struct IssueCard {
  issue: Dynamic,
  selected: Bool,
  last: Bool,
}

fn new(issue: Dynamic, selected: Bool, last: Bool) IssueCard {
  IssueCard{issue: issue, selected: selected, last: last}
}

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out =+ ch
    }
  }
  out
}

impl view::View for IssueCard {
  fn init(ctx: view::Context) {}

  fn handle_event(ctx: view::Context, mut event: view::Event) {}

  fn render(mut frame: view::Frame) {
    let col_w = frame.width()
    let identifier = decode::run(self.issue, decode::field("identifier", decode::string))
      .expect("Missing identifier")
    let title = decode::run(self.issue, decode::field("title", decode::string))
      .expect("Missing title")
    let priority = decode::run(self.issue, decode::field("priority", decode::nullable(decode::int)))
      .expect("Missing priority")

    let cursor = match self.selected {
      true => "▸",
      false => " ",
    }
    let glyph = state::priority_glyph(priority)
    let title_indent = 3
    let title_w = col_w - title_indent
    let wrapped = text::wrap_title(title, title_w)
    let has_line2 = not wrapped.line2.is_empty()
    let card_h = match has_line2 {
      true => 3,
      false => 2,
    }

    // For the selected card, paint the whole card rectangle first. Then draw
    // text on top with the same reverse style. This highlights the card box,
    // not just the cells occupied by glyphs.
    if self.selected {
      for row in 0..(card_h - 1) {
        frame.draw_styled(0, row, repeat(" ", col_w), -1, -1, false, false, false, false, true)
      }
    }

    let header = "{cursor}{glyph} {identifier}"
    frame.draw_styled(
      0, 0,
      text::truncate_with_ellipsis(header, col_w),
      -1, -1, false, false, false, false, self.selected,
    )

    frame.draw_styled(
      title_indent, 1,
      text::truncate_with_ellipsis(wrapped.line1, title_w),
      -1, -1, false, false, false, false, self.selected,
    )

    if has_line2 {
      frame.draw_styled(
        title_indent, 2,
        text::truncate_with_ellipsis(wrapped.line2, title_w),
        -1, -1, false, false, false, false, self.selected,
      )
    }

    if not self.last {
      frame.draw_text(0, card_h, repeat("━", col_w - 1))
      // Reserve the blank row after the divider so parent stacks advance the
      // same amount the old board rendering did.
      frame.expand(0, card_h + 1, 0, 1)
    }
  }
}
