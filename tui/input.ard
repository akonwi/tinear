use tinear/tui/core/box
use tinear/tui/core/style
use tinear/tui/core/view
use tinear/vaxis

// Stateful single-line input.
//
// Owns its current value and implements View for rendering. Event routing
// stays app-owned: parent components call handle_key when this input is active.
//
// Input composes its content with a Box. Consumers can override the base style
// and dimensions through the constructor, but don't need to wrap it themselves.
type OnSubmit = fn(Str)

struct Input {
  value: Str,
  placeholder: Str,
  cursor: Int,
  on_submit: OnSubmit?,
  style: style::Style?,
  width: Int?,
  height: Int?,
}

fn new(placeholder: Str, on_submit: OnSubmit?, style: style::Style?, width: Int?, height: Int?) Input {
  Input{
    value: "",
    placeholder: placeholder,
    cursor: 0,
    on_submit: on_submit,
    style: style,
    width: width,
    height: height,
  }
}

fn min_int(a: Int, b: Int) Int {
  match a < b {
    true => a,
    false => b,
  }
}

fn opt_or_int(v: Int?, fallback: Int) Int {
  match v {
    n => n,
    _ => fallback,
  }
}

fn opt_or_padding(v: style::Padding?, fallback: style::Padding) style::Padding {
  match v {
    p => p,
    _ => fallback,
  }
}

fn opt_or_border(v: style::BorderStyle?, fallback: style::BorderStyle) style::BorderStyle {
  match v {
    b => b,
    _ => fallback,
  }
}

fn char_count(s: Str) Int {
  mut count = 0
  for _ in s {
    count = count + 1
  }
  count
}

fn prefix(s: Str, n: Int) Str {
  mut out = ""
  mut idx = 0
  for ch in s {
    if idx < n {
      out = "{out}{ch}"
    }
    idx = idx + 1
  }
  out
}

fn suffix(s: Str, n: Int) Str {
  mut out = ""
  mut idx = 0
  for ch in s {
    if idx >= n {
      out = "{out}{ch}"
    }
    idx = idx + 1
  }
  out
}

struct InputContent {
  value: Str,
  placeholder: Str,
  cursor: Int,
}

impl view::View for InputContent {
  fn render(mut frame: view::Frame) {
    let is_placeholder = self.value.size() == 0
    let content_w = frame.width()
    let offset = match is_placeholder {
      true => 0,
      false => {
        let max_cursor = match content_w <= 1 {
          true => 0,
          false => content_w - 1,
        }
        match self.cursor > max_cursor {
          true => self.cursor - max_cursor,
          false => 0,
        }
      },
    }
    let content = match is_placeholder {
      true => self.placeholder,
      false => prefix(suffix(self.value, offset), content_w),
    }
    let cursor_x = match is_placeholder {
      true => 0,
      false => self.cursor - offset,
    }

    frame.draw_styled(
      0, 0, content,
      -1, -1,
      false,
      is_placeholder,
      false,
      false,
      false,
    )
    frame.show_cursor(cursor_x, 0)
  }
}

impl Input {
  fn value() Str { self.value }

  fn mut clear() {
    self.value = ""
    self.cursor = 0
  }

  fn display_value() Str {
    match self.value.size() == 0 {
      true => self.placeholder,
      false => self.value,
    }
  }

  fn resolved_style(mut frame: view::Frame) style::Style {
    let default_width = min_int(frame.width(), 32)
    let default_height = min_int(frame.height(), 3)

    match self.style {
      s => style::Style{
        padding: opt_or_padding(s.padding, style::Padding::x(1)),
        border: opt_or_border(s.border, style::BorderStyle::Single),
        border_title: s.border_title,
        background_char: s.background_char,
        fg: s.fg,
        bg: s.bg,
        bold: s.bold,
        dim: s.dim,
        italic: s.italic,
        underline: s.underline,
        reverse: s.reverse,
        width: opt_or_int(self.width, opt_or_int(s.width, default_width)),
        height: opt_or_int(self.height, opt_or_int(s.height, default_height)),
      },
      _ => style::Style{
        padding: style::Padding::x(1),
        border: style::BorderStyle::Single,
        width: opt_or_int(self.width, default_width),
        height: opt_or_int(self.height, default_height),
      },
    }
  }

  fn mut insert_text(text: Str) {
    let before = prefix(self.value, self.cursor)
    let after = suffix(self.value, self.cursor)
    self.value = "{before}{text}{after}"
    self.cursor = self.cursor + char_count(text)
  }

  fn mut backspace() {
    if self.cursor > 0 {
      let before = prefix(self.value, self.cursor - 1)
      let after = suffix(self.value, self.cursor)
      self.value = "{before}{after}"
      self.cursor = self.cursor - 1
    }
  }

  fn mut delete() {
    let len = char_count(self.value)
    if self.cursor < len {
      let before = prefix(self.value, self.cursor)
      let after = suffix(self.value, self.cursor + 1)
      self.value = "{before}{after}"
    }
  }

  fn submit() {
    match self.on_submit {
      cb => cb(self.value),
      _ => (),
    }
  }

  fn mut handle_key(key: vaxis::KeyEvent) {
    match key.name {
      "Left" => {
        if self.cursor > 0 {
          self.cursor = self.cursor - 1
        }
      },
      "Right" => {
        let len = char_count(self.value)
        if self.cursor < len {
          self.cursor = self.cursor + 1
        }
      },
      "Home" => { self.cursor = 0 },
      "End" => { self.cursor = char_count(self.value) },
      "Enter" => self.submit(),
      "BackSpace" => self.backspace(),
      "Delete" => self.delete(),
      _ => {
        if key.text.size() > 0 and not key.ctrl and not key.alt and not key.meta {
          self.insert_text(key.text)
        }
      },
    }
  }

  fn mut handle_event(event: vaxis::Event) {
    match event {
      KeyEvent(key) => self.handle_key(key),
      PasteEvent(paste) => self.insert_text(paste.content),
      _ => (),
    }
  }
}

impl view::View for Input {
  fn render(mut frame: view::Frame) {
    let content_view = InputContent{
      value: self.value,
      placeholder: self.placeholder,
      cursor: self.cursor,
    }
    box::new(content_view, self.resolved_style(frame)).render(frame)
  }
}
