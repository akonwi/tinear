use ard/testing as assertions

use cooper/ui

// Tinear's theme is grounded in the host terminal palette.
//
// A missing foreground/background means "use the terminal default" in Cooper.
// Semantic colors use ANSI palette slots so the terminal theme remains the
// source of truth on light and dark backgrounds. Tinear does not own a canvas
// color or a dark/light mode.
struct Theme {
  foreground: ui::Color,
  background: ui::Color,
  item_hover_foreground: ui::Color,
  item_hover_background: ui::Color,
  item_active_foreground: ui::Color,
  item_active_background: ui::Color,
  border: ui::Color,
  accent: ui::Color,
  danger: ui::Color,
  warning: ui::Color,
  success: ui::Color,
}

fn new() Theme {
  Theme{
    // Explicit defaults fill retained surfaces without owning a canvas color.
    // Interactive item states use host ANSI gray/blue with bright host text.
    foreground: ui::terminal_default(),
    background: ui::terminal_default(),
    item_hover_foreground: ui::indexed(15),
    item_hover_background: ui::indexed(8),
    item_active_foreground: ui::indexed(15),
    item_active_background: ui::indexed(4),
    border: ui::indexed(8),
    accent: ui::indexed(4),
    danger: ui::indexed(1),
    warning: ui::indexed(3),
    success: ui::indexed(2),
  }
}

test fn theme_uses_terminal_defaults_and_host_palette_slots() Void!Str {
  let theme = new()
  try assertions::assert(theme.foreground.terminal_default, "Expected explicit host foreground")
  try assertions::assert(theme.background.terminal_default, "Expected explicit host background fill")
  try assertions::assert(
    theme.item_hover_background.index.expect("hover palette slot") == Uint8::from(8),
    "Expected host gray hover background",
  )
  try assertions::assert(
    theme.item_active_background.index.expect("active palette slot") == Uint8::from(4),
    "Expected host accent active background",
  )
  try assertions::assert(
    theme.item_hover_foreground.index.expect("hover text slot") == Uint8::from(15) and theme.item_active_foreground.index.expect("active text slot") == Uint8::from(15),
    "Expected bright host text on interactive backgrounds",
  )
  try assertions::assert(
    theme.accent.index.expect("accent palette slot") == Uint8::from(4),
    "Expected host blue accent",
  )
  try assertions::assert(
    theme.danger.index.expect("danger palette slot") == Uint8::from(1),
    "Expected host red danger",
  )
  try assertions::assert(
    theme.warning.index.expect("warning palette slot") == Uint8::from(3),
    "Expected host yellow warning",
  )
  try assertions::assert(
    theme.success.index.expect("success palette slot") == Uint8::from(2),
    "Expected host green success",
  )
  assertions::assert(
    theme.border.index.expect("border palette slot") == Uint8::from(8),
    "Expected host gray border",
  )
}
