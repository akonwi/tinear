// Decoration primitives — values describing how a view's rendering
// surface is styled and laid out around its content.
//
// These types live in their own module rather than alongside any
// particular view because they are conceptually orthogonal to any
// specific container. Today only `box` consumes them; in the future
// any view that wants bordered or padded behaviour can pull from the
// same types without depending on `box`.
//
// A later refactor (cut 2) may unify these with text attributes
// (fg/bg/bold/...) into a single `Style` value applied via
// `styled(view, style)` — the Lipgloss model. This module is the
// home that lands in.

// Border line style.
enum BorderStyle {
  Single,    // ┌─┐│└─┘
  Double,    // ╔═╗║╚═╝
  Rounded,   // ╭─╮│╰─╯
}

// Inner padding applied between a decoration ring (border / frame
// edge) and the content it wraps.
struct Padding {
  top: Int,
  right: Int,
  bottom: Int,
  left: Int,
}

// Uniform padding on all four sides.
fn Padding::all(n: Int) Padding {
  Padding{top: n, right: n, bottom: n, left: n}
}

// Horizontal padding (CSS-style two-value).
fn Padding::x(size: Int) Padding {
  Padding{top: 0, right: 0, bottom: size, left: size}
}

// Vertical padding (CSS-style two-value).
fn Padding::y(size: Int) Padding {
  Padding{top: size, right: size, bottom: 0, left: 0}
}
