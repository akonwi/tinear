// Decoration primitives — values describing how a widget's
// rendering surface is styled and laid out around its content.
//
// These types live in their own module rather than alongside any
// particular widget because they are conceptually orthogonal to any
// specific container. Today only `box` consumes them; in the future
// any widget that wants bordered or padded behaviour can pull from
// the same types without depending on `box`.
//
// A later refactor (cut 2) may unify these with text attributes
// (fg/bg/bold/...) into a single `Style` value applied via
// `styled(widget, style)` — the Lipgloss model. This module is the
// home that lands in.

// Border line style.
enum BorderStyle {
  Single,    // ┌─┐│└─┘
  Double,    // ╔═╗║╚═╝
  Rounded,   // ╭─╮│╰─╯
}

// Inner padding applied between a decoration ring (border / frame
// edge) and the content it wraps.
struct Padding {
  top: Int,
  right: Int,
  bottom: Int,
  left: Int,
}

// Uniform padding on all four sides.
fn pad_all(n: Int) Padding {
  Padding{top: n, right: n, bottom: n, left: n}
}

// Horizontal and vertical padding (CSS-style two-value).
fn pad_xy(x: Int, y: Int) Padding {
  Padding{top: y, right: x, bottom: y, left: x}
}
