// Decoration primitives and the `Style` bundle.
//
// `Style` is a reusable, declaratively-described decoration value
// applied to a view's rendering surface. It bundles every property
// that decorates the surface — borders, padding, cell color, attrs,
// the optional title view in the top border — into one passable
// piece of data:
//
//   let card = style::Style{
//     border: style::BorderStyle::Rounded,
//     padding: style::Padding::all(1),
//     fg: 8,
//   }
//   box::new(text::new("a"), card)
//   box::new(text::new("b"), card)
//
// Style is intentionally NOT coupled to any specific view. Today
// only `box` consumes it; future views that want bordered, padded,
// or colored decoration can take the same `Style` value without
// depending on `box`.
//
// What `Style` currently affects (via Box's render):
//   - The decoration ring (border)        — fg/bg/attrs applied
//   - The optional title in the top edge  — fg/bg/attrs applied
//   - The background fill (padding ring)  — fg/bg/attrs applied
//
// What `Style` does NOT yet affect (and why):
//   - The child view's content cells. Text owns its intrinsic
//     fg/bg/attrs because a wrapper view can't reach into a child's
//     glyph rendering. A future cut may add a frame-context
//     mechanism that lets style propagate to children — out of
//     scope here.

use tinear/tui/core/view

// ---- Decoration types ----------------------------------------------

// Border line style.
enum BorderStyle {
  Single,    // ┌─┐│└─┘
  Double,    // ╔═╗║╚═╝
  Rounded,   // ╭─╮│╰─╯
}

// Inner padding applied between a decoration ring (border / frame
// edge) and the content it wraps.
struct Padding {
  top: Int,
  right: Int,
  bottom: Int,
  left: Int,
}

// Uniform padding on all four sides.
fn Padding::all(n: Int) Padding {
  Padding{top: n, right: n, bottom: n, left: n}
}

// Horizontal padding only (left + right).
fn Padding::x(size: Int) Padding {
  Padding{top: 0, right: size, bottom: 0, left: size}
}

// Vertical padding only (top + bottom).
fn Padding::y(size: Int) Padding {
  Padding{top: size, right: 0, bottom: size, left: 0}
}

// ---- The Style bundle ----------------------------------------------

// Reusable decoration bundle. Every field is optional; omit (or
// pass `none`) any property you don't want. Construct directly as
// a struct literal: `Style{border: ..., padding: ..., fg: ...}`.
struct Style {
  padding: Padding?,
  border: BorderStyle?,
  // Title view rendered inline at the top of the border, in the
  // span between the corner glyphs. Has no effect when `border` is
  // absent. As a view it carries its own styling/padding — wrap a
  // text in `box::new(text, Style{padding: Padding::x(1)})` for
  // the classic `┌ Demo ┐` look.
  border_title: view::View?,
  // Character drawn into every otherwise-empty cell of the styled
  // region. Useful for visible backgrounds, dim panels, diff fills.
  // When `bg` is set without `background_char`, a space is used.
  background_char: Str?,
  // Cell foreground color. -1 (or absent) = terminal default.
  fg: Int?,
  // Cell background color. -1 (or absent) = terminal default.
  bg: Int?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  reverse: Bool?,
  // Explicit sizing. When set, the Box renders at exactly this
  // size in the given dimension; the child is given the remaining
  // inner area regardless of how much it actually draws. When
  // absent, the dimension is fit-content (sized to the child's
  // drawn extent + border + padding).
  //
  // Pass `frame.width()` / `frame.height()` at render time for a
  // box that fills its container.
  width: Int?,
  height: Int?,
}
