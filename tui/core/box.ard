// Box container — decoratable wrapper around a single child widget.
//
// `Box` is the framework's only decoration primitive. Border,
// padding, title, and background are properties of `Box`, applied
// in a fixed order (background → border → title in top border →
// padding → child). Each is optional via `T?`.
//
// Composes by nesting: padding outside a border (margin) is
// `Box{child: Box{child, border}, padding}`.

use tinear/tui/core/widget
use tinear/tui/core/rect
use tinear/tui/core/style

// ---- Internal drawing helpers --------------------------------------

// Border glyphs for each line style. Order: TL, TR, BL, BR, H, V.
struct BorderGlyphs {
  tl: Str,
  tr: Str,
  bl: Str,
  br: Str,
  h: Str,
  v: Str,
}

fn glyphs_for(s: style::BorderStyle) BorderGlyphs {
  match s {
    style::BorderStyle::Single => BorderGlyphs{tl: "┌", tr: "┐", bl: "└", br: "┘", h: "─", v: "│"},
    style::BorderStyle::Double => BorderGlyphs{tl: "╔", tr: "╗", bl: "╚", br: "╝", h: "═", v: "║"},
    style::BorderStyle::Rounded => BorderGlyphs{tl: "╭", tr: "╮", bl: "╰", br: "╯", h: "─", v: "│"},
  }
}

fn draw_border(frame: widget::Frame, w: Int, h: Int, s: style::BorderStyle) {
  if w < 2 or h < 2 {
    ()
  } else {
    let g = glyphs_for(s)

    // Top edge
    frame.draw_text(0, 0, g.tl)
    for x in 1..(w - 1) {
      frame.draw_text(x, 0, g.h)
    }
    frame.draw_text(w - 1, 0, g.tr)

    // Vertical edges
    for y in 1..(h - 1) {
      frame.draw_text(0, y, g.v)
      frame.draw_text(w - 1, y, g.v)
    }

    // Bottom edge
    frame.draw_text(0, h - 1, g.bl)
    for x in 1..(w - 1) {
      frame.draw_text(x, h - 1, g.h)
    }
    frame.draw_text(w - 1, h - 1, g.br)
  }
}

fn fill_background(frame: widget::Frame, w: Int, h: Int, ch: Str) {
  for y in 0..h {
    for x in 0..w {
      frame.draw_text(x, y, ch)
    }
  }
}

// ---- The Box widget ------------------------------------------------

struct Box {
  child: widget::Widget,
  border: style::BorderStyle?,
  padding: style::Padding?,
  // Optional title rendered inline in the top border. Only visible
  // when `border` is set.
  title: Str?,
  // Optional fill character drawn behind the child (for tinted
  // backgrounds). When None, the background is whatever was already
  // in the cells.
  background_char: Str?,
}

impl widget::Widget for Box {
  fn render(frame: widget::Frame) {
    let w = frame.width()
    let h = frame.height()

    // 1. Background fill, if any.
    match self.background_char {
      ch => fill_background(frame, w, h, ch),
      _ => (),
    }

    // 2. Border, if any.
    let has_border = self.border.is_some()
    match self.border {
      s => draw_border(frame, w, h, s),
      _ => (),
    }

    // 3. Title in the top border row, if any (requires border).
    match self.title {
      t => {
        if has_border and w >= 4 {
          // Left-anchored at column 2 with surrounding spaces.
          frame.draw_text(2, 0, " {t} ")
        }
      },
      _ => (),
    }

    // 4. Inner area = (frame minus border ring) minus padding.
    let border_inset = match has_border {
      true => 1,
      false => 0,
    }
    let pad = match self.padding {
      p => p,
      _ => style::Padding{top: 0, right: 0, bottom: 0, left: 0},
    }

    let inner_x = border_inset + pad.left
    let inner_y = border_inset + pad.top
    let raw_w = w - (border_inset * 2) - pad.left - pad.right
    let raw_h = h - (border_inset * 2) - pad.top - pad.bottom
    let inner_w = match raw_w < 0 {
      true => 0,
      false => raw_w,
    }
    let inner_h = match raw_h < 0 {
      true => 0,
      false => raw_h,
    }

    // 5. Render the child into the computed inner area.
    let inner_area = rect::Rect{x: inner_x, y: inner_y, w: inner_w, h: inner_h}
    self.child.render(widget::sub(frame, inner_area))
  }
}

// Universal Box constructor. Returns `widget::Widget` so callers
// can pass the result into other widget-typed parameters across
// module boundaries (the Ard checker does not currently coerce
// concrete types to traits at storage positions outside the
// defining module).
fn new(
  child: widget::Widget,
  border: style::BorderStyle?,
  padding: style::Padding?,
  title: Str?,
  background: Str?,
) widget::Widget {
  Box{
    child: child,
    border: border,
    padding: padding,
    title: title,
    background_char: background,
  }
}
