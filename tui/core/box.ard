// Box — a decorative wrapper view.
//
// A Box adds spatial decoration (border, padding, optional title
// rendered into the top border, background fill) around a child
// view, plus cell-level styling on the decoration ring itself
// (fg/bg/attrs). Decoration is described as a `style::Style` value
// passed alongside the child — not inherent to the view — so the
// same Style can be reused across many boxes (see style.ard).
//
// Box renders fit-content: it draws its child into a sub-frame
// first, reads what the child actually drew (via the Frame extent),
// then sizes its border/padding ring around that. There is no
// intrinsic-size protocol — what the child rendered IS its size.

use tinear/tui/core/view
use tinear/tui/core/rect
use tinear/tui/core/style
use tinear/vaxis

// ---- Internal drawing helpers --------------------------------------

// Border glyphs for each line style. Order: TL, TR, BL, BR, H, V.
struct BorderGlyphs {
  tl: Str,
  tr: Str,
  bl: Str,
  br: Str,
  h: Str,
  v: Str,
}

fn glyphs_for(b: style::BorderStyle) BorderGlyphs {
  match b {
    style::BorderStyle::Single => BorderGlyphs{tl: "┌", tr: "┐", bl: "└", br: "┘", h: "─", v: "│"},
    style::BorderStyle::Double => BorderGlyphs{tl: "╔", tr: "╗", bl: "╚", br: "╝", h: "═", v: "║"},
    style::BorderStyle::Rounded => BorderGlyphs{tl: "╭", tr: "╮", bl: "╰", br: "╯", h: "─", v: "│"},
  }
}

// Draw a styled character at (x, y) using BoxStyle's fg/bg/attrs.
// Optional fields fall back to terminal defaults / false.
fn paint(mut frame: view::Frame, x: Int, y: Int, ch: Str, s: style::Style) {
  let fg = match s.fg {
    v => v,
    _ => -1,
  }
  let bg = match s.bg {
    v => v,
    _ => -1,
  }
  let bold = match s.bold {
    v => v,
    _ => false,
  }
  let dim = match s.dim {
    v => v,
    _ => false,
  }
  let italic = match s.italic {
    v => v,
    _ => false,
  }
  let underline = match s.underline {
    v => v,
    _ => false,
  }
  let reverse = match s.reverse {
    v => v,
    _ => false,
  }
  frame.draw_styled(x, y, ch, fg, bg, bold, dim, italic, underline, reverse)
}

// Draw the border ring at (0, 0)..(w-1, h-1) using the given style.
fn draw_border(mut frame: view::Frame, w: Int, h: Int, b: style::BorderStyle, s: style::Style) {
  if w < 2 or h < 2 {
    ()
  } else {
    let g = glyphs_for(b)

    // Top edge (corners at 0 and w-1, dashes in between).
    // Note: Ard's `a..b` is inclusive on both ends, so to iterate
    // [1, w-2] we write `1..(w - 2)`.
    paint(frame, 0, 0, g.tl, s)
    for x in 1..(w - 2) {
      paint(frame, x, 0, g.h, s)
    }
    paint(frame, w - 1, 0, g.tr, s)

    // Vertical edges (rows 1..h-2; the corners cover rows 0 and h-1).
    // Use an explicit while loop here: range boundary behavior has varied
    // during Ard upgrades, and missing this loop leaves boxes looking like
    // horizontal rules with no sides.
    mut y = 1
    while y < h - 1 {
      paint(frame, 0, y, g.v, s)
      paint(frame, w - 1, y, g.v, s)
      y = y + 1
    }

    // Bottom edge
    paint(frame, 0, h - 1, g.bl, s)
    for x in 1..(w - 2) {
      paint(frame, x, h - 1, g.h, s)
    }
    paint(frame, w - 1, h - 1, g.br, s)
  }
}

// Paint the padding ring around a content rectangle within the
// styled extent. Splits into four strips (top, bottom, left, right)
// so the content cells aren't overwritten.
fn fill_padding_ring(
  mut frame: view::Frame,
  extent_w: Int,
  extent_h: Int,
  content_x: Int,
  content_y: Int,
  content_w: Int,
  content_h: Int,
  s: style::Style,
) {
  let ch = match s.background_char {
    c => c,
    _ => " ",
  }

  // Ard's `a..b` is INCLUSIVE on both ends, so to iterate the
  // half-open range [a, b) we write `a..(b - 1)`. Inverted ranges
  // (b < a) iterate zero times, which makes the degenerate cases
  // (e.g. content_y == 0 so no top padding) collapse correctly.

  // Top strip: rows above the content, full extent width.
  for y in 0..(content_y - 1) {
    for x in 0..(extent_w - 1) {
      paint(frame, x, y, ch, s)
    }
  }
  // Bottom strip: rows below the content, full extent width.
  for y in (content_y + content_h)..(extent_h - 1) {
    for x in 0..(extent_w - 1) {
      paint(frame, x, y, ch, s)
    }
  }
  // Left strip: cells left of the content on content rows.
  for y in content_y..(content_y + content_h - 1) {
    for x in 0..(content_x - 1) {
      paint(frame, x, y, ch, s)
    }
  }
  // Right strip: cells right of the content on content rows.
  for y in content_y..(content_y + content_h - 1) {
    for x in (content_x + content_w)..(extent_w - 1) {
      paint(frame, x, y, ch, s)
    }
  }
}

// ---- The Box view --------------------------------------------------

struct Box {
  child: view::View,
  style: style::Style,
}

impl view::View for Box {
  fn init() {}
  fn handle_event(event: vaxis::Event) {}

  fn render(mut frame: view::Frame) {
    let s = self.style
    let max_w = frame.width()
    let max_h = frame.height()

    let pad = match s.padding {
      p => p,
      _ => style::Padding{top: 0, right: 0, bottom: 0, left: 0},
    }
    let border_inset = match s.border.is_some() {
      true => 1,
      false => 0,
    }

    // Inner width / height available to the child. If the style
    // specifies an explicit width/height we honour it (capped at
    // what the frame can hold); otherwise the child gets the full
    // available area.
    let frame_inner_w = max_w - 2 * border_inset - pad.left - pad.right
    let frame_inner_h = max_h - 2 * border_inset - pad.top - pad.bottom
    let inner_w_from_explicit = match s.width {
      w => w - 2 * border_inset - pad.left - pad.right,
      _ => frame_inner_w,
    }
    let inner_h_from_explicit = match s.height {
      h => h - 2 * border_inset - pad.top - pad.bottom,
      _ => frame_inner_h,
    }
    let raw_inner_w = inner_w_from_explicit
    let raw_inner_h = inner_h_from_explicit
    let inner_w = match raw_inner_w < 0 {
      true => 0,
      false => raw_inner_w,
    }
    let inner_h = match raw_inner_h < 0 {
      true => 0,
      false => raw_inner_h,
    }

    // 1. Render the child into a sub-frame at (border + pad.left,
    //    border + pad.top), inner area. The child draws only what
    //    it wants; we read the bounding box after.
    let inner_x = border_inset + pad.left
    let inner_y = border_inset + pad.top
    let inner_area = rect::Rect{x: inner_x, y: inner_y, w: inner_w, h: inner_h}
    mut child_sub = view::sub(frame, inner_area)
    self.child.render(child_sub)
    let dim = child_sub.dimensions()

    // 2. Compute our extent. With explicit sizing the Box always
    //    occupies exactly the requested w/h; otherwise it fits to
    //    the child's drawn region.
    let content_x = inner_x + dim.x
    let content_y = inner_y + dim.y
    let content_w = dim.w
    let content_h = dim.h
    let fit_w = content_x + content_w + pad.right + border_inset
    let fit_h = content_y + content_h + pad.bottom + border_inset
    let extent_w = match s.width {
      w => w,
      _ => fit_w,
    }
    let extent_h = match s.height {
      h => h,
      _ => fit_h,
    }

    // 3. Paint the padding ring around the content (skipping child
    //    cells). Fires when padding, border, bg, or background_char
    //    suggest a visible region.
    let needs_fill = s.bg.is_some() or s.background_char.is_some() or s.padding.is_some() or s.border.is_some()
    if needs_fill {
      fill_padding_ring(frame, extent_w, extent_h, content_x, content_y, content_w, content_h, s)
    }

    // 4. Border at the extent edges (overwrites the corresponding
    //    fill cells with border glyphs).
    match s.border {
      b => draw_border(frame, extent_w, extent_h, b, s),
      _ => (),
    }

    // 5. Title at top of border. Title renders into a sub-frame at
    //    (1, 0) with the available interior width; its own render
    //    paints only its content + padding, leaving the rest of the
    //    top border as dashes drawn in step 4.
    match s.border_title {
      t => {
        if s.border.is_some() {
          let raw_title_w = extent_w - 2
          let title_w = match raw_title_w < 0 {
            true => 0,
            false => raw_title_w,
          }
          let title_area = rect::Rect{x: 1, y: 0, w: title_w, h: 1}
          mut title_sub = view::sub(frame, title_area)
          t.render(title_sub)
        }
      },
      _ => (),
    }
  }
}

// Wrap a child view with a Style. Returns a view so the result
// composes further. (Cross-module trait coercion happens here,
// inside the module that defines `impl View for Box`.)
fn new(child: view::View, s: style::Style) view::View {
  Box{child: child, style: s}
}
