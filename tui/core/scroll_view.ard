use tinear/tui/core/rect
use tinear/tui/core/view
use tinear/vaxis

// ScrollView clips a child view to its own frame and shifts the child upward by
// `offset` rows. The child can render more rows than the viewport; only the
// visible slice is painted.
//
// Like Box/Stack, this is a wrapper view: render uses the tree-owned child when
// present and falls back to the constructor child otherwise.
struct ScrollView {
  child: view::View,
  offset: Int,
}

fn new(child: view::View) ScrollView {
  ScrollView{child: child, offset: 0}
}

impl ScrollView {
  fn mut scroll_up(lines: Int) {
    self.offset = self.offset - lines
    if self.offset < 0 {
      self.offset = 0
    }
  }

  fn mut scroll_down(lines: Int) {
    self.offset = self.offset + lines
    if self.offset < 0 {
      self.offset = 0
    }
  }

  fn mut page_up(viewport_h: Int) {
    let amount = match viewport_h > 1 {
      true => viewport_h - 1,
      false => 1,
    }
    self.scroll_up(amount)
  }

  fn mut page_down(viewport_h: Int) {
    let amount = match viewport_h > 1 {
      true => viewport_h - 1,
      false => 1,
    }
    self.scroll_down(amount)
  }

  fn mut handle_key(key: vaxis::KeyEvent) Bool {
    match key.name {
      "Up" => {
        self.scroll_up(1)
        true
      },
      "k" => {
        self.scroll_up(1)
        true
      },
      "Down" => {
        self.scroll_down(1)
        true
      },
      "j" => {
        self.scroll_down(1)
        true
      },
      "PageUp" => {
        self.page_up(10)
        true
      },
      "PageDown" => {
        self.page_down(10)
        true
      },
      "Home" => {
        self.offset = 0
        true
      },
      _ => false,
    }
  }
}

impl view::View for ScrollView {
  fn mut init(ctx: view::Context) {
    if ctx.child_count() == 0 {
      ctx.add_child(self.child)
    }
  }

  fn mut handle_event(ctx: view::Context, mut event: view::Event) {
    match event.raw {
      KeyEvent(key) => {
        if self.handle_key(key) {
          event.stop()
          ctx.redraw()
        }
      },
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    let viewport_h = frame.height()
    let child_h = viewport_h + self.offset
    let area = rect::Rect{x: 0, y: 0 - self.offset, w: frame.width(), h: child_h}
    mut child_frame = view::sub(frame, area)
    child_frame.render_child_or(0, self.child)

    // Reserve the viewport extent even when the child draws nothing, so parent
    // layouts treat the scroll view as occupying the assigned region.
    frame.expand(0, 0, frame.width(), viewport_h)

    if self.offset > 0 {
      frame.draw_text(frame.width() - 1, 0, "↑")
    }
  }
}
