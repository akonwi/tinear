// Text atom — a single line of styled text.
//
// Truncates to the frame width when too long. Wrapping is left for
// a future revision; for now `Text` is single-line only.

use tinear/tui/core/view
use tinear/vaxis

struct Text {
  content: Str,
  // Foreground color. -1 = terminal default.
  fg: Int,
  // Background color. -1 = terminal default.
  bg: Int,
  bold: Bool,
  dim: Bool,
  italic: Bool,
  underline: Bool,
  reverse: Bool,
}

impl view::View for Text {
  fn init(ctx: view::Context) {}

  fn handle_event(ctx: view::Context, event: vaxis::Event) {}

  fn render(mut frame: view::Frame) {
    // Draw a single line at (0, 0). Vaxis clips the right edge
    // automatically when content overruns the frame width.
    // Negative fg/bg values mean "terminal default"; all-defaults
    // styling is indistinguishable from plain text.
    //
    // The Frame's extent tracking captures the rendered_width
    // automatically — no separate measurement is needed.
    frame.draw_styled(
      0, 0, self.content,
      self.fg, self.bg,
      self.bold, self.dim, self.italic, self.underline, self.reverse,
    )
  }
}

// Construct a styled Text. Every styling field is optional and
// defaults to the terminal's default (colors) or false (attrs).
// Plain text is `text::new("hello")`; styled text uses named
// arguments: `text::new("hello", reverse: true)` or
// `text::new("hello", fg: 4, bold: true)`.
//
// Returns `view::View` rather than `Text` so the trait coercion
// happens here — inside the module that defines `impl View for
// Text`. The Ard checker does not currently coerce a concrete type
// to its trait across module boundaries at storage positions (only
// at function-argument positions), so view constructors must hand
// back already-trait-typed values for cross-module use.
fn new(
  content: Str,
  fg: Int?,
  bg: Int?,
  bold: Bool?,
  dim: Bool?,
  italic: Bool?,
  underline: Bool?,
  reverse: Bool?,
) view::View {
  let r_fg = match fg {
    v => v,
    _ => -1,
  }
  let r_bg = match bg {
    v => v,
    _ => -1,
  }
  let r_bold = match bold {
    v => v,
    _ => false,
  }
  let r_dim = match dim {
    v => v,
    _ => false,
  }
  let r_italic = match italic {
    v => v,
    _ => false,
  }
  let r_underline = match underline {
    v => v,
    _ => false,
  }
  let r_reverse = match reverse {
    v => v,
    _ => false,
  }
  Text{
    content: content,
    fg: r_fg,
    bg: r_bg,
    bold: r_bold,
    dim: r_dim,
    italic: r_italic,
    underline: r_underline,
    reverse: r_reverse,
  }
}
