// Rectangular region used throughout the framework.
//
// Coordinates are always in the local space of the Frame they're
// being used against — never absolute terminal coordinates. A widget
// addresses its own frame as `(0, 0)..(w, h)`; the position of the
// frame on the actual terminal is handled by `widget::sub` and the
// underlying vaxis subwindow.
//
// Helpers that return a new `Rect` (e.g. `inset`) are free functions
// rather than `impl Rect` methods because the Ard checker
// stack-overflows on impl methods that return their own struct
// type. See docs/adrs/0003-tui-framework.md.

struct Rect {
  x: Int,
  y: Int,
  w: Int,
  h: Int,
}

fn empty() Rect {
  Rect{x: 0, y: 0, w: 0, h: 0}
}

impl Rect {
  // True when (x, y) lies inside this rect.
  fn contains(x: Int, y: Int) Bool {
    x >= self.x and x < self.x + self.w and y >= self.y and y < self.y + self.h
  }

  // True when this rect has zero area.
  fn is_empty() Bool {
    self.w <= 0 or self.h <= 0
  }
}

// Returns a new rect inset by the given amounts on each side. The
// width and height clamp to zero rather than going negative — an
// over-inset rect collapses instead of inverting.
//
// (Free function rather than a `Rect` method: see file header.)
fn inset(self: Rect, top: Int, right: Int, bottom: Int, left: Int) Rect {
  let new_w = match self.w - left - right < 0 {
    true => 0,
    false => self.w - left - right,
  }
  let new_h = match self.h - top - bottom < 0 {
    true => 0,
    false => self.h - top - bottom,
  }
  Rect{x: self.x + left, y: self.y + top, w: new_w, h: new_h}
}
