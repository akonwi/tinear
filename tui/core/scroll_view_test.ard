use ard/testing

use tinear/tui/core/rect
use tinear/tui/core/scroll_view
use tinear/tui/core/stack
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/vaxis

private extern fn test_vaxis() vaxis::Vaxis = "TestVaxisNil"
private extern fn test_window(width: Int, height: Int) vaxis::Window = "TestWindow"
private extern fn test_line(y: Int) Str = "TestLine"
private extern fn test_cell_grapheme(x: Int, y: Int) Str = "TestCellGrapheme"

fn test_frame(width: Int, height: Int) view::Frame {
  let vx = test_vaxis()
  let ctx = view::context(vx)
  view::Frame{vx: vx, window: test_window(width, height), tree: ctx.tree, node_id: ctx.node_id, extent: rect::Rect{x: 0, y: 0, w: 0, h: 0}}
}

fn sample_content() view::View {
  stack::vstack(
    [
      text::new("one"),
      text::new("two"),
      text::new("three"),
      text::new("four"),
    ],
  )
}

test fn test_scroll_view_renders_initial_viewport() Void!Str {
  mut frame = test_frame(10, 2)

  scroll_view::new(sample_content()).render(frame)

  try testing::assert(test_line(0).starts_with("one"), "first row should show first content row, got '{test_line(0)}'")
  testing::assert(test_line(1).starts_with("two"), "second row should show second content row, got '{test_line(1)}'")
}

test fn test_scroll_view_offsets_child_vertically() Void!Str {
  mut frame = test_frame(10, 2)
  mut sv = scroll_view::new(sample_content())
  sv.scroll_down(1)

  sv.render(frame)

  try testing::assert(test_line(0).starts_with("two"), "first visible row should be second content row, got '{test_line(0)}'")
  try testing::assert(test_line(1).starts_with("three"), "second visible row should be third content row, got '{test_line(1)}'")
  testing::assert(test_cell_grapheme(9, 0) == "↑", "top-right should show upward overflow indicator")
}

test fn test_scroll_view_clamps_negative_offset() Void!Str {
  mut sv = scroll_view::new(sample_content())
  sv.scroll_down(3)
  sv.scroll_up(99)

  mut frame = test_frame(10, 2)
  sv.render(frame)

  testing::assert(test_line(0).starts_with("one"), "scroll_up should clamp at the top")
}
