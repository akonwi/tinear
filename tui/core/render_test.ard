use ard/testing

use tinear/tui/core/box
use tinear/tui/core/rect
use tinear/tui/core/stack
use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/vaxis

private extern fn test_vaxis() vaxis::Vaxis = "TestVaxisNil"
private extern fn test_window(width: Int, height: Int) vaxis::Window = "TestWindow"
private extern fn test_line(y: Int) Str = "TestLine"
private extern fn test_cell_grapheme(x: Int, y: Int) Str = "TestCellGrapheme"
private extern fn test_cell_reverse(x: Int, y: Int) Bool = "TestCellReverse"

fn test_frame(width: Int, height: Int) view::Frame {
  let vx = test_vaxis()
  let ctx = view::context(vx)
  view::Frame{vx: vx, window: test_window(width, height), tree: ctx.tree, node_id: ctx.node_id, extent: rect::Rect{x: 0, y: 0, w: 0, h: 0}}
}

test fn test_text_renders_into_test_frame() Void!Str {
  mut frame = test_frame(10, 2)

  text::new("hello").render(frame)

  try testing::assert(test_line(0) == "hello     ", "expected text on first line, got '{test_line(0)}'")
  testing::assert(test_cell_grapheme(1, 0) == "e", "expected second cell to be e")
}

test fn test_styled_text_records_reverse_attribute() Void!Str {
  mut frame = test_frame(10, 2)

  text::new("selected", reverse: true).render(frame)

  testing::assert(test_cell_reverse(0, 0), "expected reverse style on first cell")
}

test fn test_box_renders_border_and_child() Void!Str {
  mut frame = test_frame(12, 5)

  box::new(
    text::new("hi"),
    style::Style{
      border: style::BorderStyle::Single,
      padding: style::Padding::x(1),
    },
  ).render(frame)

  try testing::assert(test_cell_grapheme(0, 0) == "┌", "expected top-left border")
  try testing::assert(test_cell_grapheme(5, 2) == "┘", "expected bottom-right border")
  try testing::assert(test_cell_grapheme(2, 1) == "h", "expected child text inside box")
  testing::assert(test_cell_grapheme(3, 1) == "i", "expected child text inside box")
}

test fn test_hstack_places_children_horizontally() Void!Str {
  mut frame = test_frame(10, 2)

  stack::hstack([text::new("ab"), text::new("cd")]).render(frame)

  testing::assert(test_line(0).starts_with("abcd"), "hstack should render children side by side, got '{test_line(0)}'")
}

test fn test_vsplit_places_children_in_fixed_rows() Void!Str {
  mut frame = test_frame(10, 4)

  stack::vsplit(
    [
      stack::fixed(text::new("top"), 1),
      stack::fixed(stack::Spacer::v(1), 1),
      stack::fixed(text::new("body"), 1),
    ],
  ).render(frame)

  try testing::assert(test_line(0).starts_with("top"), "first split child should render at top")
  testing::assert(test_line(2).starts_with("body"), "third split child should render after spacer, got '{test_line(2)}'")
}

test fn test_subframes_clip_child_output() Void!Str {
  mut frame = test_frame(4, 2)

  text::new("abcdef").render(frame)

  testing::assert(test_line(0) == "abcd", "test window should clip text to frame width, got '{test_line(0)}'")
}
