use ard/testing as assertions

use cooper/box
use cooper/event
use cooper/runtime
use cooper/style
use cooper/testing
use cooper/text
use tinear/models/cache
use tinear/models/shell as shell_model
use tinear/models/tabs
use tinear/tui/shell_controller
use tinear/tui/theme

private struct ScreenState {
  focuses: Int,
  handled: Int,
  disposals: Int,
}

private struct Counter {
  value: Int,
}

private fn modifiers() event::Modifiers {
  event::Modifiers{
    shift: false,
    ctrl: false,
    alt: false,
    super: false,
  }
}

private fn key(value: Str) mut event::KeyEvent {
  event::key(value, value, event::KeyEventType::press, modifiers())
}

test fn tab_chips_use_intrinsic_width_with_a_document_cap() Void!Str {
  try assertions::assert(
    shell_controller::tab_chip_width("CCA-1782", true) == 12,
    "issue tabs should not reserve document-title width",
  )
  try assertions::assert(
    shell_controller::tab_chip_width("A very long document title that needs clipping", true) == 26,
    "long dynamic labels should retain the existing cap",
  )
  assertions::assert(
    shell_controller::tab_chip_width("Inbox", false) == 7,
    "permanent tabs should preserve their padding",
  )
}

private fn fake_screen(ctx: mut runtime::Runtime, label: Str, state: mut ScreenState) shell_controller::Screen {
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      flex_direction: style::FlexDirection::row,
    ),
  )
  root.set_focusable(true)
  root.add(text::new(ctx, content: label))
  shell_controller::Screen{
    root: root,
    focus: fn() {
      state.focuses =+ 1
      let _ = root.focus()
    },
    handle_key: fn(received: mut event::KeyEvent) Bool {
      if received.matches("x") {
        state.handled =+ 1
        true
      } else {
        false
      }
    },
    dispose: fn() {
      state.disposals =+ 1
    },
  }
}

private fn dynamic_factory(ctx: mut runtime::Runtime, created: mut Counter, disposed: mut Counter) fn(tabs::TabRef) shell_controller::Screen {
  fn(reference: tabs::TabRef) shell_controller::Screen {
    created.value =+ 1
    let state = mut ScreenState{
      focuses: 0,
      handled: 0,
      disposals: 0,
    }
    let base = fake_screen(ctx, "Detail {reference.title}", state)
    shell_controller::Screen{
      root: base.root,
      focus: base.focus,
      handle_key: base.handle_key,
      dispose: fn() {
        base.dispose()
        disposed.value =+ 1
      },
    }
  }
}

test fn shell_switches_persistent_tabs_and_persists_selection() Void!Str {
  let application = testing::new(80, 16)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let snapshots = mut List::new<cache::LoggedInCache>()
  let controller = shell_controller::new(
    application.context,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox body", inbox_state),
    fake_screen(application.context, "Board body", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {
      snapshots.push(value)
    },
    fn() {},
    fn() {},
    fn() {},
  )
  application.root.add(controller.root)
  application.render()
  try assertions::assert(
    controller.inbox.root.style().flex_direction == style::FlexDirection::row,
    "shell visibility changes must preserve the screen's own layout style",
  )
  try testing::assert_contains(application.frame().text(), "Inbox body")
  let active_tab = application.frame().cell(1, 0).expect("active Inbox tab")
  try assertions::assert(active_tab.grapheme == "I", "active tab label should remain readable")
  try assertions::assert(
    active_tab.style.foreground.expect("active tab accent").index.expect("host palette index") == Uint8::from(4),
    "active tab should use host accent",
  )
  try assertions::assert(
    active_tab.style.bold and (not active_tab.style.underline) and (not active_tab.style.reverse),
    "active tab should use accent and weight without underline or reverse video",
  )
  let top_rule = application.frame().cell(0, 1).expect("tab rule")
  try assertions::assert(
    top_rule.grapheme == "─" and top_rule.style.dim,
    "tab bar should end with a dim rule",
  )
  try assertions::assert(
    controller.board.root.style().display == style::Display::none,
    "board should stay mounted but hidden",
  )
  let first_hint = application.frame().cell(0, 15).expect("left-aligned footer hint")
  try assertions::assert(
    first_hint.grapheme == "T" and first_hint.style.bold,
    "footer key hints should begin at the left edge",
  )

  try assertions::assert(controller.handle_key(key("tab")), "Tab should switch views")
  application.render()
  try assertions::assert(controller.model.tab_index == 1, "Tab should select My Issues")
  let board_tab = application.frame().cell(8, 0).expect("active board tab")
  try assertions::assert(
    board_tab.style.bold and (not board_tab.style.underline) and (not board_tab.style.reverse),
    "selected board tab should follow Quiet Structure selection",
  )
  let board_hint = application.frame().cell(0, 15).expect("board footer hint")
  try assertions::assert(
    board_hint.grapheme == "←",
    "updated footer hints should remain left-aligned without a tab-title prefix",
  )
  try assertions::assert(board_state.focuses == 1, "new active screen should reclaim focus")
  try assertions::assert(snapshots.size() == 1, "selection should persist")
  try testing::assert_contains(application.frame().text(), "Board body")
  assertions::assert(
    controller.inbox.root.style().display == style::Display::none,
    "Inbox should remain mounted but hidden",
  )
}

test fn shell_restores_opens_reuses_retitles_and_closes_dynamic_tabs() Void!Str {
  let application = testing::new(100, 18)
  defer application.destroy()
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let fixed = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let restored_ref = tabs::doc_tab("doc-1", "Restored doc")
  let initial = shell_model::Model{tab_index: 0, tabs: [restored_ref]}
  let controller = shell_controller::new(
    application.context,
    theme::new(),
    initial,
    fake_screen(application.context, "Inbox", fixed),
    fake_screen(application.context, "Board", fixed),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {},
    fn() {},
  )
  application.root.add(controller.root)
  try assertions::assert(created.value == 1, "restored tab should create one retained controller")
  try assertions::assert(
    controller.dynamic_screens.at(0).expect("restored").screen.root.style().display == style::Display::none,
    "inactive restored tab should be hidden",
  )

  controller.select_tab(2)
  application.render()
  try testing::assert_contains(application.frame().text(), "Detail Restored doc")
  controller.open(tabs::doc_tab("doc-1", "ignored"))
  try assertions::assert(created.value == 1, "opening existing identity should reuse its controller")
  controller.retitle(restored_ref, "Renamed doc")
  application.render()
  try testing::assert_contains(application.frame().text(), "Renamed doc")

  try assertions::assert(controller.handle_key(key("escape")), "Escape should close dynamic tab")
  try assertions::assert(controller.model.tab_index == 1, "closing detail should return to board")
  try assertions::assert(controller.dynamic_screens.size() == 0, "closed controller should detach")
  assertions::assert(disposed.value == 1, "closed controller should dispose once")
}

test fn shell_routes_mouse_global_and_active_commands() Void!Str {
  let application = testing::new(80, 14)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let searches = mut Counter{value: 0}
  let creations = mut Counter{value: 0}
  let controller = shell_controller::new(
    application.context,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox", inbox_state),
    fake_screen(application.context, "Board", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {
      searches.value =+ 1
    },
    fn() {
      creations.value =+ 1
    },
  )
  application.root.add(controller.root)
  application.render()
  application.click(8, 0)
  try assertions::assert(controller.model.tab_index == 1, "clicking My Issues tab should select it")
  try assertions::assert(controller.handle_key(key("?")), "search should be globally handled")
  try assertions::assert(
    controller.handle_key(
      event::key(
        "?",
        "?",
        event::KeyEventType::press,
        event::Modifiers{
          shift: true,
          ctrl: false,
          alt: false,
          super: false,
        },
      ),
    ),
    "terminal question-mark events should be globally handled with Shift",
  )
  try assertions::assert(controller.handle_key(key("c")), "create should be globally handled")
  try assertions::assert(controller.handle_key(key("x")), "active screen should handle remaining keys")
  try assertions::assert(searches.value == 2, "both normalized search key shapes should run the callback")
  try assertions::assert(creations.value == 1, "create callback should run")
  try assertions::assert(board_state.handled == 1, "active board should receive delegated key")
  controller.open(tabs::issue_tab("AKO-1"))
  try assertions::assert(not controller.handle_key(key("c")), "detail tabs should own the c command")
  try assertions::assert(creations.value == 1, "detail c should not start issue creation")
  application.render()
  try assertions::assert(
    application.frame().cell(25, 0).expect("close button").grapheme == "×",
    "dynamic tab should render a close target",
  )
  application.click(25, 0)
  try assertions::assert(controller.model.tabs.size() == 0, "clicking × should close the tab")
  try assertions::assert(
    controller.model.tab_index == 1,
    "closing selected tab should return to My Issues",
  )
  assertions::assert(disposed.value == 1, "close button should dispose the dynamic screen")
}

test fn shell_disposal_cleans_screens_and_persistence_once() Void!Str {
  let application = testing::new(60, 12)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let persistence_disposals = mut Counter{value: 0}
  let controller = shell_controller::new(
    application.context,
    theme::new(),
    shell_model::Model{tab_index: 2, tabs: [tabs::issue_tab("AKO-1")]},
    fake_screen(application.context, "Inbox", inbox_state),
    fake_screen(application.context, "Board", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {
      persistence_disposals.value =+ 1
    },
    fn() {},
    fn() {},
  )
  application.root.add(controller.root)
  controller.dispose()
  controller.dispose()
  try assertions::assert(inbox_state.disposals == 1, "Inbox should dispose once")
  try assertions::assert(board_state.disposals == 1, "board should dispose once")
  try assertions::assert(disposed.value == 1, "dynamic screen should dispose once")
  assertions::assert(persistence_disposals.value == 1, "persistence worker should dispose once")
}
