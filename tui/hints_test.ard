use ard/testing

use tinear/tui/hints
use tinear/tui/ui/test as uitest

test fn test_hints_bar_renders_labels_with_spacing() Void!Str {
  let app = uitest::app(hints::bar(["↑↓ select", "r refresh", "q quit"]))
  app.pump(40, 1)

  try testing::assert(app.contains("↑↓ select"), "should render first hint")
  try testing::assert(app.contains("r refresh"), "should render second hint")
  testing::assert(app.contains("q quit"), "should render third hint")
}
