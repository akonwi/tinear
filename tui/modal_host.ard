use cooper
use cooper/cui
use cooper/cui/renderer
use cooper/ui
use tinear/tui/cui_bridge
use tinear/tui/theme as tinear_theme

struct Ticket {
  generation: Int,
}

// Shared state described by the Host component and owned by the facade.
struct Model {
  open: Bool,
  title: Str,
  footer: Str,
  body: (mut ui::Box)?,
  body_dispose: fn(),
  body_attached: fn(),
  generation: Int,
}

// Per-presentation record. `attached` reports whether the bridge committed;
// replaced or closed bodies that never mounted must dispose eagerly because
// CUI never owned them.
struct Current {
  body: mut ui::Box,
  dispose: fn(),
  restore_focus: fn(),
  can_dismiss: fn() Bool,
  attached: Bool,
}

private struct HostProps {
  model: mut Model,
}

private struct Host {
  props: mut HostProps,
  frame: mut cui::BoxRef,
  palette: tinear_theme::Theme,
}

private fn root_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    position: ui::Position::absolute,
    left: ui::cells(0),
    top: ui::cells(0),
    width: ui::percent(100.0),
    height: ui::percent(100.0),
    align_items: ui::Align::center,
    justify_content: ui::Justify::center,
    z_index: 1000,
  )
}

struct ModalHost {
  model: mut Model,
  cui: renderer::Renderer,
  current: (mut Current)?,
  generation: Int,
  presented: Bool,
  disposed: Bool,
  palette: tinear_theme::Theme,
}

private fn host_factory(palette: tinear_theme::Theme) fn(mut HostProps) mut Host {
  fn(props: mut HostProps) mut Host {
    (mut Host{props: props, frame: cui::box_ref(), palette: palette})
  }
}

impl cui::Component for Host {
  fn mut render() cui::View {
    let model = self.props.model
    let children = mut List::new<cui::View>()
    if model.open {
      let frame_children = mut List::new<cui::View>()
      frame_children.push(cui::text(model.title, text_style: ui::text_style(bold: true)))
      match model.body {
        body => {
          let frame = self.frame
          let attached = model.body_attached
          frame_children.push(
            cui_bridge::view(
              body,
              model.body_dispose,
              fn() {
                // The full-screen layer wins hit testing; the frame is the
                // keyboard fallback while modal content chooses its own focus.
                match frame.current {
                  panel => {
                    let _ = panel.focus()
                  },
                  _ => (),
                }
                attached()
              },
              key: "body-{model.generation}",
            ),
          )
        },
        _ => (),
      }
      frame_children.push(cui::text(model.footer, text_style: ui::text_style(dim: true)))
      children.push(
        cui::box(
          frame_children.@,
          ref: self.frame,
          // A described key handler keeps the frame focusable across commits.
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {},
          styles: ui::style(
            width: ui::percent(70.0),
            max_width: ui::cells(72),
            max_height: ui::percent(80.0),
            background: self.palette.background,
            border: ui::Border::rounded,
            border_color: self.palette.accent,
            flex_direction: ui::FlexDirection::column,
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(1),
              bottom: ui::cells(0),
              left: ui::cells(1),
            },
            gap: ui::cells(1),
          ),
        ),
      )
    }
    let display = match model.open {
      true => ui::Display::flex,
      false => ui::Display::none,
    }
    cui::box(
      children.@,
      styles: root_style(display),
      on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
        received.stop_propagation()
      },
    )
  }
}

fn new(ctx: mut cooper::Runtime, root: mut cooper::Root, palette: tinear_theme::Theme) mut ModalHost {
  let model = mut Model{
    open: false,
    title: "",
    footer: "",
    body: Maybe::new<mut ui::Box>(),
    body_dispose: fn() {},
    body_attached: fn() {},
    generation: 0,
  }
  let mounted = renderer::mount(
    ctx,
    root,
    cui::child(host_factory(palette), HostProps{model: model}),
  )
  (mut ModalHost{
    model: model,
    cui: mounted,
    current: Maybe::new<mut Current>(),
    generation: 0,
    presented: false,
    disposed: false,
    palette: palette,
  })
}

impl ModalHost {
  fn is_open() Bool {
    self.presented
  }

  fn is_current(ticket: Ticket) Bool {
    self.presented and ticket.generation == self.generation
  }

  // Retire the active body. CUI runs the dispose path for committed bodies;
  // bodies that never reached a commit are disposed eagerly here.
  private fn mut clear_current() {
    let old = self.current
    self.current = Maybe::new<mut Current>()
    self.presented = false
    self.cui.update(fn() {
      self.model.open = false
      self.model.body = Maybe::new<mut ui::Box>()
      self.model.body_dispose = fn() {}
      self.model.body_attached = fn() {}
    })
    match old {
      previous => {
        if not previous.attached {
          (previous.dispose)()
          previous.body.destroy(recursive: true)
        }
      },
      _ => (),
    }
  }

  fn mut present(
    title: Str,
    body: mut ui::Box,
    footer: Str,
    dispose: fn(),
    initial_focus: fn(),
    restore_focus: fn(),
    can_dismiss: fn() Bool,
  ) Ticket {
    if self.presented {
      self.clear_current()
    }
    self.generation =+ 1
    let generation = self.generation
    let current = mut Current{
      body: body,
      dispose: dispose,
      restore_focus: restore_focus,
      can_dismiss: can_dismiss,
      attached: false,
    }
    self.current = Maybe::new(current)
    self.presented = true
    self.cui.update(fn() {
      self.model.open = true
      self.model.title = title
      self.model.footer = footer
      self.model.body = Maybe::new(body)
      self.model.body_dispose = dispose
      self.model.body_attached = fn() {
        current.attached = true
        initial_focus()
      }
      self.model.generation = generation
    })
    Ticket{generation: generation}
  }

  // Retitle the open modal without replacing its body.
  fn mut set_chrome(title: Str, footer: Str) {
    if self.presented {
      self.cui.update(fn() {
        self.model.title = title
        self.model.footer = footer
      })
    }
  }

  fn mut close() Bool {
    if not self.presented {
      false
    } else {
      self.generation =+ 1
      let closing_generation = self.generation
      let restore = match self.current {
        current => current.restore_focus,
        _ => fn() {},
      }
      self.clear_current()
      if (not self.presented) and self.generation == closing_generation {
        restore()
      }
      true
    }
  }

  fn mut dismiss() Bool {
    if not self.presented {
      false
    } else {
      let allowed = match self.current {
        current => (current.can_dismiss)(),
        _ => true,
      }
      if allowed {
        self.close()
      } else {
        false
      }
    }
  }

  fn mut close_if_current(ticket: Ticket) Bool {
    if self.is_current(ticket) {
      self.close()
    } else {
      false
    }
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      match self.current {
        current => {
          if not current.attached {
            (current.dispose)()
            current.body.destroy(recursive: true)
          }
        },
        _ => (),
      }
      self.current = Maybe::new<mut Current>()
      self.presented = false
      // Retires the committed body bridge, running its dispose path.
      self.cui.destroy()
    }
  }
}
