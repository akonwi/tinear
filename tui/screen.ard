use tinear/vaxis

// Per-frame layout box. Parents compute this each frame and pass it
// to a component's draw method. Components never store layout
// themselves — only persistent state lives in their structs.
struct Layout {
  x: Int,
  y: Int,
  width: Int,
  height: Int,
}

// ---- terminal geometry -------------------------------------------------

fn term_height(vx: vaxis::Vaxis) Int {
  let win = vaxis::root(vx)
  vaxis::window_height(win)
}

fn term_width(vx: vaxis::Vaxis) Int {
  let win = vaxis::root(vx)
  vaxis::window_width(win)
}

// Row index of the bottom status bar line.
fn status_bar_y(vx: vaxis::Vaxis) Int {
  let h = term_height(vx)
  h - 1
}

// Rows available for tab content (between tab bar and status bar).
fn content_height(vx: vaxis::Vaxis) Int {
  term_height(vx) - 4
}

// Width of the inbox sidebar in split detail view. Clamped between
// 28 and 44 columns, otherwise 35% of terminal width.
fn sidebar_width(vx: vaxis::Vaxis) Int {
  let w = term_width(vx)
  let s = w * 35 / 100
  match s < 28 {
    true => 28,
    false => match s > 44 {
      true => 44,
      false => s,
    },
  }
}
