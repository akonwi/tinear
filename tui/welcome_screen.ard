use go:go.rockorager.dev/vaxis/ui
use tinear/config
use go:tinear/ffi
use tinear/linear/client

struct State {
  draft_api_key: Str,
  has_error: Bool,
}

// Validate the API key against Linear and, on success, persist it
// to the on-disk config. Returns Void!Str so callers can branch on
// ok / err without caring about the viewer payload.
fn validate_and_save(api_key: Str) Void!Str {
  let validate_query = "query \{ viewer \{ id \} \}"
  match client::graphql(api_key, validate_query) {
    ok(_) => {
      let _ = try config::write(api_key)
      Result::ok(())
    },
    err(e) => Result::err("Invalid API key: {e}"),
  }
}

fn bold() ui::Style {
  ui::Style{Attribute: ui::AttrBold}
}

fn logo_lines() [ui::Widget] {
  mut lines: [ui::Widget] = [
    ui::Text{Value: "▀█▀ ▀ █▀█ █▀▀ ▄▀█ █▀█", Style: bold()},
    ui::Text{Value: " █  █ █ █ ██▄ █▀█ █▀▄", Style: bold()},
  ]
  lines
}

fn spacer(height: Int) ui::Widget {
  ui::SizedBox{Height: height}
}

fn set_draft(c: mut ffi::StateCtx, value: Str) {
  ffi::Update<State>(
    c,
    fn(s: mut State) {
      s.draft_api_key = value
      s.has_error = false
    },
  )
}

fn set_error(c: mut ffi::StateCtx) {
  ffi::Update<State>(
    c,
    fn(s: mut State) {
      s.has_error = true
    },
  )
}

fn submit_login(c: mut ffi::StateCtx, api_key: Str, on_login_success: fn(Str)) {
  match api_key.is_empty() {
    true => set_error(c),
    false => {
      match validate_and_save(api_key) {
        ok(_) => on_login_success(api_key),
        err(_) => set_error(c),
      }
    },
  }
}

fn form(c: mut ffi::StateCtx, theme: ui::Theme, model: State, on_login_success: fn(Str)) ui::Widget {
  let children = mut logo_lines()
  children.push(spacer(2))
  children.push(ui::Text{Value: "Enter your Linear API key"})
  children.push(spacer(1))
  children.push(
    ui::TextField{
      Value: model.draft_api_key,
      Placeholder: "Paste Linear API key",
      MinWidth: 48,
      OnChanged: fn(ev: ui::EventContext, value: Str) {
        set_draft(c, value)
      },
      OnSubmitted: fn(ev: ui::EventContext, value: Str) {
        submit_login(c, value, on_login_success)
      },
    },
  )
  children.push(spacer(1))
  children.push(
    ui::Button{
      Label: "Login",
      OnPressed: fn(ev: ui::EventContext) {
        submit_login(c, ffi::StateValue<State>(c).draft_api_key, on_login_success)
      },
    },
  )
  if model.has_error {
    children.push(spacer(1))
    children.push(ui::Text{Value: "Invalid API token", Style: ui::Style{Foreground: theme.DangerText}})
  }
  ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    CrossAxisAlignment: ui::CrossAxisCenter,
    Children: deref children,
  }
}

fn new(on_login_success: fn(Str)) ui::Widget {
  ffi::Stateful{
    Init: fn() Any {
      State{draft_api_key: "", has_error: false}
    },
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      let theme = ui::MustDepend<ui::Theme>(ctx)
      form(c, theme, ffi::StateValue<State>(c), on_login_success)
    },
  }
}
