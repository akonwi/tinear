use tinear/tui/ui

fn logo_lines() [ui::Widget] {
  [
    ui::text("▀█▀ ▀ █▀█ █▀▀ ▄▀█ █▀█", style: ui::style(bold: true)),
    ui::text(" █  █ █ █ ██▄ █▀█ █▀▄", style: ui::style(bold: true)),
  ]
}

fn submit_login(state: ui::State, on_login: fn(Str) Bool, api_key: Str) {
  match api_key.is_empty() {
    true => state.set("error", true),
    false => {
      let ok = on_login(api_key)
      state.set("error", not ok)
      if ok {
        state.set("api_key", api_key)
        state.set("authed", true)
      }
    },
  }
}

fn new(state: ui::State, on_login: fn(Str) Bool) ui::Widget {
  let api_key = state.get<Str>("api_key").or("")
  let has_error = state.get<Bool>("error").or(false)
  mut children = logo_lines()
  children.push(ui::sized_box(0, 2))
  children.push(ui::text("Enter your Linear API key"))
  children.push(ui::sized_box(0, 1))
  children.push(ui::text_field(
    value: api_key,
    placeholder: "Paste Linear API key",
    min_width: 48,
    obscure: false,
    on_changed: fn(_event_ctx: ui::EventContext, value: Str) {
      state.set("api_key", value)
      state.set("error", false)
    },
    on_submitted: fn(_event_ctx: ui::EventContext, value: Str) {
      submit_login(state: state, on_login: on_login, api_key: value)
    },
  ))
  children.push(ui::sized_box(0, 1))
  children.push(ui::button("Login", fn(_event_ctx: ui::EventContext) {
    submit_login(state: state, on_login: on_login, api_key: state.get<Str>("api_key").or(""))
  }))
  if has_error {
    children.push(ui::sized_box(0, 1))
    children.push(ui::text("Invalid API token"))
  }
  ui::center(ui::padding_all(1, ui::column_min(children)))
}
