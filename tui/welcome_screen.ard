use tinear/tui/core/stack
use tinear/tui/core/view
use tinear/tui/input
use tinear/vaxis

struct WelcomeScreen {
  input: input::Input,
}

fn centered_y(mut frame: view::Frame, height: Int) Int {
  let raw = (frame.height() - height) / 2
  match raw < 0 {
    true => 0,
    false => raw,
  }
}

fn centered_width(mut frame: view::Frame, desired: Int) Int {
  match desired > frame.width() {
    true => frame.width(),
    false => desired,
  }
}

struct CenteredText {
  content: Str,
  bold: Bool,
}

impl view::View for CenteredText {
  fn render(mut frame: view::Frame) {
    let raw_x = (frame.width() - frame.rendered_width(self.content)) / 2
    let x = match raw_x < 0 {
      true => 0,
      false => raw_x,
    }
    frame.draw_styled(x, 0, self.content, -1, -1, self.bold, false, false, false, false)
  }
}

fn centered_text(content: Str, bold: Bool) view::View {
  CenteredText{content: content, bold: bold}
}

struct CenteredInput {
  input: input::Input,
  width: Int,
}

impl view::View for CenteredInput {
  fn render(mut frame: view::Frame) {
    let input_w = centered_width(frame, self.width)
    let raw_x = (frame.width() - input_w) / 2
    let input_x = match raw_x < 0 {
      true => 0,
      false => raw_x,
    }
    stack::hstack([stack::Spacer::h(input_x), self.input]).render(frame)
  }
}

impl WelcomeScreen {
  fn mut handle_key(key: vaxis::KeyEvent) {
    self.input.handle_key(key)
  }

  fn mut handle_event(event: vaxis::Event) {
    self.input.handle_event(event)
  }
}

impl view::View for WelcomeScreen {
  fn render(mut frame: view::Frame) {
    let top = centered_y(frame, 10)
    let content = stack::vstack(
      [
        stack::Spacer::v(top),
        centered_text("▀█▀ ▀ █▀█ █▀▀ ▄▀█ █▀█", true),
        centered_text(" █  █ █ █ ██▄ █▀█ █▀▄", true),
        stack::Spacer::v(2),
        centered_text("Enter your Linear API key", true),
        CenteredInput{input: self.input, width: 32},
      ],
    )

    content.render(frame)
  }
}

fn new() WelcomeScreen {
  WelcomeScreen{input: input::new("Paste Linear API key")}
}
