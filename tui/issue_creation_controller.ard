use cooper
use cooper/cui
use cooper/ui
use tinear/models/issues
use tinear/services/issue_creation_service
use tinear/tui/modal_host
use tinear/tui/picker_controller
use tinear/tui/theme as tinear_theme

private fn begin_submission(guard: Chan<Bool>) Bool {
  select {
    guard.sender().send(true) => true,
    _ => false,
  }
}

private fn clear_submission(guard: Chan<Bool>) {
  select {
    guard.receiver().recv() => (),
    _ => (),
  }
}

fn submission_active(guard: Chan<Bool>) Bool {
  mut active = false
  select {
    guard.receiver().recv() => {
      active = true
      guard.sender().send(true)
    },
    _ => (),
  }
  active
}

private fn submit_chord(received: mut cooper::KeyEvent) Bool {
  received.matches("return", ctrl: true) or received.matches("m", ctrl: true) or received.matches("j", ctrl: true)
}

enum Stage {
  loading,
  picker,
  form,
}

// Which form field holds focus. Describing focus with state keeps it stable
// across rerenders instead of fighting reconciliation.
enum FormFocus {
  title,
  description,
}

struct CreationProps {
  palette: tinear_theme::Theme,
  service: issue_creation_service::Service,
  submit_guard: Chan<Bool>,
  set_chrome: fn(Str, Str),
  close_with_error: fn(Str),
  notify: fn(Str, Str, Bool),
  on_created: fn(Str),
  close: fn(),
}

struct Creation {
  props: mut CreationProps,
  stage: Stage,
  teams: [issues::Team],
  selected_team: issues::Team?,
  title_value: Str,
  description_value: Str,
  status: Str,
  status_danger: Bool,
  focus_field: FormFocus,
  request: Int,
  stop: Chan<Bool>,
  context_handle: cui::Context?,
  title_field: mut cui::InputRef,
  description_field: mut cui::TextAreaRef,
}

private fn creation(props: mut CreationProps) mut Creation {
  (mut Creation{
    props: props,
    stage: Stage::loading,
    teams: [],
    selected_team: Maybe::new<issues::Team>(),
    title_value: "",
    description_value: "",
    status: "",
    status_danger: false,
    focus_field: FormFocus::title,
    request: 0,
    stop: Chan::new<Bool>(),
    context_handle: Maybe::new<cui::Context>(),
    title_field: cui::input_ref(),
    description_field: cui::text_area_ref(),
  })
}

impl Creation {
  private fn mut set_status(message: Str, danger: Bool) {
    self.status = message
    self.status_danger = danger
  }

  private fn mut show_form(team: issues::Team, ctx: cui::Context) {
    self.selected_team = Maybe::new(team)
    self.stage = Stage::form
    self.focus_field = FormFocus::title
    (self.props.set_chrome)(
      "New issue — {team.name}",
      "Tab next field   Ctrl+Enter create   Esc cancel",
    )
  }

  private fn mut show_team_picker(teams: [issues::Team]) {
    self.teams = teams
    self.stage = Stage::picker
    (self.props.set_chrome)(
      "New issue — choose team",
      "↑↓ select   Enter confirm   Esc cancel",
    )
  }

  private fn mut finish_create(result: Str!Str) {
    clear_submission(self.props.submit_guard)
    match result {
      ok(identifier) => {
        (self.props.notify)("Issue created", identifier, true)
        let trimmed = identifier.trim()
        (self.props.close)()
        if not trimmed.is_empty() {
          (self.props.on_created)(trimmed)
        }
      },
      err(message) => self.set_status(message, true),
    }
  }

  private fn mut submit(ctx: cui::Context) {
    let title = self.title_value.trim()
    if title.is_empty() {
      self.set_status("Title is required", true)
    } else {
      match self.selected_team {
        team => {
          if begin_submission(self.props.submit_guard) {
            self.set_status("Creating…", false)
            let description = self.description_value
            self.request =+ 1
            let request = self.request
            let dispatch = ctx.dispatch
            (self.props.service.create_issue)(
              self.stop.receiver(),
              team.id,
              title,
              description,
              fn(result: Str!Str) {
                let _ = dispatch(fn() {
                  if self.request == request {
                    self.finish_create(result)
                    ctx.invalidate_root()
                  }
                })
              },
            )
          }
        },
        _ => self.set_status("Select a team", true),
      }
    }
  }

  private fn mut handle_form_key(received: mut cooper::KeyEvent, ctx: cui::Context) {
    if received.event_type != cooper::KeyEventType::release {
      if submission_active(self.props.submit_guard) {
        received.prevent_default()
        received.stop_propagation()
      } else if submit_chord(received) {
        self.submit(ctx)
        received.prevent_default()
        received.stop_propagation()
      }
    }
  }

  private fn mut swap_focus(to_description: Bool) {
    self.focus_field = match to_description {
      true => FormFocus::description,
      false => FormFocus::title,
    }
  }

  private fn mut handle_field_key(
    received: mut cooper::KeyEvent,
    ctx: cui::Context,
    to_description: Bool,
  ) {
    if received.event_type != cooper::KeyEventType::release and (received.matches("tab") or received.matches("tab", shift: true)) and (not submission_active(self.props.submit_guard)) {
      self.swap_focus(to_description)
      received.prevent_default()
      received.stop_propagation()
    } else {
      self.handle_form_key(received, ctx)
    }
  }
}

impl cui::Lifecycle for Creation {
  fn mut mounted(ctx: cui::Context) {
    self.context_handle = Maybe::new(ctx)
    (self.props.set_chrome)("New issue", "Esc cancel")
    self.request =+ 1
    let request = self.request
    let dispatch = ctx.dispatch
    (self.props.service.load_teams)(self.stop.receiver(), fn(result: [issues::Team]!Str) {
      let _ = dispatch(fn() {
        if self.request == request {
          match result {
            ok(teams) => {
              match teams.size() {
                0 => (self.props.close_with_error)("No teams found in this workspace"),
                1 => self.show_form(teams.at(0).expect("one team"), ctx),
                _ => self.show_team_picker(teams),
              }
            },
            err(message) => (self.props.close_with_error)(message),
          }
          ctx.invalidate_root()
        }
      })
    })
  }

  fn mut unmounting(ctx: cui::Context) {
    self.stop.close()
  }
}

impl cui::Component for Creation {
  fn mut render() cui::View {
    match self.stage {
      Stage::loading => {
        cui::box(
          [cui::text("Loading teams…", selectable: false, text_style: ui::text_style(dim: true))],
          styles: ui::style(
            width: ui::percent(100.0),
            height: ui::cells(3),
            align_items: ui::Align::center,
            justify_content: ui::Justify::center,
          ),
        )
      },
      Stage::picker => {
        let options = mut List::new<picker_controller::Option>()
        for team in self.teams {
          options.push(
            picker_controller::Option{
              id: team.id,
              label: "{team.name} ({team.key})",
              description: "",
            },
          )
        }
        let teams = self.teams
        picker_controller::view(
          self.props.palette,
          "Filter teams",
          options.@,
          "",
          fn(option: picker_controller::Option) {
            for team in teams {
              if team.id == option.id {
                match self.context_handle {
                  ctx => self.show_form(team, ctx),
                  _ => (),
                }
              }
            }
          },
          key: "team-picker",
        )
      },
      Stage::form => self.form_view(),
    }
  }
}

impl Creation {
  private fn mut form_view() cui::View {
    let row_style = ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0)
    cui::box(
      [
        cui::text(
          "Title",
          selectable: false,
          styles: row_style,
          text_style: ui::text_style(dim: true),
        ),
        cui::input(
          self.title_value,
          ref: self.title_field,
          placeholder: "Issue title…",
          styles: row_style,
          focused: self.focus_field == FormFocus::title,
          on_input: fn(value: Str, ctx: cui::Context) {
            if not submission_active(self.props.submit_guard) {
              self.title_value = value
              self.set_status("", false)
            }
          },
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
            self.handle_field_key(received, ctx, true)
          },
        ),
        cui::box([], styles: row_style),
        cui::text(
          "Description (optional)",
          selectable: false,
          styles: row_style,
          text_style: ui::text_style(dim: true),
        ),
        cui::text_area(
          self.description_value,
          ref: self.description_field,
          focused: self.focus_field == FormFocus::description,
          placeholder: "Add details…",
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(7), flex_shrink: 0.0),
          on_input: fn(value: Str, ctx: cui::Context) {
            if not submission_active(self.props.submit_guard) {
              self.description_value = value
            }
          },
          on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
            self.handle_field_key(received, ctx, false)
          },
        ),
        cui::text(
          self.status,
          selectable: false,
          styles: row_style,
          text_style: match self.status_danger {
            true => ui::text_style(foreground: self.props.palette.danger, bold: true),
            false => ui::text_style(dim: true),
          },
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(12),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

struct Controller {
  context: mut cooper::Runtime,
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: issue_creation_service::Service,
  restore_focus: fn(),
  notify: fn(Str, Str, Bool),
  on_created: fn(Str),
  current_ticket: modal_host::Ticket?,
  disposed: Bool,
}

fn new(
  ctx: mut cooper::Runtime,
  modal: mut modal_host::ModalHost,
  palette: tinear_theme::Theme,
  service: issue_creation_service::Service,
  restore_focus: fn(),
  notify: fn(Str, Str, Bool),
  on_created: fn(Str),
) mut Controller {
  (mut Controller{
    context: ctx,
    modal: modal,
    palette: palette,
    service: service,
    restore_focus: restore_focus,
    notify: notify,
    on_created: on_created,
    current_ticket: Maybe::new<modal_host::Ticket>(),
    disposed: false,
  })
}

impl Controller {
  private fn mut close_current() {
    match self.current_ticket {
      ticket => {
        let _ = self.modal.close_if_current(ticket)
      },
      _ => (),
    }
    self.current_ticket = Maybe::new<modal_host::Ticket>()
  }

  fn mut open() {
    if not self.disposed and not self.modal.is_open() {
      let submit_guard = Chan::new<Bool>(1)
      let view = cui::child(
        creation,
        CreationProps{
          palette: self.palette,
          service: self.service,
          submit_guard: submit_guard,
          set_chrome: fn(title: Str, footer: Str) {
            self.modal.set_chrome(title, footer)
          },
          close_with_error: fn(message: Str) {
            self.close_current()
            self.notify("New issue", message, false)
          },
          notify: self.notify,
          on_created: self.on_created,
          close: fn() {
            self.close_current()
          },
        },
        key: "creation",
      )
      let ticket = self.modal.present_view(
        "New issue",
        view,
        "Esc cancel",
        self.restore_focus,
        fn() Bool {
          not submission_active(submit_guard)
        },
      )
      self.current_ticket = Maybe::new(ticket)
    }
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      self.close_current()
    }
  }
}
