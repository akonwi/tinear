use ard/async
use ard/decode
use ard/duration
use ard/list as List
use ard/maybe

use tinear/linear/client
use tinear/os
use tinear/tui/api
use tinear/tui/board
use tinear/tui/components
use tinear/tui/decode as decode_utils
use tinear/tui/draw
use tinear/tui/issue_tab
use tinear/tui/modals
use tinear/tui/notifications
use tinear/tui/screen
use tinear/tui/state
use tinear/tui/text
use tinear/vaxis

// The TUI application: top-level draw routine plus the event/input
// loop. Holds run-time mutable state as locals in run_loop; an
// AppState snapshot is rebuilt each frame and passed (immutably)
// into draw_screen.

fn draw_screen(state: state::AppState) Void {
  let vx = state.vx
  vaxis::window_clear(vaxis::root(vx))

  draw::draw_tab_bar(vx, state.tabs, state.active_tab)

  if state.active_tab == 0 {
    notifications::draw_inbox_content(state)
  } else if state.active_tab == 1 {
    board::draw_board_content(state)
  } else {
    // Issue detail tab: active_tab - 2 indexes into issue_tabs.
    let idx = state.active_tab - 2
    if idx < state.issue_tabs.size() {
      issue_tab::draw_issue_tab(state, state.issue_tabs.at(idx))
    }
  }

  // Overlay pickers on top of whatever the active tab drew.
  match state.state_picker {
    p => modals::draw_state_picker(state.vx, p),
    _ => (),
  }
  match state.cycle_picker {
    p => modals::draw_cycle_picker(state.vx, p),
    _ => (),
  }

  // The composer takes precedence over the pickers (they shouldn't
  // be open at the same time, but if they are this is the active
  // one).
  match state.comment_composer {
    c => modals::draw_comment_composer(state.vx, c),
    _ => vaxis::hide_cursor(state.vx),
  }

  vaxis::render(vx)
}

fn run_loop(api_key: Str, vx: vaxis::Vaxis) Void!Str {
  let viewer = try api::fetch_viewer(api_key)
  let viewer_id = decode::run(viewer, decode::field("id", decode::string)).expect("Missing id")
  let name = decode_utils::user_display_name(viewer)
  let email = decode::run(viewer, decode::field("email", decode::string)).expect("Missing email")

  let initial_notifs = try api::fetch_inbox(api_key)
  // Board fetch is best-effort; if it fails we still want the inbox.
  let initial_columns: [state::BoardColumn] = match api::fetch_board(api_key, viewer_id) {
    ok(cols) => cols,
    err(_) => [],
  }
  mut notifs = initial_notifs
  mut columns = initial_columns
  mut cursor = 0
  mut comment_cursor = 0
  mut board_col = 0
  mut board_row = 0
  mut board_scroll = 0
  mut issue_tabs: [state::IssueTab] = []
  mut detail_mode = false
  mut active_tab = 0
  mut state_picker: state::StatePicker? = maybe::none()
  mut cycle_picker: state::CyclePicker? = maybe::none()
  mut comment_composer: state::CommentComposer? = maybe::none()
  mut running = true

  // Background refresh: an Ard fiber owns the schedule. Every 5
  // minutes it posts a RedrawEvent into vaxis's event queue, which
  // wakes the main loop's blocking next_event call and lets it
  // refetch inbox + board. The fiber captures vx read-only (vaxis's
  // Go-side methods are thread-safe) and outlives this scope; the
  // process tears it down on exit.
  async::start(fn() {
    while {
      async::sleep(duration::from_minutes(5))
      vaxis::post(vx, vaxis::RedrawEvent{})
    }
  })

  while running {
    // Build the visible tabs list: two fixed + one per open issue tab.
    mut tabs = ["Inbox", "My Issues"]
    for it in issue_tabs {
      let id = decode::run(it.issue, decode::field("identifier", decode::string)).expect("Missing identifier")
      tabs.push(id)
    }
    let state = state::AppState{
      api_key: api_key,
      vx: vx,
      notifications: notifs,
      columns: columns,
      cursor: cursor,
      comment_cursor: comment_cursor,
      board_col: board_col,
      board_row: board_row,
      board_scroll: board_scroll,
      issue_tabs: issue_tabs,
      viewer_name: name,
      viewer_email: email,

      running: running,
      tabs: tabs,
      active_tab: active_tab,
      detail_mode: detail_mode,
      state_picker: state_picker,
      cycle_picker: cycle_picker,
      comment_composer: comment_composer,
    }
    draw_screen(state)

    let event = try vaxis::next_event(vx)

    match event {
      QuitEvent(_) => {
        running = false
      },
      ResizeEvent(_) => (),
      RedrawEvent(_) => {
        // Background refresh: refetch inbox + board silently. Try to
        // preserve the inbox selection by id (a notification may have
        // shifted index after archive/new arrivals); clamp board
        // cursors. Issue tabs are left alone — they refresh as a
        // side effect of mutations and the per-tab `r` key.
        let prev_selected_id = match notifs.size() > cursor {
          true => decode::run(notifs.at(cursor), decode::field("id", decode::string))
            .expect("Missing notif id"),
          false => "",
        }
        match api::fetch_inbox(api_key) {
          ok(nodes) => {
            notifs = nodes
            mut found = false
            if (not prev_selected_id.is_empty()) {
              for n, i in notifs {
                let nid = decode::run(n, decode::field("id", decode::string))
                  .expect("Missing notif id")
                if nid == prev_selected_id {
                  cursor = i
                  found = true
                }
              }
            }
            if (not found) {
              cursor = match notifs.size() == 0 {
                true => 0,
                false => match cursor >= notifs.size() {
                  true => notifs.size() - 1,
                  false => cursor,
                },
              }
              comment_cursor = 0
              detail_mode = false
            }
            ()
          },
          err(_) => (),
        }
        match api::fetch_board(api_key, viewer_id) {
          ok(cols) => {
            columns = cols
            if board_col >= columns.size() {
              board_col = match columns.size() == 0 {
                true => 0,
                false => columns.size() - 1,
              }
            }
            if columns.size() > 0 {
              let col_size = columns.at(board_col).issues.size()
              if board_row >= col_size {
                board_row = match col_size == 0 {
                  true => 0,
                  false => col_size - 1,
                }
              }
            }
            ()
          },
          err(_) => (),
        }
      },
      FocusEvent(_) => (),
      PasteEvent(_) => (),
      MouseEvent(_) => (),
      ColorThemeEvent(_) => (),
      KeyEvent(k) => {
        if k.ctrl and k.name == "c" {
          running = false
        } else if state_picker.is_some() {
          // PICKER MODE — intercepts everything until closed.
          // Match bindings are immutable, so copy once into `p` and
          // mutate that throughout this arm.
          match state_picker {
            picker => {
              mut p = picker
              if k.name == "Escape" {
                state_picker = maybe::none()
              } else if k.name == "Up" or k.name == "k" {
                if p.cursor > 0 {
                  p.cursor = p.cursor - 1
                  state_picker = maybe::some(p)
                }
              } else if k.name == "Down" or k.name == "j" {
                if p.cursor < p.states.size() - 1 {
                  p.cursor = p.cursor + 1
                  state_picker = maybe::some(p)
                }
              } else if k.name == "Enter" or k.name == "Space" {
                let target = p.states.at(p.cursor)
                let new_state_id = decode::run(target, decode::field("id", decode::string))
                  .expect("Missing state.id")
                if new_state_id == p.current_state_id {
                  // No change — just close.
                  state_picker = maybe::none()
                } else {
                  match api::update_issue_state(api_key, p.issue_id, new_state_id) {
                    ok(_) => {
                      // Refresh whichever view triggered the picker.
                      if p.from_board {
                        match api::fetch_board(api_key, viewer_id) {
                          ok(cols) => {
                            columns = cols
                            // Clamp board cursor in case the issue
                            // moved to a column at a different
                            // position.
                            if board_col >= columns.size() {
                              board_col = match columns.size() == 0 {
                                true => 0,
                                false => columns.size() - 1,
                              }
                            }
                            if columns.size() > 0 {
                              let col_size = columns.at(board_col).issues.size()
                              if board_row >= col_size {
                                board_row = match col_size == 0 {
                                  true => 0,
                                  false => col_size - 1,
                                }
                              }
                            }
                            ()
                          },
                          err(_) => (),
                        }
                      } else {
                        if p.tab_idx < issue_tabs.size() {
                          match api::fetch_single_issue(api_key, p.issue_id) {
                            ok(updated) => {
                              mut tab = issue_tabs.at(p.tab_idx)
                              tab.issue = updated
                              issue_tabs.set(p.tab_idx, tab)
                              ()
                            },
                            err(_) => (),
                          }
                        }
                      }
                      state_picker = maybe::none()
                      ()
                    },
                    err(_) => (),
                  }
                }
              } else {
                ()
              }
            },
            _ => (),
          }
        } else if cycle_picker.is_some() {
          // CYCLE PICKER MODE — cursor index 0 is "(no cycle)", real
          // cycles start at 1. Mirrors the state picker flow.
          match cycle_picker {
            picker => {
              mut p = picker
              let row_count = p.cycles.size() + 1
              if k.name == "Escape" {
                cycle_picker = maybe::none()
              } else if k.name == "Up" or k.name == "k" {
                if p.cursor > 0 {
                  p.cursor = p.cursor - 1
                  cycle_picker = maybe::some(p)
                }
              } else if k.name == "Down" or k.name == "j" {
                if p.cursor < row_count - 1 {
                  p.cursor = p.cursor + 1
                  cycle_picker = maybe::some(p)
                }
              } else if k.name == "Enter" or k.name == "Space" {
                let target_cycle_id = match p.cursor == 0 {
                  true => "",
                  false => {
                    let c = p.cycles.at(p.cursor - 1)
                    decode::run(c, decode::field("id", decode::string))
                      .expect("Missing cycle.id")
                  },
                }
                if target_cycle_id == p.current_cycle_id {
                  // No change — just close.
                  cycle_picker = maybe::none()
                } else {
                  match api::update_issue_cycle(api_key, p.issue_id, target_cycle_id) {
                    ok(_) => {
                      if p.from_board {
                        match api::fetch_board(api_key, viewer_id) {
                          ok(cols) => {
                            columns = cols
                            if board_col >= columns.size() {
                              board_col = match columns.size() == 0 {
                                true => 0,
                                false => columns.size() - 1,
                              }
                            }
                            if columns.size() > 0 {
                              let col_size = columns.at(board_col).issues.size()
                              if board_row >= col_size {
                                board_row = match col_size == 0 {
                                  true => 0,
                                  false => col_size - 1,
                                }
                              }
                            }
                            ()
                          },
                          err(_) => (),
                        }
                      } else {
                        if p.tab_idx < issue_tabs.size() {
                          match api::fetch_single_issue(api_key, p.issue_id) {
                            ok(updated) => {
                              mut tab = issue_tabs.at(p.tab_idx)
                              tab.issue = updated
                              issue_tabs.set(p.tab_idx, tab)
                              ()
                            },
                            err(_) => (),
                          }
                        }
                      }
                      cycle_picker = maybe::none()
                      ()
                    },
                    err(_) => (),
                  }
                }
              } else {
                ()
              }
            },
            _ => (),
          }
        } else if comment_composer.is_some() {
          // COMPOSER MODE — typed text goes into the buffer; Ctrl+↵
          // submits, Esc cancels. Match bindings are immutable so
          // copy once into `c` and mutate that throughout the arm.
          match comment_composer {
            comp => {
              mut c = comp
              if k.name == "Escape" {
                comment_composer = maybe::none()
              } else if k.ctrl and k.name == "Enter" {
                if (not c.body.is_empty()) {
                  match api::create_comment(api_key, c.issue_id, c.body) {
                    ok(_) => {
                      // Refetch this tab's comments and slot them in.
                      if c.tab_idx < issue_tabs.size() {
                        match api::fetch_issue_comments(api_key, c.issue_id) {
                          ok(cs) => {
                            mut tab = issue_tabs.at(c.tab_idx)
                            tab.comments_view.comments = cs
                            issue_tabs.set(c.tab_idx, tab)
                            ()
                          },
                          err(_) => (),
                        }
                      }
                      comment_composer = maybe::none()
                      ()
                    },
                    err(_) => (),
                  }
                }
              } else if k.name == "BackSpace" {
                c.body = vaxis::text_backspace(c.body)
                comment_composer = maybe::some(c)
              } else if k.name == "Enter" {
                c.body = c.body + "\n"
                comment_composer = maybe::some(c)
              } else if (not k.text.is_empty()) and (not k.ctrl) and (not k.alt) and (not k.meta) {
                // Typed text: append. Skips modifier combos so Ctrl+L
                // etc. don't accidentally insert characters.
                c.body = c.body + k.text
                comment_composer = maybe::some(c)
              } else {
                ()
              }
            },
            _ => (),
          }
        } else if k.name == "Tab" {
          let last = tabs.size() - 1
          if k.shift {
            active_tab = match active_tab == 0 {
              true => last,
              false => active_tab - 1,
            }
          } else {
            active_tab = match active_tab == last {
              true => 0,
              false => active_tab + 1,
            }
          }
          detail_mode = false
        } else if active_tab == 1 {
          // BOARD tab
          if k.name == "r" {
            match api::fetch_board(api_key, viewer_id) {
              ok(cols) => {
                columns = cols
                board_col = 0
                board_row = 0
                board_scroll = 0
                ()
              },
              err(_) => (),
            }
          } else if k.name == "Up" or k.name == "k" {
            if board_row > 0 {
              board_row = board_row - 1
            }
          } else if k.name == "Down" or k.name == "j" {
            if columns.size() > 0 {
              let col_size = columns.at(board_col).issues.size()
              if board_row < col_size - 1 {
                board_row = board_row + 1
              }
            }
          } else if k.name == "Left" or k.name == "h" {
            if board_col > 0 {
              board_col = board_col - 1
              // Clamp row to the new column's size.
              let new_size = columns.at(board_col).issues.size()
              if board_row >= new_size {
                board_row = new_size - 1
              }
              // Scroll left if cursor went off the left edge.
              if board_col < board_scroll {
                board_scroll = board_col
              }
            }
          } else if k.name == "Right" or k.name == "l" {
            if board_col < columns.size() - 1 {
              board_col = board_col + 1
              let new_size = columns.at(board_col).issues.size()
              if board_row >= new_size {
                board_row = new_size - 1
              }
              // Scroll right if cursor went off the right edge.
              let visible = board::board_visible_count(vx, columns.size())
              if board_col >= board_scroll + visible {
                board_scroll = board_col - visible + 1
              }
            }
          } else if k.name == "Enter" or k.name == "Space" {
            if columns.size() > 0 {
              let col = columns.at(board_col)
              if col.issues.size() > 0 {
                let selected = col.issues.at(board_row)
                let sel_id = decode::run(selected, decode::field("identifier", decode::string))
                  .expect("Missing identifier")
                let sel_uid = decode::run(selected, decode::field("id", decode::string))
                  .expect("Missing id")
                // Focus existing tab if this issue is already open.
                mut existing = -1
                for it, i in issue_tabs {
                  let tid = decode::run(it.issue, decode::field("identifier", decode::string))
                    .expect("Missing identifier")
                  if tid == sel_id and existing == -1 {
                    existing = i
                  }
                }
                if existing >= 0 {
                  active_tab = 2 + existing
                  ()
                } else {
                  // Fetch comments on demand; best-effort.
                  let comments: [Dynamic] = match api::fetch_issue_comments(api_key, sel_uid) {
                    ok(cs) => cs,
                    err(_) => [],
                  }
                  issue_tabs.push(state::IssueTab{
                    issue: selected,
                    section: 0,
                    active: false,
                    desc_view: components::Scrollview::new(),
                    comments_view: components::CommentList::new(comments),
                  })
                  active_tab = 2 + issue_tabs.size() - 1
                  ()
                }
              }
            }
          } else if k.name == "s" {
            // Open the status picker for the selected card.
            if columns.size() > 0 {
              let col = columns.at(board_col)
              if col.issues.size() > 0 {
                let selected = col.issues.at(board_row)
                match api::open_state_picker(api_key, selected, true, 0) {
                  ok(p) => {
                    state_picker = maybe::some(p)
                    ()
                  },
                  err(_) => (),
                }
              }
            }
          } else if k.name == "y" {
            // Open the cycle picker for the selected card.
            if columns.size() > 0 {
              let col = columns.at(board_col)
              if col.issues.size() > 0 {
                let selected = col.issues.at(board_row)
                match api::open_cycle_picker(api_key, selected, true, 0) {
                  ok(p) => {
                    cycle_picker = maybe::some(p)
                    ()
                  },
                  err(_) => (),
                }
              }
            }
          } else {
            ()
          }
        } else if active_tab >= 2 {
          // ISSUE TAB
          let idx = active_tab - 2
          mut current = issue_tabs.at(idx)
          if k.name == "Escape" {
            if current.active {
              current.active = false
              issue_tabs.set(idx, current)
              ()
            } else {
              mut remaining: [state::IssueTab] = []
              for it, i in issue_tabs {
                if not (i == idx) {
                  remaining.push(it)
                }
              }
              issue_tabs = remaining
              active_tab = match active_tab > 0 {
                true => active_tab - 1,
                false => 0,
              }
              ()
            }
          } else if (k.name == "Enter" or k.name == "Space") and (not current.active) {
            current.active = true
            issue_tabs.set(idx, current)
            ()
          } else if k.name == "Up" or k.name == "k" {
            if current.active {
              if current.section == 0 {
                current.desc_view.scroll = current.desc_view.scroll - 1
                issue_tabs.set(idx, current)
                ()
              } else {
                current.comments_view.cursor = match current.comments_view.cursor > 0 {
                  true => current.comments_view.cursor - 1,
                  false => 0,
                }
                issue_tabs.set(idx, current)
                ()
              }
            } else {
              if current.section > 0 {
                current.section = 0
                issue_tabs.set(idx, current)
                ()
              }
            }
          } else if k.name == "Down" or k.name == "j" {
            if current.active {
              if current.section == 0 {
                current.desc_view.scroll = current.desc_view.scroll + 1
                issue_tabs.set(idx, current)
                ()
              } else {
                let last = current.comments_view.comments.size() - 1
                let new_cursor = match current.comments_view.cursor < last {
                  true => current.comments_view.cursor + 1,
                  false => last,
                }
                current.comments_view.cursor = match new_cursor < 0 {
                  true => 0,
                  false => new_cursor,
                }
                issue_tabs.set(idx, current)
                ()
              }
            } else {
              if current.section < 1 {
                current.section = 1
                issue_tabs.set(idx, current)
                ()
              }
            }
          } else if k.name == "g" and current.active {
            if k.shift {
              if current.section == 0 {
                current.desc_view.scroll = 999999
                issue_tabs.set(idx, current)
                ()
              } else {
                let last = current.comments_view.comments.size() - 1
                current.comments_view.cursor = match last < 0 {
                  true => 0,
                  false => last,
                }
                issue_tabs.set(idx, current)
                ()
              }
            } else {
              if current.section == 0 {
                current.desc_view.scroll = 0
                issue_tabs.set(idx, current)
                ()
              } else {
                current.comments_view.cursor = 0
                current.comments_view.top = 0
                issue_tabs.set(idx, current)
                ()
              }
            }
          } else if k.name == "r" {
            let issue_uid = decode::run(current.issue, decode::field("id", decode::string))
              .expect("Missing id")
            match api::fetch_issue_comments(api_key, issue_uid) {
              ok(cs) => {
                current.comments_view.comments = cs
                issue_tabs.set(idx, current)
                ()
              },
              err(_) => (),
            }
          } else if k.name == "s" and (not current.active) {
            // Open the status picker for this tab's issue.
            match api::open_state_picker(api_key, current.issue, false, idx) {
              ok(p) => {
                state_picker = maybe::some(p)
                ()
              },
              err(_) => (),
            }
          } else if k.name == "y" and (not current.active) {
            // Open the cycle picker for this tab's issue.
            match api::open_cycle_picker(api_key, current.issue, false, idx) {
              ok(p) => {
                cycle_picker = maybe::some(p)
                ()
              },
              err(_) => (),
            }
          } else if k.name == "c" and (not current.active) {
            // Open the comment composer for this tab's issue.
            let issue_uid = decode::run(current.issue, decode::field("id", decode::string))
              .expect("Missing id")
            let issue_ident = decode::run(current.issue, decode::field("identifier", decode::string))
              .expect("Missing identifier")
            comment_composer = maybe::some(state::CommentComposer{
              issue_id: issue_uid,
              issue_identifier: issue_ident,
              body: "",
              tab_idx: idx,
            })
          } else {
            ()
          }
        } else if k.name == "r" {
          match api::fetch_inbox(api_key) {
            ok(nodes) => {
              notifs = nodes
              cursor = 0
              comment_cursor = 0
              detail_mode = false
              ()
            },
            err(e) => {
              ()
            },
          }
        } else if k.name == "Enter" or k.name == "Space" {
          detail_mode = true
          comment_cursor = notifications::trigger_comment_index(notifs.at(cursor))
        } else if k.name == "Escape" {
          detail_mode = false
        } else if k.name == "BackSpace" {
          if notifs.size() > 0 {
            let target = notifs.at(cursor)
            let target_id = decode::run(target, decode::field("id", decode::string))
              .expect("Missing id")
            match api::archive_notification(api_key, target_id) {
              ok(_) => {
                notifs = List::keep(notifs, fn(n: Dynamic) Bool {
                  let nid = decode::run(n, decode::field("id", decode::string)).expect("Missing id")
                  not (nid == target_id)
                })
                if cursor >= notifs.size() {
                  if notifs.size() > 0 {
                    cursor = notifs.size() - 1
                  } else {
                    cursor = 0
                  }
                }
                detail_mode = false
                comment_cursor = 0
              },
              err(_) => (),
            }
          }
        } else if k.name == "o" and detail_mode {
          let selected = notifs.at(cursor)
          let sel_type = decode::run(selected, decode::field("type", decode::string)).expect("Missing type")
          if notifications::is_pr_comment_type(sel_type) {
            // Build the GitHub comment permalink from the PR URL and
            // comment id, since Linear's notification.url just points
            // back to the Linear inbox.
            let pr_obj = decode_utils::optional_field(selected, "pullRequest")
            let pr_url = match pr_obj {
              pr => decode::run(pr, decode::field("url", decode::string)).expect("Missing PR url"),
              _ => "",
            }
            let cid_opt = decode::run(selected, decode::field("pullRequestCommentId", decode::nullable(decode::string)))
              .expect("Missing pullRequestCommentId")
            let cid = match cid_opt {
              c => c,
              _ => "",
            }
            let target = match pr_url.is_empty() {
              true => "",
              false => match cid.is_empty() {
                true => pr_url,
                false => "{pr_url}#issuecomment-{cid}",
              },
            }
            if not target.is_empty() {
              let _ = os::open_url(target)
              ()
            }
          }
        } else if k.name == "Up" or k.name == "k" {
          if detail_mode {
            if comment_cursor > 0 {
              comment_cursor = comment_cursor - 1
            }
          } else {
            if cursor > 0 {
              cursor = cursor - 1
            }
          }
        } else if k.name == "Down" or k.name == "j" {
          if detail_mode {
            let max = notifications::notif_comments(notifs.at(cursor)).size() - 1
            if comment_cursor < max {
              comment_cursor = comment_cursor + 1
            }
          } else {
            let max = notifs.size() - 1
            if cursor < max {
              cursor = cursor + 1
            }
          }
        } else {
          ()
        }
      },
    }
  }

  Result::ok(())
}
