use ard/decode
use ard/testing

use tinear/models/issues
use tinear/tui/issue_detail_view
use tinear/tui/ui/test as uitest

fn test_issue_json(description: Str) Str {
  "\{\"id\":\"issue-1\",\"identifier\":\"AKO-123\",\"title\":\"Fix token refresh\",\"description\":{description},\"priority\":2,\"state\":\{\"id\":\"state-1\",\"name\":\"In Progress\",\"type\":\"started\",\"position\":1.0\},\"team\":\{\"id\":\"team-1\",\"name\":\"Core\",\"key\":\"AKO\"\},\"project\":\{\"name\":\"Auth Infra\"\},\"assignee\":\{\"name\":\"Jane Doe\",\"displayName\":\"Jane\"\},\"cycle\":\{\"id\":\"cycle-1\",\"number\":12,\"name\":\"Cycle 12\"\}\}"
}

fn test_issue() issues::Issue {
  let raw = decode::from_json(test_issue_json("null")).expect("parse test issue")
  issues::decode_issue(raw)
}

fn test_issue_with_description() issues::Issue {
  let raw = decode::from_json(test_issue_json("\"Refresh tokens should rotate before expiry so sessions remain active.\""))
    .expect("parse test issue with description")
  issues::decode_issue(raw)
}

fn test_issue_with_long_description() issues::Issue {
  let raw = decode::from_json(test_issue_json("\"line 1\\nline 2\\nline 3\\nline 4\\nhidden tail\""))
    .expect("parse test issue with long description")
  issues::decode_issue(raw)
}

fn test_comment(id: Str, author: Str, body: Str) issues::Comment {
  issues::Comment{id: id, author: author, created_at: "2026-01-02T03:04:05.000Z", body: body}
}

test fn test_issue_detail_header_renders_top_metadata() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue(), []))
  app.pump(80, 10)

  try testing::assert(app.contains("AKO-123"), "detail should render issue identifier")
  try testing::assert(app.contains("Fix token refresh"), "detail should render title")
  try testing::assert(app.contains("Status"), "detail should render status label")
  try testing::assert(app.contains("In Progress"), "detail should render status")
  try testing::assert(app.contains("Priority"), "detail should render priority label")
  try testing::assert(app.contains("High"), "detail should render priority")
  try testing::assert(app.contains("Assignee"), "detail should render assignee label")
  try testing::assert(app.contains("Jane"), "detail should render assignee")
  try testing::assert(app.contains("Cycle 12"), "detail should render cycle")
  testing::assert(app.contains("Auth Infra"), "detail should render project")
}

test fn test_issue_detail_renders_description() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue_with_description(), []))
  app.pump(80, 14)

  try testing::assert(app.contains("Description"), "detail should render description section")
  testing::assert(app.contains("Refresh tokens should rotate before expiry"), "detail should render description text")
}

test fn test_issue_detail_renders_empty_description_placeholder() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue(), []))
  app.pump(80, 14)

  testing::assert(app.contains("(no description)"), "detail should render empty description placeholder")
}

test fn test_issue_detail_renders_comments() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue_with_description(), [
    test_comment("comment-1", "Alice", "I hit this yesterday on the mobile app."),
    test_comment("comment-2", "Bob", "We should also log refresh attempts."),
  ]))
  app.pump(80, 20)

  try testing::assert(app.contains("Comments (2)"), "detail should render comment count")
  try testing::assert(app.contains("Alice"), "detail should render first comment author")
  try testing::assert(app.contains("2026-01-02"), "detail should render comment date")
  try testing::assert(app.contains("I hit this yesterday"), "detail should render first comment body")
  testing::assert(app.contains("Bob"), "detail should render second comment author")
}

test fn test_issue_detail_renders_empty_comments_placeholder() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue(), []))
  app.pump(80, 20)

  testing::assert(app.contains("(no comments)"), "detail should render empty comments placeholder")
}

test fn test_issue_detail_clips_long_description() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue_with_long_description(), []))
  app.pump(80, 11)

  try testing::assert(app.contains("line 1"), "detail should render visible description start")
  testing::assert(not app.contains("hidden tail"), "detail should clip overflowing description before footer area")
}

test fn test_issue_detail_opens_and_cancels_comment_composer() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue(), []))
  app.pump(80, 20)

  app.key("c")
  app.pump(80, 20)
  try testing::assert(app.contains("Ctrl+Enter send"), "composer should show send hint")

  app.escape()
  app.pump(80, 20)
  testing::assert(not app.contains("Ctrl+Enter send"), "Esc should close composer")
}

test fn test_issue_detail_comment_composer_autofocuses_textarea() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue(), []))
  app.pump(80, 20)

  app.key("c")
  app.pump(80, 20)
  app.key("h")
  app.key("i")
  app.pump(80, 20)

  testing::assert(app.contains("hi"), "typing after opening composer should enter text without clicking")
}

test fn test_issue_detail_scrolls_description_with_j() Void!Str {
  let app = uitest::app(issue_detail_view::with_comments(test_issue_with_long_description(), []))
  app.pump(80, 11)

  app.key("j")
  app.key("j")
  app.key("j")
  app.key("j")
  app.pump(80, 11)

  try testing::assert(not app.contains("line 1"), "j should scroll first description line out of view")
  testing::assert(app.contains("hidden tail"), "j should reveal lower description content")
}
