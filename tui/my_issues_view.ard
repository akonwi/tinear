use ard/async
use ard/decode
use ard/maybe

use tinear/models/issues
use tinear/tui/api
use tinear/tui/modal
use tinear/tui/state
use tinear/tui/text
use tinear/tui/ui

fn clamp(value: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    value < 0 => 0,
    value >= count => count - 1,
    _ => value,
  }
}

fn board_column_gap() Int { 3 }
fn board_column_width() Int { 30 }
fn board_visible_count(col_count: Int) Int {
  match col_count < 3 {
    true => col_count,
    false => 3,
  }
}

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out =+ ch
    }
  }
  out
}

fn visible_scroll(scroll: Int, selected: Int, visible_count: Int, col_count: Int) Int {
  let safe_visible = match visible_count < 1 {
    true => 1,
    false => visible_count,
  }
  let max_scroll = match col_count > safe_visible {
    true => col_count - safe_visible,
    false => 0,
  }
  let clamped = match scroll > max_scroll {
    true => max_scroll,
    false => match scroll < 0 {
      true => 0,
      false => scroll,
    },
  }

  let with_selected = match selected < clamped {
    true => selected,
    false => match selected >= clamped + safe_visible {
      true => selected - safe_visible + 1,
      false => clamped,
    },
  }

  match with_selected > max_scroll {
    true => max_scroll,
    false => match with_selected < 0 {
      true => 0,
      false => with_selected,
    },
  }
}

fn row_text(value: Str, selected: Bool) ui::Widget {
  match selected {
    true => ui::text(value, style: ui::style(reverse: true)),
    false => ui::text(value),
  }
}

fn card_body(issue: issues::Issue, selected: Bool, col_w: Int) ui::Widget {
  let cursor = match selected {
    true => "▸",
    false => " ",
  }
  let glyph = state::priority_glyph(issue.priority)
  let title_indent = "   "
  let title_w = col_w - 3
  let wrapped = text::wrap_title(issue.title, title_w)
  mut children = [
    row_text("{cursor}{glyph} {issue.identifier}", selected),
    row_text("{title_indent}{wrapped.line1}", selected),
  ]
  if not wrapped.line2.is_empty() {
    children.push(row_text("{title_indent}{wrapped.line2}", selected))
  }
  ui::column_stretch(children)
}

fn issue_card(issue: issues::Issue, selected: Bool, last: Bool, col_w: Int) ui::Widget {
  let first = match selected {
    true => ui::box(card_body(issue, selected, col_w), style: ui::style(reverse: true)),
    false => card_body(issue, selected, col_w),
  }
  mut children = [first]
  if not last {
    children.push(ui::text(repeat("━", col_w - 1)))
    children.push(ui::sized_box(0, 1))
  }
  ui::column_stretch(children)
}

fn board_column(col: issues::BoardColumn, col_idx: Int, selected_col: Int, selected_row: Int) ui::Widget {
  let col_w = board_column_width()
  let suffix = match col.state_type == "completed" {
    true => " · last 10",
    false => "",
  }
  let header = text::truncate_with_ellipsis("{col.name} ({col.issues.size()}){suffix}", col_w)
  mut children = [
    ui::text(header),
    ui::text(repeat("─", col_w - 1), style: ui::style(foreground: "border")),
    ui::sized_box(0, 1),
  ]
  let last_idx = col.issues.size() - 1
  for issue, row_idx in col.issues {
    children.push(issue_card(
      issue: issue,
      selected: col_idx == selected_col and row_idx == selected_row,
      last: row_idx == last_idx,
      col_w: col_w,
    ))
  }
  ui::constrained_width(col_w, ui::column_stretch(children))
}

fn board(columns: [issues::BoardColumn], selected_col: Int, selected_row: Int, scroll: Int) ui::Widget {
  let col_count = columns.size()
  let visible_count = board_visible_count(col_count)
  let start_col = visible_scroll(scroll, selected_col, visible_count, col_count)
  let end_excl = match start_col + visible_count > col_count {
    true => col_count,
    false => start_col + visible_count,
  }

  mut widgets: [ui::Widget] = []
  if start_col > 0 {
    widgets.push(ui::text("‹"))
  }
  for col, col_idx in columns {
    if col_idx >= start_col and col_idx < end_excl {
      if widgets.size() > 0 {
        widgets.push(ui::sized_box(board_column_gap(), 0))
      }
      widgets.push(board_column(col, col_idx, selected_col, selected_row))
    }
  }
  if end_excl < col_count {
    widgets.push(ui::sized_box(board_column_gap(), 0))
    widgets.push(ui::text("›"))
  }
  ui::focusable(ui::row(widgets))
}

fn selected_row_count(columns: [issues::BoardColumn], col: Int) Int {
  match columns.size() == 0 {
    true => 0,
    false => columns.at(clamp(col, columns.size())).issues.size(),
  }
}

fn selected_issue(columns: [issues::BoardColumn], col: Int, row: Int) issues::Issue? {
  match columns.size() == 0 {
    true => maybe::none(),
    false => {
      let safe_col = clamp(col, columns.size())
      let issues = columns.at(safe_col).issues
      match issues.size() == 0 {
        true => maybe::none(),
        false => maybe::some(issues.at(clamp(row, issues.size()))),
      }
    },
  }
}

fn state_picker_rows(picker: state::StatePicker) ui::Widget {
  mut rows: [ui::Widget] = []
  for s, i in picker.states {
    let sid = decode::run(s, decode::field("id", decode::string)).expect("Missing state.id")
    let sname = decode::run(s, decode::field("name", decode::string)).expect("Missing state.name")
    let cursor_mark = match i == picker.cursor {
      true => "▸",
      false => " ",
    }
    let current_suffix = match sid == picker.current_state_id {
      true => "  (current)",
      false => "",
    }
    rows.push(ui::text(" {cursor_mark} {sname}{current_suffix}"))
  }
  ui::column_stretch(rows)
}

fn cycle_picker_rows(picker: state::CyclePicker) ui::Widget {
  let row_count = picker.cycles.size() + 1
  mut rows: [ui::Widget] = []
  for r in 0..(row_count - 1) {
    let cursor_mark = match r == picker.cursor {
      true => "▸",
      false => " ",
    }
    mut label = ""
    if r == 0 {
      let suffix = match picker.current_cycle_id.is_empty() {
        true => "  (current)",
        false => "",
      }
      label = "(no cycle){suffix}"
    } else {
      let c = picker.cycles.at(r - 1)
      let number = decode::run(c, decode::field("number", decode::int)).expect("Missing cycle.number")
      let cid = decode::run(c, decode::field("id", decode::string)).expect("Missing cycle.id")
      let name_opt = decode::run(c, decode::field("name", decode::nullable(decode::string))).expect("Missing cycle.name")
      let base = match name_opt {
        n => n,
        _ => "Cycle {number}",
      }
      let suffix = match cid == picker.current_cycle_id {
        true => "  (current)",
        false => "",
      }
      label = "{base}{suffix}"
    }
    rows.push(ui::text(" {cursor_mark} {label}"))
  }
  ui::column_stretch(rows)
}

fn picker_footer() ui::Widget {
  ui::text("↑↓ select  ↵ confirm  Esc cancel")
}

fn state_picker_modal(picker: state::StatePicker, on_dismiss: fn(ui::EventContext)) ui::Widget {
  modal::dialog(
    title: "Status — {picker.issue_identifier} ({picker.team_name})",
    child: state_picker_rows(picker),
    footer: picker_footer(),
    width: 50,
    on_dismiss: on_dismiss,
  )
}

fn cycle_picker_modal(picker: state::CyclePicker, on_dismiss: fn(ui::EventContext)) ui::Widget {
  modal::dialog(
    title: "Cycle — {picker.issue_identifier} ({picker.team_name})",
    child: cycle_picker_rows(picker),
    footer: picker_footer(),
    width: 60,
    on_dismiss: on_dismiss,
  )
}

type StatePickerOption = state::StatePicker?
type CyclePickerOption = state::CyclePicker?

struct MyIssuesUiState {
  columns: [issues::BoardColumn],
  loading: Bool,
  loaded: Bool,
  error: Str,
  col: Int,
  row: Int,
  scroll: Int,
  state_picker: StatePickerOption,
  cycle_picker: CyclePickerOption,
}

fn initial_state() MyIssuesUiState {
  MyIssuesUiState{
    columns: [],
    loading: false,
    loaded: false,
    error: "",
    col: 0,
    row: 0,
    scroll: 0,
    state_picker: maybe::none(),
    cycle_picker: maybe::none(),
  }
}

fn base_content(columns: [issues::BoardColumn], loading: Bool, error: Str, col: Int, row: Int, scroll: Int) ui::Widget {
  if loading {
    ui::text("Loading my issues…")
  } else if not error.is_empty() {
    ui::text("Unable to load my issues", style: ui::style(bold: true))
  } else if columns.size() == 0 {
    ui::center(ui::text("No issues assigned to you."))
  } else {
    board(columns, col, row, scroll)
  }
}

fn content(columns: [issues::BoardColumn], loading: Bool, error: Str, col: Int, row: Int, scroll: Int, state_picker: StatePickerOption, cycle_picker: CyclePickerOption, on_picker_dismiss: fn(ui::EventContext)) ui::Widget {
  let base = base_content(columns: columns, loading: loading, error: error, col: col, row: row, scroll: scroll)
  match state_picker {
    p => ui::overlay_modal(base, state_picker_modal(p, on_picker_dismiss)),
    _ => match cycle_picker {
      p => ui::overlay_modal(base, cycle_picker_modal(p, on_picker_dismiss)),
      _ => base,
    },
  }
}

fn new(api_key: Str) ui::Widget {
  ui::stateful(
    key: "my-issues",
    init: fn(ctx: ui::BuildContext) MyIssuesUiState {
      let initial = initial_state()
      mut next = initial
      next.loading = true
      let rt = ctx.runtime()
      async::start(fn() {
        let result = issues::load(api_key)
        rt.dispatch(fn(state: ui::State) {
          state.set<MyIssuesUiState>(fn(mut loaded: MyIssuesUiState) {
            match result {
              ok(columns) => {
                loaded.columns = columns
                loaded.error = ""
              },
              err(e) => { loaded.error = e },
            }
            loaded.loaded = true
            loaded.loading = false
          })
        })
      })
      next
    },
    build: fn(ctx: ui::BuildContext, state: ui::State) ui::Widget {
      let model = state.value<MyIssuesUiState>()
      let rt = ctx.runtime()
      let col = clamp(model.col, model.columns.size())
      let row = clamp(model.row, selected_row_count(model.columns, col))
      let scroll = visible_scroll(
        model.scroll,
        col,
        board_visible_count(model.columns.size()),
        model.columns.size(),
      )
      ui::actions(
        child: ui::shortcuts(
          child: ui::focusable_key("tab.my_issues", content(
            columns: model.columns,
            loading: model.loading,
            error: model.error,
            col: col,
            row: row,
            scroll: scroll,
            state_picker: model.state_picker,
            cycle_picker: model.cycle_picker,
            on_picker_dismiss: fn(_ctx: ui::EventContext) {
              state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                next.state_picker = maybe::none()
                next.cycle_picker = maybe::none()
              })
            },
          )),
          bindings: [
            "Up": "my_issues.previous_row",
            "k": "my_issues.previous_row",
            "Down": "my_issues.next_row",
            "j": "my_issues.next_row",
            "Left": "my_issues.previous_col",
            "h": "my_issues.previous_col",
            "Right": "my_issues.next_col",
            "l": "my_issues.next_col",
            "Enter": "my_issues.open",
            "r": "my_issues.refresh",
            "s": "my_issues.open_state_picker",
            "y": "my_issues.open_cycle_picker",
            "Escape": "picker.dismiss",
            "Esc": "picker.dismiss",
            "Space": "picker.confirm",
          ],
        ),
        bindings: [
          ui::action("my_issues.previous_row", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
              match next.state_picker {
                p => {
                  if p.cursor > 0 {
                    p.cursor = p.cursor - 1
                    next.state_picker = maybe::some(p)
                  }
                },
                _ => match next.cycle_picker {
                  p => {
                    if p.cursor > 0 {
                      p.cursor = p.cursor - 1
                      next.cycle_picker = maybe::some(p)
                    }
                  },
                  _ => { next.row = clamp(row - 1, selected_row_count(model.columns, col)) },
                },
              }
            })
            ui::EventResult::handled
          }),
          ui::action("my_issues.next_row", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
              match next.state_picker {
                p => {
                  if p.cursor < p.states.size() - 1 {
                    p.cursor = p.cursor + 1
                    next.state_picker = maybe::some(p)
                  }
                },
                _ => match next.cycle_picker {
                  p => {
                    if p.cursor < p.cycles.size() {
                      p.cursor = p.cursor + 1
                      next.cycle_picker = maybe::some(p)
                    }
                  },
                  _ => { next.row = clamp(row + 1, selected_row_count(model.columns, col)) },
                },
              }
            })
            ui::EventResult::handled
          }),
          ui::action("my_issues.previous_col", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            let next_col = clamp(col - 1, model.columns.size())
            state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
              next.col = next_col
              next.row = clamp(row, selected_row_count(model.columns, next_col))
              next.scroll = visible_scroll(scroll, next_col, board_visible_count(model.columns.size()), model.columns.size())
            })
            ui::EventResult::handled
          }),
          ui::action("my_issues.next_col", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            let next_col = clamp(col + 1, model.columns.size())
            state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
              next.col = next_col
              next.row = clamp(row, selected_row_count(model.columns, next_col))
              next.scroll = visible_scroll(scroll, next_col, board_visible_count(model.columns.size()), model.columns.size())
            })
            ui::EventResult::handled
          }),
          ui::action("my_issues.refresh", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            if not model.loading {
              state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                next.loading = true
              })
              async::start(fn() {
                let result = issues::load(api_key)
                rt.dispatch(fn(state: ui::State) {
                  state.set<MyIssuesUiState>(fn(mut refreshed: MyIssuesUiState) {
                    match result {
                      ok(columns) => {
                        refreshed.columns = columns
                        refreshed.error = ""
                        refreshed.col = clamp(col, columns.size())
                        refreshed.row = clamp(row, selected_row_count(columns, col))
                      },
                      err(e) => { refreshed.error = e },
                    }
                    refreshed.loaded = true
                    refreshed.loading = false
                  })
                })
              })
              ()
            }
            ui::EventResult::handled
          }),
          ui::action("my_issues.open_state_picker", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            if model.state_picker.is_none() and model.cycle_picker.is_none() {
              match selected_issue(model.columns, col, row) {
                issue => {
                  match api::open_state_picker(api_key, issue.raw, true, 0) {
                    ok(p) => {
                      state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                        next.state_picker = maybe::some(p)
                      })
                    },
                    err(_) => (),
                  }
                },
                _ => (),
              }
            }
            ui::EventResult::handled
          }),
          ui::action("my_issues.open_cycle_picker", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            if model.state_picker.is_none() and model.cycle_picker.is_none() {
              match selected_issue(model.columns, col, row) {
                issue => {
                  match api::open_cycle_picker(api_key, issue.raw, true, 0) {
                    ok(p) => {
                      state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                        next.cycle_picker = maybe::some(p)
                      })
                    },
                    err(_) => (),
                  }
                },
                _ => (),
              }
            }
            ui::EventResult::handled
          }),
          ui::action("picker.dismiss", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
              next.state_picker = maybe::none()
              next.cycle_picker = maybe::none()
            })
            ui::EventResult::handled
          }),
          ui::action("picker.confirm", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            match model.state_picker {
              p => {
                let target = p.states.at(p.cursor)
                let new_state_id = decode::run(target, decode::field("id", decode::string)).expect("Missing state.id")
                if new_state_id == p.current_state_id {
                  state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                    next.state_picker = maybe::none()
                  })
                } else {
                  match api::update_issue_state(api_key, p.issue_id, new_state_id) {
                    ok(_) => {
                      state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                        next.state_picker = maybe::none()
                        match issues::load(api_key) {
                          ok(columns) => {
                            next.columns = columns
                            next.error = ""
                            next.col = clamp(col, columns.size())
                            next.row = clamp(row, selected_row_count(columns, col))
                          },
                          err(e) => { next.error = e },
                        }
                        next.loaded = true
                        next.loading = false
                      })
                    },
                    err(_) => (),
                  }
                }
              },
              _ => match model.cycle_picker {
                p => {
                  let target_cycle_id = match p.cursor == 0 {
                    true => "",
                    false => {
                      let c = p.cycles.at(p.cursor - 1)
                      decode::run(c, decode::field("id", decode::string)).expect("Missing cycle.id")
                    },
                  }
                  if target_cycle_id == p.current_cycle_id {
                    state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                      next.cycle_picker = maybe::none()
                    })
                  } else {
                    match api::update_issue_cycle(api_key, p.issue_id, target_cycle_id) {
                      ok(_) => {
                        state.set<MyIssuesUiState>(fn(mut next: MyIssuesUiState) {
                          next.cycle_picker = maybe::none()
                          match issues::load(api_key) {
                            ok(columns) => {
                              next.columns = columns
                              next.error = ""
                              next.col = clamp(col, columns.size())
                              next.row = clamp(row, selected_row_count(columns, col))
                            },
                            err(e) => { next.error = e },
                          }
                          next.loaded = true
                          next.loading = false
                        })
                      },
                      err(_) => (),
                    }
                  }
                },
                _ => (),
              },
            }
            ui::EventResult::handled
          }),
          ui::action("my_issues.open", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            match selected_issue(model.columns, col, row) {
              _issue => (),
              _ => (),
            }
            ui::EventResult::handled
          }),
        ],
      )
    },
  )
}
