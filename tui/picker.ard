use go:go.rockorager.dev/vaxis/ui
use go:strings
use go:tinear/ffi
use tinear/tui/hints_bar
use tinear/tui/modal

// A reusable single-select picker presented in a modal. Each call to
// `new(props)` returns a builder closure suitable for handing to the
// app-level `show_modal` callback wired in `main.ard`.
//
// Behaviour:
//   - up / down (or j / k) move the highlighted option
//   - more than 5 options adds a filter field: typing narrows the list
//     (case-insensitive substring); j / k / Space then type instead of
//     navigating, and Up / Down / Enter are captured before the field
//   - Enter (or Space) calls `on_confirm` with the picked Option and
//     dismisses the modal
//   - Esc dismisses the modal without confirming (handled by the modal
//     frame, which catches the app-level DismissIntent)
//   - clicking an option = confirm + dismiss
//   - the initial cursor lands on whichever option has `current: true`,
//     or 0 if none / id mismatch
//
// The picker owns a small local `PickerState` (just the cursor) inside
// its own Stateful so the position survives modal-builder rebuilds
// (the builder is invoked on every AppState change, e.g. a toast
// arriving).

struct Option {
  // Stable identifier (e.g. state id, cycle id). Passed back to the
  // caller via on_confirm so they can dispatch the mutation.
  id: Str,
  label: Str,
  // true marks the option as the current selection — the picker shows
  // a "(current)" suffix and initialises the cursor here.
  current: Bool,
}

struct Props {
  // Stable identity for the picker's Stateful (e.g.
  // "issue-state:CCA-123"). Distinct purposes/entities must not share
  // a key, or cursor state leaks between pickers in the modal slot.
  key: Str,
  title: Str,
  options: [Option],
  // Optional fixed width. When none, the modal hugs content; for
  // pickers a 40-50 col width usually feels right.
  width: Int?,
  on_confirm: fn(Option),
}

struct PickerState {
  started: Bool,
  cursor: Int,
  // Filter query; only rendered/active when the option list is long
  // enough to warrant it (see FILTER_THRESHOLD).
  filter: Str,
  // Long option lists (e.g. project pickers) scroll; RevealIndex keeps
  // the cursor row visible.
  scroll: mut ui::ScrollController,
  list: mut ui::SliverListController,
}

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

// Option lists longer than this get a filter field.
let FILTER_THRESHOLD: Int = 5

fn filterable(props: Props) Bool {
  props.options.size() > FILTER_THRESHOLD
}

// Options matching the filter (case-insensitive substring), in their
// original order. An empty filter matches everything.
fn visible_options(props: Props, filter: Str) [Option] {
  let query = strings::ToLower(filter.trim())
  match query.is_empty() {
    true => props.options,
    false => {
      let matched: mut [Option] = mut []
      for option in props.options {
        if strings::ToLower(option.label).contains(query) {
          matched.push(option)
        }
      }
      deref matched
    },
  }
}

fn initial_cursor(props: Props) Int {
  mut found = 0
  for option, idx in props.options {
    if option.current {
      found = idx
    }
  }
  clamp_cursor(found, props.options.size())
}

// One row per option. The cursor-here option uses ListTile's Selected
// styling (theme.Primary bg); the "(current)" suffix marks the option
// the data already considers selected. Clicking an option fires the
// confirm + close sequence (same as Enter).
// Cap the visible rows; longer lists scroll (RevealIndex follows the
// cursor).
let MAX_VISIBLE_OPTIONS: Int = 12

fn option_row(theme: ui::Theme, option: Option, selected: Bool, on_press: fn(ui::EventContext)) ui::Widget {
  let title_text = match option.current {
    true => "{option.label}   (current)",
    false => option.label,
  }
  ui::ListTile{
    Title: ui::Text{Value: title_text, Style: ui::Style{Foreground: theme.Foreground}},
    Selected: selected,
    OnPressed: on_press,
  }
}

fn render_options(theme: ui::Theme, state: PickerState, options: [Option], cursor: Int, on_pick: fn(Int)) ui::Widget {
  let count = options.size()
  match count == 0 {
    true => {
      ui::SizedBox{
        Height: 1,
        Child: ui::Text{Value: "No matches", Style: ui::Style{Foreground: theme.MutedForeground}},
      }
    },
    false => {
      let height = match count > MAX_VISIBLE_OPTIONS {
        true => MAX_VISIBLE_OPTIONS,
        false => count,
      }
      ui::SizedBox{
        Height: height,
        Child: ui::CustomScrollView{
          Controller: state.scroll,
          Slivers: [
            ui::SliverListBuilder{
              Controller: state.list,
              Count: count,
              ItemExtent: 1,
              Overscan: 4,
              Builder: fn(ctx: ui::BuildContext, i: Int) ui::Widget {
                option_row(
                  theme,
                  options.at(i).expect("builder index in range"),
                  i == cursor,
                  fn(ev: ui::EventContext) {
                    on_pick(i)
                  },
                )
              },
            },
          ],
        },
      }
    },
  }
}

// TextField renders at exactly MinWidth; match the modal's content
// width (fixed width minus the frame's 2 cols of horizontal padding).
fn filter_field_width(props: Props) Int {
  match props.width {
    w => w - 4,
    _ => 44,
  }
}

fn picker_hints() [hints_bar::Hint] {
  // No hint for filtering: the field's placeholder is affordance
  // enough, and the extra hint overflows the modal footer.
  [
    hints_bar::Hint{key: "↑↓", label: "select"},
    hints_bar::Hint{key: "↵", label: "confirm"},
    hints_bar::Hint{key: "Esc", label: "cancel"},
  ]
}

fn move_cursor(c: mut ffi::StateCtx, count: Int, delta: Int) {
  ffi::Update<PickerState>(
    c,
    fn(s: mut PickerState) {
      s.cursor = clamp_cursor(s.cursor + delta, count)
    },
  )
  let s = ffi::StateValue<PickerState>(c)
  s.list.RevealIndex(s.cursor)
}

// Body widget (everything between the title divider and the footer
// divider of the modal frame). Lives in its own Stateful so the cursor
// position survives across modal-builder rebuilds.
fn picker_body(props: Props, close: fn()) ui::Widget {
  ffi::Stateful{
    Key: "picker:{props.key}",
    Init: fn() Any {
      mut scroll = ui::ScrollController{}
      mut list = ui::SliverListController{}
      PickerState{started: false, cursor: initial_cursor(props), filter: "", scroll: mut scroll, list: mut list}
    },
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      let theme = ui::MustDepend<ui::Theme>(ctx)
      let state = ffi::StateRef<PickerState>(c)
      if not state.started {
        // Scroll the initial cursor (the "current" option) into view
        // on first open; deliberately does not schedule a rebuild.
        state.started = true
        state.list.RevealIndex(state.cursor)
      }
      let snapshot = ffi::StateValue<PickerState>(c)
      let options = visible_options(props, snapshot.filter)
      let cursor = clamp_cursor(snapshot.cursor, options.size())
      let has_filter = filterable(props)

      // Confirm and pick helpers (indexes are into the FILTERED list).
      // Both end the picker. Close BEFORE confirming: on_confirm may
      // open a follow-up modal (e.g. the create-issue team picker
      // leads to the form), and closing afterwards would immediately
      // dismiss it.
      let confirm_at = fn(idx: Int) {
        let safe = clamp_cursor(idx, options.size())
        if options.size() > 0 {
          close()
          props.on_confirm(options.at(safe).expect("clamped"))
        }
      }

      let list_widget = render_options(theme, snapshot, options, cursor, confirm_at)

      // With a filter field, the field owns focus and ordinary keys
      // (j / k / Space type into it); without one, an outer Focus
      // absorbs the modal frame's AutoFocus so it doesn't land on
      // option[0]'s ListTile (which would paint SurfaceHovered
      // competing with the cursor's Selected styling).
      let body: ui::Widget = match has_filter {
        true => {
          mut children: [ui::Widget] = [
            ui::FocusScope{
              AutoFocus: true,
              Child: ui::TextField{
                Value: snapshot.filter,
                Placeholder: "Filter…",
                MinWidth: filter_field_width(props),
                OnChanged: fn(ev: ui::EventContext, value: Str) {
                  ffi::Update<PickerState>(
                    c,
                    fn(s: mut PickerState) {
                      s.filter = value
                      s.cursor = 0
                    },
                  )
                  ffi::StateValue<PickerState>(c).list.RevealIndex(0)
                },
              },
            },
            ui::Divider{Style: ui::Style{Foreground: theme.Border, Background: theme.Surface}},
            list_widget,
          ]
          ui::Flex{
            Axis: ui::Vertical,
            MainAxisSize: ui::MainAxisSizeMin,
            CrossAxisAlignment: ui::CrossAxisStretch,
            Children: children,
          }
        },
        false => {
          mut focus_node = ui::FocusNode{}
          ui::Focus(mut focus_node, list_widget)
        },
      }

      // j / k / Space only navigate when there's no filter field —
      // otherwise they're typed characters.
      let bindings: [Str: ui::Intent] = match has_filter {
        true => [
          "Down": ffi::Intent("picker.next"),
          "Up": ffi::Intent("picker.prev"),
          "Enter": ffi::Intent("picker.confirm"),
        ],
        false => [
          "j": ffi::Intent("picker.next"),
          "Down": ffi::Intent("picker.next"),
          "k": ffi::Intent("picker.prev"),
          "Up": ffi::Intent("picker.prev"),
          "Enter": ffi::Intent("picker.confirm"),
          "Space": ffi::Intent("picker.confirm"),
        ],
      }

      ui::Actions{
        Bindings: [
          "picker.next": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
            move_cursor(c, visible_options(props, ffi::StateValue<PickerState>(c).filter).size(), 1)
            ui::EventHandled
          },
          "picker.prev": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
            move_cursor(c, visible_options(props, ffi::StateValue<PickerState>(c).filter).size(), -1)
            ui::EventHandled
          },
          "picker.confirm": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
            confirm_at(ffi::StateValue<PickerState>(c).cursor)
            ui::EventHandled
          },
        ],
        Child: ui::Shortcuts{
          Bindings: bindings,
          Child: body,
        },
      }
    },
  }
}

// Returns a modal builder. Hand the result to `show_modal` so the app
// root layers it over the rest of the UI.
fn new(props: Props) fn(ui::Theme, fn()) ui::Widget {
  fn(theme: ui::Theme, close: fn()) ui::Widget {
    modal::show_modal(
      theme,
      props.title,
      picker_body(props, close),
      hints_bar::row(theme, picker_hints()),
      props.width,
      fn(ev: ui::EventContext) {
        close()
      },
    )
  }
}
