use ard/maybe

use tinear/tui/modal
use tinear/tui/ui

struct Option {
  id: Str,
  label: Str,
  current: Bool,
}

struct Props {
  title: Str,
  options: [Option],
  inititial_id: Str,
  width: Int?,
}

struct CursorState {
  cursor: Int,
}

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

fn initial_cursor(props: Props) Int {
  mut cursor = 0
  for option, idx in props.options {
    if option.id == props.inititial_id {
      cursor = idx
    }
  }
  clamp_cursor(cursor, props.options.size())
}

private fn view(props: Props, cursor: Int) ui::Widget {
  let selected_cursor = clamp_cursor(cursor, props.options.size())
  mut rows: [ui::Widget] = []
  for option, idx in props.options {
    let cursor_mark = match idx == selected_cursor {
      true => "▸",
      false => " ",
    }
    let suffix = match option.current {
      true => "  (current)",
      false => "",
    }
    rows.push(ui::text(" {cursor_mark} {option.label}{suffix}"))
  }
  ui::column_stretch(rows)
}

fn footer() ui::Widget {
  ui::text("↑↓ select  ↵ confirm  Esc cancel")
}

fn selected_at(props: Props, cursor: Int) Option? {
  match props.options.size() == 0 {
    true => maybe::none(),
    false => maybe::some(props.options.at(clamp_cursor(cursor, props.options.size()))),
  }
}

fn new(props: Props, on_confirm: fn(ui::EventContext, Option), on_dismiss: fn(ui::EventContext)) ui::Widget {
  ui::stateful(
    key: props.title,
    init: fn(_ctx: ui::BuildContext) CursorState {
      CursorState{cursor: initial_cursor(props)}
    },
    build: fn(_ctx: ui::BuildContext, state: ui::State<CursorState>) ui::Widget {
      let model = state.value()
      let cursor = clamp_cursor(model.cursor, props.options.size())
      ui::actions(
        child: ui::shortcuts(
          child: modal::dialog(
            title: props.title,
            child: view(props, cursor),
            footer: footer(),
            width: props.width.or(50),
            on_dismiss: on_dismiss,
          ),
          bindings: [
            "Up": "picker.previous",
            "k": "picker.previous",
            "Down": "picker.next",
            "j": "picker.next",
            "Enter": "picker.confirm",
            "Space": "picker.confirm",
          ],
        ),
        bindings: [
          ui::action(
            "picker.previous",
            fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(
                fn(mut next: CursorState) {
                  next.cursor = clamp_cursor(model.cursor - 1, props.options.size())
                },
              )
              ui::EventResult::handled
            },
          ),
          ui::action(
            "picker.next",
            fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(
                fn(mut next: CursorState) {
                  next.cursor = clamp_cursor(model.cursor + 1, props.options.size())
                },
              )
              ui::EventResult::handled
            },
          ),
          ui::action(
            "picker.confirm",
            fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
              match selected_at(props, model.cursor) {
                option => on_confirm(ctx, option),
                _ => (),
              }
              ui::EventResult::handled
            },
          ),
        ],
      )
    },
  )
}
