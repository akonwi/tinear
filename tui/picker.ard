use ard/maybe

use tinear/models/issues
use tinear/tui/state
use tinear/tui/ui

struct Option {
  id: Str,
  label: Str,
  current: Bool,
}

struct Picker {
  title: Str,
  options: [Option],
  cursor: Int,
  width: Int,
}

struct Active {
  kind: Str,
  issue_id: Str,
  picker: Picker,
}

fn state_kind() Str { "state" }
fn cycle_kind() Str { "cycle" }

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

fn view(picker: Picker) ui::Widget {
  mut rows: [ui::Widget] = []
  for option, idx in picker.options {
    let cursor_mark = match idx == picker.cursor {
      true => "▸",
      false => " ",
    }
    let suffix = match option.current {
      true => "  (current)",
      false => "",
    }
    rows.push(ui::text(" {cursor_mark} {option.label}{suffix}"))
  }
  ui::column_stretch(rows)
}

fn new(picker: Picker, on_previous: fn(ui::EventContext), on_next: fn(ui::EventContext), on_confirm: fn(ui::EventContext)) ui::Widget {
  ui::actions(
    child: ui::shortcuts(
      child: ui::focusable(view(picker)),
      bindings: [
        "Up": "picker.previous",
        "k": "picker.previous",
        "Down": "picker.next",
        "j": "picker.next",
        "Enter": "picker.confirm",
        "Space": "picker.confirm",
      ],
    ),
    bindings: [
      ui::action("picker.previous", fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
        on_previous(ctx)
        ui::EventResult::handled
      }),
      ui::action("picker.next", fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
        on_next(ctx)
        ui::EventResult::handled
      }),
      ui::action("picker.confirm", fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
        on_confirm(ctx)
        ui::EventResult::handled
      }),
    ],
  )
}

fn footer() ui::Widget {
  ui::text("↑↓ select  ↵ confirm  Esc cancel")
}

fn previous(picker: Picker) Picker {
  mut next = picker
  next.cursor = clamp_cursor(picker.cursor - 1, picker.options.size())
  next
}

fn next(picker: Picker) Picker {
  mut next_picker = picker
  next_picker.cursor = clamp_cursor(picker.cursor + 1, picker.options.size())
  next_picker
}

fn selected(picker: Picker) Option? {
  match picker.options.size() == 0 {
    true => maybe::none(),
    false => maybe::some(picker.options.at(clamp_cursor(picker.cursor, picker.options.size()))),
  }
}

fn sort_states(states: [issues::WorkflowState]) [issues::WorkflowState] {
  let n = states.size()
  if n < 2 {
    states
  } else {
    mut result = states
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        let ra = state::state_type_rank(a.state_type)
        let rb = state::state_type_rank(b.state_type)
        let swap = match ra == rb {
          true => a.position > b.position,
          false => ra > rb,
        }
        if swap {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

fn sort_cycles(cycles: [issues::Cycle]) [issues::Cycle] {
  let n = cycles.size()
  if n < 2 {
    cycles
  } else {
    mut result = cycles
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        if a.number < b.number {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

fn cycle_label(cycle: issues::Cycle) Str {
  match cycle.name.is_empty() {
    true => "Cycle {cycle.number}",
    false => cycle.name,
  }
}

fn state_for_issue(api_key: Str, issue: issues::Issue) Picker!Str {
  let states = sort_states(try issues::load_team_states(api_key, issue.team_id))
  mut options: [Option] = []
  mut cursor = 0
  for s, idx in states {
    let current = s.id == issue.state_id
    if current {
      cursor = idx
    }
    options.push(Option{id: s.id, label: s.name, current: current})
  }
  Result::ok(Picker{
    title: "Status — {issue.identifier} ({issue.team_name})",
    options: options,
    cursor: cursor,
    width: 50,
  })
}

fn cycle_for_issue(api_key: Str, issue: issues::Issue) Picker!Str {
  let result = try issues::load_team_cycles(api_key, issue.team_id)

  mut filtered: [issues::Cycle] = []
  match result.active_cycle_number {
    active_n => {
      for c in result.cycles {
        if c.number <= active_n + 1 or c.id == issue.cycle_id {
          filtered.push(c)
        }
      }
    },
    _ => { filtered = result.cycles },
  }

  let cycles = sort_cycles(filtered)
  mut options = [Option{id: "", label: "(no cycle)", current: issue.cycle_id.is_empty()}]
  mut cursor = 0
  for c in cycles {
    let current = c.id == issue.cycle_id
    if current {
      cursor = options.size()
    }
    options.push(Option{id: c.id, label: cycle_label(c), current: current})
  }

  Result::ok(Picker{
    title: "Cycle — {issue.identifier} ({issue.team_name})",
    options: options,
    cursor: cursor,
    width: 60,
  })
}

fn active_state(api_key: Str, issue: issues::Issue) Active!Str {
  let p = try state_for_issue(api_key, issue)
  Result::ok(Active{kind: state_kind(), issue_id: issue.id, picker: p})
}

fn active_cycle(api_key: Str, issue: issues::Issue) Active!Str {
  let p = try cycle_for_issue(api_key, issue)
  Result::ok(Active{kind: cycle_kind(), issue_id: issue.id, picker: p})
}
