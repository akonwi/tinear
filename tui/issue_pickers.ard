use ard/async
use ard/maybe
use vaxis/ui

use tinear/models/issues
use tinear/tui/hints_bar
use tinear/tui/modal
use tinear/tui/picker
use tinear/tui/toast

// Shared modal helpers used by both the My Issues board and the
// issue detail tab to change an issue's state / cycle.
//
// Each open_*_picker:
//   1. Immediately presents a "Loading…" modal with the picker's
//      title and width so the modal frame stays visually stable.
//   2. Fetches the relevant data (team states / team cycles).
//   3. On success, swaps the modal body for the real picker.
//   4. On failure, closes the modal and surfaces a toast.
//
// When the user confirms an option, the picker calls back into the
// supplied `on_change(new_id)`. The caller is responsible for
// dispatching the mutation (issues::update_state /
// issues::update_cycle) and any post-success refresh — because
// "what to do after the change lands" differs per surface (refresh
// board vs. re-fetch the single issue, etc.) and depends on a
// view-specific runtime/state type.
//
// show_modal / close_modal / notify are all runtime-safe callbacks
// (they dispatch onto the UI thread internally) so we call them from
// background fibers without needing a runtime handle here.

fn state_picker_title(issue: issues::Issue) Str {
  "Change state \u2014 {issue.identifier}"
}

fn cycle_picker_title(issue: issues::Issue) Str {
  "Change cycle \u2014 {issue.identifier}"
}

fn cycle_label(c: issues::Cycle) Str {
  match c.name.is_empty() {
    true => "Cycle {c.number}",
    false => c.name,
  }
}

// Sort cycles by number descending so the newest cycle is on top.
fn sort_cycles(cycles: [issues::Cycle]) [issues::Cycle] {
  let n = cycles.size()
  if n < 2 {
    cycles
  } else {
    mut result = cycles
    for i in 0..n - 2 {
      for j in 0..n - 2 - i {
        let a = result.at(j)
        let b = result.at(j + 1)
        if a.number < b.number {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

// Limit cycles to: anything up to one cycle past the team's current
// active cycle (so users can move issues into the next cycle), plus
// the issue's currently-assigned cycle (in case it's older).
fn filter_cycles_for_issue(
  result: issues::TeamCyclesResult, current_cycle_id: Str,
) [issues::Cycle] {
  match result.active_cycle_number {
    active_n => {
      mut filtered: [issues::Cycle] = []
      for c in result.cycles {
        if c.number <= active_n + 1 or c.id == current_cycle_id {
          filtered.push(c)
        }
      }
      filtered
    },
    _ => result.cycles,
  }
}

// "Loading…" modal that keeps the same frame as the picker that
// will replace it. The body is wrapped in ui::focus so the modal's
// focus_scope auto_focus has a target inside the modal.
fn loading_modal_builder(title: Str) fn(ui::Theme, fn()) ui::Widget {
  fn(theme: ui::Theme, close: fn()) ui::Widget {
    modal::show_modal(
      theme: theme,
      title: title,
      child: ui::focus(ui::sized_box(
        0, 3,
        ui::center(
          ui::styled_text("Loading\u2026", fg: theme.muted_foreground),
        ),
      )),
      footer: hints_bar::row(theme, [
        hints_bar::Hint{ key: "Esc", label: "cancel" },
      ]),
      width: maybe::some(50),
      on_dismiss: fn(_ctx: ui::EventContext) { close() },
    )
  }
}

// Open the state picker for the given issue. on_change is called
// (from a background fiber) with the chosen state id when the user
// confirms.
fn open_state_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_state_id = issue.state_id
  let title = state_picker_title(issue)

  show_modal(loading_modal_builder(title))

  let _ = async::start(fn() {
    let result = issues::load_team_states(key, team_id)
    match result {
      ok(states) => {
        mut options: [picker::Option] = []
        for ws in states {
          options.push(picker::Option{
            id: ws.id,
            label: ws.name,
            current: ws.id == current_state_id,
          })
        }
        show_modal(picker::new(picker::Props{
          title: title,
          options: options,
          width: maybe::some(50),
          on_confirm: fn(opt: picker::Option) { on_change(opt.id) },
        }))
      },
      err(e) => {
        close_modal()
        notify("State picker", "Failed to load states: {e}", toast::ToastVariant::error)
      },
    }
  })
}

// Open the cycle picker for the given issue. The first option is a
// synthetic "(no cycle)" entry with id="" — issues::update_cycle
// treats an empty cycle_id as the null-cycle mutation.
fn open_cycle_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_cycle_id = issue.cycle_id
  let title = cycle_picker_title(issue)

  show_modal(loading_modal_builder(title))

  let _ = async::start(fn() {
    let result = issues::load_team_cycles(key, team_id)
    match result {
      ok(tcr) => {
        let cycles = sort_cycles(filter_cycles_for_issue(tcr, current_cycle_id))
        mut options: [picker::Option] = [
          picker::Option{
            id: "",
            label: "(no cycle)",
            current: current_cycle_id.is_empty(),
          },
        ]
        for c in cycles {
          options.push(picker::Option{
            id: c.id,
            label: cycle_label(c),
            current: c.id == current_cycle_id,
          })
        }
        show_modal(picker::new(picker::Props{
          title: title,
          options: options,
          width: maybe::some(60),
          on_confirm: fn(opt: picker::Option) { on_change(opt.id) },
        }))
      },
      err(e) => {
        close_modal()
        notify("Cycle picker", "Failed to load cycles: {e}", toast::ToastVariant::error)
      },
    }
  })
}
