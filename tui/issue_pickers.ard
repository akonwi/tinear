use ard/async

use go:go.rockorager.dev/vaxis/ui
use tinear/models/issues
use tinear/tui/hints_bar
use tinear/tui/modal
use tinear/tui/picker
use tinear/tui/state
use tinear/tui/toast

// Shared modal helpers used by both the My Issues board and the issue
// detail tab to change an issue's state / cycle.
//
// Each open_*_picker:
//   1. Immediately presents a "Loading…" modal with the picker's title
//      and width so the modal frame stays visually stable.
//   2. Fetches the relevant data (team states / team cycles).
//   3. On success, swaps the modal body for the real picker.
//   4. On failure, closes the modal and surfaces a toast.
//
// When the user confirms an option, the picker calls back into the
// supplied `on_change(new_id)`. The caller is responsible for
// dispatching the mutation and any post-success refresh — because
// "what to do after the change lands" differs per surface (refresh
// board vs. re-fetch the single issue).
//
// show_modal / close_modal / notify are all runtime-safe callbacks
// (they dispatch onto the UI thread internally) so we call them from
// background fibers without needing a runtime handle here.

fn state_picker_title(issue: issues::Issue) Str {
  "Change state — {issue.identifier}"
}

fn cycle_picker_title(issue: issues::Issue) Str {
  "Change cycle — {issue.identifier}"
}

fn cycle_label(c: issues::Cycle) Str {
  match c.name.is_empty() {
    true => "Cycle {c.number}",
    false => c.name,
  }
}

// Sort cycles by number descending so the newest cycle is on top.
fn sort_cycles(cycles: [issues::Cycle]) [issues::Cycle] {
  let n = cycles.size()
  if n < 2 {
    cycles
  } else {
    let result = mut cycles
    for i in 0..n - 2 {
      for j in 0..n - 2 - i {
        let a = result.at(j).expect("bounds checked")
        let b = result.at(j + 1).expect("bounds checked")
        if a.number < b.number {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    deref result
  }
}

// Limit cycles to: anything up to one cycle past the team's current
// active cycle (so users can move issues into the next cycle), plus
// the issue's currently-assigned cycle (in case it's older).
fn filter_cycles_for_issue(result: issues::TeamCyclesResult, current_cycle_id: Str) [issues::Cycle] {
  match result.active_cycle_number {
    active_n => {
      let filtered: mut [issues::Cycle] = mut []
      for c in result.cycles {
        if c.number <= active_n + 1 or c.id == current_cycle_id {
          filtered.push(c)
        }
      }
      deref filtered
    },
    _ => result.cycles,
  }
}

// "Loading…" modal that keeps the same frame as the picker that will
// replace it. The body is wrapped in a Focus so the modal's FocusScope
// AutoFocus has a target inside the modal.
fn loading_modal_builder(title: Str) fn(ui::Theme, fn()) ui::Widget {
  fn(theme: ui::Theme, close: fn()) ui::Widget {
    mut focus_node = ui::FocusNode{}
    modal::show_modal(
      theme,
      title,
      ui::Focus(
        mut focus_node,
        ui::SizedBox{
          Height: 3,
          Child: ui::Center(ui::Text{Value: "Loading…", Style: ui::Style{Foreground: theme.MutedForeground}}),
        },
      ),
      hints_bar::row(theme, [hints_bar::Hint{key: "Esc", label: "cancel"}]),
      Maybe::new(50),
      fn(ev: ui::EventContext) {
        close()
      },
    )
  }
}

// Open the state picker for the given issue. on_change is called (from
// a background fiber) with the chosen state id when the user confirms.
fn open_state_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_state_id = issue.state_id
  let title = state_picker_title(issue)

  show_modal(loading_modal_builder(title))

  async::start(
    fn() {
      let result = issues::load_team_states(key, team_id)
      match result {
        ok(states) => {
          let options: mut [picker::Option] = mut []
          for ws in states {
            options.push(
              picker::Option{
                id: ws.id,
                label: ws.name,
                current: ws.id == current_state_id,
              },
            )
          }
          show_modal(
            picker::new(
              picker::Props{
                key: "issue-state:{issue.identifier}",
                title: title,
                options: deref options,
                width: Maybe::new(50),
                on_confirm: fn(opt: picker::Option) {
                  on_change(opt.id)
                },
              },
            ),
          )
        },
        err(e) => {
          close_modal()
          notify("State picker", "Failed to load states: {e}", toast::ToastVariant::error)
        },
      }
    },
  )
}

// Open the cycle picker for the given issue. The first option is a
// synthetic "(no cycle)" entry with id="" — issues::update_cycle
// treats an empty cycle_id as the null-cycle mutation.
fn open_cycle_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_cycle_id = issue.cycle_id
  let title = cycle_picker_title(issue)

  show_modal(loading_modal_builder(title))

  async::start(
    fn() {
      let result = issues::load_team_cycles(key, team_id)
      match result {
        ok(tcr) => {
          let cycles = sort_cycles(filter_cycles_for_issue(tcr, current_cycle_id))
          let options: mut [picker::Option] = mut [
            picker::Option{
              id: "",
              label: "(no cycle)",
              current: current_cycle_id.is_empty(),
            },
          ]
          for c in cycles {
            options.push(
              picker::Option{
                id: c.id,
                label: cycle_label(c),
                current: c.id == current_cycle_id,
              },
            )
          }
          show_modal(
            picker::new(
              picker::Props{
                key: "issue-cycle:{issue.identifier}",
                title: title,
                options: deref options,
                width: Maybe::new(60),
                on_confirm: fn(opt: picker::Option) {
                  on_change(opt.id)
                },
              },
            ),
          )
        },
        err(e) => {
          close_modal()
          notify("Cycle picker", "Failed to load cycles: {e}", toast::ToastVariant::error)
        },
      }
    },
  )
}

// ── Priority ─────────────────────────────────────────────────────────

// Static option set: Linear priorities are fixed (0 = none, 1 = urgent
// … 4 = low). No fetch, so the picker shows immediately.
fn open_priority_picker(
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  on_change: fn(Int),
) {
  let current = issue.priority.or(0)
  let options: mut [picker::Option] = mut []
  for value in [0, 1, 2, 3, 4] {
    let label = match value {
      0 => "No priority",
      _ => {
        let glyph = state::priority_glyph(Maybe::new(value))
        "{glyph} {state::priority_label(Maybe::new(value))}"
      },
    }
    options.push(picker::Option{id: "{value}", label: label, current: value == current})
  }
  let values = [0, 1, 2, 3, 4]
  show_modal(
    picker::new(
      picker::Props{
        key: "issue-priority:{issue.identifier}",
        title: "Change priority — {issue.identifier}",
        options: deref options,
        width: Maybe::new(46),
        on_confirm: fn(picked: picker::Option) {
          mut chosen = 0
          for value in values {
            if picked.id == "{value}" {
              chosen = value
            }
          }
          on_change(chosen)
        },
      },
    ),
  )
}

// ── Assignee ─────────────────────────────────────────────────────────

fn open_assignee_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_assignee_id = issue.assignee_id
  let title = "Assign — {issue.identifier}"

  show_modal(loading_modal_builder(title))

  async::start(
    fn() {
      let result = issues::fetch_team_members(key, team_id)
      match result {
        ok(members) => {
          let options: mut [picker::Option] = mut [
            picker::Option{id: "", label: "Unassigned", current: current_assignee_id.is_empty()},
          ]
          for member in members {
            options.push(
              picker::Option{
                id: member.id,
                label: member.name,
                current: member.id == current_assignee_id,
              },
            )
          }
          show_modal(
            picker::new(
              picker::Props{
                key: "issue-assignee:{issue.identifier}",
                title: title,
                options: deref options,
                width: Maybe::new(46),
                on_confirm: fn(picked: picker::Option) {
                  on_change(picked.id)
                },
              },
            ),
          )
        },
        err(e) => {
          close_modal()
          notify("Assign", e, toast::ToastVariant::error)
        },
      }
    },
  )
}

// ── Project ──────────────────────────────────────────────────────────

fn open_project_picker(
  api_key: Str,
  issue: issues::Issue,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_change: fn(Str),
) {
  let key = api_key
  let team_id = issue.team_id
  let current_project_id = issue.project_id
  let title = "Change project — {issue.identifier}"

  show_modal(loading_modal_builder(title))

  async::start(
    fn() {
      let result = issues::fetch_team_projects(key, team_id)
      match result {
        ok(projects) => {
          let options: mut [picker::Option] = mut [
            picker::Option{id: "", label: "No project", current: current_project_id.is_empty()},
          ]
          for project in projects {
            options.push(
              picker::Option{
                id: project.id,
                label: project.name,
                current: project.id == current_project_id,
              },
            )
          }
          show_modal(
            picker::new(
              picker::Props{
                key: "issue-project:{issue.identifier}",
                title: title,
                options: deref options,
                width: Maybe::new(56),
                on_confirm: fn(picked: picker::Option) {
                  on_change(picked.id)
                },
              },
            ),
          )
        },
        err(e) => {
          close_modal()
          notify("Change project", e, toast::ToastVariant::error)
        },
      }
    },
  )
}
