use ard/testing as assertions

use cooper/event
use cooper/testing
use tinear/tui/picker_controller
use tinear/tui/theme

private struct Selection {
  id: Str,
  count: Int,
}

private fn options() [picker_controller::Option] {
  [
    picker_controller::Option{
      id: "todo",
      label: "Todo",
      description: "Unstarted",
    },
    picker_controller::Option{
      id: "doing",
      label: "In Progress",
      description: "Started",
    },
    picker_controller::Option{
      id: "done",
      label: "Done",
      description: "Completed",
    },
  ]
}

private fn filter_options() [picker_controller::Option] {
  let values = mut options()
  values.push(
    picker_controller::Option{
      id: "canceled",
      label: "Canceled",
      description: "Canceled",
    },
  )
  values.push(
    picker_controller::Option{
      id: "duplicate",
      label: "Duplicate",
      description: "Canceled",
    },
  )
  values.push(
    picker_controller::Option{
      id: "backlog",
      label: "Backlog",
      description: "Backlog",
    },
  )
  values.@
}

private fn key(name: Str, text: Str) mut event::KeyEvent {
  event::key(
    name,
    text,
    event::KeyEventType::press,
    event::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

test fn picker_filters_navigates_and_selects() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let picker = picker_controller::new(
    application.context,
    theme::new(),
    "Filter states",
    filter_options(),
    "doing",
    fn(option: picker_controller::Option) {
      selection.id = option.id
      selection.count =+ 1
    },
  )
  application.root.add(picker.root)
  picker.focus()
  application.render()
  try assertions::assert(picker.cursor == 1, "selected id should seed cursor")
  try assertions::assert(
    picker.results.requested_scroll_top() == 2,
    "initial selection should request a deterministic offset before layout",
  )
  try testing::assert_contains(application.frame().text(), "In Progress")
  let rule = application.frame().cell(0, 1).expect("picker rule")
  try assertions::assert(
    rule.grapheme == "─" and rule.style.dim,
    "picker input should end with a dim rule",
  )
  let selected_surface = application.frame().cell(0, 4).expect("selected picker surface")
  try assertions::assert(
    selected_surface.style.background.expect("active background").index.expect("host palette index") == Uint8::from(4),
    "selected picker option should use the active background",
  )
  let selected_label = application.frame().cell(1, 4).expect("selected picker label")
  try assertions::assert(
    selected_label.style.foreground.expect("active foreground").index.expect("host palette index") == Uint8::from(15) and selected_label.style.background.expect("active text background").index.expect("host palette index") == Uint8::from(4) and selected_label.style.bold,
    "selected picker option should use readable active text",
  )
  application.mouse_move(2, 5)
  application.render()
  try assertions::assert(
    application.frame().cell(
      0,
      5,
    ).expect(
      "selected hover surface",
    ).style.background.expect("selected background").index.expect("host palette index") == Uint8::from(4),
    "selected background should take precedence over hover",
  )
  application.mouse_move(2, 2)
  application.render()
  let hovered_surface = application.frame().cell(0, 2).expect("hovered picker surface")
  try assertions::assert(
    hovered_surface.style.background.expect("hover background").index.expect("host palette index") == Uint8::from(8),
    "hovered picker option should use the hover background",
  )
  application.mouse_move(2, 4)
  application.render()
  try assertions::assert(
    application.frame().cell(
      0,
      2,
    ).expect(
      "restored picker surface",
    ).style.background.expect("default background").terminal_default,
    "leaving an option should restore its terminal-default background",
  )
  picker.focus()

  application.key(key("down", ""))
  application.key(key("return", ""))
  try assertions::assert(selection.id == "done", "keyboard selection should activate highlighted option")
  try assertions::assert(selection.count == 1, "selection callback should run once")

  picker.apply_filter("progress")
  try assertions::assert(picker.filtered.size() == 1, "filter should match label case-insensitively")
  try assertions::assert(
    picker.filtered.at(0).expect("match").id == "doing",
    "matching option should remain",
  )
  picker.apply_filter("completed")
  assertions::assert(
    picker.filtered.at(0).expect("description match").id == "done",
    "description should be searchable",
  )
}

test fn small_picker_hides_filter_and_supports_direct_navigation() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let picker = picker_controller::new(
    application.context,
    theme::new(),
    "Filter states",
    options(),
    "",
    fn(option: picker_controller::Option) {
      selection.id = option.id
      selection.count =+ 1
    },
  )
  application.root.add(picker.root)
  picker.focus()
  application.render()
  try assertions::assert(not picker.filterable, "five or fewer options should not show a filter")
  try assertions::assert(
    not application.frame().text().contains("Filter states"),
    "small picker should omit its filter placeholder",
  )
  application.key(key("j", "j"))
  application.key(key("space", " "))
  try assertions::assert(selection.id == "doing", "j and Space should navigate and activate directly")
  assertions::assert(selection.count == 1, "small picker should activate once")
}

test fn picker_renders_empty_state_and_ignores_empty_activation() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let picker = picker_controller::new(
    application.context,
    theme::new(),
    "Filter",
    filter_options(),
    "",
    fn(option: picker_controller::Option) {
      selection.count =+ 1
    },
  )
  application.root.add(picker.root)
  picker.apply_filter("no such state")
  application.render()
  try testing::assert_contains(application.frame().text(), "No matches")
  picker.focus()
  application.key(key("return", ""))
  assertions::assert(selection.count == 0, "empty picker should not activate")
}

test fn picker_mouse_selects_visible_row() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let picker = picker_controller::new(
    application.context,
    theme::new(),
    "Filter",
    filter_options(),
    "",
    fn(option: picker_controller::Option) {
      selection.id = option.id
      selection.count =+ 1
    },
  )
  application.root.add(picker.root)
  application.render()
  application.click(2, 5)
  try assertions::assert(selection.id == "doing", "clicking second row should select it")
  assertions::assert(selection.count == 1, "mouse selection should activate once")
}

test fn picker_disposal_removes_listeners() Void!Str {
  let application = testing::new(40, 12)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let picker = picker_controller::new(
    application.context,
    theme::new(),
    "Filter",
    options(),
    "",
    fn(option: picker_controller::Option) {
      selection.count =+ 1
    },
  )
  application.root.add(picker.root)
  picker.dispose()
  picker.dispose()
  try assertions::assert(picker.disposed, "picker disposal should be idempotent")
  assertions::assert(picker.rows.size() == 0, "disposed picker should release row records")
}
