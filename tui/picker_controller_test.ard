use ard/testing as assertions

use cooper
use cooper/event
use cooper/cui/renderer
use cooper/testing
use tinear/tui/picker_controller
use tinear/tui/theme

private struct Selection {
  id: Str,
  count: Int,
}

private fn options() [picker_controller::Option] {
  [
    picker_controller::Option{
      id: "todo",
      label: "Todo",
      description: "Unstarted",
    },
    picker_controller::Option{
      id: "doing",
      label: "In Progress",
      description: "Started",
    },
    picker_controller::Option{
      id: "done",
      label: "Done",
      description: "Completed",
    },
  ]
}

private fn filter_options() [picker_controller::Option] {
  let values = mut options()
  values.push(
    picker_controller::Option{
      id: "canceled",
      label: "Canceled",
      description: "Canceled",
    },
  )
  values.push(
    picker_controller::Option{
      id: "duplicate",
      label: "Duplicate",
      description: "Canceled",
    },
  )
  values.push(
    picker_controller::Option{
      id: "backlog",
      label: "Backlog",
      description: "Backlog",
    },
  )
  values.@
}

private fn five_options() [picker_controller::Option] {
  let values = filter_options()
  [
    values.at(0).expect("first"),
    values.at(1).expect("second"),
    values.at(2).expect("third"),
    values.at(3).expect("fourth"),
    values.at(4).expect("fifth"),
  ]
}

private fn key(name: Str, text: Str) mut cooper::KeyEvent {
  event::key(
    name,
    text,
    cooper::KeyEventType::press,
    cooper::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

private fn mount(
  application: testing::TestApp,
  placeholder: Str,
  values: [picker_controller::Option],
  selected_id: Str,
  selection: mut Selection,
) renderer::Renderer {
  let mounted = renderer::mount(
    application.context,
    application.root,
    picker_controller::view(
      theme::new(),
      placeholder,
      values,
      selected_id,
      fn(option: picker_controller::Option) {
        selection.id = option.id
        selection.count =+ 1
      },
    ),
  )
  let _ = application.flush()
  application.render()
  mounted
}

// Background color of the first cell on a frame row.
private fn row_background(application: testing::TestApp, y: Int) Uint8 {
  match application.frame().cell(0, y) {
    cell => {
      match cell.style.background {
        color => color.index.or(Uint8::from(0)),
        _ => Uint8::from(0),
      }
    },
    _ => Uint8::from(0),
  }
}

test fn picker_filters_navigates_and_selects() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", filter_options(), "doing", selection)
  defer mounted.destroy()

  try testing::assert_contains(application.frame().text(), "In Progress")
  let rule = application.frame().cell(0, 1).expect("picker rule")
  try assertions::assert(
    rule.grapheme == "─" and rule.style.dim,
    "picker input should end with a dim rule",
  )
  try assertions::assert(
    row_background(application, 4) == Uint8::from(4),
    "selected picker option should use the active background",
  )
  let selected_label = application.frame().cell(1, 4).expect("selected picker label")
  try assertions::assert(
    selected_label.style.foreground.expect("active foreground").index.expect("host palette index") == Uint8::from(15) and selected_label.style.bold,
    "selected picker option should use readable active text",
  )

  application.mouse_move(2, 2)
  let _ = application.flush()
  application.render()
  try assertions::assert(
    row_background(application, 2) == Uint8::from(8),
    "hovered picker option should use the hover background",
  )
  application.mouse_move(2, 4)
  let _ = application.flush()
  application.render()
  try assertions::assert(
    row_background(application, 4) == Uint8::from(4),
    "selected background should take precedence over hover",
  )

  // Filtering is case-insensitive over labels and descriptions.
  application.paste(event::paste("progress"))
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "In Progress")
  try assertions::assert(
    not application.frame().text().contains("Backlog"),
    "filter should drop non-matching labels",
  )
  application.key(key("return", ""))
  let _ = application.flush()
  try assertions::assert(selection.id == "doing", "Enter should select the filtered option")
  assertions::assert(selection.count == 1, "activation should report once")
}

test fn picker_filter_matches_descriptions_and_resets_cursor() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", filter_options(), "doing", selection)
  defer mounted.destroy()

  application.paste(event::paste("completed"))
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Done")
  application.key(key("return", ""))
  let _ = application.flush()
  try assertions::assert(selection.id == "done", "description matches should be selectable")
  assertions::assert(
    row_background(application, 2) == Uint8::from(4),
    "filtering should reset the cursor to the first match",
  )
}

test fn small_picker_hides_filter_and_supports_direct_navigation() Void!Str {
  let application = testing::new(50, 14)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", options(), "", selection)
  defer mounted.destroy()

  try assertions::assert(
    not application.frame().text().contains("Filter states"),
    "five or fewer options should not show a filter",
  )
  try assertions::assert(
    row_background(application, 0) == Uint8::from(4),
    "small picker should start on its first option",
  )
  application.key(key("j", "j"))
  let _ = application.flush()
  application.render()
  try assertions::assert(
    row_background(application, 2) == Uint8::from(4),
    "j should advance the cursor without a filter",
  )
  application.key(key("k", "k"))
  let _ = application.flush()
  application.render()
  try assertions::assert(
    row_background(application, 0) == Uint8::from(4),
    "k should move back",
  )
  application.key(key("down", ""))
  application.key(key("space", " "))
  let _ = application.flush()
  assertions::assert(selection.id == "doing", "space should activate without a filter")
}

test fn five_options_stay_unfiltered() Void!Str {
  let application = testing::new(50, 16)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", five_options(), "", selection)
  defer mounted.destroy()
  assertions::assert(
    not application.frame().text().contains("Filter states"),
    "the filter threshold is exclusive at five options",
  )
}

test fn picker_renders_empty_state_and_ignores_empty_activation() Void!Str {
  let application = testing::new(50, 14)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", filter_options(), "", selection)
  defer mounted.destroy()

  application.paste(event::paste("no such state"))
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "No matches")
  application.key(key("return", ""))
  let _ = application.flush()
  assertions::assert(selection.count == 0, "activation with no matches should be inert")
}

test fn picker_mouse_selects_visible_row() Void!Str {
  let application = testing::new(50, 14)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", options(), "", selection)
  defer mounted.destroy()

  application.click(2, 2)
  let _ = application.flush()
  try assertions::assert(selection.id == "doing", "clicking a row should select it")
  assertions::assert(selection.count == 1, "clicking should activate once")
}

test fn unmounted_picker_stops_reporting_selections() Void!Str {
  let application = testing::new(50, 14)
  defer application.destroy()
  let selection = mut Selection{id: "", count: 0}
  let mounted = mount(application, "Filter states", options(), "", selection)
  mounted.destroy()
  mounted.destroy()
  let _ = application.flush()
  application.render()
  application.click(2, 2)
  application.key(key("return", ""))
  let _ = application.flush()
  try assertions::assert(selection.count == 0, "retired picker should not report selections")
  assertions::assert(
    not application.frame().text().contains("Todo"),
    "retired picker should stop painting",
  )
}
