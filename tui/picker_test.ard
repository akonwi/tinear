use ard/testing

use tinear/tui/picker

fn props(labels: [Str]) picker::Props {
  mut options: [picker::Option] = []
  for label in labels {
    options.push(picker::Option{id: label, label: label, current: false})
  }
  picker::Props{
    key: "test",
    title: "Test",
    options: options,
    width: Maybe::new(),
    on_confirm: fn(opt: picker::Option) {},
  }
}

test fn filter_appears_above_threshold() Void!Str {
  try testing::assert(
    not picker::filterable(props(["a", "b", "c", "d", "e"])),
    "5 options should not be filterable",
  )
  testing::assert(
    picker::filterable(props(["a", "b", "c", "d", "e", "f"])),
    "6 options should be filterable",
  )
}

test fn visible_options_filters_case_insensitively() Void!Str {
  let p = props(["Zoom Replacement", "Focused Care", "Task Platform", "care packages"])
  let matched = picker::visible_options(p, "CARE")
  try testing::assert(matched.size() == 2, "substring should match case-insensitively")
  try testing::assert(matched.at(0).expect("bounds").label == "Focused Care", "original order kept")
  testing::assert(matched.at(1).expect("bounds").label == "care packages", "lowercase label matches")
}

test fn empty_filter_matches_everything() Void!Str {
  let p = props(["a", "b", "c"])
  try testing::assert(picker::visible_options(p, "").size() == 3, "empty filter matches all")
  try testing::assert(picker::visible_options(p, "  ").size() == 3, "whitespace filter matches all")
  testing::assert(picker::visible_options(p, "zzz").size() == 0, "no match yields empty list")
}
