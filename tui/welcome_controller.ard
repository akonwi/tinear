use cooper
use cooper/cui
use cooper/ui
use tinear/services/auth
use tinear/tui/theme as tinear_theme

// Declarative welcome screen. Authentication supersession uses a request
// counter; unmount closes the view cancellation channel and mount-scoped
// dispatch suppresses late completions.
struct WelcomeProps {
  palette: tinear_theme::Theme,
  authenticate: auth::Authenticate,
  on_success: fn(Str),
}

struct Welcome {
  props: mut WelcomeProps,
  draft: Str,
  loading: Bool,
  error: Str,
  request: Int,
  initial_focus_pending: Bool,
  button_focused: Bool,
  button: mut cui::BoxRef,
  stop: Chan<Bool>,
}

private fn welcome(props: mut WelcomeProps) mut Welcome {
  (mut Welcome{
    props: props,
    draft: "",
    loading: false,
    error: "",
    request: 0,
    initial_focus_pending: true,
    button_focused: false,
    button: cui::box_ref(),
    stop: Chan::new<Bool>(),
  })
}

fn view(
  palette: tinear_theme::Theme,
  authenticate: auth::Authenticate,
  on_success: fn(Str),
) cui::View {
  cui::child(
    welcome,
    WelcomeProps{
      palette: palette,
      authenticate: authenticate,
      on_success: on_success,
    },
    key: "welcome",
  )
}

impl Welcome {
  private fn mut submit(ctx: cui::Context) {
    if not self.loading {
      let api_key = self.draft.trim()
      if api_key.is_empty() {
        self.error = "Enter an API key"
      } else {
        self.error = ""
        self.loading = true
        self.request =+ 1
        let request = self.request
        let dispatch = ctx.dispatch
        (self.props.authenticate)(api_key, self.stop.receiver(), fn(result: Void!Str) {
          let _ = dispatch(fn() {
            if self.request == request {
              self.loading = false
              match result {
                ok(_) => (self.props.on_success)(api_key),
                err(message) => {
                  self.error = message
                },
              }
            }
          })
        })
      }
    }
  }
}

impl cui::Lifecycle for Welcome {
  fn mut mounted(ctx: cui::Context) {
    // Focus is described only for the initial commit; afterwards it stays
    // imperative so renders cannot steal focus from the login button.
    let _ = ctx.dispatch(fn() {
      self.initial_focus_pending = false
    })
    match self.button.current {
      panel => {
        let _ = panel.node().on_focus(fn() {
          let _ = ctx.dispatch(fn() {
            self.button_focused = true
          })
        })
        let _ = panel.node().on_blur(fn() {
          let _ = ctx.dispatch(fn() {
            self.button_focused = false
          })
        })
      },
      _ => (),
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    self.stop.close()
  }
}

impl cui::Component for Welcome {
  fn mut render() cui::View {
    let palette = self.props.palette
    let border_color = match self.button_focused {
      true => palette.accent,
      false => palette.border,
    }
    cui::box(
      [
        cui::box(
          [
            cui::text(
              "▀█▀ ▀ █▀█ █▀▀ ▄▀█ █▀█\n █  █ █ █ ██▄ █▀█ █▀▄",
              selectable: false,
              text_style: ui::text_style(foreground: palette.accent, bold: true),
            ),
            cui::text("Enter your Linear API key", selectable: false),
            cui::input(
              self.draft,
              placeholder: "lin_api_…",
              styles: ui::style(width: ui::cells(44), height: ui::cells(1)),
              focused: match self.initial_focus_pending {
                true => Maybe::new(true),
                false => Maybe::new<Bool>(),
              },
              on_input: fn(value: Str, ctx: cui::Context) {
                self.draft = value
              },
              on_submit: fn(value: Str, ctx: cui::Context) {
                self.submit(ctx)
              },
            ),
            cui::box(
              [
                cui::text(
                  match self.loading {
                    true => "Signing in…",
                    false => "Login",
                  },
                  selectable: false,
                ),
              ],
              ref: self.button,
              styles: ui::style(
                border: ui::Border::rounded,
                border_color: border_color,
                width: ui::cells(14),
                height: ui::cells(3),
                align_items: ui::Align::center,
                justify_content: ui::Justify::center,
              ),
              on_key: fn(received: mut cooper::KeyEvent, ctx: cui::Context) {
                if received.event_type != cooper::KeyEventType::release and (received.matches("return") or received.matches("space")) {
                  self.submit(ctx)
                  received.prevent_default()
                  received.stop_propagation()
                }
              },
              on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
                if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
                  self.submit(ctx)
                  received.stop_propagation()
                }
              },
            ),
            cui::text(
              match self.loading {
                true => "Validating with Linear",
                false => "",
              },
              selectable: false,
              styles: ui::style(height: ui::cells(1)),
              text_style: ui::text_style(dim: true),
            ),
            cui::text(
              self.error,
              selectable: false,
              styles: ui::style(height: ui::cells(1)),
              text_style: ui::text_style(foreground: palette.danger, bold: true),
            ),
          ],
          styles: ui::style(
            width: ui::cells(48),
            flex_direction: ui::FlexDirection::column,
            align_items: ui::Align::center,
            gap: ui::cells(1),
          ),
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        align_items: ui::Align::center,
        justify_content: ui::Justify::center,
      ),
    )
  }
}
