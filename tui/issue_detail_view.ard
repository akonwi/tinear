use ard/async

use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi
use tinear/models/issues
use tinear/os
use tinear/tui/compose_view
use tinear/tui/hints_bar
use tinear/tui/issue_pickers
use tinear/tui/markdown
use tinear/tui/modal
use tinear/tui/refresh
use tinear/tui/state
use tinear/tui/text
use tinear/tui/toast

// Issue detail tab.
//
// Layout:
//   ┌────────────────────────────────────────────┐
//   │ <identifier>   <title>                      │  ← sticky header
//   │ Status   X      Priority  Y                 │
//   │ Assignee Z      Cycle     W                 │
//   │ Project  P      Team      T                 │
//   ├────────────────────────────────────────────┤
//   │ Description │ Comments (N)                  │  ← section tabs
//   ├────────────────────────────────────────────┤
//   │ <wrapped section body>                      │   scrollable (j/k)
//   └────────────────────────────────────────────┘
//
// Compose (`n`) and the state/cycle pickers (`s`/`y`) return with the
// modal slice.

// Section identifiers for the tabbed body. Stored as a small Int so it
// matches the existing style of small tab indexes in this codebase.
let SECTION_DESCRIPTION: Int = 0
let SECTION_COMMENTS: Int = 1

struct Detail {
  started: Bool,

  // Loaded issue (populated on first fetch). Identifier is held
  // separately so we can show "Loading {identifier}…" until the first
  // fetch completes.
  identifier: Str,
  issue: issues::Issue?,
  issue_loading: Bool,
  issue_error: Str,

  // Comments.
  comments: [issues::Comment],
  comments_loading: Bool,
  comments_error: Str,

  // Guards stale issue snapshots: loads capture the generation when
  // they start and only apply if it hasn't moved (a successful save
  // bumps it, so an older periodic refresh can't reinstall the
  // pre-save description).
  issue_generation: Int,

  // In-place description editing (Description section only). The
  // draft is separate from the issue so a background refresh can't
  // clobber unsaved edits.
  editing_description: Bool,
  description_draft: Str,
  description_saving: Bool,
  description_error: Str,

  // Stops the per-tab periodic refresh loop on dispose.
  refresh_stop: Chan<Bool>,

  // Body scroll controller.
  scroll: mut ui::ScrollController,

  // Active section in the description/comments tab bar.
  active_section: Int,
}

// ── Async loads ──────────────────────────────────────────────────────

fn load_issue(c: mut ffi::StateCtx, api_key: Str, identifier: Str) {
  let generation = ffi::StateValue<Detail>(c).issue_generation
  async::start(
    fn() {
      let result = issues::load_issue(api_key, identifier)
      ffi::Dispatch(
        c,
        fn() {
          if ffi::StateValue<Detail>(c).issue_generation == generation {
            ffi::Update<Detail>(
              c,
              fn(v: mut Detail) {
                match result {
                  ok(issue) => {
                    v.issue = Maybe::new(issue)
                    v.issue_error = ""
                  },
                  err(e) => { v.issue_error = e },
                }
                v.issue_loading = false
              },
            )
          }
        },
      )
    },
  )
}

fn load_comments(c: mut ffi::StateCtx, api_key: Str, identifier: Str) {
  async::start(
    fn() {
      let result = issues::load_comments(api_key, identifier)
      ffi::Dispatch(
        c,
        fn() {
          ffi::Update<Detail>(
            c,
            fn(v: mut Detail) {
              match result {
                ok(comments) => {
                  v.comments = comments
                  v.comments_error = ""
                },
                err(e) => { v.comments_error = e },
              }
              v.comments_loading = false
            },
          )
        },
      )
    },
  )
}

// Dispatched by the compose modal after a successful create_comment.
// We re-fetch comments and scroll to the end so the new comment is
// visible. The fetch stays on a background fiber so the modal can
// close immediately.
fn refresh_comments_after_post(c: mut ffi::StateCtx, api_key: Str, identifier: Str) {
  async::start(
    fn() {
      let refreshed = issues::load_comments(api_key, identifier)
      ffi::Dispatch(
        c,
        fn() {
          ffi::Update<Detail>(
            c,
            fn(v: mut Detail) {
              match refreshed {
                ok(comments) => {
                  v.comments = comments
                  v.comments_error = ""
                },
                err(e) => { v.comments_error = e },
              }
              v.scroll.ScrollToEnd()
            },
          )
        },
      )
    },
  )
}

// Silent refresh of both the issue and its comments. Used by the
// background refresh loop. Errors surface as toasts but don't touch
// the existing data — the user keeps the last good snapshot.
fn refresh_detail(
  c: mut ffi::StateCtx,
  api_key: Str,
  identifier: Str,
  notify: fn(Str, Str, toast::ToastVariant),
) {
  let generation = ffi::StateValue<Detail>(c).issue_generation
  async::start(
    fn() {
      let issue_result = issues::load_issue(api_key, identifier)
      match issue_result {
        ok(issue) => {
          ffi::Dispatch(
            c,
            fn() {
              // Discard snapshots that started before a save landed.
              if ffi::StateValue<Detail>(c).issue_generation == generation {
                ffi::Update<Detail>(
                  c,
                  fn(v: mut Detail) {
                    v.issue = Maybe::new(issue)
                    v.issue_error = ""
                  },
                )
              }
            },
          )
        },
        err(e) => notify("Issue refresh", e, toast::ToastVariant::error),
      }
    },
  )
  async::start(
    fn() {
      let comments_result = issues::load_comments(api_key, identifier)
      match comments_result {
        ok(comments) => {
          ffi::Dispatch(
            c,
            fn() {
              ffi::Update<Detail>(
                c,
                fn(v: mut Detail) {
                  v.comments = comments
                  v.comments_error = ""
                },
              )
            },
          )
        },
        err(e) => notify("Comments refresh", e, toast::ToastVariant::error),
      }
    },
  )
}

// ── Layout helpers ───────────────────────────────────────────────────

fn min_column(children: [ui::Widget], stretch: Bool) ui::Widget {
  match stretch {
    true => {
      ui::Flex{
        Axis: ui::Vertical,
        MainAxisSize: ui::MainAxisSizeMin,
        CrossAxisAlignment: ui::CrossAxisStretch,
        Children: children,
      }
    },
    false => {
      ui::Flex{
        Axis: ui::Vertical,
        MainAxisSize: ui::MainAxisSizeMin,
        CrossAxisAlignment: ui::CrossAxisCenter,
        Children: children,
      }
    },
  }
}

fn muted(theme: ui::Theme, value: Str) ui::Widget {
  ui::Text{Value: value, Style: ui::Style{Foreground: theme.MutedForeground}}
}

fn blank_line() ui::Widget {
  ui::SizedBox{Height: 1}
}

fn divider(theme: ui::Theme) ui::Widget {
  ui::Divider{Style: ui::Style{Foreground: theme.Border, Background: theme.Background}}
}

fn value_or_dash(value: Str) Str {
  match value.is_empty() {
    true => "—",
    false => value,
  }
}

// One labelled field: "Label  Value" with a fixed-width label column.
fn field_pair(theme: ui::Theme, label: Str, value: Str, value_width: Int) ui::Widget {
  mut children: [ui::Widget] = [
    ui::SizedBox{
      Width: 10,
      Height: 1,
      Child: muted(theme, label),
    },
    ui::SizedBox{
      Width: value_width,
      Height: 1,
      Child: ui::Text{
        Value: text::truncate_with_ellipsis(value_or_dash(value), value_width),
        Style: ui::Style{Foreground: theme.Foreground},
      },
    },
  ]
  ui::Flex{Axis: ui::Horizontal, Children: children}
}

fn field_row(theme: ui::Theme, left_label: Str, left_value: Str, right_label: Str, right_value: Str) ui::Widget {
  mut children: [ui::Widget] = [
    field_pair(theme, left_label, left_value, 24),
    ui::SizedBox{Width: 3, Height: 1},
    field_pair(theme, right_label, right_value, 24),
  ]
  ui::Flex{Axis: ui::Horizontal, Children: children}
}

fn priority_value(issue: issues::Issue) Str {
  let label = state::priority_label(issue.priority)
  let glyph = state::priority_glyph(issue.priority)
  match glyph.trim().is_empty() {
    true => label,
    false => "{glyph} {label}",
  }
}

fn metadata_header(theme: ui::Theme, issue: issues::Issue) ui::Widget {
  mut title_children: [ui::Widget] = [
    ui::Text{
      Value: issue.identifier,
      Style: ui::Style{Foreground: theme.Foreground, Attribute: ui::AttrBold},
    },
    ui::Text{Value: "  "},
    ui::Expanded(
      ui::Text{Value: issue.title, Style: ui::Style{Foreground: theme.Foreground, Attribute: ui::AttrBold}},
    ),
  ]
  min_column(
    [
      ui::Flex{Axis: ui::Horizontal, Children: title_children},
      blank_line(),
      field_row(theme, "Status", issue.state_name, "Priority", priority_value(issue)),
      field_row(theme, "Assignee", issue.assignee_name, "Cycle", issue.cycle_label),
      field_row(theme, "Project", issue.project_name, "Team", issue.team_name),
    ],
    true,
  )
}

// Section-tab chip. Matches the app-level tab_chip styling in
// logged_in_screen.ard so the description/comments toggle reads as the
// same control to the user.
fn section_tab(theme: ui::Theme, label: Str, active: Bool, on_press: fn(ui::EventContext)) ui::Widget {
  let padded = " {label} "
  match active {
    true => {
      ui::Text{
        Value: padded,
        Style: ui::Style{Foreground: theme.Foreground, Background: theme.Primary},
        OnPressed: on_press,
        ClickAffordance: ui::ClickAffordanceNone,
      }
    },
    false => {
      ui::Text{
        Value: padded,
        Style: ui::Style{Foreground: theme.MutedForeground},
        OnPressed: on_press,
        ClickAffordance: ui::ClickAffordanceNone,
      }
    },
  }
}

fn switch_section(c: mut ffi::StateCtx, target: Int) {
  if not ffi::StateValue<Detail>(c).active_section == target {
    ffi::Update<Detail>(
      c,
      fn(v: mut Detail) {
        v.active_section = target
        // Reset scroll so the new section starts at the top — the previous
        // section's offset would otherwise be applied to unrelated content.
        v.scroll.ScrollToStart()
      },
    )
  }
}

fn start_editing_description(c: mut ffi::StateCtx) {
  let current = ffi::StateValue<Detail>(c)
  match current.issue {
    issue => {
      ffi::Update<Detail>(
        c,
        fn(v: mut Detail) {
          v.active_section = SECTION_DESCRIPTION
          v.editing_description = true
          v.description_draft = issue.description.or("")
          v.description_error = ""
        },
      )
    },
    _ => (),
  }
}

fn cancel_editing_description(c: mut ffi::StateCtx) {
  ffi::Update<Detail>(
    c,
    fn(v: mut Detail) {
      v.editing_description = false
      v.description_saving = false
      v.description_error = ""
    },
  )
}

fn save_description(
  c: mut ffi::StateCtx,
  api_key: Str,
  identifier: Str,
  notify: fn(Str, Str, toast::ToastVariant),
) {
  let current = ffi::StateValue<Detail>(c)
  match current.issue {
    issue => {
      if not current.description_saving {
        let text = current.description_draft
        ffi::Update<Detail>(
          c,
          fn(v: mut Detail) {
            v.description_saving = true
            v.description_error = ""
          },
        )
        async::start(
          fn() {
            let result = issues::update_description(api_key, issue.id, text)
            ffi::Dispatch(
              c,
              fn() {
                match result {
                  ok(_) => {
                    // No success toast: the re-rendered description IS
                    // the feedback (applied optimistically from the
                    // draft). Bumping the generation invalidates any
                    // in-flight pre-save refresh; the follow-up load
                    // reconciles with the server. Errors surface inline.
                    ffi::Update<Detail>(
                      c,
                      fn(v: mut Detail) {
                        v.editing_description = false
                        v.description_saving = false
                        v.issue_generation = v.issue_generation + 1
                        match v.issue {
                          loaded => {
                            mut updated = loaded
                            updated.description = Maybe::new(text)
                            v.issue = Maybe::new(updated)
                          },
                          _ => (),
                        }
                      },
                    )
                    load_issue(c, api_key, identifier)
                  },
                  err(e) => {
                    ffi::Update<Detail>(
                      c,
                      fn(v: mut Detail) {
                        v.description_saving = false
                        v.description_error = e
                      },
                    )
                  },
                }
              },
            )
          },
        )
      }
    },
    _ => (),
  }
}

// Tab bar for the body sections: "Description" and "Comments (N)" side
// by side, separated by the same theme.Border pipe used by the
// app-level tab bar, with a border underneath.
fn section_tabs(c: mut ffi::StateCtx, theme: ui::Theme, model: Detail) ui::Widget {
  let comments_label = match model.comments_loading {
    true => "Comments",
    false => "Comments ({model.comments.size()})",
  }
  mut tab_children: [ui::Widget] = [
    section_tab(
      theme,
      "Description",
      model.active_section == SECTION_DESCRIPTION,
      fn(ev: ui::EventContext) {
        switch_section(c, SECTION_DESCRIPTION)
      },
    ),
    ui::Text{Value: "│", Style: ui::Style{Foreground: theme.Border}},
    section_tab(
      theme,
      comments_label,
      model.active_section == SECTION_COMMENTS,
      fn(ev: ui::EventContext) {
        switch_section(c, SECTION_COMMENTS)
      },
    ),
  ]
  min_column([ui::Flex{Axis: ui::Horizontal, Children: tab_children}, divider(theme)], true)
}

fn description_body_widget(theme: ui::Theme, issue: issues::Issue) ui::Widget {
  match issue.description {
    desc => {
      match desc.is_empty() {
        true => muted(theme, "(no description)"),
        false => markdown::render(theme, desc),
      }
    },
    _ => muted(theme, "(no description)"),
  }
}

// In-place editor shown in the Description slot while editing. The
// error/saving slots are always present so the widget shape stays
// stable across state transitions.
fn description_editor(c: mut ffi::StateCtx, theme: ui::Theme, model: Detail) ui::Widget {
  // Both slots keep one widget type across states (empty Text when
  // there's nothing to say) so reconciliation never sees a type swap.
  let error_widget: ui::Widget = match model.description_error.is_empty() {
    true => ui::Text{Value: ""},
    false => ui::Text{Value: "⚠ {model.description_error}", Style: ui::Style{Foreground: theme.DangerText}},
  }
  let status_widget: ui::Widget = match model.description_saving {
    true => ui::Text{Value: "Saving…", Style: ui::Style{Foreground: theme.MutedForeground}},
    false => ui::Text{Value: "Ctrl+↵ save · Esc cancel", Style: ui::Style{Foreground: theme.MutedForeground}},
  }
  mut children: [ui::Widget] = [
    error_widget,
    ui::FocusScope{
      AutoFocus: true,
      Child: ui::TextArea{
        Value: model.description_draft,
        Placeholder: "Describe the issue… (markdown)",
        MinWidth: 70,
        MinHeight: 12,
        SoftWrap: true,
        OnChanged: fn(ev: ui::EventContext, value: Str) {
          ffi::Update<Detail>(
            c,
            fn(v: mut Detail) {
              v.description_draft = value
              v.description_error = ""
            },
          )
        },
      },
    },
    status_widget,
  ]
  min_column(children, true)
}

fn comment_card(theme: ui::Theme, comment: issues::Comment) ui::Widget {
  mut header_children: [ui::Widget] = []
  if comment.depth > 0 {
    header_children.push(muted(theme, "↳ "))
  }
  header_children.push(
    ui::Text{Value: comment.author, Style: ui::Style{Foreground: theme.Foreground, Attribute: ui::AttrBold}},
  )
  header_children.push(muted(theme, " · "))
  header_children.push(muted(theme, text::format_date(comment.created_at)))
  mut children: [ui::Widget] = [ui::Flex{Axis: ui::Horizontal, Children: header_children}, markdown::render(theme, comment.body)]
  let card = min_column(children, true)
  // Replies indent under their parent; Linear threads are one level
  // deep, so a single indent step is all there is.
  match comment.depth > 0 {
    true => ui::Padding(ui::Insets{Left: 3}, card),
    false => card,
  }
}

fn comments_body(theme: ui::Theme, comments: [issues::Comment], loading: Bool, error: Str) ui::Widget {
  match {
    loading => muted(theme, "Loading comments…"),
    not error.is_empty() => {
      ui::Text{Value: "Unable to load comments: {error}", Style: ui::Style{Foreground: theme.DangerText}}
    },
    comments.size() == 0 => muted(theme, "(no comments)"),
    _ => {
      mut rows: [ui::Widget] = []
      let last_idx = comments.size() - 1
      for comment, idx in comments {
        rows.push(comment_card(theme, comment))
        if not idx == last_idx {
          // Separator lives at the list level so it stays full width
          // even when the card above it is an indented reply.
          rows.push(ui::Padding(ui::Symmetric(0, 1), divider(theme)))
        }
      }
      min_column(rows, true)
    },
  }
}

// Build whichever section's body is active. Both arms return
// Padding(column(...)) so the widget type at this slot stays stable
// across section switches — the conditional content changes one level
// deeper, which reconciliation handles cleanly.
fn active_body(c: mut ffi::StateCtx, theme: ui::Theme, issue: issues::Issue, model: Detail) ui::Widget {
  let inner = match {
    model.active_section == SECTION_COMMENTS => comments_body(theme, model.comments, model.comments_loading, model.comments_error),
    model.editing_description => description_editor(c, theme, model),
    _ => description_body_widget(theme, issue),
  }
  ui::Padding(ui::Symmetric(1, 0), min_column([inner], true))
}

// ── Top-level layout ─────────────────────────────────────────────────

fn loaded_layout(c: mut ffi::StateCtx, theme: ui::Theme, issue: issues::Issue, model: Detail) ui::Widget {
  mut children: [ui::Widget] = [
    ui::Padding(ui::Symmetric(1, 0), metadata_header(theme, issue)),
    divider(theme),
    ui::Padding(ui::Symmetric(1, 0), section_tabs(c, theme, model)),
    ui::Expanded(ui::ScrollView{Controller: model.scroll, Child: active_body(c, theme, issue, model)}),
  ]
  let content = ui::Flex{
    Axis: ui::Vertical,
    CrossAxisAlignment: ui::CrossAxisStretch,
    Children: children,
  }

  // One SelectionArea wraps the whole tab so mouse-drag selection spans
  // the sticky header (id, title, field grid) and the scrollable body
  // alike. Interactive children (the section tab chips) still click:
  // clickable Text fires OnPressed at the target phase and returns
  // Handled before the ancestor SelectionArea sees the press in the
  // bubble phase. Cmd+C (Super+c) copies whatever is selected; the app
  // root binds Ctrl+C to quit.
  ui::SelectionArea{Child: content}
}

fn loading_placeholder(theme: ui::Theme, identifier: Str) ui::Widget {
  ui::Center(muted(theme, "Loading {identifier}…"))
}

fn error_placeholder(theme: ui::Theme, identifier: Str, error: Str) ui::Widget {
  ui::Center(
    min_column(
      [
        ui::Text{
          Value: "Couldn't load {identifier}",
          Style: ui::Style{Foreground: theme.DangerText, Attribute: ui::AttrBold},
        },
        blank_line(),
        muted(theme, error),
      ],
      false,
    ),
  )
}

fn shortcut_bindings(editing: Bool) [Str: ui::Intent] {
  match editing {
    true => [
      "Ctrl+Enter": ffi::Intent("issue_detail.save_description"),
      "Ctrl+m": ffi::Intent("issue_detail.save_description"),
      "Ctrl+j": ffi::Intent("issue_detail.save_description"),
    ],
    false => [
      "j": ffi::Intent("issue_detail.scroll_down"),
      "Down": ffi::Intent("issue_detail.scroll_down"),
      "k": ffi::Intent("issue_detail.scroll_up"),
      "Up": ffi::Intent("issue_detail.scroll_up"),
      "d": ffi::Intent("issue_detail.section_description"),
      "e": ffi::Intent("issue_detail.edit_description"),
      "c": ffi::Intent("issue_detail.section_comments"),
      "n": ffi::Intent("issue_detail.compose"),
      "o": ffi::Intent("issue_detail.open_in_browser"),
      "s": ffi::Intent("issue_detail.state_picker"),
      "y": ffi::Intent("issue_detail.cycle_picker"),
      "p": ffi::Intent("issue_detail.priority_picker"),
      "a": ffi::Intent("issue_detail.assignee_picker"),
      "Shift+p": ffi::Intent("issue_detail.project_picker"),
    ],
  }
}

// ── Public widget ────────────────────────────────────────────────────

fn build(
  c: mut ffi::StateCtx,
  ctx: ui::BuildContext,
  api_key: Str,
  identifier: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  active: Bool,
) ui::Widget {
  let theme = ui::MustDepend<ui::Theme>(ctx)
  let model = ffi::StateValue<Detail>(c)
  let editing = model.editing_description

  // Body chooses between loading / error / loaded layouts, wrapped in
  // a stable outer column so the widget type at this slot never
  // changes between rebuilds (widget-reconciliation trap).
  let body_widget = match model.issue {
    issue => loaded_layout(c, theme, issue, model),
    _ => {
      match {
        not model.issue_error.is_empty() => error_placeholder(theme, identifier, model.issue_error),
        _ => loading_placeholder(theme, identifier),
      }
    },
  }
  // Expanded so the body actually fills the available height; the
  // ScrollView inside needs a bounded extent to clip against.
  mut children: [ui::Widget] = [ui::Expanded(body_widget)]
  let inner = ui::Flex{
    Axis: ui::Vertical,
    CrossAxisAlignment: ui::CrossAxisStretch,
    Children: children,
  }

  // While editing, an extra Actions layer shadows intents that must
  // not escape to the shell. Actions lookup stops at the FIRST
  // registered handler (Ignored does not forward to outer Actions),
  // so these handlers exist only in edit mode:
  //   - vaxis.dismiss: cancel the edit (swallowed while saving);
  //     when not editing the binding is absent so Esc still reaches
  //     the shell and closes the tab
  //   - save chords: issue_detail.save_description
  //   - tabs.inbox / tabs.my_issues / global.search: return Ignored —
  //     lookup stops here (shell never switches tabs / opens search)
  //     and the capture-phase key continues to the TextArea as a
  //     typed character (1 / 2 / ?)
  //   - vaxis.next-focus / previous-focus: swallowed so Tab can't
  //     switch app tabs mid-edit
  let editing_bindings: [ui::IntentType: ui::ActionFunc] = [
    "vaxis.dismiss": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      let current = ffi::StateValue<Detail>(c)
      match current.description_saving {
        true => ui::EventHandled,
        false => {
          cancel_editing_description(c)
          ui::EventHandled
        },
      }
    },
    "issue_detail.save_description": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      save_description(c, api_key, identifier, notify)
      ui::EventHandled
    },
    "tabs.inbox": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      ui::EventIgnored
    },
    "tabs.my_issues": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      ui::EventIgnored
    },
    "global.search": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      ui::EventIgnored
    },
    "vaxis.next-focus": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      ui::EventHandled
    },
    "vaxis.previous-focus": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
      ui::EventHandled
    },
  ]
  let no_bindings: [ui::IntentType: ui::ActionFunc] = [:]

  // Only the active issue tab participates in focus management (see
  // the shell's IndexedStack note).
  ui::Actions{
    Bindings: [
      // `n` opens the compose modal. If the user is on the Description
      // section we also switch to Comments first so the freshly-posted
      // comment will show up in context once we re-render.
      "issue_detail.scroll_up": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        model.scroll.ScrollByLines(-1)
        ui::EventHandled
      },
      "issue_detail.scroll_down": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        model.scroll.ScrollByLines(1)
        ui::EventHandled
      },
      "issue_detail.section_description": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).active_section == SECTION_DESCRIPTION {
          true => ui::EventIgnored,
          false => {
            switch_section(c, SECTION_DESCRIPTION)
            ui::EventHandled
          },
        }
      },
      "issue_detail.section_comments": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).active_section == SECTION_COMMENTS {
          true => ui::EventIgnored,
          false => {
            switch_section(c, SECTION_COMMENTS)
            ui::EventHandled
          },
        }
      },
      "issue_detail.compose": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            switch_section(c, SECTION_COMMENTS)
            model.scroll.ScrollToEnd()
            let refresh_cb = fn() {
              refresh_comments_after_post(c, api_key, identifier)
            }
            show_modal(
              fn(theme_inner: ui::Theme, close: fn()) ui::Widget {
                modal::show_modal(
                  theme_inner,
                  "New comment — {issue.identifier}",
                  compose_view::new(api_key, issue, refresh_cb, close),
                  hints_bar::row(
                    theme_inner,
                    [hints_bar::Hint{key: "Ctrl+↵", label: "send"}, hints_bar::Hint{key: "Esc", label: "cancel"}],
                  ),
                  Maybe::new(70),
                  fn(ev2: ui::EventContext) {
                    close()
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.edit_description": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        start_editing_description(c)
        ui::EventHandled
      },
      "issue_detail.open_in_browser": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            if not issue.url.is_empty() {
              let _ = os::open_url(issue.url)
            }
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.state_picker": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            let issue_id = issue.id
            issue_pickers::open_state_picker(
              api_key,
              issue,
              show_modal,
              close_modal,
              notify,
              fn(new_state_id: Str) {
                async::start(
                  fn() {
                    let r = issues::update_state(api_key, issue_id, new_state_id)
                    ffi::Dispatch(
                      c,
                      fn() {
                        match r {
                          ok(_) => load_issue(c, api_key, identifier),
                          err(e) => notify("Update state", e, toast::ToastVariant::error),
                        }
                      },
                    )
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.priority_picker": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            let issue_id = issue.id
            issue_pickers::open_priority_picker(
              issue,
              show_modal,
              fn(new_priority: Int) {
                async::start(
                  fn() {
                    let r = issues::update_priority(api_key, issue_id, new_priority)
                    ffi::Dispatch(
                      c,
                      fn() {
                        match r {
                          ok(_) => load_issue(c, api_key, identifier),
                          err(e) => notify("Update priority", e, toast::ToastVariant::error),
                        }
                      },
                    )
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.assignee_picker": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            let issue_id = issue.id
            issue_pickers::open_assignee_picker(
              api_key,
              issue,
              show_modal,
              close_modal,
              notify,
              fn(new_assignee_id: Str) {
                async::start(
                  fn() {
                    let r = issues::update_assignee(api_key, issue_id, new_assignee_id)
                    ffi::Dispatch(
                      c,
                      fn() {
                        match r {
                          ok(_) => load_issue(c, api_key, identifier),
                          err(e) => notify("Assign", e, toast::ToastVariant::error),
                        }
                      },
                    )
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.project_picker": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            let issue_id = issue.id
            issue_pickers::open_project_picker(
              api_key,
              issue,
              show_modal,
              close_modal,
              notify,
              fn(new_project_id: Str) {
                async::start(
                  fn() {
                    let r = issues::update_project(api_key, issue_id, new_project_id)
                    ffi::Dispatch(
                      c,
                      fn() {
                        match r {
                          ok(_) => load_issue(c, api_key, identifier),
                          err(e) => notify("Update project", e, toast::ToastVariant::error),
                        }
                      },
                    )
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
      "issue_detail.cycle_picker": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match ffi::StateValue<Detail>(c).issue {
          issue => {
            let issue_id = issue.id
            issue_pickers::open_cycle_picker(
              api_key,
              issue,
              show_modal,
              close_modal,
              notify,
              fn(new_cycle_id: Str) {
                async::start(
                  fn() {
                    let r = issues::update_cycle(api_key, issue_id, new_cycle_id)
                    ffi::Dispatch(
                      c,
                      fn() {
                        match r {
                          ok(_) => load_issue(c, api_key, identifier),
                          err(e) => notify("Update cycle", e, toast::ToastVariant::error),
                        }
                      },
                    )
                  },
                )
              },
            )
          },
          _ => (),
        }
        ui::EventHandled
      },
    ],
    Child: ui::Actions{
      Bindings: match editing {
        true => editing_bindings,
        false => no_bindings,
      },
      Child: ui::Shortcuts{
        // While editing, single-key shortcuts would steal typing from
        // the TextArea at the capture phase — bind only the save
        // chords. (State changes rebuild, so the map tracks
        // editing_description.)
        Bindings: shortcut_bindings(editing),
        Child: ui::FocusScope{
          AutoFocus: active,
          ReclaimFocus: active,
          Child: inner,
        },
      },
    },
  }
}

fn new(
  api_key: Str,
  identifier: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  active: Bool,
) ui::Widget {
  ffi::Stateful{
    Key: "issue:{identifier}",
    Init: fn() Any {
      mut scroll = ui::ScrollController{}
      Detail{
        started: false,
        identifier: identifier,
        issue: Maybe::new(),
        issue_loading: true,
        issue_error: "",
        comments: [],
        comments_loading: true,
        comments_error: "",
        issue_generation: 0,
        editing_description: false,
        description_draft: "",
        description_saving: false,
        description_error: "",
        refresh_stop: Chan::new<Bool>(),
        scroll: mut scroll,
        active_section: SECTION_DESCRIPTION,
      }
    },
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      // First-build kick: initial fetches plus the 5-minute background
      // refresh. The stop channel is closed on dispose so closed tabs
      // stop polling.
      let s = ffi::StateRef<Detail>(c)
      if not s.started {
        s.started = true
        load_issue(c, api_key, identifier)
        load_comments(c, api_key, identifier)
        refresh::schedule_periodic(
          s.refresh_stop,
          5 * 60 * 1000,
          fn() {
            refresh_detail(c, api_key, identifier, notify)
          },
        )
      }
      build(c, ctx, api_key, identifier, notify, show_modal, close_modal, active)
    },
    OnDispose: fn(c: mut ffi::StateCtx) {
      let s = ffi::StateValue<Detail>(c)
      s.refresh_stop.close()
    },
  }
}
