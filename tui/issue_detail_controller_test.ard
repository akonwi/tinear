use ard/testing as assertions

use cooper/event
use cooper/testing
use tinear/models/issues
use tinear/services/issue_detail_service
use tinear/tui/issue_detail_controller
use tinear/tui/issue_field_picker_controller
use tinear/tui/theme

struct FakeState {
  issue_loads: [fn(issues::Issue!Str)],
  comment_loads: [fn([issues::Comment]!Str)],
}

struct Scheduled {
  actions: [fn()],
  cancellations: Int,
}

struct Actions {
  opened_url: Str,
  picked: [Str],
  errors: Int,
}

private fn fake_service(state: mut FakeState) issue_detail_service::Service {
  issue_detail_service::Service{
    load_issue: fn(cancellation: Receiver<Bool>, identifier: Str, completion: fn(issues::Issue!Str)) {
      state.issue_loads.push(completion)
    },
    load_comments: fn(cancellation: Receiver<Bool>, identifier: Str, completion: fn([issues::Comment]!Str)) {
      state.comment_loads.push(completion)
    },
  }
}

private fn fake_schedule(state: mut Scheduled) fn(Int, fn()) fn() {
  fn(milliseconds: Int, action: fn()) fn() {
    state.actions.push(action)
    fn() {
      state.cancellations =+ 1
    }
  }
}

private fn issue(title: Str, description: Str) issues::Issue {
  issues::Issue{
    id: "issue-1",
    identifier: "AKO-1",
    title: title,
    description: Maybe::new(description),
    priority: 2,
    state_id: "started",
    state_name: "In Progress",
    state_type: "started",
    state_position: 1.0,
    team_id: "team-1",
    team_name: "Core",
    team_key: "AKO",
    project_id: "project-1",
    project_name: "Tinear",
    assignee_id: "user-1",
    assignee_name: "Alex",
    cycle_id: "cycle-1",
    cycle_label: "Cycle 1",
    url: "https://linear.app/AKO-1",
  }
}

private fn comment(id: Str, author: Str, body: Str, depth: Int) issues::Comment {
  issues::Comment{
    id: id,
    author: author,
    created_at: "2026-01-01",
    body: body,
    parent_id: "",
    depth: depth,
  }
}

private fn key(name: Str, shift: Bool?) mut event::KeyEvent {
  event::key(
    name,
    "",
    event::KeyEventType::press,
    event::Modifiers{
      shift: shift.or(false),
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

private fn make_controller(
  application: testing::TestApp,
  fake: mut FakeState,
  scheduled: mut Scheduled,
  actions: mut Actions,
) mut issue_detail_controller::IssueDetailController {
  issue_detail_controller::new(
    application.context,
    theme::new(),
    "AKO-1",
    fake_service(fake),
    fake_schedule(scheduled),
    fn(url: Str) {
      actions.opened_url = url
    },
    fn(field: issue_field_picker_controller::Field, selected: issues::Issue) {
      let name = match field {
        issue_field_picker_controller::Field::state => "state",
        issue_field_picker_controller::Field::cycle => "cycle",
        issue_field_picker_controller::Field::priority => "priority",
        issue_field_picker_controller::Field::assignee => "assignee",
        issue_field_picker_controller::Field::project => "project",
      }
      actions.picked.push("{name}:{selected.id}")
    },
    fn(title: Str, message: Str) {
      actions.errors =+ 1
    },
  )
}

test fn issue_detail_loads_issue_and_comments_independently_and_routes_commands() Void!Str {
  let application = testing::new(90, 28)
  defer application.destroy()
  let fake = mut FakeState{issue_loads: [], comment_loads: []}
  let scheduled = mut Scheduled{actions: [], cancellations: 0}
  let actions = mut Actions{
    opened_url: "",
    picked: [],
    errors: 0,
  }
  let controller = make_controller(application, fake, scheduled, actions)
  application.root.add(controller.root)
  controller.start()
  try assertions::assert(fake.issue_loads.size() == 1, "issue should load once")
  try assertions::assert(fake.comment_loads.size() == 1, "comments should load independently")

  (fake.comment_loads.at(0).expect("comments"))(
    Result::ok([comment("c1", "Alex", "First **comment**", 0), comment("c2", "Blair", "Reply", 1)]),
  )
  try assertions::assert(controller.comments.size() == 2, "comments may finish before issue")
  (fake.issue_loads.at(0).expect("issue"))(
    Result::ok(issue("Retained detail", "# Description\n\nBody with **markdown**")),
  )
  application.render()
  try testing::assert_contains(application.frame().text(), "AKO-1")
  try testing::assert_contains(application.frame().text(), "Retained detail")
  try testing::assert_contains(application.frame().text(), "Tinear")
  try testing::assert_contains(application.frame().text(), "Core")
  try testing::assert_contains(application.frame().text(), "Description")
  try testing::assert_contains(application.frame().text(), "Body with markdown")

  try assertions::assert(controller.handle_key(key("c")), "c should switch to comments")
  application.render()
  try testing::assert_contains(application.frame().text(), "First comment")
  let focused_comment = controller.comment_records.at(0).expect("focused comment")
  try assertions::assert(
    focused_comment.root.style().background.expect("active background").index.expect("palette") == Uint8::from(4),
    "focused comment should use the same accent background as a focused issue card",
  )
  try assertions::assert(
    focused_comment.header.text_style().foreground.expect("active foreground").index.expect("palette") == Uint8::from(15) and focused_comment.header.text_style().bold and focused_comment.body.active,
    "focused comment content should use bright active text",
  )
  try assertions::assert(controller.handle_key(key("j")), "j should move comment cursor")
  try assertions::assert(controller.comment_cursor == 1, "comment cursor should move")
  try assertions::assert(
    controller.comment_records.at(
      1,
    ).expect(
      "next focused comment",
    ).root.style().background.expect("active background").index.expect("palette") == Uint8::from(4),
    "comment navigation should move the active surface",
  )
  try assertions::assert(controller.handle_key(key("o")), "o should open issue URL")
  try assertions::assert(actions.opened_url == "https://linear.app/AKO-1", "loaded issue URL should open")
  let _ = controller.handle_key(key("p"))
  let _ = controller.handle_key(key("p", shift: true))
  try assertions::assert(
    actions.picked.at(0).expect("priority") == "priority:issue-1",
    "p should open priority picker",
  )
  try assertions::assert(
    actions.picked.at(1).expect("project") == "project:issue-1",
    "P should open project picker",
  )

  controller.refresh(true)
  (fake.comment_loads.at(1).expect("refreshed comments"))(
    Result::ok(
      [
        comment("new", "New", "Inserted", 0),
        comment("c1", "Alex", "First **comment**", 0),
        comment("c2", "Blair", "Reply", 1),
      ],
    ),
  )
  assertions::assert(
    controller.comments.at(controller.comment_cursor).expect("preserved comment").id == "c2",
    "comment refresh should preserve cursor by stable ID",
  )
}

test fn issue_detail_rejects_stale_issue_and_comment_results() Void!Str {
  let application = testing::new(70, 20)
  defer application.destroy()
  let fake = mut FakeState{issue_loads: [], comment_loads: []}
  let scheduled = mut Scheduled{actions: [], cancellations: 0}
  let actions = mut Actions{
    opened_url: "",
    picked: [],
    errors: 0,
  }
  let controller = make_controller(application, fake, scheduled, actions)
  application.root.add(controller.root)
  controller.start()
  controller.refresh(true)
  (fake.issue_loads.at(0).expect("stale issue"))(Result::ok(issue("Stale", "old")))
  (fake.comment_loads.at(0).expect("stale comments"))(
    Result::ok([comment("old", "Old", "stale", 0)]),
  )
  try assertions::assert(controller.issue.is_none(), "older issue generation should be ignored")
  try assertions::assert(controller.comments.size() == 0, "older comments generation should be ignored")

  (fake.issue_loads.at(1).expect("current issue"))(Result::ok(issue("Current", "new")))
  (fake.comment_loads.at(1).expect("current comments"))(
    Result::ok([comment("new", "New", "current", 0)]),
  )
  try assertions::assert(
    controller.issue.expect("loaded").title == "Current",
    "current issue should apply",
  )
  assertions::assert(
    controller.comments.at(0).expect("comment").id == "new",
    "current comments should apply",
  )
}

test fn issue_detail_disposal_cancels_periodic_refresh_and_late_results() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let fake = mut FakeState{issue_loads: [], comment_loads: []}
  let scheduled = mut Scheduled{actions: [], cancellations: 0}
  let actions = mut Actions{
    opened_url: "",
    picked: [],
    errors: 0,
  }
  let controller = make_controller(application, fake, scheduled, actions)
  application.root.add(controller.root)
  controller.start()
  controller.dispose()
  (fake.issue_loads.at(0).expect("late issue"))(Result::ok(issue("Late", "late")))
  (fake.comment_loads.at(0).expect("late comments"))(
    Result::ok([comment("late", "Late", "late", 0)]),
  )
  try assertions::assert(controller.issue.is_none(), "disposed detail should ignore late issue")
  try assertions::assert(controller.comments.size() == 0, "disposed detail should ignore late comments")
  assertions::assert(scheduled.cancellations == 1, "dispose should stop periodic refresh")
}
