use ard/testing

use tinear/tui/core/rect
use tinear/tui/core/view
use tinear/tui/tab_bar
use tinear/vaxis

private extern fn test_vaxis() vaxis::Vaxis = "TestVaxisNil"
private extern fn test_window(width: Int, height: Int) vaxis::Window = "TestWindow"
private extern fn test_line(y: Int) Str = "TestLine"
private extern fn test_cell_reverse(x: Int, y: Int) Bool = "TestCellReverse"

fn test_frame(width: Int, height: Int) view::Frame {
  let vx = test_vaxis()
  let ctx = view::context(vx)
  view::Frame{vx: vx, window: test_window(width, height), tree: ctx.tree, node_id: ctx.node_id, extent: rect::Rect{x: 0, y: 0, w: 0, h: 0}}
}

test fn test_tab_bar_renders_labels_and_separator() Void!Str {
  mut frame = test_frame(30, 2)

  tab_bar::new(["Inbox", "My Issues"]).render(frame)

  testing::assert(test_line(0).starts_with(" Inbox │ My Issues "), "expected tab labels, got '{test_line(0)}'")
}

test fn test_tab_bar_reverses_selected_tab_cells() Void!Str {
  mut frame = test_frame(30, 2)
  mut tabs = tab_bar::new(["Inbox", "My Issues"])
  tabs.select(1)

  tabs.render(frame)

  try testing::assert(not test_cell_reverse(0, 0), "unselected first tab should not be reversed")
  try testing::assert(not test_cell_reverse(7, 0), "separator should not be reversed")
  testing::assert(test_cell_reverse(8, 0), "selected second tab padding should be reversed")
}
