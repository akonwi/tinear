use ard/async

use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi
use tinear/models/cache
use tinear/models/documents
use tinear/models/inbox
use tinear/models/issues
use tinear/models/tabs
use tinear/os
use tinear/tui/create_issue_view
use tinear/tui/doc_detail_view
use tinear/tui/hints_bar
use tinear/tui/inbox_view
use tinear/tui/issue_detail_view
use tinear/tui/modal
use tinear/tui/my_issues_view
use tinear/tui/search_view
use tinear/tui/text
use tinear/tui/toast

// Shell for the logged-in view.
//
// Two permanent tabs (Inbox, My Issues) plus zero or more dynamic
// detail tabs (issues and documents). Tab math treats them as one
// flat list:
//   index 0       -> Inbox
//   index 1       -> My Issues
//   index 2..n+1  -> tabs[i - 2]
struct Model {
  tab_index: Int,
  tabs: [tabs::TabRef],
}

// Widest a dynamic tab label may render. Issue identifiers are short;
// document titles get truncated with an ellipsis.
let MAX_TAB_LABEL_WIDTH: Int = 24

fn total_tabs(s: Model) Int {
  2 + s.tabs.size()
}

fn clamp_tab_index(idx: Int, total: Int) Int {
  match {
    idx < 0 => 0,
    idx >= total => total - 1,
    _ => idx,
  }
}

fn tab_label_at(s: Model, i: Int) Str {
  match i {
    0 => "Inbox",
    1 => "My Issues",
    _ => {
      let tab_idx = i - 2
      match tab_idx >= 0 and tab_idx < s.tabs.size() {
        true => text::truncate_with_ellipsis(
          s.tabs.at(tab_idx).expect("bounds checked").title,
          MAX_TAB_LABEL_WIDTH,
        ),
        false => "?",
      }
    },
  }
}

fn cycle_next(s: Model) Int {
  let n = total_tabs(s)
  match s.tab_index + 1 >= n {
    true => 0,
    false => s.tab_index + 1,
  }
}

fn cycle_prev(s: Model) Int {
  match s.tab_index <= 0 {
    true => total_tabs(s) - 1,
    false => s.tab_index - 1,
  }
}

fn selected_is_dynamic_tab(s: Model) Bool {
  s.tab_index >= 2
}

fn close_current_tab(s: Model) Model {
  mut next = s
  let tab_idx = s.tab_index - 2
  if tab_idx >= 0 and tab_idx < s.tabs.size() {
    mut remaining: [tabs::TabRef] = []
    for tab, idx in s.tabs {
      if not idx == tab_idx {
        remaining.push(tab)
      }
    }
    next.tabs = remaining
    next.tab_index = 1
  }
  next
}

// Open `ref` as a dynamic tab. If a tab with the same identity (kind +
// id) is already open, just switch to it; otherwise append a new tab
// and select it.
fn open_tab(s: Model, ref: tabs::TabRef) Model {
  mut existing_idx = -1
  for tab, i in s.tabs {
    if tabs::same(tab, ref) {
      existing_idx = i
    }
  }
  mut next = s
  if existing_idx >= 0 {
    next.tab_index = 2 + existing_idx
  } else {
    mut new_tabs: [tabs::TabRef] = []
    for tab in s.tabs {
      new_tabs.push(tab)
    }
    new_tabs.push(ref)
    next.tabs = new_tabs
    next.tab_index = 2 + new_tabs.size() - 1
  }
  next
}

// Current title of an open tab, if present. Used to skip no-op
// retitles (every doc refresh reports its title).
fn tab_title(s: Model, ref: tabs::TabRef) Str? {
  mut found: Str? = Maybe::new()
  for tab in s.tabs {
    if tabs::same(tab, ref) {
      found = Maybe::new(tab.title)
    }
  }
  found
}

// Refresh the label of an open doc tab once its title is known (on
// first load, or when a rename comes back from a refresh).
fn retitle_tab(s: Model, ref: tabs::TabRef, title: Str) Model {
  mut next = s
  mut new_tabs: [tabs::TabRef] = []
  for tab in s.tabs {
    match tabs::same(tab, ref) {
      true => new_tabs.push(tabs::TabRef{kind: tab.kind, id: tab.id, title: title}),
      false => new_tabs.push(tab),
    }
  }
  next.tabs = new_tabs
  next
}

// ── State updates ─────────────────────────────────────────────────────

// Persist the current logged-in slice to the on-disk cache. Wrapped in
// async::start so disk I/O doesn't block the UI; errors are swallowed
// because cache persistence is best-effort — a failed save shouldn't
// break the session.
fn persist(c: mut ffi::StateCtx) {
  let snap = ffi::StateValue<Model>(c)
  async::start(
    fn() {
      let _ = cache::save_logged_in(cache::LoggedInCache{tab_index: snap.tab_index, tabs: snap.tabs})
    },
  )
}

fn select_tab(c: mut ffi::StateCtx, idx: Int) {
  ffi::Update<Model>(
    c,
    fn(s: mut Model) {
      s.tab_index = idx
    },
  )
  persist(c)
}

fn replace_model(c: mut ffi::StateCtx, next: Model) {
  ffi::Update<Model>(
    c,
    fn(s: mut Model) {
      s.tab_index = next.tab_index
      s.tabs = next.tabs
    },
  )
  persist(c)
}

// ── Rendering ─────────────────────────────────────────────────────────

// Tab chip. Mirrors the theming used by upstream ListTile:
//
//   selected   => fg theme.Foreground on bg theme.Primary
//   unselected => fg theme.MutedForeground, transparent bg
//
// ClickAffordanceNone suppresses the default underline vaxis/ui adds
// to clickable Text; the bg fill is the visual affordance for tabs.
fn tab_chip(theme: ui::Theme, label: Str, selected: Bool, on_press: fn(ui::EventContext)) ui::Widget {
  let padded = " {label} "
  match selected {
    true => {
      ui::Text{
        Value: padded,
        Style: ui::Style{Foreground: theme.Foreground, Background: theme.Primary},
        OnPressed: on_press,
        ClickAffordance: ui::ClickAffordanceNone,
      }
    },
    false => {
      ui::Text{
        Value: padded,
        Style: ui::Style{Foreground: theme.MutedForeground},
        OnPressed: on_press,
        ClickAffordance: ui::ClickAffordanceNone,
      }
    },
  }
}

// Tab bar widget. Owns its own bottom border so the composing column
// doesn't need to space anything around it.
fn tab_bar(c: mut ffi::StateCtx, theme: ui::Theme, s: Model) ui::Widget {
  mut chips: [ui::Widget] = []
  let n = total_tabs(s)
  if n > 0 {
    for i in 0..n - 1 {
      if i > 0 {
        chips.push(ui::Text{Value: "│", Style: ui::Style{Foreground: theme.Border}})
      }
      // `for` binds an immutable per-iteration `i`, captured by value
      // by the closure below — no loop-closure trap.
      chips.push(
        tab_chip(
          theme,
          tab_label_at(s, i),
          i == s.tab_index,
          fn(ev: ui::EventContext) {
            select_tab(c, i)
          },
        ),
      )
    }
  }
  mut children: [ui::Widget] = [
    ui::Flex{Axis: ui::Horizontal, Children: chips},
    ui::Divider{Style: ui::Style{Foreground: theme.Border, Background: theme.Background}},
  ]
  ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    Children: children,
  }
}

// Open an inbox item. Routing:
//   issue/comment/mention notifications -> promote target_id to a
//     new (or existing) tab in issue_tabs and select it
//   PR notifications -> launch notification.url in the system
//     browser. The URL is Linear's deep-link to the specific
//     comment/mention activity, so it lands the user in the right
//     spot in Linear's review UI.
//   project / other notifications -> if a url is present, open it
//     in the browser; otherwise no-op.
fn open_inbox_item(c: mut ffi::StateCtx, item: inbox::Item) {
  if item.notification_type.starts_with("issue") {
    replace_model(c, open_tab(ffi::StateValue<Model>(c), tabs::issue_tab(item.target_id)))
  } else {
    if not item.url.is_empty() {
      let _ = os::open_url(item.url)
    }
  }
}

// Resolves the active tab to a body widget. All bodies are mounted at
// once via IndexedStack so each tab's local state survives switching
// tabs — only the visible tab paints.
fn body_for(
  c: mut ffi::StateCtx,
  api_key: Str,
  s: Model,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
) ui::Widget {
  // The inbox reports failures only; adapt to the error variant here.
  let notify_error = fn(title: Str, description: Str) {
    notify(title, description, toast::ToastVariant::error)
  }
  mut children: [ui::Widget] = [
    inbox_view::new(
      api_key,
      fn(item: inbox::Item) {
        open_inbox_item(c, item)
      },
      notify_error,
      s.tab_index == 0,
    ),
    my_issues_view::new(
      // From the My Issues board, Enter on a card promotes the issue
      // to a dynamic tab. Same shell helper as the inbox uses.
      api_key,
      fn(issue: issues::Issue) {
        replace_model(c, open_tab(ffi::StateValue<Model>(c), tabs::issue_tab(issue.identifier)))
      },
      notify,
      show_modal,
      close_modal,
      s.tab_index == 1,
    ),
  ]
  for tab, idx in s.tabs {
    let body: ui::Widget = match tab.kind {
      tabs::Kind::issue => issue_detail_view::new(
        api_key,
        tab.id,
        notify,
        show_modal,
        close_modal,
        s.tab_index == idx + 2,
      ),
      tabs::Kind::doc => doc_detail_view::new(
        api_key,
        tab.id,
        tab.title,
        fn(title: Str) {
          // Skip no-op retitles: every 5-minute doc refresh reports its
          // title, and an unchanged one shouldn't rebuild the shell or
          // rewrite the cache.
          let current = ffi::StateValue<Model>(c)
          match tab_title(current, tab) {
            existing => {
              if not existing == title {
                replace_model(c, retitle_tab(current, tab, title))
              }
            },
            _ => (),
          }
        },
        notify,
        s.tab_index == idx + 2,
      ),
    }
    children.push(body)
  }
  ui::IndexedStack{
    Index: s.tab_index,
    Alignment: ui::TopLeft,
    Children: children,
  }
}

fn hints_for(s: Model) [hints_bar::Hint] {
  match {
    s.tab_index == 0 => {
      [
        hints_bar::Hint{key: "Tab", label: "switch"},
        hints_bar::Hint{key: "↑↓", label: "select"},
        hints_bar::Hint{key: "⌫", label: "delete"},
        hints_bar::Hint{key: "r", label: "refresh"},
        hints_bar::Hint{key: "↵", label: "open"},
        hints_bar::Hint{key: "o", label: "browser"},
        hints_bar::Hint{key: "c", label: "new issue"},
        hints_bar::Hint{key: "?", label: "search"},
      ]
    },
    s.tab_index == 1 => {
      [
        hints_bar::Hint{key: "↑↓", label: ""},
        hints_bar::Hint{key: "←→", label: ""},
        hints_bar::Hint{key: "↵", label: "open"},
        hints_bar::Hint{key: "s", label: "status"},
        hints_bar::Hint{key: "p", label: "priority"},
        hints_bar::Hint{key: "a", label: "assign"},
        hints_bar::Hint{key: "y", label: "cycle"},
        hints_bar::Hint{key: "P", label: "project"},
        hints_bar::Hint{key: "r", label: "refresh"},
        hints_bar::Hint{key: "c", label: "new issue"},
        hints_bar::Hint{key: "?", label: "search"},
      ]
    },
    _ => {
      let tab_idx = s.tab_index - 2
      let kind = match tab_idx >= 0 and tab_idx < s.tabs.size() {
        true => s.tabs.at(tab_idx).expect("bounds checked").kind,
        false => tabs::Kind::issue,
      }
      match kind {
        tabs::Kind::doc => {
          [
            hints_bar::Hint{key: "↑↓", label: "scroll"},
            hints_bar::Hint{key: "o", label: "open in Linear"},
            hints_bar::Hint{key: "Esc", label: "close"},
          ]
        },
        tabs::Kind::issue => {
          [
            hints_bar::Hint{key: "↑↓", label: "scroll"},
            hints_bar::Hint{key: "d", label: "description"},
            hints_bar::Hint{key: "c", label: "comments"},
            hints_bar::Hint{key: "n", label: "new comment"},
            hints_bar::Hint{key: "s", label: "status"},
            hints_bar::Hint{key: "p", label: "priority"},
            hints_bar::Hint{key: "a", label: "assign"},
            hints_bar::Hint{key: "y", label: "cycle"},
            hints_bar::Hint{key: "P", label: "project"},
            hints_bar::Hint{key: "o", label: "browser"},
            hints_bar::Hint{key: "Esc", label: "close"},
          ]
        },
      }
    },
  }
}

fn screen(
  c: mut ffi::StateCtx,
  theme: ui::Theme,
  s: Model,
  api_key: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
) ui::Widget {
  mut children: [ui::Widget] = [
    tab_bar(c, theme, s),
    ui::Expanded(body_for(c, api_key, s, notify, show_modal, close_modal)),
    hints_bar::new(theme, hints_for(s)),
  ]
  ui::Flex{Axis: ui::Vertical, Children: children}
}

// ── Entry point ───────────────────────────────────────────────────────

fn build(
  c: mut ffi::StateCtx,
  ctx: ui::BuildContext,
  api_key: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  modal_open: Bool,
) ui::Widget {
  let theme = ui::MustDepend<ui::Theme>(ctx)
  let model = ffi::StateValue<Model>(c)
  // Tab / Shift+Tab / Escape are already mapped to NextFocusIntent,
  // PreviousFocusIntent and DismissIntent by the app-level Shortcuts
  // that wraps every vaxis/ui root. We can't override those keys from
  // an inner Shortcuts because the outer one consumes them during the
  // capture phase. Instead we install handlers for those upstream
  // intents in our Actions: Invoke walks UP from the focused widget
  // and finds our handler before it reaches the app-level Actions.
  ui::Actions{
    Bindings: [
      // Tab switches are gated on modal_open so their bound keys
      // (1 / 2) can flow through to text fields inside modals as
      // typed characters: Shortcuts dispatch in the capture phase,
      // and returning Ignored lets the event continue to the focused
      // element's target phase.
      "vaxis.next-focus": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        select_tab(c, cycle_next(ffi::StateValue<Model>(c)))
        ui::EventHandled
      },
      "vaxis.previous-focus": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        select_tab(c, cycle_prev(ffi::StateValue<Model>(c)))
        ui::EventHandled
      },
      "vaxis.dismiss": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        let current = ffi::StateValue<Model>(c)
        match selected_is_dynamic_tab(current) {
          true => {
            replace_model(c, close_current_tab(current))
            ui::EventHandled
          },
          false => ui::EventIgnored,
        }
      },
      "tabs.inbox": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match modal_open {
          true => ui::EventIgnored,
          false => {
            select_tab(c, 0)
            ui::EventHandled
          },
        }
      },
      "tabs.my_issues": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match modal_open {
          true => ui::EventIgnored,
          false => {
            select_tab(c, 1)
            ui::EventHandled
          },
        }
      },
      "issues.create": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        // Gated on modal_open (so `c` types into modal text fields)
        // and on dynamic tabs (where `c` switches to Comments).
        match modal_open or selected_is_dynamic_tab(ffi::StateValue<Model>(c)) {
          true => ui::EventIgnored,
          false => {
            create_issue_view::open(
              api_key,
              show_modal,
              close_modal,
              notify,
              // Called from the create flow's background fiber, so
              // re-enter the UI thread before touching shell state
              // (notify/close_modal are dispatch-safe; this must be too).
              fn(identifier: Str) {
                ffi::Dispatch(
                  c,
                  fn() {
                    replace_model(c, open_tab(ffi::StateValue<Model>(c), tabs::issue_tab(identifier)))
                  },
                )
              },
            )
            ui::EventHandled
          },
        }
      },
      "global.search": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        match modal_open {
          true => ui::EventIgnored,
          false => {
            let on_open_issue = fn(issue: issues::Issue) {
              replace_model(c, open_tab(ffi::StateValue<Model>(c), tabs::issue_tab(issue.identifier)))
              close_modal()
            }
            let on_open_doc = fn(doc: documents::DocMeta) {
              replace_model(c, open_tab(ffi::StateValue<Model>(c), tabs::doc_tab(doc.slug_id, doc.title)))
              close_modal()
            }
            show_modal(
              fn(theme_inner: ui::Theme, close: fn()) ui::Widget {
                modal::show_modal(
                  theme_inner,
                  "Search",
                  search_view::new(api_key, on_open_issue, on_open_doc),
                  hints_bar::row(
                    theme_inner,
                    [
                      hints_bar::Hint{key: "↑↓", label: "select"},
                      hints_bar::Hint{key: "↵", label: "open"},
                      hints_bar::Hint{key: "Esc", label: "close"},
                    ],
                  ),
                  Maybe::new(60),
                  fn(ev2: ui::EventContext) {
                    close()
                  },
                )
              },
            )
            ui::EventHandled
          },
        }
      },
    ],
    Child: ui::Shortcuts{
      Bindings: [
        "1": ffi::Intent("tabs.inbox"),
        "2": ffi::Intent("tabs.my_issues"),
        "?": ffi::Intent("global.search"),
        "c": ffi::Intent("issues.create"),
      ],
      Child: ui::FocusScope{
        AutoFocus: true,
        Child: screen(c, theme, model, api_key, notify, show_modal, close_modal),
      },
    },
  }
}

fn new(
  api_key: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  modal_open: Bool,
) ui::Widget {
  ffi::Stateful{
    Init: fn() Any {
      // Hydrate from the on-disk cache so the user returns to
      // whatever they had open last session. Missing / unreadable /
      // version-mismatched cache falls back to the default layout.
      match cache::load_logged_in() {
        cached => {
          let hydrated = Model{tab_index: cached.tab_index, tabs: cached.tabs}
          // A hand-edited cache can hold an out-of-range index, which
          // would feed IndexedStack an invalid child index.
          Model{tab_index: clamp_tab_index(cached.tab_index, total_tabs(hydrated)), tabs: cached.tabs}
        },
        _ => Model{tab_index: 0, tabs: []},
      }
    },
    Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
      build(c, ctx, api_key, notify, show_modal, close_modal, modal_open)
    },
  }
}
