use vaxis/ui

use tinear/models/inbox
use tinear/os
use tinear/tui/hints_bar
use tinear/tui/inbox_view
use tinear/tui/toast

// Minimal shell for the logged-in view.
//
// Two permanent tabs (Inbox, My Issues) plus zero or more dynamic issue
// detail tabs. Tab math treats them as one flat list:
//   index 0       -> Inbox
//   index 1       -> My Issues
//   index 2..n+1  -> issue_tabs[i - 2]
//
// For this first pass:
// - tab bodies are placeholders
// - no cache, no overlays, no real Linear data
// - two dummy issue tabs are seeded so tab math is exercised
struct Model {
  tab_index: Int,
  issue_tabs: [Str],
}

fn total_tabs(s: Model) Int { 2 + s.issue_tabs.size() }

fn tab_label_at(s: Model, i: Int) Str {
  match i {
    0 => "Inbox",
    1 => "My Issues",
    _ => {
      let issue_idx = i - 2
      match issue_idx >= 0 and issue_idx < s.issue_tabs.size() {
        true => s.issue_tabs.at(issue_idx),
        false => "?",
      }
    },
  }
}

fn cycle_next(s: Model) Int {
  let n = total_tabs(s)
  match s.tab_index + 1 >= n {
    true => 0,
    false => s.tab_index + 1,
  }
}

fn cycle_prev(s: Model) Int {
  match s.tab_index <= 0 {
    true => total_tabs(s) - 1,
    false => s.tab_index - 1,
  }
}

fn selected_is_issue_tab(s: Model) Bool { s.tab_index >= 2 }

fn close_current_issue_tab(s: Model) Model {
  mut next = s
  let issue_idx = s.tab_index - 2
  if issue_idx >= 0 and issue_idx < s.issue_tabs.size() {
    mut remaining: [Str] = []
    for label, idx in s.issue_tabs {
      if not (idx == issue_idx) {
        remaining.push(label)
      }
    }
    next.issue_tabs = remaining
    next.tab_index = 1
  }
  next
}

// Open `identifier` as an issue tab. If it's already in `issue_tabs`,
// just switch to it; otherwise append a new tab and select it. Used by
// the inbox's Enter action to surface a notification's issue.
fn open_issue_tab(s: Model, identifier: Str) Model {
  mut existing_idx = -1
  for tab, i in s.issue_tabs {
    if tab == identifier {
      existing_idx = i
    }
  }
  mut next = s
  if existing_idx >= 0 {
    next.tab_index = 2 + existing_idx
  } else {
    mut new_tabs: [Str] = []
    for tab in s.issue_tabs {
      new_tabs.push(tab)
    }
    new_tabs.push(identifier)
    next.issue_tabs = new_tabs
    next.tab_index = 2 + new_tabs.size() - 1
  }
  next
}

// ── Rendering ─────────────────────────────────────────────────────────

// Tab chip. Mirrors the theming used by upstream ListTile:
//
//   selected   => fg theme.foreground on bg theme.primary  (same as ListTile.Selected)
//   unselected => fg theme.muted_foreground, transparent bg
//
// ClickAffordance::none suppresses the default underline vaxis/ui adds
// to clickable Text; the bg fill is the visual affordance for tabs.
fn tab_chip(theme: ui::Theme, label: Str, selected: Bool, on_press: fn(ui::EventContext)) ui::Widget {
  let padded = " {label} "
  match selected {
    true => ui::styled_text(
      padded,
      fg: theme.foreground,
      bg: theme.primary,
      on_pressed: on_press,
      click_affordance: ui::ClickAffordance::none,
    ),
    false => ui::styled_text(
      padded,
      fg: theme.muted_foreground,
      on_pressed: on_press,
      click_affordance: ui::ClickAffordance::none,
    ),
  }
}

// Tab bar widget. Owns its own bottom border so the composing column
// doesn't need to space anything around it.
fn tab_bar(theme: ui::Theme, s: Model, on_tab_press: fn(Int)) ui::Widget {
  mut chips: [ui::Widget] = []
  let n = total_tabs(s)
  if n > 0 {
    for i in 0..n - 1 {
      if i > 0 {
        chips.push(ui::styled_text("│", fg: theme.border))
      }
      // `for` binds an immutable per-iteration `i`, captured by value
      // by the closure below — no loop-closure trap.
      chips.push(tab_chip(
        theme,
        tab_label_at(s, i),
        i == s.tab_index,
        fn(_ctx: ui::EventContext) { on_tab_press(i) },
      ))
    }
  }
  ui::column([
    ui::row(chips),
    ui::divider(fg: theme.border, bg: theme.background),
  ])
}

fn placeholder_for(label: Str) ui::Widget {
  ui::center(
    ui::column(
      [
        ui::styled_text(label, attrs: ui::TextAttrs{ bold: true }),
        ui::sized_box(0, 1, ui::text("")),
        ui::text("(placeholder)"),
      ],
      main_size: ui::MainSize::min,
      cross_align: ui::CrossAlign::center,
    ),
  )
}

// Resolves the active tab to a body widget. All bodies are mounted at
// once via ui::indexed_stack so each tab's local state (cursor, scroll,
// fetched data) survives switching tabs — only the visible tab paints.
fn body_for(
  api_key: Str, s: Model, on_open: fn(inbox::Item),
  notify: fn(Str, Str, toast::ToastVariant),
) ui::Widget {
  mut children: [ui::Widget] = [
    inbox_view::new(api_key, on_open, notify),
    placeholder_for("My Issues"),
  ]
  for label in s.issue_tabs {
    children.push(placeholder_for(label))
  }
  ui::indexed_stack(
    s.tab_index, children, alignment: ui::Alignment::top_left,
  )
}

fn hints_for(s: Model) [hints_bar::Hint] {
  match {
    s.tab_index == 0 => [
      hints_bar::Hint{ key: "Tab", label: "switch" },
      hints_bar::Hint{ key: "↑↓",  label: "select" },
      hints_bar::Hint{ key: "⌫",   label: "delete" },
      hints_bar::Hint{ key: "r",   label: "refresh" },
      hints_bar::Hint{ key: "↵",   label: "open" },
      hints_bar::Hint{ key: "?",   label: "search" },
    ],
    s.tab_index == 1 => [
      hints_bar::Hint{ key: "↑↓", label: "" },
      hints_bar::Hint{ key: "←→", label: "" },
      hints_bar::Hint{ key: "↵",  label: "open" },
      hints_bar::Hint{ key: "s",  label: "status" },
      hints_bar::Hint{ key: "y",  label: "cycle" },
      hints_bar::Hint{ key: "r",  label: "refresh" },
      hints_bar::Hint{ key: "?",  label: "search" },
    ],
    _ => [
      hints_bar::Hint{ key: "s",   label: "status" },
      hints_bar::Hint{ key: "y",   label: "cycle" },
      hints_bar::Hint{ key: "esc", label: "close" },
      hints_bar::Hint{ key: "o",   label: "open in browser" },
    ],
  }
}

fn screen(
  theme: ui::Theme, s: Model, api_key: Str,
  on_tab_press: fn(Int), on_open: fn(inbox::Item),
  notify: fn(Str, Str, toast::ToastVariant),
) ui::Widget {
  ui::column(
    [
      tab_bar(theme, s, on_tab_press),
      ui::expanded(body_for(api_key, s, on_open, notify)),
      hints_bar::new(theme, hints_for(s)),
    ],
  )
}

// ── Entry point ───────────────────────────────────────────────────────

fn new(api_key: Str, notify: fn(Str, Str, toast::ToastVariant)) ui::Widget {
  ui::stateful(
    key: "logged-in",
    init: fn(_ctx: ui::BuildContext) Model {
      Model{
        tab_index: 0,
        issue_tabs: [],
      }
    },
    build: fn(ctx: ui::BuildContext, state: ui::State<Model>) ui::Widget {
      let theme = ui::must_have_theme(ctx)
      let model = state.value()
      let on_tab_press = fn(idx: Int) {
        state.set(fn(mut s: Model) { s.tab_index = idx })
      }
      // Open an inbox item. Routing:
      //   issue/comment/mention notifications -> promote target_id to a
      //     new (or existing) tab in issue_tabs and select it
      //   PR notifications -> launch notification.url in the system
      //     browser. The URL is Linear's deep-link to the specific
      //     comment/mention activity, so it lands the user in the right
      //     spot in Linear's review UI.
      //   project / other notifications -> if a url is present, open it
      //     in the browser; otherwise no-op.
      let on_open = fn(item: inbox::Item) {
        if item.notification_type.starts_with("issue") {
          state.set(fn(mut s: Model) { s = open_issue_tab(s, item.target_id) })
        } else {
          if not item.url.is_empty() {
            let _ = os::open_url(item.url)
          }
        }
      }
      // Tab / Shift+Tab / Escape are already mapped to NextFocusIntent,
      // PreviousFocusIntent and DismissIntent by the app-level Shortcuts that
      // wraps every vaxis/ui root. We can't override those keys from an inner
      // Shortcuts because the outer one consumes them during capture phase.
      // Instead we install handlers for those upstream intents in our Actions.
      // Invoke walks UP from the focused widget and finds our handler before
      // it reaches the app-level Actions, so we win.
      ui::shortcuts(
        ui::actions(
          ui::focus_scope(
            ui::focus(screen(theme, model, api_key, on_tab_press, on_open, notify)),
            trap: false,
            auto_focus: true,
          ),
          [
            ui::action("vaxis.next-focus", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(fn(mut s: Model) { s.tab_index = cycle_next(s) })
              ui::EventResult::handled
            }),
            ui::action("vaxis.previous-focus", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(fn(mut s: Model) { s.tab_index = cycle_prev(s) })
              ui::EventResult::handled
            }),
            ui::action("vaxis.dismiss", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              match selected_is_issue_tab(model) {
                true => {
                  state.set(fn(mut s: Model) { s = close_current_issue_tab(s) })
                  ui::EventResult::handled
                },
                false => ui::EventResult::ignored,
              }
            }),
            ui::action("tabs.inbox", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(fn(mut s: Model) { s.tab_index = 0 })
              ui::EventResult::handled
            }),
            ui::action("tabs.my_issues", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              state.set(fn(mut s: Model) { s.tab_index = 1 })
              ui::EventResult::handled
            }),
            // Dev: fire one toast per variant for visual review. Bound
            // to `t` below. Remove once the toast system is signed off.
            ui::action("dev.toast_demo", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              notify(
                "Inbox refreshed",
                "7 notifications loaded",
                toast::ToastVariant::info,
              )
              notify(
                "Notification archived",
                "",
                toast::ToastVariant::success,
              )
              notify(
                "Couldn't archive notification",
                "network timeout",
                toast::ToastVariant::error,
              )
              ui::EventResult::handled
            }),
          ],
        ),
        [
          "1": "tabs.inbox",
          "2": "tabs.my_issues",
          "t": "dev.toast_demo",
        ],
      )
    },
  )
}
