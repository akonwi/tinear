use tinear/tui/inbox_view
use tinear/tui/hints
use tinear/tui/my_issues_view
use tinear/tui/ui

struct LoggedInUiState {
  tab: Str,
}

fn selected_tab(model: LoggedInUiState) Str {
  match model.tab {
    "" => "Inbox",
    _ => model.tab,
  }
}

fn with_tab(model: LoggedInUiState, tab: Str) LoggedInUiState {
  mut next = model
  next.tab = tab
  next
}

fn toggled_tab(model: LoggedInUiState) LoggedInUiState {
  match selected_tab(model) {
    "Inbox" => with_tab(model, "My Issues"),
    _ => with_tab(model, "Inbox"),
  }
}

fn tab_label(label: Str, selected: Bool) ui::Widget {
  let padded = " {label} "
  match selected {
    true => ui::text(padded, style: ui::style(reverse: true)),
    false => ui::text(padded),
  }
}

fn tab_bar(tab: Str) ui::Widget {
  ui::row([
    tab_label("Inbox", tab == "Inbox"),
    ui::divider(style: ui::style(foreground: "border"), vertical: true),
    tab_label("My Issues", tab == "My Issues"),
  ])
}

fn tab_index(tab: Str) Int {
  match tab {
    "My Issues" => 1,
    _ => 0,
  }
}

fn focus_tab(tab: Str) {
  match tab {
    "My Issues" => ui::request_focus("tab.my_issues"),
    _ => ui::request_focus("tab.inbox"),
  }
}

fn body(tab: Str, inbox: ui::Widget, my_issues: ui::Widget) ui::Widget {
  ui::indexed_stack(tab_index(tab), [inbox, my_issues])
}

fn footer(tab: Str) ui::Widget {
  match tab {
    "My Issues" => hints::bar(["↑↓", "← →", "↵ open", "s status", "y cycle", "r refresh"]),
    _ => hints::bar(["Tab switch", "↑↓ select", "⌫ delete", "r refresh", "↵ open"]),
  }
}

fn screen_separator() ui::Widget {
  ui::divider(style: ui::style(foreground: "border"))
}

fn content(model: LoggedInUiState, inbox: ui::Widget, my_issues: ui::Widget) ui::Widget {
  let tab = selected_tab(model)
  ui::column_stretch([
    tab_bar(tab),
    screen_separator(),
    ui::expanded(body(tab, inbox, my_issues)),
    screen_separator(),
    footer(tab),
  ])
}

fn new(api_key: Str) ui::Widget {
  let inbox = inbox_view::new(api_key)
  let my_issues = my_issues_view::new(api_key)
  ui::stateful(
    init: fn(_ctx: ui::BuildContext) LoggedInUiState {
      LoggedInUiState{tab: "Inbox"}
    },
    build: fn(_ctx: ui::BuildContext, state: ui::State) ui::Widget {
      let model = state.value<LoggedInUiState>()
      ui::actions(
      child: ui::shortcuts(
        child: content(model, inbox, my_issues),
        bindings: [
          "Tab": "tabs.next",
          "1": "tabs.inbox",
          "2": "tabs.my_issues",
        ],
      ),
      bindings: [
        ui::action("tabs.next", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          let next_tab = selected_tab(toggled_tab(model))
          state.set<LoggedInUiState>(fn(mut next: LoggedInUiState) {
            next.tab = next_tab
          })
          focus_tab(next_tab)
          ui::EventResult::handled
        }),
        ui::action("tabs.inbox", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          state.set<LoggedInUiState>(fn(mut next: LoggedInUiState) {
            next.tab = "Inbox"
          })
          focus_tab("Inbox")
          ui::EventResult::handled
        }),
        ui::action("tabs.my_issues", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          state.set<LoggedInUiState>(fn(mut next: LoggedInUiState) {
            next.tab = "My Issues"
          })
          focus_tab("My Issues")
          ui::EventResult::handled
        }),
      ],
    )
    },
  )
}
