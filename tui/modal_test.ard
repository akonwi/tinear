use ard/testing

use tinear/tui/modal
use tinear/tui/ui
use tinear/tui/ui/test as uitest

test fn test_modal_dialog_renders_title_and_dismisses_on_escape() Void!Str {
  mut dismissed = false
  let app = uitest::app(
    modal::dialog(
      title: "Confirm",
      child: ui::text("Are you sure?"),
      footer: ui::text("Esc close"),
      width: 24,
      on_dismiss: fn(_ctx: ui::EventContext) {
        dismissed = true
      },
    ),
  )

  app.pump(40, 8)
  try testing::assert(app.contains("Confirm"), "modal should render title")
  try testing::assert(app.contains("Are you sure?"), "modal should render body")

  app.escape()
  testing::assert(dismissed, "Escape should dispatch modal dismiss action")
}

test fn test_overlay_with_focus_trap_escape_takes_priority_over_ancestor_shortcut() Void!Str {
  mut dismissed = false
  mut ancestor = false
  let app = uitest::app(
    ui::actions(
      child: ui::shortcuts(
        child: ui::overlay(
          child: ui::focusable(ui::text("Base")),
          overlay: modal::dialog(
            title: "Status",
            child: ui::text("In Progress"),
            footer: ui::text("Esc cancel"),
            width: 30,
            on_dismiss: fn(_ctx: ui::EventContext) {
              dismissed = true
            },
          ),
          position: ui::OverlayPosition::center,
          trap_focus: true,
          auto_focus: true,
        ),
        bindings: ["Escape": "ancestor.escape", "Esc": "ancestor.escape"],
      ),
      bindings: [
        ui::action(
          "ancestor.escape",
          fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            ancestor = true
            ui::EventResult::handled
          },
        ),
      ],
    ),
  )

  app.pump(60, 10)
  app.escape()

  try testing::assert(dismissed, "modal Escape should run first")
  testing::assert(not ancestor, "ancestor Escape shortcut should not run while modal is open")
}
