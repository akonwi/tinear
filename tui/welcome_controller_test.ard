use ard/testing as assertions

use cooper
use cooper/cui/renderer
use cooper/event
use cooper/testing
use cooper/ui
use tinear/services/auth
use tinear/tui/theme
use tinear/tui/welcome_controller

struct Attempt {
  api_key: Str,
  completion: fn(Void!Str),
}

private fn fake_auth(attempts: mut [Attempt]) auth::Authenticate {
  fn(api_key: Str, view_cancellation: Receiver<Bool>, completion: fn(Void!Str)) {
    attempts.push(Attempt{api_key: api_key, completion: completion})
    ()
  }
}

private fn modifiers() cooper::Modifiers {
  cooper::Modifiers{
    shift: false,
    ctrl: false,
    alt: false,
    super: false,
  }
}

private fn press(application: testing::TestApp, name: Str, text: Str) {
  application.key(event::key(name, text, cooper::KeyEventType::press, modifiers()))
}

// Find the foreground color of the bold error text starting with "In".
private fn error_foreground(application: testing::TestApp) ui::Color? {
  mut found = Maybe::new<ui::Color>()
  mut y = 0
  while y < application.frame().height() {
    mut x = 0
    while x < application.frame().width() {
      match application.frame().cell(x, y) {
        cell => {
          if cell.grapheme == "I" and cell.style.bold and found.is_none() {
            let next = match application.frame().cell(x + 1, y) {
              found_cell => found_cell.grapheme,
              _ => "",
            }
            if next == "n" {
              found = cell.style.foreground
            }
          }
        },
        _ => (),
      }
      x =+ 1
    }
    y =+ 1
  }
  found
}

test fn welcome_requires_an_api_key() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let attempts = mut List::new<Attempt>()
  let mounted = renderer::mount(
    application.context,
    application.root,
    welcome_controller::view(theme::new(), fake_auth(attempts), fn(api_key: Str) {}),
  )
  defer mounted.destroy()
  let _ = application.flush()
  press(application, "return", "")
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Enter an API key")
  assertions::assert(attempts.size() == 0, "blank submission should not authenticate")
}

test fn welcome_surfaces_authentication_failure_and_allows_retry() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let attempts = mut List::new<Attempt>()
  let mounted = renderer::mount(
    application.context,
    application.root,
    welcome_controller::view(theme::new(), fake_auth(attempts), fn(api_key: Str) {}),
  )
  defer mounted.destroy()
  let _ = application.flush()
  application.paste(event::paste("lin_api_bad"))
  press(application, "return", "")
  try assertions::assert(attempts.size() == 1, "submission should start authentication")
  try assertions::assert(
    attempts.at(0).expect("attempt").api_key == "lin_api_bad",
    "draft should be passed through",
  )
  attempts.at(0).expect("attempt").completion(Result::err("Invalid API token"))
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Invalid API token")
  let actual_error = error_foreground(application).expect("error foreground")
  let expected_error = theme::new().danger
  let matches_danger = actual_error.red == expected_error.red and actual_error.green == expected_error.green and actual_error.blue == expected_error.blue
  try assertions::assert(matches_danger, "authentication errors should use the danger color")

  application.paste(event::paste("2"))
  press(application, "return", "")
  assertions::assert(attempts.size() == 2, "failed authentication should permit retry")
}

test fn welcome_reports_success_once() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let attempts = mut List::new<Attempt>()
  mut authenticated = ""
  let mounted = renderer::mount(
    application.context,
    application.root,
    welcome_controller::view(theme::new(), fake_auth(attempts), fn(api_key: Str) {
      authenticated = api_key
    }),
  )
  defer mounted.destroy()
  let _ = application.flush()
  application.paste(event::paste("lin_api_valid"))
  press(application, "return", "")
  try assertions::assert(attempts.size() == 1, "Input submit should authenticate")
  press(application, "return", "")
  try assertions::assert(attempts.size() == 1, "loading state should reject duplicate submit")
  attempts.at(0).expect("attempt").completion(Result::ok(()))
  let _ = application.flush()
  assertions::assert(
    authenticated == "lin_api_valid",
    "success should report the authenticated key",
  )
}

test fn welcome_disposal_rejects_late_authentication() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let attempts = mut List::new<Attempt>()
  mut successes = 0
  let mounted = renderer::mount(
    application.context,
    application.root,
    welcome_controller::view(theme::new(), fake_auth(attempts), fn(api_key: Str) {
      successes =+ 1
    }),
  )
  let _ = application.flush()
  application.paste(event::paste("lin_api_valid"))
  press(application, "return", "")
  try assertions::assert(attempts.size() == 1, "submission should start authentication")
  mounted.destroy()
  attempts.at(0).expect("attempt").completion(Result::ok(()))
  let _ = application.flush()
  assertions::assert(successes == 0, "unmounted screen should suppress late success")
}

test fn welcome_button_focus_survives_authentication_error() Void!Str {
  let application = testing::new(60, 18)
  defer application.destroy()
  let attempts = mut List::new<Attempt>()
  let mounted = renderer::mount(
    application.context,
    application.root,
    welcome_controller::view(theme::new(), fake_auth(attempts), fn(api_key: Str) {}),
  )
  defer mounted.destroy()
  let _ = application.flush()
  application.paste(event::paste("test-key"))
  let _ = application.flush()
  application.render()
  mut row = 0
  while row < application.frame().height() {
    mut col = 0
    while col + 1 < application.frame().width() {
      if application.frame().cell(col, row).expect("cell").grapheme == "L" and application.frame().cell(col + 1, row).expect("next cell").grapheme == "o" {
        application.click(col, row)
      }
      col =+ 1
    }
    row =+ 1
  }
  try assertions::assert(attempts.size() == 1, "click should focus and activate Login")
  attempts.at(0).expect("attempt").completion(Result::err("Try again"))
  let _ = application.flush()
  application.render()
  press(application, "space", " ")
  assertions::assert(attempts.size() == 2, "error rerender must leave focus on Login")
}
