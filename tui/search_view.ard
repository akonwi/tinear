use ard/async
use ard/duration
use ard/maybe

use tinear/models/issues
use tinear/tui/hints
use tinear/tui/modal
use tinear/tui/text
use tinear/tui/ui

struct SearchUiState {
  query: Str,
  results: [issues::Issue],
  cursor: Int,
  loading: Bool,
  error: Str,
  searched: Bool,
  generation: Int,
}

fn empty_state() SearchUiState {
  SearchUiState{
    query: "",
    results: [],
    cursor: 0,
    loading: false,
    error: "",
    searched: false,
    generation: 0,
  }
}

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

fn selected_issue(model: SearchUiState) issues::Issue? {
  match model.results.size() == 0 {
    true => maybe::none(),
    false => maybe::some(model.results.at(clamp_cursor(model.cursor, model.results.size()))),
  }
}

fn row_text(value: Str, selected: Bool) ui::Widget {
  match selected {
    true => ui::text(value, style: ui::style(reverse: true)),
    false => ui::text(value),
  }
}

fn result_row(issue: issues::Issue, selected: Bool) ui::Widget {
  let cursor = match selected {
    true => "▸",
    false => " ",
  }
  let state_name = text::truncate_with_ellipsis(issue.state_name, 10)
  let children = [
    ui::sized_box_child(2, 1, row_text(cursor, selected)),
    ui::sized_box_child(10, 1, row_text(issue.identifier, selected)),
    ui::expanded(row_text(text::truncate_with_ellipsis(issue.title, 32), selected)),
    ui::sized_box_child(10, 1, row_text(state_name, selected)),
  ]
  match selected {
    true => ui::row(children: children, style: ui::style(reverse: true)),
    false => ui::row(children),
  }
}

fn visible_start(cursor: Int, count: Int, height: Int) Int {
  let max_start = match count > height {
    true => count - height,
    false => 0,
  }
  let desired = match cursor >= height {
    true => cursor - height + 1,
    false => 0,
  }
  match desired > max_start {
    true => max_start,
    false => desired,
  }
}

fn result_rows(model: SearchUiState, height: Int) ui::Widget {
  let start = visible_start(model.cursor, model.results.size(), height)
  let end_excl = match start + height > model.results.size() {
    true => model.results.size(),
    false => start + height,
  }
  mut rows: [ui::Widget] = []
  for issue, idx in model.results {
    if idx >= start and idx < end_excl {
      rows.push(result_row(issue, idx == model.cursor))
    }
  }
  ui::column_stretch(rows)
}

fn results_body(model: SearchUiState) ui::Widget {
  if model.loading {
    ui::center(ui::text("Searching…", style: ui::style(foreground: "border")))
  } else if not model.error.is_empty() {
    ui::center(ui::text("Unable to search — try again", style: ui::style(foreground: "border")))
  } else if model.query.trim().is_empty() {
    ui::center(ui::text("Type to search across issues", style: ui::style(foreground: "border")))
  } else if model.searched and model.results.size() == 0 {
    ui::center(ui::text("No issues found", style: ui::style(foreground: "border")))
  } else {
    result_rows(model, 8)
  }
}

fn start_search(api_key: Str, query: Str, generation: Int, rt: ui::Runtime<SearchUiState>) {
  async::start(fn() {
    async::sleep(duration::from_millis(300))
    let trimmed = query.trim()
    rt.dispatch(fn(state: ui::State<SearchUiState>) {
      let current = state.value()
      if current.generation == generation and current.query.trim() == trimmed and not trimmed.is_empty() {
        async::start(fn() {
          let result = issues::search(api_key, trimmed)
          rt.dispatch(fn(state: ui::State<SearchUiState>) {
            let current = state.value()
            if current.generation == generation and current.query.trim() == trimmed {
              state.set(fn(mut next: SearchUiState) {
                match result {
                  ok(results) => {
                    next.results = results
                    next.cursor = 0
                    next.error = ""
                  },
                  err(e) => {
                    let empty_results: [issues::Issue] = []
                    next.results = empty_results
                    next.cursor = 0
                    next.error = e
                  },
                }
                next.loading = false
                next.searched = true
              })
            }
          })
        })
      }
    })
  })
}

fn dialog_body(api_key: Str, model: SearchUiState, state: ui::State<SearchUiState>, rt: ui::Runtime<SearchUiState>) ui::Widget {
  ui::column_stretch([
    ui::focus_scope(
      child: ui::text_field(
        value: model.query,
        placeholder: "Search issues…",
        min_width: 48,
        obscure: false,
        on_changed: fn(_ctx: ui::EventContext, value: Str) {
          let trimmed = value.trim()
          let generation = model.generation + 1
          state.set(fn(mut next: SearchUiState) {
            let empty_results: [issues::Issue] = []
            next.query = value
            next.generation = generation
            next.results = empty_results
            next.cursor = 0
            next.error = ""
            if trimmed.is_empty() {
              next.loading = false
              next.searched = false
            } else {
              next.loading = true
              next.searched = true
            }
          })
          if not trimmed.is_empty() {
            start_search(api_key, value, generation, rt)
          }
        },
        on_submitted: fn(_ctx: ui::EventContext, _submitted: Str) {},
      ),
      trap: false,
      auto_focus: true,
    ),
    ui::divider(style: ui::style(foreground: "border")),
    ui::box(results_body(model), height: 8),
  ])
}

fn new(api_key: Str, on_open: fn(ui::EventContext, issues::Issue), on_dismiss: fn(ui::EventContext)) ui::Widget {
  ui::stateful(
    key: "issue-search",
    init: fn(_ctx: ui::BuildContext) SearchUiState {
      empty_state()
    },
    build: fn(ctx: ui::BuildContext, state: ui::State<SearchUiState>) ui::Widget {
      let model = state.value()
      ui::actions(
        child: ui::shortcuts_capture(
          child: modal::dialog(
            title: "Search Issues",
            child: dialog_body(api_key, model, state, ctx.runtime<SearchUiState>()),
            footer: hints::bar(["↵ open", "↑↓ select", "Esc close"]),
            width: 60,
            on_dismiss: on_dismiss,
          ),
          bindings: [
            "Up": "search.previous",
            "Down": "search.next",
            "Enter": "search.open",
          ],
        ),
        bindings: [
          ui::action("search.previous", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            state.set(fn(mut next: SearchUiState) {
              next.cursor = clamp_cursor(next.cursor - 1, next.results.size())
            })
            ui::EventResult::handled
          }),
          ui::action("search.next", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            state.set(fn(mut next: SearchUiState) {
              next.cursor = clamp_cursor(next.cursor + 1, next.results.size())
            })
            ui::EventResult::handled
          }),
          ui::action("search.open", fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
            if not model.loading {
              match selected_issue(model) {
                issue => on_open(ctx, issue),
                _ => (),
              }
            }
            ui::EventResult::handled
          }),
        ],
      )
    },
  )
}
