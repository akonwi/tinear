use ard/async
use ard/duration
use ard/maybe
use vaxis/ui

use tinear/models/issues
use tinear/tui/text as text

// Search modal body. Owns a stateful Search and renders the
// text_field + results list. Up / Down / Enter are handled by an
// inner Shortcuts that intercepts during the capture phase before
// the text_field's target phase consumes them.
//
// The caller wraps this widget in `modal::show_modal(...)` (frame,
// title, footer, on_dismiss) and threads it through `show_modal`.

struct Search {
  query: Str,
  results: [issues::Issue],
  cursor: Int,
  loading: Bool,
  error: Str,
  // True once we've issued at least one search for the current
  // query. Distinguishes "user hasn't typed anything yet" from
  // "user searched but no results came back."
  searched: Bool,
  // Bumped on every keystroke. Pending searches check that the
  // generation still matches before applying their result, so
  // out-of-order responses from stale queries can't overwrite the
  // current results.
  generation: Int,
  // Outer scroll for the results sliver.
  scroll: ui::ScrollController,
  // Drives reveal_index on cursor changes.
  list_scroll: ui::SliverListController,
}

fn clamp_cursor(cursor: Int, count: Int) Int {
  match {
    count <= 0 => 0,
    cursor < 0 => 0,
    cursor >= count => count - 1,
    _ => cursor,
  }
}

fn selected_issue(model: Search) issues::Issue? {
  match model.results.size() == 0 {
    true => maybe::none(),
    false => maybe::some(
      model.results.at(clamp_cursor(model.cursor, model.results.size())),
    ),
  }
}

// ── Debounced search ─────────────────────────────────────────────────

// Schedule a search for `query` tagged with `generation`. After
// 300ms of quiet, the fiber checks that the current state still
// matches (same generation, same trimmed query, non-empty). If yes,
// it fires the actual API call; another generation check guards
// applying the result so a long-running request from an older query
// can't overwrite newer results.
fn start_search(
  api_key: Str, query: Str, generation: Int, rt: ui::Runtime<Search>,
) {
  let _ = async::start(fn() {
    async::sleep(duration::from_millis(300))
    let trimmed = query.trim()
    rt.dispatch(fn(s: ui::State<Search>) {
      let current = s.value()
      let still_current = current.generation == generation and current.query.trim() == trimmed and not trimmed.is_empty()
      if still_current {
        let _ = async::start(fn() {
          let result = issues::search(api_key, trimmed)
          rt.dispatch(fn(s2: ui::State<Search>) {
            let current2 = s2.value()
            if current2.generation == generation and current2.query.trim() == trimmed {
              s2.set(fn(mut next: Search) {
                match result {
                  ok(results) => {
                    next.results = results
                    next.cursor = 0
                    next.error = ""
                  },
                  err(e) => {
                    let empty: [issues::Issue] = []
                    next.results = empty
                    next.cursor = 0
                    next.error = e
                  },
                }
                next.loading = false
                next.searched = true
              })
            }
          })
        })
      }
    })
  })
}

// ── Result rows ──────────────────────────────────────────────────────

// Single row: identifier (10 cols) | title (flex, clipped with
// ellipsis) | state name (12 cols).
// list_tile.Selected gives the cursor row its theme.primary chrome.
fn result_row(
  theme: ui::Theme, issue: issues::Issue, selected: Bool,
  on_press: fn(ui::EventContext),
) ui::Widget {
  let state_name = text::truncate_with_ellipsis(issue.state_name, 12)
  let content = ui::row(
    [
      ui::sized_box(
        10, 1,
        ui::styled_text(
          issue.identifier,
          fg: theme.foreground,
          attrs: ui::TextAttrs{ bold: true },
        ),
      ),
      ui::sized_box(2, 1, ui::text(" ")),
      // rich_text with overflow ellipsis truncates to whatever
      // width expanded actually gives the title, instead of relying
      // on a hard-coded byte budget that has to match the layout.
      ui::expanded(
        ui::rich_text(
          [ui::span(issue.title, fg: theme.foreground)],
          overflow: ui::TextOverflow::ellipsis,
          max_lines: 1,
          soft_wrap: false,
        ),
      ),
      ui::sized_box(2, 1, ui::text(" ")),
      ui::sized_box(
        12, 1,
        ui::styled_text(state_name, fg: theme.muted_foreground),
      ),
    ],
  )
  ui::list_tile(
    title: content,
    selected: selected,
    on_pressed: on_press,
  )
}

fn empty_placeholder(theme: ui::Theme, message: Str) ui::Widget {
  ui::center(
    ui::styled_text(message, fg: theme.muted_foreground),
  )
}

// Body that swaps between loading / error / empty / typing prompt /
// results. All branches return ui::center(...) for placeholders and
// the sliver scroll view for results — the outer slot stays
// stable-shaped enough across rebuilds for reconciliation.
fn results_body(theme: ui::Theme, model: Search, on_pick: fn(Int)) ui::Widget {
  match {
    model.loading => empty_placeholder(theme, "Searching\u2026"),
    not model.error.is_empty() => ui::center(
      ui::styled_text(
        "Unable to search: {model.error}", fg: theme.danger_text,
      ),
    ),
    model.query.trim().is_empty() => empty_placeholder(
      theme, "Type to search across issues",
    ),
    model.searched and model.results.size() == 0 => empty_placeholder(
      theme, "No issues found",
    ),
    _ => ui::custom_scroll_view(
      model.scroll,
      [
        ui::sliver_list_builder(
          count: model.results.size(),
          builder: fn(_ctx: ui::BuildContext, i: Int) ui::Widget {
            result_row(
              theme, model.results.at(i),
              i == model.cursor,
              fn(_ctx: ui::EventContext) { on_pick(i) },
            )
          },
          item_extent: maybe::some(1),
          overscan: maybe::some(4),
          controller: maybe::some(model.list_scroll),
        ),
      ],
    ),
  }
}

// ── Body ─────────────────────────────────────────────────────────────

fn body(
  api_key: Str,
  theme: ui::Theme, model: Search,
  state: ui::State<Search>, rt: ui::Runtime<Search>,
  on_open: fn(issues::Issue),
) ui::Widget {
  let on_pick = fn(idx: Int) {
    // Click handler: move cursor to the picked row and open it
    // (same UX as the picker option click).
    let safe = clamp_cursor(idx, model.results.size())
    if model.results.size() > 0 {
      state.set(fn(mut next: Search) { next.cursor = safe })
      on_open(model.results.at(safe))
    }
  }
  ui::column(
    [
      // Search input. Focus_scope(auto_focus: true) so the modal
      // frame's auto_focus lands here on first open. text_field
      // handles its own internal events; we don't trap Tab.
      ui::focus_scope(
        ui::text_field(
          value: model.query,
          placeholder: "Search issues\u2026",
          // text_field renders at exactly min_width upstream (it
          // wraps itself in SizedBox{Width: min_width}), so set it
          // to the modal's content width (60 − 2 cols of horizontal
          // padding) to make the field fill the row.
          min_width: 58,
          on_changed: fn(_ctx: ui::EventContext, value: Str) {
            let trimmed = value.trim()
            let generation = model.generation + 1
            state.set(fn(mut next: Search) {
              let empty: [issues::Issue] = []
              next.query = value
              next.generation = generation
              next.results = empty
              next.cursor = 0
              next.error = ""
              if trimmed.is_empty() {
                next.loading = false
                next.searched = false
              } else {
                next.loading = true
              }
            })
            if not trimmed.is_empty() {
              start_search(api_key, value, generation, rt)
            }
          },
        ),
        trap: false,
        auto_focus: true,
      ),
      // Divider blends with the modal surface, not the app
      // background. modal::show_modal uses theme.surface as its
      // fill so any in-modal widget that paints its own background
      // has to match (otherwise the app background bleeds through).
      ui::divider(fg: theme.border, bg: theme.surface),
      // Fixed-height results region. The custom_scroll_view inside
      // needs a bounded extent to clip and scroll; 8 rows feels
      // right for the modal layout and matches main.
      ui::sized_box(0, 8, results_body(theme, model, on_pick)),
    ],
    main_size: ui::MainSize::min,
    cross_align: ui::CrossAlign::stretch,
  )
}

// ── Public widget ────────────────────────────────────────────────────

// Returns the search modal body. Caller wraps in
// modal::show_modal(title, child: this, footer, on_dismiss).
//
// on_open is invoked with the chosen issue when the user presses
// Enter (or clicks a row). Typical implementation: open the issue
// as a new tab and close the modal.
fn new(api_key: Str, on_open: fn(issues::Issue)) ui::Widget {
  ui::stateful(
    key: "search",
    init: fn(_ctx: ui::BuildContext) Search {
      let empty: [issues::Issue] = []
      Search{
        query: "",
        results: empty,
        cursor: 0,
        loading: false,
        error: "",
        searched: false,
        generation: 0,
        scroll: ui::scroll_controller(),
        list_scroll: ui::sliver_list_controller(),
      }
    },
    build: fn(ctx: ui::BuildContext, state: ui::State<Search>) ui::Widget {
      let theme = ui::must_have_theme(ctx)
      let model = state.value()
      let rt = ctx.runtime<Search>()

      let move_cursor = fn(delta: Int) {
        let count = model.results.size()
        if count > 0 {
          let next_cursor = clamp_cursor(model.cursor + delta, count)
          state.set(fn(mut s: Search) { s.cursor = next_cursor })
          let _ = ui::sliver_list_controller_reveal_index(
            model.list_scroll, next_cursor,
          )
        }
      }

      // Up / Down / Enter intercepted during the capture phase
      // before text_field's target phase consumes them. Other keys
      // (typing) aren't bound here, so they pass through to the
      // field naturally.
      ui::shortcuts(
        ui::actions(
          body(api_key, theme, model, state, rt, on_open),
          [
            ui::action("search.prev", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              move_cursor(-1)
              ui::EventResult::handled
            }),
            ui::action("search.next", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              move_cursor(1)
              ui::EventResult::handled
            }),
            ui::action("search.open", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
              if not model.loading {
                match selected_issue(model) {
                  issue => on_open(issue),
                  _ => (),
                }
              }
              ui::EventResult::handled
            }),
          ],
        ),
        [
          "Up": "search.prev",
          "Down": "search.next",
          "Enter": "search.open",
        ],
      )
    },
  )
}
