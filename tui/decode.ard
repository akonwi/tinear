use ard/decode
use ard/maybe

// Returns the field as `Some(Dynamic)` if present and non-null,
// otherwise `None`. Use this instead of `decode::field(name, ...)`
// for fields that might be absent — GraphQL inline fragments, for
// instance, omit the field entirely when their parent type doesn't
// match the fragment.
fn optional_field(data: Dynamic, name: Str) Dynamic? {
  match decode::run(data, decode::field(name, decode::dynamic)) {
    ok(v) => {
      match decode::is_void(v) {
        true => maybe::none(),
        false => maybe::some(v),
      }
    },
    err(_) => maybe::none(),
  }
}

// Renderable name for a Linear User. Prefers `displayName` when the
// User object contains it and it is non-empty; otherwise falls back
// to `name`. Queries should select both fields whenever possible so
// this helper always has something to return.
fn user_display_name(user: Dynamic) Str {
  let dn_opt = optional_field(user, "displayName")
  let dn = match dn_opt {
    d => decode::run(d, decode::string).expect("displayName not a string"),
    _ => "",
  }
  match dn.is_empty() {
    true => decode::run(user, decode::field("name", decode::string))
      .expect("Missing user.name"),
    false => dn,
  }
}
