use cooper
use cooper/ui
use tinear/tui/theme as tinear_theme

struct Hint {
  key: Str,
  label: Str,
}

struct HintsBar {
  root: mut ui::Box,
  actions_text: mut ui::Text,
  palette: tinear_theme::Theme,
}

private fn actions_content(hints: [Hint], palette: tinear_theme::Theme) ui::StyledText {
  let spans = mut List::new<ui::Span>()
  for hint, index in hints {
    if index > 0 {
      spans.push(ui::span("   "))
    }
    spans.push(
      ui::span(hint.key, style: ui::span_style(foreground: palette.accent, bold: true)),
    )
    if not hint.label.is_empty() {
      spans.push(ui::span(" {hint.label}", style: ui::span_style(dim: true)))
    }
  }
  ui::styled_text(spans.@)
}

fn new(ctx: mut cooper::Runtime, palette: tinear_theme::Theme, hints: [Hint]) mut HintsBar {
  let root = ui::box(
    ctx,
    styles: ui::style(
      width: ui::percent(100.0),
      height: ui::cells(1),
      flex_shrink: 0.0,
      flex_direction: ui::FlexDirection::row,
      align_items: ui::Align::center,
      justify_content: ui::Justify::start,
      overflow: ui::Overflow::hidden,
    ),
  )
  let actions_text = ui::text(
    ctx,
    content: actions_content(hints, palette),
    selectable: false,
    wrap: ui::TextWrap::none,
    overflow: ui::TextOverflow::ellipsis,
    styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 1.0),
  )
  root.add(actions_text)
  (mut HintsBar{
    root: root,
    actions_text: actions_text,
    palette: palette,
  })
}

impl HintsBar {
  fn mut set(hints: [Hint]) {
    self.actions_text.set_content(actions_content(hints, self.palette))
  }
}
