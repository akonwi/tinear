use go:go.rockorager.dev/vaxis/ui

// A keyboard hint to surface to the user.
//
// `key`   is the key (or chord) that triggers the action, e.g. "Tab",
//         "↑↓", "?", "Ctrl+c".
// `label` is the human-readable description, e.g. "switch", "select",
//         "open". May be empty when the key glyph is self-explanatory
//         (e.g. "↑↓" alone).
struct Hint {
  key: Str,
  label: Str,
}

// Reusable footer hints bar.
//
// Renders a top border followed by a row of hints. Each hint renders
// its `key` in `theme.Foreground` and its `label` in
// `theme.MutedForeground`, with 3 spaces between adjacent hints.
//
// The bar owns its top border so the composing column doesn't need a
// separate divider widget between the body and the hints.
fn render_hint(theme: ui::Theme, hint: Hint) ui::Widget {
  match hint.label.is_empty() {
    true => ui::Text{Value: hint.key, Style: ui::Style{Foreground: theme.Foreground}},
    false => {
      ui::RichText{
        Spans: [
          ui::TextSpan{Text: hint.key, Style: ui::Style{Foreground: theme.Foreground}},
          ui::TextSpan{Text: " {hint.label}", Style: ui::Style{Foreground: theme.MutedForeground}},
        ],
      }
    },
  }
}

// Bare hints row, no top border. Used inside containers (modal frames,
// etc.) that already supply their own divider above the footer.
fn row(theme: ui::Theme, items: [Hint]) ui::Widget {
  let children: mut [ui::Widget] = mut []
  for hint, idx in items {
    if idx > 0 {
      children.push(ui::Text{Value: "   "})
    }
    children.push(render_hint(theme, hint))
  }
  ui::Flex{Axis: ui::Horizontal, Children: children.@}
}

fn new(theme: ui::Theme, items: [Hint]) ui::Widget {
  mut children: [ui::Widget] = [
    ui::Divider{Style: ui::Style{Foreground: theme.Border, Background: theme.Background}},
    row(theme, items),
  ]
  ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    Children: children,
  }
}
