use cooper/box
use cooper/context
use cooper/style
use cooper/text
use tinear/tui/theme as tinear_theme

struct Hint {
  key: Str,
  label: Str,
}

struct HintsBar {
  root: mut box::Box,
  context_text: mut text::Text,
  actions_text: mut text::Text,
  palette: tinear_theme::Theme,
}

private fn actions_content(hints: [Hint], palette: tinear_theme::Theme) text::StyledText {
  let spans = mut List::new<text::Span>()
  for hint, index in hints {
    if index > 0 {
      spans.push(text::span("   "))
    }
    spans.push(
      text::span(hint.key, style: text::span_style(foreground: palette.accent, bold: true)),
    )
    if not hint.label.is_empty() {
      spans.push(text::span(" {hint.label}", style: text::span_style(dim: true)))
    }
  }
  text::styled_text(spans.@)
}

fn new(ctx: mut context::Context, palette: tinear_theme::Theme, context_label: Str, hints: [Hint]) mut HintsBar {
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::cells(1),
      flex_shrink: 0.0,
      flex_direction: style::FlexDirection::row,
      align_items: style::Align::center,
      justify_content: style::Justify::space_between,
      overflow: style::Overflow::hidden,
    ),
  )
  let context_text = text::new(
    ctx,
    content: " {context_label}",
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
    styles: style::new(
      width: style::cells(1),
      min_width: style::cells(8),
      height: style::cells(1),
      flex_grow: 1.0,
      flex_shrink: 1.0,
    ),
    text_style: text::style(dim: true),
  )
  let actions_text = text::new(
    ctx,
    content: actions_content(hints, palette),
    selectable: false,
    wrap: text::TextWrap::none,
    overflow: text::TextOverflow::ellipsis,
    styles: style::new(width: style::fit_content(), height: style::cells(1), flex_shrink: 1.0),
  )
  root.add(context_text)
  root.add(actions_text)
  (mut HintsBar{
    root: root,
    context_text: context_text,
    actions_text: actions_text,
    palette: palette,
  })
}

impl HintsBar {
  fn mut set(context_label: Str, hints: [Hint]) {
    self.context_text.set_content(" {context_label}")
    self.actions_text.set_content(actions_content(hints, self.palette))
  }
}
