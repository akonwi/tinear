use ard/async

use go:time

// Schedules `action` to run every `interval_ms` milliseconds on a
// background fiber until `stop` is closed. The first invocation happens
// AFTER the first sleep — callers that want immediate fetch-on-mount do
// it themselves before calling schedule_periodic.
fn schedule_periodic(stop: Chan<Bool>, interval_ms: Int, action: fn()) {
  async::start(
    fn() {
      mut running = true
      while running {
        select {
          stop.recv() => { running = false },
          time::After(time::Duration::from(interval_ms) * time::Millisecond).recv() => action(),
        }
      }
    },
  )
}
