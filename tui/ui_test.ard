use ard/testing

use tinear/tui/ui
use tinear/tui/ui/test as uitest

test fn test_ui_test_app_renders_text_and_cells() Void!Str {
  let app = uitest::app(ui::text("Hello", style: ui::style(reverse: true)))
  app.pump(10, 1)

  try testing::assert(app.contains("Hello"), "test app should expose painted text")
  try testing::assert(app.cell_grapheme(0, 0) == "H", "first cell should contain H")
  testing::assert(app.cell_reverse(0, 0), "styled text should mark reverse cells")
}

test fn test_ui_on_width_reports_pumped_width() Void!Str {
  mut width = 0
  let app = uitest::app(
    ui::on_width(
      ui::text("Sized"),
      fn(next: Int) {
        width = next
      },
    ),
  )

  app.pump(32, 3)
  try testing::assert(width == 32, "on_width should report initial layout width")

  app.pump(48, 3)
  testing::assert(width == 48, "on_width should report resized layout width")
}

test fn test_ui_key_debug_renders_title_and_description_toast() Void!Str {
  let app = uitest::app(ui::key_debug(ui::focusable(ui::text("Body"))))

  app.pump(40, 6)
  app.enter()
  app.pump(40, 6)

  try testing::assert(
    app.contains("Enter"),
    "key debug toast should show key name as title, got '{app.text()}'",
  )
  testing::assert(
    app.contains("code="),
    "key debug toast should show raw key details as description, got '{app.text()}'",
  )
}

test fn test_ui_box_can_render_sized_spacer_with_border() Void!Str {
  let app = uitest::app(
    ui::row([
      ui::box(
        width: 5,
        height: 3,
        border: ui::border(top: true, right: true, bottom: true, left: true, style: ui::style(foreground: "border")),
      ),
      ui::text("x"),
    ]),
  )

  app.pump(10, 5)

  let rendered = app.text()
  try testing::assert(rendered.contains("┌───┐"), "box should respect width, got '{rendered}'")
  try testing::assert(rendered.contains("│   │"), "box should render middle row, got '{rendered}'")
  testing::assert(rendered.contains("└───┘"), "box should respect height, got '{rendered}'")
}

test fn test_ui_box_spacer_does_not_paint_over_parent_border() Void!Str {
  let app = uitest::app(
    ui::row([
      ui::box(
        ui::column_min([
          ui::box(height: 1),
          ui::text("x"),
          ui::box(height: 1),
        ]),
        width: 5,
        border: ui::border(top: true, right: true, bottom: true, left: true, style: ui::style(foreground: "border")),
      ),
    ]),
  )

  app.pump(20, 8)
  let rendered = app.text()

  try testing::assert(rendered.contains("┌───┐"), "parent box should retain top border, got '{rendered}'")
  testing::assert(rendered.contains("└───┘"), "parent box should retain bottom border, got '{rendered}'")
}

test fn test_ui_overlay_positions_child_bottom_right() Void!Str {
  let app = uitest::app(ui::overlay(
    child: ui::text("Base"),
    overlay: ui::text("T"),
    position: ui::OverlayPosition::bottom_right,
    trap_focus: false,
    auto_focus: false,
  ))

  app.pump(10, 3)

  testing::assert(app.cell_grapheme(9, 2) == "T", "bottom-right overlay should paint in last cell")
}

test fn test_ui_test_app_dispatches_shortcut_actions() Void!Str {
  mut pressed = false
  let app = uitest::app(
    ui::actions(
      child: ui::shortcuts(child: ui::focusable(ui::text("Press x")), bindings: ["x": "test.press"]),
      bindings: [
        ui::action(
          "test.press",
          fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
            pressed = true
            ui::EventResult::handled
          },
        ),
      ],
    ),
  )

  app.pump(20, 1)
  app.key("x")

  testing::assert(pressed, "shortcut should dispatch action")
}

test fn test_ui_capture_shortcuts_fire_before_focused_text_field() Void!Str {
  mut moved = false
  let app = uitest::app(
    ui::actions(
      child: ui::shortcuts_capture(
        child: ui::focus_scope(
          child: ui::text_field(
            value: "",
            placeholder: "Search",
            min_width: 20,
            obscure: false,
            on_changed: fn(_ctx: ui::EventContext, _next: Str) {},
            on_submitted: fn(_ctx: ui::EventContext, _submitted: Str) {},
          ),
          trap: false,
          auto_focus: true,
        ),
        bindings: ["Down": "move.down"],
      ),
      bindings: [
        ui::action("move.down", fn(_ctx: ui::EventContext, _intent: Str) ui::EventResult {
          moved = true
          ui::EventResult::handled
        }),
      ],
    ),
  )

  app.pump(30, 3)
  app.down()

  testing::assert(moved, "capture shortcut should handle Down before focused text field")
}

test fn test_ui_text_area_edits_multiline_value() Void!Str {
  mut value = ""
  let app = uitest::app(
    ui::text_area(
      value: value,
      placeholder: "Write",
      min_width: 20,
      min_height: 3,
      soft_wrap: true,
      on_changed: fn(_ctx: ui::EventContext, next: Str) {
        value = next
      },
      on_submitted: fn(_ctx: ui::EventContext, _submitted: Str) {},
    ),
  )

  app.pump(30, 5)
  app.click(1, 1)
  app.key("h")
  app.key("i")
  app.enter()
  app.key("!")
  app.pump(30, 5)

  testing::assert(value == "hi\n!", "text_area should preserve newline edits")
}

test fn test_ui_text_area_submits_with_ctrl_j() Void!Str {
  mut submitted = ""
  let app = uitest::app(
    ui::text_area(
      value: "draft",
      placeholder: "Write",
      min_width: 20,
      min_height: 3,
      soft_wrap: true,
      on_changed: fn(_ctx: ui::EventContext, _next: Str) {},
      on_submitted: fn(_ctx: ui::EventContext, value: Str) {
        submitted = value
      },
    ),
  )

  app.pump(30, 5)
  app.click(1, 1)
  app.ctrl_j()

  testing::assert(submitted == "draft", "Ctrl+j should submit current text_area value")
}

test fn test_ui_scroll_view_clips_overflowing_child() Void!Str {
  let app = uitest::app(
    ui::scroll_view(ui::column_stretch([ui::text("line 1"), ui::text("line 2"), ui::text("line 3")])),
  )

  app.pump(20, 2)

  try testing::assert(app.contains("line 1"), "scroll view should render visible first line")
  try testing::assert(app.contains("line 2"), "scroll view should render visible second line")
  testing::assert(not app.contains("line 3"), "scroll view should clip overflowing third line")
}

test fn test_ui_scroll_view_scrolls_with_keyboard() Void!Str {
  let app = uitest::app(
    ui::scroll_view(ui::column_stretch([ui::text("line 1"), ui::text("line 2"), ui::text("line 3")])),
  )

  app.pump(20, 2)
  app.down()
  app.pump(20, 2)

  try testing::assert(not app.contains("line 1"), "scroll view should move first line out of view")
  testing::assert(app.contains("line 3"), "scroll view should reveal third line after scrolling")
}

test fn test_ui_scroll_pane_controller_scrolls_child() Void!Str {
  let controller = ui::scroll_pane_controller()
  let app = uitest::app(
    ui::scroll_pane(
      controller,
      ui::column_stretch([ui::text("line 1"), ui::text("line 2"), ui::text("line 3")]),
    ),
  )

  app.pump(20, 2)
  ui::scroll_pane_scroll_by(controller, 0, 1)
  app.pump(20, 2)

  try testing::assert(
    not app.contains("line 1"),
    "scroll pane controller should move first line out of view",
  )
  testing::assert(app.contains("line 3"), "scroll pane controller should reveal third line")
}
