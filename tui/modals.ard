use ard/decode

use tinear/tui/state
use tinear/tui/text
use tinear/vaxis

// Render the status picker modal centered on screen. Drawn last so
// it sits on top of the underlying tab. The interior is filled with
// spaces so tab content doesn't leak through.
fn draw_state_picker(vx: vaxis::Vaxis, picker: state::StatePicker) Void {
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)
  let term_h = vaxis::window_height(win)

  let w = 50
  let states_count = picker.states.size()
  // top + header + sep + states + foot_sep + footer + bottom
  let h = states_count + 6
  let x = (term_w - w) / 2
  let y = (term_h - h) / 2

  // Top border
  mut top = "┌"
  for i in 0..(w - 3) {
    top =+ "─"
  }
  top =+ "┐"
  vaxis::draw_text(vx, x, y, top)

  // Header row
  let header = " Status — {picker.issue_identifier} ({picker.team_name}) "
  let header_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, header, w - 2), w - 2)
  vaxis::draw_text(vx, x, y + 1, "│{header_padded}│")

  // Separator
  mut sep = "├"
  for i in 0..(w - 3) {
    sep =+ "─"
  }
  sep =+ "┤"
  vaxis::draw_text(vx, x, y + 2, sep)

  // State rows
  for s, i in picker.states {
    let sid = decode::run(s, decode::field("id", decode::string)).expect("Missing state.id")
    let sname = decode::run(s, decode::field("name", decode::string)).expect("Missing state.name")
    let cursor_mark = match i == picker.cursor {
      true => "▸",
      false => " ",
    }
    let current_suffix = match sid == picker.current_state_id {
      true => "  (current)",
      false => "",
    }
    let content = " {cursor_mark} {sname}{current_suffix}"
    let padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, content, w - 2), w - 2)
    vaxis::draw_text(vx, x, y + 3 + i, "│{padded}│")
  }

  // Separator above the footer hints.
  let foot_y = y + 3 + states_count
  mut foot_sep = "├"
  for i in 0..(w - 3) {
    foot_sep =+ "─"
  }
  foot_sep =+ "┤"
  vaxis::draw_text(vx, x, foot_y, foot_sep)

  // Footer with key hints
  let footer = " ↑↓ select  ↵ confirm  Esc cancel "
  let footer_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, footer, w - 2), w - 2)
  vaxis::draw_text(vx, x, foot_y + 1, "│{footer_padded}│")

  // Bottom border
  mut bot = "└"
  for i in 0..(w - 3) {
    bot =+ "─"
  }
  bot =+ "┘"
  vaxis::draw_text(vx, x, foot_y + 2, bot)
}

// Render the cycle picker modal centered on screen. Cursor index 0
// is rendered as the implicit "(no cycle)" row; subsequent rows
// correspond to picker.cycles.
fn draw_cycle_picker(vx: vaxis::Vaxis, picker: state::CyclePicker) Void {
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)
  let term_h = vaxis::window_height(win)

  // Adaptive width: cycle labels can be long (team naming
  // conventions like "FY26Q3 - Cycle 13") plus we right-align a
  // YYYY-MM-DD start date, so 50 cols is cramped.
  let w = match term_w > 80 {
    true => 70,
    false => match term_w > 60 {
      true => 60,
      false => term_w - 4,
    },
  }
  // + 1 for the implicit "(no cycle)" row
  let row_count = picker.cycles.size() + 1
  // top + header + sep + rows + foot_sep + footer + bottom
  let h = row_count + 6
  let x = (term_w - w) / 2
  let y = (term_h - h) / 2

  // Top border
  mut top = "┌"
  for i in 0..(w - 3) {
    top =+ "─"
  }
  top =+ "┐"
  vaxis::draw_text(vx, x, y, top)

  // Header row
  let header = " Cycle — {picker.issue_identifier} ({picker.team_name}) "
  let header_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, header, w - 2), w - 2)
  vaxis::draw_text(vx, x, y + 1, "│{header_padded}│")

  // Separator
  mut sep = "├"
  for i in 0..(w - 3) {
    sep =+ "─"
  }
  sep =+ "┤"
  vaxis::draw_text(vx, x, y + 2, sep)

  // Rows: " ▸ <label>      <date> "
  // The label half is left-aligned and truncated to fit; the date
  // half is right-aligned with one trailing space. When no startsAt
  // is available, the label takes the full row width.
  for r in 0..(row_count - 1) {
    let cursor_mark = match r == picker.cursor {
      true => "▸",
      false => " ",
    }
    mut label = ""
    mut date_str = ""
    if r == 0 {
      let suffix = match picker.current_cycle_id.is_empty() {
        true => "  (current)",
        false => "",
      }
      label = "(no cycle){suffix}"
    } else {
      let c = picker.cycles.at(r - 1)
      let number = decode::run(c, decode::field("number", decode::int))
        .expect("Missing cycle.number")
      let cid = decode::run(c, decode::field("id", decode::string))
        .expect("Missing cycle.id")
      let name_opt = decode::run(c, decode::field("name", decode::nullable(decode::string)))
        .expect("Missing cycle.name")
      let starts_opt = decode::run(c, decode::field("startsAt", decode::nullable(decode::string)))
        .expect("Missing cycle.startsAt")
      // Prefer the team's custom name (which usually already encodes
      // the cycle number, e.g. "FY26Q3 - Cycle 13"); fall back to
      // the bare number otherwise.
      let base = match name_opt {
        n => n,
        _ => "Cycle {number}",
      }
      let suffix = match cid == picker.current_cycle_id {
        true => "  (current)",
        false => "",
      }
      label = "{base}{suffix}"
      date_str = match starts_opt {
        s => text::format_date(s),
        _ => "",
      }
    }

    let prefix = " {cursor_mark} {label}"
    let date_width = vaxis::rendered_width(vx, date_str)
    // Reserve trailing space (1) plus the date column when present.
    let prefix_w = w - 3 - date_width
    let prefix_text = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, prefix, prefix_w), prefix_w)
    let row_content = "{prefix_text}{date_str} "
    vaxis::draw_text(vx, x, y + 3 + r, "│{row_content}│")
  }

  // Separator above the footer
  let foot_y = y + 3 + row_count
  mut foot_sep = "├"
  for i in 0..(w - 3) {
    foot_sep =+ "─"
  }
  foot_sep =+ "┤"
  vaxis::draw_text(vx, x, foot_y, foot_sep)

  // Footer with key hints
  let footer = " ↑↓ select  ↵ confirm  Esc cancel "
  let footer_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, footer, w - 2), w - 2)
  vaxis::draw_text(vx, x, foot_y + 1, "│{footer_padded}│")

  // Bottom border
  mut bot = "└"
  for i in 0..(w - 3) {
    bot =+ "─"
  }
  bot =+ "┘"
  vaxis::draw_text(vx, x, foot_y + 2, bot)
}

// Render the comment composer modal centered on screen. Multi-line
// body word-wrapped to the interior width; cursor follows the end of
// the buffer. If the wrapped output overflows the text area, only
// the last `text_h` lines are shown.
fn draw_comment_composer(vx: vaxis::Vaxis, composer: state::CommentComposer) Void {
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)
  let term_h = vaxis::window_height(win)

  let w = match term_w > 90 {
    true => 80,
    false => term_w - 4,
  }
  let h = match term_h > 24 {
    true => 18,
    false => term_h - 4,
  }
  let x = (term_w - w) / 2
  let y = (term_h - h) / 2

  // Top border
  mut top = "┌"
  for i in 0..(w - 3) {
    top =+ "─"
  }
  top =+ "┐"
  vaxis::draw_text(vx, x, y, top)

  // Header row
  let header = " New comment — {composer.issue_identifier} "
  let header_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, header, w - 2), w - 2)
  vaxis::draw_text(vx, x, y + 1, "│{header_padded}│")

  // Separator under header
  mut sep = "├"
  for i in 0..(w - 3) {
    sep =+ "─"
  }
  sep =+ "┤"
  vaxis::draw_text(vx, x, y + 2, sep)

  // Text area: rows y+3 through y+h-3 (h-5 rows total).
  let text_h = h - 5
  let text_w = w - 4
  let wrapped = text::wrap_text(composer.body, text_w)
  let total = wrapped.size()
  // If we overflow, show the last `text_h` lines.
  let first = match total > text_h {
    true => total - text_h,
    false => 0,
  }

  // Fill all text rows so any prior content is cleared.
  for r in 0..(text_h - 1) {
    let blank = text::pad_str_display(vx, "", text_w)
    vaxis::draw_text(vx, x, y + 3 + r, "│ {blank} │")
  }

  // Draw visible wrapped lines.
  mut cursor_row = 0
  mut cursor_col = 0
  for line, i in wrapped {
    if i >= first {
      let row_idx = i - first
      let padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, line, text_w), text_w)
      vaxis::draw_text(vx, x, y + 3 + row_idx, "│ {padded} │")
      if i == total - 1 {
        cursor_row = y + 3 + row_idx
        cursor_col = x + 2 + vaxis::rendered_width(vx, line)
      }
    }
  }
  if total == 0 {
    cursor_row = y + 3
    cursor_col = x + 2
  }

  // Footer with key hints
  let foot_y = y + 3 + text_h
  mut foot_sep = "├"
  for i in 0..(w - 3) {
    foot_sep =+ "─"
  }
  foot_sep =+ "┤"
  vaxis::draw_text(vx, x, foot_y, foot_sep)

  let footer = " Ctrl+↵ send  Esc cancel "
  let footer_padded = text::pad_str_display(vx, text::truncate_with_ellipsis_display(vx, footer, w - 2), w - 2)
  vaxis::draw_text(vx, x, foot_y + 1, "│{footer_padded}│")

  // Bottom border
  mut bot = "└"
  for i in 0..(w - 3) {
    bot =+ "─"
  }
  bot =+ "┘"
  vaxis::draw_text(vx, x, foot_y + 2, bot)

  // Cursor at the end of the buffer.
  vaxis::show_cursor(vx, cursor_col, cursor_row)
}
