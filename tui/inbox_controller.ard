use cooper
use cooper/cui
use cooper/ui
use go:strings
use tinear/models/inbox
use tinear/models/issue_state
use tinear/services/inbox_service
use tinear/tui/scheduler
use tinear/tui/shell_controller
use tinear/tui/theme as tinear_theme
use tinear/tui/timestamp

struct CachedDetail {
  notification_id: Str,
  detail: inbox::Detail,
}

struct InboxController {
  context: mut cooper::Runtime,
  list_scroll: mut cui::ScrollBoxRef,
  detail_scroll: mut cui::ScrollBoxRef,
  list_status: Str,
  list_status_error: Bool,
  detail_text: ui::TextContent,
  detail_dim: Bool,
  items: [inbox::Item],
  reported_count: Int,
  cursor: Int,
  hovered_id: Str,
  loading: Bool,
  list_generation: Int,
  detail_generation: Int,
  detail_notification_id: Str,
  cached_details: [CachedDetail],
  stop: Chan<Bool>,
  disposed: Bool,
  pending_focus: Bool,
  invalidate: fn(),
  service: inbox_service::Service,
  schedule: scheduler::Schedule,
  cancel_refresh: fn(),
  on_open_issue: fn(Str),
  open_url: fn(Str),
  notify_error: fn(Str, Str),
  palette: tinear_theme::Theme,
}

private fn status_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    width: ui::percent(100.0),
    height: ui::cells(1),
    flex_shrink: 0.0,
  )
}

private fn detail_content(item: inbox::Item, detail: inbox::Detail, palette: tinear_theme::Theme) ui::StyledText {
  let spans = mut List::new<ui::Span>()
  spans.push(
    ui::span(
      "{item.actor_name} {item.type_label}",
      style: ui::span_style(foreground: palette.accent, bold: true),
    ),
  )
  let identity = match detail.team_key.is_empty() {
    true => detail.identifier,
    false => "{detail.identifier} · {detail.team_key}",
  }
  spans.push(ui::span("\n{identity}", style: ui::span_style(dim: true)))
  spans.push(ui::span("\n\n{detail.title}", style: ui::span_style(bold: true)))
  spans.push(
    ui::span(
      "\n\n── Details ─────────────────────────",
      style: ui::span_style(dim: true),
    ),
  )
  if not detail.state_name.is_empty() {
    spans.push(ui::span("\nStatus      ", style: ui::span_style(dim: true)))
    spans.push(ui::span(detail.state_name))
  }
  if (not detail.assignee_name.is_empty()) and not detail.assignee_name == "—" {
    spans.push(ui::span("\nAssignee    ", style: ui::span_style(dim: true)))
    spans.push(ui::span(detail.assignee_name))
  }
  let priority = issue_state::priority_label(detail.priority)
  if not priority == "—" {
    spans.push(ui::span("\nPriority    ", style: ui::span_style(dim: true)))
    spans.push(ui::span(priority))
  }
  if not detail.team_name.is_empty() {
    spans.push(ui::span("\nTeam        ", style: ui::span_style(dim: true)))
    spans.push(ui::span(detail.team_name))
  }
  if not detail.project_name.is_empty() and not detail.project_name == "—" {
    spans.push(ui::span("\nProject     ", style: ui::span_style(dim: true)))
    spans.push(ui::span(detail.project_name))
  }
  if not detail.description.is_empty() {
    spans.push(
      ui::span(
        "\n\n── Description ─────────────────────",
        style: ui::span_style(dim: true),
      ),
    )
    spans.push(ui::span("\n{detail.description}"))
  }
  match detail.triggering_comment {
    comment => {
      spans.push(
        ui::span(
          "\n\n── Activity ────────────────────────",
          style: ui::span_style(dim: true),
        ),
      )
      let header = match comment.created_at.is_empty() {
        true => comment.author,
        false => "{comment.author} · {timestamp::friendly(comment.created_at)}",
      }
      spans.push(ui::span("\n{header}", style: ui::span_style(dim: true)))
      spans.push(ui::span("\n{comment.body}"))
    },
    _ => (),
  }
  if detail.comments.size() > 0 {
    spans.push(
      ui::span(
        "\n\n── Comments ────────────────────────",
        style: ui::span_style(dim: true),
      ),
    )
    for comment in detail.comments {
      let header = match comment.created_at.is_empty() {
        true => comment.author,
        false => "{comment.author} · {timestamp::friendly(comment.created_at)}",
      }
      spans.push(ui::span("\n{header}", style: ui::span_style(dim: true)))
      spans.push(ui::span("\n{comment.body}\n"))
    }
  }
  if detail.history.size() > 0 {
    spans.push(
      ui::span(
        "\n\n── History ─────────────────────────",
        style: ui::span_style(dim: true),
      ),
    )
    for history in detail.history {
      spans.push(
        ui::span(
          "\n{history.from_state} → {history.to_state}",
          style: ui::span_style(dim: true),
        ),
      )
    }
  }
  ui::styled_text(spans.@)
}

private fn detail_preview(item: inbox::Item, palette: tinear_theme::Theme) ui::StyledText {
  ui::styled_text(
    [
      ui::span(
        "{item.actor_name} {item.type_label}",
        style: ui::span_style(foreground: palette.accent, bold: true),
      ),
      ui::span("\n{item.target_id}", style: ui::span_style(dim: true)),
      ui::span("\n\n{item.title}", style: ui::span_style(bold: true)),
      ui::span("\n\nLoading details…", style: ui::span_style(dim: true)),
    ],
  )
}

private fn detail_error(item: inbox::Item, message: Str, palette: tinear_theme::Theme) ui::StyledText {
  ui::styled_text(
    [
      ui::span(
        "{item.actor_name} {item.type_label}",
        style: ui::span_style(foreground: palette.accent, bold: true),
      ),
      ui::span("\n{item.target_id}", style: ui::span_style(dim: true)),
      ui::span("\n\n{item.title}", style: ui::span_style(bold: true)),
      ui::span(
        "\n\n! Couldn't load details",
        style: ui::span_style(foreground: palette.danger, bold: true),
      ),
      ui::span("\n{message}", style: ui::span_style(dim: true)),
    ],
  )
}

fn new(
  ctx: mut cooper::Runtime,
  palette: tinear_theme::Theme,
  service: inbox_service::Service,
  schedule: scheduler::Schedule,
  on_open_issue: fn(Str),
  open_url: fn(Str),
  notify_error: fn(Str, Str),
) mut InboxController {
  (mut InboxController{
    context: ctx,
    list_scroll: cui::scroll_box_ref(),
    detail_scroll: cui::scroll_box_ref(),
    list_status: "Loading Inbox…",
    list_status_error: false,
    detail_text: "Select a notification",
    detail_dim: true,
    items: [],
    reported_count: -1,
    cursor: 0,
    hovered_id: "",
    loading: false,
    list_generation: 0,
    detail_generation: 0,
    detail_notification_id: "",
    cached_details: [],
    stop: Chan::new<Bool>(),
    disposed: false,
    pending_focus: false,
    invalidate: fn() {},
    service: service,
    schedule: schedule,
    cancel_refresh: fn() {},
    on_open_issue: on_open_issue,
    open_url: open_url,
    notify_error: notify_error,
    palette: palette,
  })
}

impl InboxController {
  private fn mut scroll_list_to_cursor() {
    match self.list_scroll.current {
      panel => {
        let _ = panel.scroll_to(self.cursor * 3)
      },
      _ => (),
    }
  }

  private fn mut scroll_detail_to(offset: Int) {
    match self.detail_scroll.current {
      panel => {
        let _ = panel.scroll_to(offset)
      },
      _ => (),
    }
  }

  private fn mut scroll_detail_by(delta: Int) {
    match self.detail_scroll.current {
      panel => {
        let _ = panel.scroll_by(delta)
      },
      _ => (),
    }
  }

  private fn mut update_terminal_title() {
    let count = self.items.size()
    if count != self.reported_count {
      self.reported_count = count
      let title = match count > 0 {
        true => "tinear ({count})",
        false => "tinear",
      }
      let _ = self.context.set_title(title)
    }
  }

  private fn selected_id() Str {
    match self.items.at(self.cursor) {
      item => item.notification_id,
      _ => "",
    }
  }

  private fn mut show_list_status(message: Str, error: Bool) {
    self.list_status = message
    self.list_status_error = error
  }

  private fn mut replace_items(items: [inbox::Item], preserve_selection: Bool) {
    let previous_id = match preserve_selection {
      true => self.selected_id(),
      false => "",
    }
    self.items = items
    self.cursor = 0
    if not previous_id.is_empty() {
      for item, index in self.items {
        if item.notification_id == previous_id {
          self.cursor = index
        }
      }
    }
    if self.cursor >= self.items.size() and self.items.size() > 0 {
      self.cursor = self.items.size() - 1
    }
    self.scroll_list_to_cursor()
    match self.items.size() {
      0 => {
        self.show_list_status("No notifications", false)
        self.detail_notification_id = ""
        self.detail_dim = true
        self.detail_text = "You're all caught up."
      },
      _ => {
        self.show_list_status("", false)
        self.load_selected_detail()
      },
    }
  }

  private fn mut schedule_refresh() {
    (self.cancel_refresh)()
    self.cancel_refresh = self.schedule(5 * 60 * 1000, fn() {
      if not self.disposed {
        self.refresh(true)
        self.schedule_refresh()
      }
    })
  }

  fn mut start() {
    if (not self.disposed) and self.list_generation == 0 {
      self.refresh(false)
      self.schedule_refresh()
    }
  }

  fn mut refresh(silent: Bool) {
    if not self.disposed {
      self.list_generation =+ 1
      let generation = self.list_generation
      self.loading = true
      if not silent {
        self.show_list_status("Loading Inbox…", false)
      }
      self.service.load(self.stop.receiver(), fn(result: [inbox::Item]!Str) {
        if (not self.disposed) and generation == self.list_generation {
          self.loading = false
          match result {
            ok(items) => self.replace_items(items, silent),
            err(message) => {
              if self.items.size() == 0 {
                self.show_list_status(message, true)
              } else {
                self.notify_error("Couldn't refresh Inbox", message)
              }
            },
          }
          self.update_terminal_title()
          (self.invalidate)()
          self.retry_focus()
        }
      })
    }
  }

  private fn cached_detail(notification_id: Str) inbox::Detail? {
    mut found: inbox::Detail? = Maybe::new()
    for cached in self.cached_details {
      if cached.notification_id == notification_id {
        found = Maybe::new(cached.detail)
      }
    }
    found
  }

  private fn mut cache_detail(notification_id: Str, detail: inbox::Detail) {
    let next = mut List::new<CachedDetail>()
    for cached in self.cached_details {
      if not cached.notification_id == notification_id {
        next.push(cached)
      }
    }
    next.push(CachedDetail{notification_id: notification_id, detail: detail})
    self.cached_details = next.@
  }

  private fn mut load_selected_detail() {
    match self.items.at(self.cursor) {
      item => {
        self.detail_generation =+ 1
        let generation = self.detail_generation
        let notification_id = item.notification_id
        self.detail_notification_id = notification_id
        self.detail_dim = false
        let cached = self.cached_detail(notification_id)
        let had_cached = cached.is_some()
        match cached {
          detail => { self.detail_text = detail_content(item, detail, self.palette) },
          _ => { self.detail_text = detail_preview(item, self.palette) },
        }
        self.scroll_detail_to(0)
        self.service.load_detail(
          notification_id,
          self.stop.receiver(),
          fn(result: inbox::Detail!Str) {
            if not self.disposed {
              match result {
                ok(detail) => {
                  self.cache_detail(notification_id, detail)
                  if generation == self.detail_generation and self.detail_notification_id == notification_id {
                    self.detail_text = detail_content(item, detail, self.palette)
                    (self.invalidate)()
                  }
                },
                err(message) => {
                  if (not had_cached) and generation == self.detail_generation and self.detail_notification_id == notification_id {
                    self.detail_text = detail_error(item, message, self.palette)
                    (self.invalidate)()
                  }
                },
              }
            }
          },
        )
      },
      _ => {
        self.detail_notification_id = ""
        self.detail_dim = true
        self.detail_text = "Select a notification"
      },
    }
  }

  fn mut select_id(notification_id: Str) {
    if not self.disposed {
      for item, index in self.items {
        if item.notification_id == notification_id {
          self.cursor = index
        }
      }
      self.scroll_list_to_cursor()
      self.load_selected_detail()
    }
  }

  private fn mut move_cursor(delta: Int) {
    if self.items.size() > 0 {
      let cleared_hover = not self.hovered_id.is_empty()
      self.hovered_id = ""
      mut next = self.cursor + delta
      if next < 0 {
        next = 0
      }
      if next >= self.items.size() {
        next = self.items.size() - 1
      }
      if next != self.cursor {
        self.cursor = next
        self.scroll_list_to_cursor()
        self.load_selected_detail()
      }
    }
  }

  private fn mut open_selected(browser: Bool) {
    match self.items.at(self.cursor) {
      item => {
        if browser {
          if not item.url.is_empty() {
            self.open_url(item.url)
          }
        } else if item.notification_type.starts_with("issue") {
          if (not item.target_id.is_empty()) and not item.target_id == "—" {
            self.on_open_issue(item.target_id)
          }
        } else if not item.url.is_empty() {
          self.open_url(item.url)
        }
      },
      _ => (),
    }
  }

  private fn mut archive_selected() {
    match self.items.at(self.cursor) {
      item => {
        let remaining = mut List::new<inbox::Item>()
        for candidate in self.items {
          if not candidate.notification_id == item.notification_id {
            remaining.push(candidate)
          }
        }
        self.items = remaining.@
        self.update_terminal_title()
        if self.cursor >= self.items.size() and self.cursor > 0 {
          self.cursor =- 1
        }
        match self.items.size() {
          0 => {
            self.detail_generation =+ 1
            self.detail_notification_id = ""
            self.show_list_status("No notifications", false)
            self.detail_dim = true
            self.detail_text = "You're all caught up."
          },
          _ => self.load_selected_detail(),
        }
        self.service.archive(
          item.notification_id,
          self.stop.receiver(),
          fn(result: Void!Str) {
            if not self.disposed {
              match result {
                ok(_) => (),
                err(message) => self.notify_error("Couldn't archive notification", message),
              }
            }
          },
        )
      },
      _ => (),
    }
  }

  // A screen that is still loading describes no focus target, or describes one
  // inside a hidden subtree, so the claim is remembered and retried after the
  // commit that first reveals it.
  private fn mut apply_focus() Bool {
    mut applied = false
    match self.list_scroll.current {
      panel => {
        applied = panel.focus()
      },
      _ => (),
    }
    if applied {
      self.pending_focus = false
    }
    applied
  }

  fn mut focus() {
    self.pending_focus = true
    let _ = self.apply_focus()
  }

  private fn mut retry_focus() {
    if self.pending_focus and (not self.disposed) {
      let _ = self.context.dispatch(fn() {
        if self.pending_focus and (not self.disposed) {
          let _ = self.apply_focus()
        }
      })
    }
  }

  fn mut handle_key(received: mut cooper::KeyEvent) Bool {
    if self.disposed or received.event_type == cooper::KeyEventType::release {
      false
    } else {
      mut handled = true
      match {
        received.matches("j") or received.matches("down") => self.move_cursor(1),
        received.matches("k") or received.matches("up") => self.move_cursor(-1),
        received.matches("return") => self.open_selected(false),
        received.matches("o") => self.open_selected(true),
        received.matches("backspace") => self.archive_selected(),
        received.matches("r") => self.refresh(false),
        received.matches("l") or received.matches("right") => {
          self.scroll_detail_by(1)
        },
        received.matches("h") or received.matches("left") => {
          self.scroll_detail_by(-1)
        },
        received.matches("space", shift: true) => {
          self.scroll_detail_by(-10)
        },
        received.matches("space") => {
          self.scroll_detail_by(10)
        },
        _ => { handled = false },
      }
      if handled {
        // Key routing happens outside CUI, so request a render explicitly.
        (self.invalidate)()
      }
      handled
    }
  }

  fn mut view() cui::View {
    cui::child(inbox_view, InboxProps{controller: self}, key: "inbox")
  }

  fn mut screen() shell_controller::Screen {
    shell_controller::declarative_screen(
      view: self.view(),
      focus: fn() {
        self.focus()
      },
      handle_key: fn(received: mut cooper::KeyEvent) Bool {
        self.handle_key(received)
      },
      dispose: fn() {
        self.dispose()
      },
    )
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      (self.cancel_refresh)()
      self.cancel_refresh = fn() {}
      self.stop.close()
    }
  }
}

struct InboxProps {
  controller: mut InboxController,
}

struct InboxView {
  props: mut InboxProps,
}

private fn inbox_view(props: mut InboxProps) mut InboxView {
  (mut InboxView{props: props})
}

impl InboxView {
  private fn mut row(item: inbox::Item, index: Int) cui::View {
    let controller = self.props.controller
    let palette = controller.palette
    let active = index == controller.cursor
    let hovered = (not active) and item.notification_id == controller.hovered_id
    let foreground = match {
      active => palette.item_active_foreground,
      hovered => palette.item_hover_foreground,
      _ => palette.foreground,
    }
    let background = match {
      active => palette.item_active_background,
      hovered => palette.item_hover_background,
      _ => palette.background,
    }
    let notification_id = item.notification_id
    cui::box(
      [
        cui::box(
          [
            cui::text(
              item.title,
              selectable: false,
              wrap: ui::TextWrap::none,
              overflow: ui::TextOverflow::ellipsis,
              styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
              text_style: ui::text_style(foreground: foreground, bold: active),
            ),
            cui::text(
              "{item.actor_name} {item.type_label} · {item.target_id}",
              selectable: false,
              wrap: ui::TextWrap::none,
              overflow: ui::TextOverflow::ellipsis,
              styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
              text_style: ui::text_style(
                foreground: foreground,
                dim: (not active) and not hovered,
              ),
            ),
          ],
          styles: ui::style(
            width: ui::cells(1),
            height: ui::cells(2),
            flex_grow: 1.0,
            background: background,
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(0),
              bottom: ui::cells(0),
              left: ui::cells(1),
            },
          ),
          on_mouse: fn(received: mut cooper::MouseEvent, ctx: cui::Context) {
            if received.event_type == cooper::MouseEventType::move {
              controller.hovered_id = notification_id
            } else if received.event_type == cooper::MouseEventType::out {
              if controller.hovered_id == notification_id {
                controller.hovered_id = ""
              }
            } else if received.event_type == cooper::MouseEventType::down and received.button == cooper::MouseButton::left {
              controller.select_id(notification_id)
              received.stop_propagation()
            }
          },
        ),
      ],
      key: "row-{item.notification_id}",
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::cells(3),
        flex_shrink: 0.0,
        flex_direction: ui::FlexDirection::row,
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}

// The render request is bound at mount instead of injected at construction, so
// the controller needs no `notify` wiring from its host or its tests.
impl cui::Lifecycle for InboxView {
  fn mut mounted(ctx: cui::Context) {
    self.props.controller.invalidate = ctx.invalidate_root
  }

  fn mut unmounting(ctx: cui::Context) {
    self.props.controller.invalidate = fn() {}
  }
}

impl cui::Component for InboxView {
  fn mut render() cui::View {
    let controller = self.props.controller
    let palette = controller.palette
    let list = mut List::new<cui::View>()
    if not controller.list_status.is_empty() {
      list.push(
        cui::text(
          "  {controller.list_status}",
          selectable: false,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(1), flex_shrink: 0.0),
          text_style: match controller.list_status_error {
            true => ui::text_style(foreground: palette.danger, bold: true),
            false => ui::text_style(dim: true),
          },
        ),
      )
    }
    for item, index in controller.items {
      list.push(self.row(item, index))
    }
    cui::box(
      [
        cui::scroll_box(
          list.@,
          ref: controller.list_scroll,
          styles: ui::style(
            width: ui::percent(35.0),
            height: ui::percent(100.0),
            flex_shrink: 0.0,
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(1),
              bottom: ui::cells(0),
              left: ui::cells(0),
            },
          ),
        ),
        cui::text(
          strings::Repeat("│\n", 256),
          selectable: false,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::clip,
          styles: ui::style(width: ui::cells(1), height: ui::percent(100.0), flex_shrink: 0.0),
          text_style: ui::text_style(dim: true),
        ),
        cui::box(
          [
            cui::scroll_box(
              [
                cui::text(
                  controller.detail_text,
                  wrap: ui::TextWrap::word,
                  styles: ui::style(width: ui::percent(100.0), flex_shrink: 0.0),
                  text_style: ui::text_style(dim: controller.detail_dim),
                ),
              ],
              ref: controller.detail_scroll,
              styles: ui::style(
                width: ui::percent(100.0),
                height: ui::cells(0),
                flex_grow: 1.0,
                min_height: ui::cells(0),
              ),
            ),
          ],
          styles: ui::style(
            width: ui::cells(0),
            height: ui::percent(100.0),
            flex_grow: 1.0,
            flex_shrink: 1.0,
            min_width: ui::cells(0),
            padding: ui::Edges{
              top: ui::cells(0),
              right: ui::cells(1),
              bottom: ui::cells(0),
              left: ui::cells(1),
            },
          ),
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::row,
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}
