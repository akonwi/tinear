use tinear/tui/core/view
use tinear/tui/core/text
use tinear/tui/core/box
use tinear/tui/core/rect
use tinear/tui/core/style
use tinear/vaxis

// Stateful tab bar view.
//
// The selected tab lives inside TabBar. The app owns a concrete TabBar field,
// forwards relevant events to it, and render derives the visible tabs from the
// current selected index.
struct TabBar {
  labels: [Str],
  selected: Int,
}

fn new(labels: [Str]) TabBar {
  TabBar{labels: labels, selected: 0}
}

impl TabBar {
  fn selected_index() Int { self.selected }

  fn selected_label() Str {
    match self.labels.size() == 0 {
      true => "",
      false => self.labels.at(self.selected),
    }
  }

  fn mut select(index: Int) {
    match self.labels.size() {
      0 => (),
      _ => {
        match {
          index < 0 => { self.selected = 0},
          index >= self.labels.size() => { self.selected = self.labels.size() - 1 },
          _ => { self.selected = index }
        }
      }
    }
  }

  fn mut next() {
    match self.labels.size() == 0 {
      true => { self.selected = 0 },
      false => {
        let next = self.selected + 1
        self.selected = match next >= self.labels.size() {
          true => 0,
          false => next,
        }
      }
    }
  }

  fn mut previous() {
    match self.labels.size() == 0 {
      true => { self.selected = 0 },
      false => {
        self.selected = match self.selected <= 0 {
          true => self.labels.size() - 1,
          false => self.selected - 1,
        }
      }
    }
  }

  // Handle tab-bar-specific key events. Returns true when the event was
  // consumed by the tab bar.
  fn mut handle_key(key: vaxis::KeyEvent) Bool {
    match key.name {
      "Tab" => {
        self.next()
        true
      },
      "Left" => {
        self.previous()
        true
      },
      "Right" => {
        self.next()
        true
      },
      _ => false,
    }
  }
}

impl view::View for TabBar {
  fn render(mut frame: view::Frame) {
    mut x = 0
    for label, idx in self.labels {
      if idx > 0 {
        let sep = text::new("│")
        let sep_area = rect::Rect{x: x, y: 0, w: frame.width() - x, h: 1}
        mut sep_sub = view::sub(frame, sep_area)
        sep.render(sep_sub)
        let sep_dim = sep_sub.dimensions()
        frame.expand(x + sep_dim.x, sep_dim.y, sep_dim.w, sep_dim.h)
        x = x + sep_dim.x + sep_dim.w
      }

      let selected = idx == self.selected
      let tab = box::new(
        text::new(label, reverse: selected),
        style::Style{
          padding: style::Padding::x(1),
          reverse: selected,
        },
      )
      let tab_area = rect::Rect{x: x, y: 0, w: frame.width() - x, h: 1}
      mut tab_sub = view::sub(frame, tab_area)
      tab.render(tab_sub)
      let tab_dim = tab_sub.dimensions()
      frame.expand(x + tab_dim.x, tab_dim.y, tab_dim.w, tab_dim.h)
      x = x + tab_dim.x + tab_dim.w
    }
  }
}
