// Tab bar — app-level composed view built from `tui/core/`
// primitives.
//
// This is the kind of "composition that proves useful enough to
// name" that ADR 0003 expects to live in `tui/`, not `tui/core/`.
// The core framework knows nothing about tabs; it just provides
// the layout primitives.
//
// Given a list of labels and the index of the active tab, returns
// a one-row HStack:
//
//    Inbox │ My Issues │ AKO-123
//
// Each label is wrapped in a Box with horizontal padding so the
// reverse-video highlight (on the active tab) extends one cell
// past the letters on each side. Style decoration doesn't
// propagate into a child's content cells, so the active tab sets
// `reverse` both on the Box's Style (which paints the padding
// ring) and on the inner Text (which paints the label glyphs).

use tinear/tui/core/box
use tinear/tui/core/stack
use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view

// Construct a tab bar from `labels` with `active` highlighted.
// Returns a `view::View` (cross-module trait coercion happens in
// this module).
fn tab_bar(labels: [Str], active: Int) view::View {
  mut children: [view::View] = []
  for label, idx in labels {
    if idx > 0 {
      children.push(text::new("│"))
    }
    if idx == active {
      children.push(box::new(
        text::new(label, reverse: true),
        style::Style{
          padding: style::Padding::x(1),
          reverse: true,
        },
      ))
    } else {
      children.push(box::new(
        text::new(label),
        style::Style{padding: style::Padding::x(1)},
      ))
    }
  }
  stack::hstack(children)
}
