use ard/testing as assertions

use cooper
use cooper/cui
use cooper/cui/renderer
use cooper/event
use cooper/testing
use cooper/ui
use tinear/models/cache
use tinear/models/shell as shell_model
use tinear/models/tabs
use tinear/tui/screen_route
use tinear/tui/tab_shell
use tinear/tui/theme

private struct ScreenState {
  focuses: Int,
  handled: Int,
  disposals: Int,
}

private struct Counter {
  value: Int,
}

private fn modifiers() cooper::Modifiers {
  cooper::Modifiers{
    shift: false,
    ctrl: false,
    alt: false,
    super: false,
  }
}

private fn key(value: Str) mut cooper::KeyEvent {
  event::key(value, value, cooper::KeyEventType::press, modifiers())
}

test fn tab_chips_use_intrinsic_cell_width_with_a_document_cap() Void!Str {
  let application = testing::new(80, 12)
  defer application.destroy()
  try assertions::assert(
    tab_shell::tab_chip_width(application.context.measure_text("CCA-1782"), true) == 12,
    "issue tabs should not reserve document-title width",
  )
  try assertions::assert(
    tab_shell::tab_chip_width(
      application.context.measure_text("A very long document title that needs clipping"),
      true,
    ) == 26,
    "long dynamic labels should retain the existing cap",
  )
  assertions::assert(
    tab_shell::tab_chip_width(application.context.measure_text("Inbox"), false) == 7,
    "permanent tabs should preserve their padding",
  )
  assertions::assert(
    tab_shell::tab_chip_width(application.context.measure_text("界界"), true) == 8,
    "wide graphemes should use terminal cell width rather than rune count",
  )
}

private struct FakeProps {
  label: Str,
  state: mut ScreenState,
  route: mut screen_route::Route,
}

private struct FakeScreen {
  props: mut FakeProps,
  panel: mut cui::BoxRef,
}

private fn fake_component(props: mut FakeProps) mut FakeScreen {
  (mut FakeScreen{props: props, panel: cui::box_ref()})
}

impl cui::Lifecycle for FakeScreen {
  fn mut mounted(ctx: cui::Context) {
    self.props.route.focus = fn() {
      self.panel.focus(ctx)
    }
    self.panel.current.expect(
      "mounted panel",
    ).node().on_focus(fn() {
      self.props.state.focuses =+ 1
    })
  }

  fn mut unmounting(ctx: cui::Context) {
    self.props.route.clear()
  }
}

impl cui::Component for FakeScreen {
  fn mut render() cui::View {
    cui::box(
      // A no-op key handler is what makes the panel focusable.
      [cui::text(self.props.label)],
      on_key: fn(received: mut cooper::KeyEvent, context: cui::Context) {},
      ref: self.panel,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::row,
      ),
    )
  }
}

private fn fake_screen(ctx: mut cooper::Runtime, label: Str, state: mut ScreenState) tab_shell::Screen {
  let route = screen_route::new()
  tab_shell::screen(
    view: cui::child(
      fake_component,
      FakeProps{
        label: label,
        state: state,
        route: route,
      },
    ),
    focus: fn() {
      route.focus()
    },
    handle_key: fn(received: mut cooper::KeyEvent) Bool {
      if received.matches("x") {
        state.handled =+ 1
        true
      } else {
        false
      }
    },
    dispose: fn() {
      state.disposals =+ 1
    },
  )
}

private fn dynamic_factory(ctx: mut cooper::Runtime, created: mut Counter, disposed: mut Counter) fn(tabs::TabRef) tab_shell::Screen {
  fn(reference: tabs::TabRef) tab_shell::Screen {
    created.value =+ 1
    let state = mut ScreenState{
      focuses: 0,
      handled: 0,
      disposals: 0,
    }
    let base = fake_screen(ctx, "Detail {reference.title}", state)
    tab_shell::screen(
      view: base.view,
      focus: base.focus,
      handle_key: base.handle_key,
      dispose: fn() {
        base.dispose()
        disposed.value =+ 1
      },
    )
  }
}

private fn tracked_dynamic_factory(
  ctx: mut cooper::Runtime,
  created: mut Counter,
  disposed: mut Counter,
  handled: mut Counter,
) fn(tabs::TabRef) tab_shell::Screen {
  fn(reference: tabs::TabRef) tab_shell::Screen {
    created.value =+ 1
    let state = mut ScreenState{
      focuses: 0,
      handled: 0,
      disposals: 0,
    }
    let base = fake_screen(ctx, "Detail {reference.title}", state)
    tab_shell::screen(
      view: base.view,
      focus: base.focus,
      handle_key: fn(received: mut cooper::KeyEvent) Bool {
        if received.matches("x") {
          handled.value =+ 1
          true
        } else {
          false
        }
      },
      dispose: fn() {
        base.dispose()
        disposed.value =+ 1
      },
    )
  }
}

test fn shell_switches_persistent_tabs_and_persists_selection() Void!Str {
  let application = testing::new(80, 16)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let snapshots = mut List::new<cache::LoggedInCache>()
  let fixture = mount_shell(
    application,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox body", inbox_state),
    fake_screen(application.context, "Board body", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {
      snapshots.push(value)
    },
    fn() {},
    fn() {},
    fn() {},
  )
  let mounted = fixture.mounted
  let component = fixture.component
  defer mounted.destroy()
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Inbox body")
  let active_tab = application.frame().cell(1, 0).expect("active Inbox tab")
  try assertions::assert(active_tab.grapheme == "I", "active tab label should remain readable")
  try assertions::assert(
    active_tab.style.foreground.expect("active tab accent").index.expect("host palette index") == Uint8::from(4),
    "active tab should use host accent",
  )
  try assertions::assert(
    active_tab.style.bold and (not active_tab.style.underline) and (not active_tab.style.reverse),
    "active tab should use accent and weight without underline or reverse video",
  )
  let top_rule = application.frame().cell(0, 1).expect("tab rule")
  try assertions::assert(
    top_rule.grapheme == "─" and top_rule.style.dim,
    "tab bar should end with a dim rule",
  )
  try assertions::assert(
    not application.frame().text().contains("Board body"),
    "board should stay mounted but hidden",
  )
  let first_hint = application.frame().cell(0, 15).expect("left-aligned footer hint")
  try assertions::assert(
    first_hint.grapheme == "T" and first_hint.style.bold,
    "footer key hints should begin at the left edge",
  )

  try assertions::assert(component.handle_key(key("tab")), "Tab should switch views")
  let _ = application.flush()
  application.render()
  try assertions::assert(component.model.tab_index == 1, "Tab should select My Issues")
  let board_tab = application.frame().cell(8, 0).expect("active board tab")
  try assertions::assert(
    board_tab.style.bold and (not board_tab.style.underline) and (not board_tab.style.reverse),
    "selected board tab should follow Quiet Structure selection",
  )
  let board_hint = application.frame().cell(0, 15).expect("board footer hint")
  try assertions::assert(
    board_hint.grapheme == "r",
    "updated footer hints should remain left-aligned without a tab-title prefix",
  )
  let board_hints = application.frame().text()
  try assertions::assert(
    board_hints.contains("s status") and board_hints.contains("y cycle") and board_hints.contains("p priority") and board_hints.contains("a assignee") and board_hints.contains("P project"),
    "board edit bindings should name each field action",
  )
  try assertions::assert(
    (not board_hints.contains("←")) and (not board_hints.contains("drag")) and (not board_hints.contains("↵")),
    "board footer should omit redundant selection, drag, and open hints",
  )
  try assertions::assert(board_state.focuses == 1, "new active screen should reclaim focus")
  try assertions::assert(snapshots.size() == 1, "selection should persist")
  try testing::assert_contains(application.frame().text(), "Board body")
  // Hidden pages stay mounted; only the visibility wrapper changes, so the
  // inactive screen must contribute nothing to the frame.
  try assertions::assert(
    not application.frame().text().contains("Inbox body"),
    "Inbox should remain mounted but hidden",
  )
  for size in [[60, 20], [100, 30], [160, 40]] {
    application.resize(size.at(0).expect("width"), size.at(1).expect("height"))
    try assertions::assert(component.model.tab_index == 1, "resize should preserve active tab")
    try assertions::assert(
      application.frame().width() == size.at(0).expect("frame width"),
      "frame should adopt width",
    )
    try assertions::assert(
      application.frame().height() == size.at(1).expect("frame height"),
      "frame should adopt height",
    )
    try testing::assert_contains(application.frame().text(), "Board body")
  }
  assertions::assert(snapshots.size() == 1, "resize must not persist or mutate shell selection")
}

test fn shell_restores_opens_reuses_retitles_and_closes_dynamic_tabs() Void!Str {
  let application = testing::new(100, 18)
  defer application.destroy()
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let fixed = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let restored_ref = tabs::doc_tab("doc-1", "Restored doc")
  let initial = shell_model::Model{tab_index: 0, tabs: [restored_ref]}
  let fixture = mount_shell(
    application,
    theme::new(),
    initial,
    fake_screen(application.context, "Inbox", fixed),
    fake_screen(application.context, "Board", fixed),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {},
    fn() {},
  )
  let mounted = fixture.mounted
  let component = fixture.component
  defer mounted.destroy()
  let _ = application.flush()
  try assertions::assert(created.value == 1, "restored tab should create one retained component")
  application.render()
  try assertions::assert(
    not application.frame().text().contains("Detail Restored"),
    "inactive restored tab should be hidden",
  )

  component.select_tab(2)
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Detail Restored doc")
  component.open(tabs::doc_tab("doc-1", "ignored"))
  try assertions::assert(created.value == 1, "opening existing identity should reuse its component")
  component.retitle(restored_ref, "Renamed doc")
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "Renamed doc")
  component.retitle(restored_ref, "界界界界界界界界界界界界界界界界")
  let _ = application.flush()
  application.render()
  try testing::assert_contains(application.frame().text(), "…")

  try assertions::assert(component.handle_key(key("escape")), "Escape should close dynamic tab")
  try assertions::assert(component.model.tab_index == 1, "closing detail should return to board")
  try assertions::assert(component.dynamic_screens.size() == 0, "closed component should detach")
  assertions::assert(disposed.value == 1, "closed component should dispose once")
}

test fn shell_routes_mouse_global_and_active_commands() Void!Str {
  let application = testing::new(80, 14)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let searches = mut Counter{value: 0}
  let creations = mut Counter{value: 0}
  let dynamic_handled = mut Counter{value: 0}
  let fixture = mount_shell(
    application,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox", inbox_state),
    fake_screen(application.context, "Board", board_state),
    tracked_dynamic_factory(application.context, created, disposed, dynamic_handled),
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {
      searches.value =+ 1
    },
    fn() {
      creations.value =+ 1
    },
  )
  let mounted = fixture.mounted
  let component = fixture.component
  defer mounted.destroy()
  let _ = application.flush()
  application.render()
  try assertions::assert(component.handle_key(key("x")), "active Inbox should handle delegated key")
  try assertions::assert(
    inbox_state.handled == 1 and board_state.handled == 0,
    "hidden board must not receive Inbox commands",
  )
  application.click(8, 0)
  try assertions::assert(component.model.tab_index == 1, "clicking My Issues tab should select it")
  try assertions::assert(component.handle_key(key("?")), "search should be globally handled")
  try assertions::assert(
    component.handle_key(
      event::key(
        "?",
        "?",
        cooper::KeyEventType::press,
        cooper::Modifiers{
          shift: true,
          ctrl: false,
          alt: false,
          super: false,
        },
      ),
    ),
    "terminal question-mark events should be globally handled with Shift",
  )
  try assertions::assert(component.handle_key(key("c")), "create should be globally handled")
  try assertions::assert(component.handle_key(key("x")), "active screen should handle remaining keys")
  try assertions::assert(searches.value == 2, "both normalized search key shapes should run the callback")
  try assertions::assert(creations.value == 1, "create callback should run")
  try assertions::assert(board_state.handled == 1, "active board should receive delegated key")
  try assertions::assert(inbox_state.handled == 1, "hidden Inbox must not receive board commands")
  component.open(tabs::issue_tab("AKO-1"))
  try assertions::assert(
    component.handle_key(key("x")),
    "active dynamic tab should receive delegated key",
  )
  try assertions::assert(
    dynamic_handled.value == 1 and board_state.handled == 1,
    "hidden board must not receive dynamic-tab commands",
  )
  component.select_tab(0)
  try assertions::assert(
    component.handle_key(key("x")),
    "Inbox should handle after returning from detail",
  )
  try assertions::assert(
    inbox_state.handled == 2 and dynamic_handled.value == 1,
    "hidden dynamic tabs must not receive Inbox commands",
  )
  component.select_tab(2)
  try assertions::assert(not component.handle_key(key("c")), "detail tabs should own the c command")
  try assertions::assert(creations.value == 1, "detail c should not start issue creation")
  let _ = application.flush()
  application.render()
  try assertions::assert(
    application.frame().cell(25, 0).expect("close button").grapheme == "×",
    "dynamic tab should render a close target",
  )
  application.click(25, 0)
  try assertions::assert(component.model.tabs.size() == 0, "clicking × should close the tab")
  try assertions::assert(
    component.model.tab_index == 1,
    "closing selected tab should return to My Issues",
  )
  try assertions::assert(disposed.value == 1, "close button should dispose the dynamic screen")
  try assertions::assert(component.handle_key(key("x")), "board should handle after detail closes")
  assertions::assert(
    board_state.handled == 2 and dynamic_handled.value == 1,
    "closed dynamic screens must not receive later commands",
  )
}

test fn shell_disposal_cleans_screens_and_persistence_once() Void!Str {
  let application = testing::new(60, 12)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let persistence_disposals = mut Counter{value: 0}
  let fixture = mount_shell(
    application,
    theme::new(),
    shell_model::Model{tab_index: 2, tabs: [tabs::issue_tab("AKO-1")]},
    fake_screen(application.context, "Inbox", inbox_state),
    fake_screen(application.context, "Board", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {
      persistence_disposals.value =+ 1
    },
    fn() {},
    fn() {},
  )
  let mounted = fixture.mounted
  let component = fixture.component
  defer mounted.destroy()
  let _ = application.flush()
  mounted.destroy()
  mounted.destroy()
  try assertions::assert(inbox_state.disposals == 1, "Inbox should dispose once")
  try assertions::assert(board_state.disposals == 1, "board should dispose once")
  try assertions::assert(disposed.value == 1, "dynamic screen should dispose once")
  assertions::assert(persistence_disposals.value == 1, "persistence worker should dispose once")
}

test fn shell_focuses_the_active_screen_after_its_first_commit() Void!Str {
  let application = testing::new(80, 20)
  defer application.destroy()
  let inbox_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let board_state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let disposed = mut Counter{value: 0}
  let fixture = mount_shell(
    application,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox body", inbox_state),
    fake_screen(application.context, "Board body", board_state),
    dynamic_factory(application.context, created, disposed),
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {},
    fn() {},
    flush: false,
  )
  let mounted = fixture.mounted
  let component = fixture.component
  defer mounted.destroy()

  // Screen focus is imperative and needs mounted refs, so the shell claims it
  // from a lifecycle hook rather than at construction.
  try assertions::assert(inbox_state.focuses == 0, "focus must wait for the first commit")
  let _ = application.flush()
  application.render()
  try assertions::assert(inbox_state.focuses == 1, "mounting should focus the active screen")
  assertions::assert(board_state.focuses == 0, "hidden screens should not take focus")
}

private struct Fixture {
  mounted: renderer::Renderer,
  component: mut tab_shell::Tabs,
}

private fn mount_shell(
  application: testing::TestApp,
  palette: theme::Theme,
  initial_model: shell_model::Model,
  inbox: tab_shell::Screen,
  board: tab_shell::Screen,
  make_dynamic: fn(tabs::TabRef) tab_shell::Screen,
  persist: fn(cache::LoggedInCache),
  on_dispose: fn(),
  on_search: fn(),
  on_create: fn(),
  flush: Bool?,
) Fixture {
  let instances = mut List::new<mut tab_shell::Tabs>()
  let mounted = renderer::mount(
    application.context,
    application.root,
    cui::child(
      fn(props: mut tab_shell::Props) mut tab_shell::Tabs {
        let component = tab_shell::create(props)
        instances.push(component)
        component
      },
      tab_shell::Props{
        context: application.context,
        palette: palette,
        initial_model: initial_model,
        inbox: inbox,
        board: board,
        make_dynamic: make_dynamic,
        persist: persist,
        on_dispose: on_dispose,
        on_search: on_search,
        on_create: on_create,
        commands: tab_shell::commands(),
      },
    ),
  )
  if flush.or(true) {
    let _ = application.flush()
  }
  Fixture{mounted: mounted, component: instances.at(0).expect("mounted shell")}
}

private struct GenerationProps {
  initial: Int,
}

private struct GenerationScreen {
  generation: Int,
}

private fn generation_screen(props: mut GenerationProps) mut GenerationScreen {
  (mut GenerationScreen{generation: props.initial})
}

impl cui::Component for GenerationScreen {
  fn mut render() cui::View {
    cui::text("generation {self.generation}")
  }
}

test fn reopening_a_tab_before_commit_creates_a_new_component_lifetime() Void!Str {
  let application = testing::new(70, 18)
  defer application.destroy()
  let state = mut ScreenState{
    focuses: 0,
    handled: 0,
    disposals: 0,
  }
  let created = mut Counter{value: 0}
  let fixture = mount_shell(
    application,
    theme::new(),
    shell_model::empty(),
    fake_screen(application.context, "Inbox", state),
    fake_screen(application.context, "Board", state),
    fn(reference: tabs::TabRef) tab_shell::Screen {
      created.value =+ 1
      tab_shell::screen(
        cui::child(generation_screen, GenerationProps{initial: created.value}, key: "same-child"),
        fn() {},
        fn(received: mut cooper::KeyEvent) Bool {
          false
        },
        fn() {},
      )
    },
    fn(snapshot: cache::LoggedInCache) {},
    fn() {},
    fn() {},
    fn() {},
  )
  defer fixture.mounted.destroy()
  let reference = tabs::doc_tab("same", "Document")
  fixture.component.open(reference)
  let _ = application.flush()
  let _ = fixture.component.close(reference)
  fixture.component.open(reference)
  let _ = application.flush()
  application.render()
  testing::assert_contains(application.frame().text(), "generation 2")
}
