use ard/decode

use tinear/tui/core/view
use tinear/tui/state
use tinear/tui/text
use tinear/vaxis

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out =+ ch
    }
  }
  out
}

fn centered_x(mut frame: view::Frame, width: Int) Int {
  let raw = (frame.width() - width) / 2
  match raw < 0 {
    true => 0,
    false => raw,
  }
}

fn centered_y(mut frame: view::Frame, height: Int) Int {
  let raw = (frame.height() - height) / 2
  match raw < 0 {
    true => 0,
    false => raw,
  }
}

fn fit_width(mut frame: view::Frame, value: Str, width: Int) Str {
  text::pad_str_display(frame.vx, text::truncate_with_ellipsis_display(frame.vx, value, width), width)
}

// Generic centered picker modal chrome. Domain-specific pickers build row
// strings, then compose this view for border/header/footer rendering.
struct PickerModal {
  title: Str,
  rows: [Str],
  footer: Str,
  width: Int,
}

impl view::View for PickerModal {
  fn init(ctx: view::Context) {}
  fn handle_event(ctx: view::Context, mut event: view::Event) {}

  fn render(mut frame: view::Frame) {
    let w = match self.width > frame.width() {
      true => frame.width(),
      false => self.width,
    }
    let h = self.rows.size() + 6
    let x = centered_x(frame, w)
    let y = centered_y(frame, h)
    let inner_w = w - 2

    frame.draw_text(x, y, "┌" + repeat("─", w - 2) + "┐")
    frame.draw_text(x, y + 1, "│" + fit_width(frame, self.title, inner_w) + "│")
    frame.draw_text(x, y + 2, "├" + repeat("─", w - 2) + "┤")

    for row, idx in self.rows {
      frame.draw_text(x, y + 3 + idx, "│" + fit_width(frame, row, inner_w) + "│")
    }

    let foot_y = y + h - 3
    frame.draw_text(x, foot_y, "├" + repeat("─", w - 2) + "┤")
    frame.draw_text(x, foot_y + 1, "│" + fit_width(frame, self.footer, inner_w) + "│")
    frame.draw_text(x, foot_y + 2, "└" + repeat("─", w - 2) + "┘")
  }
}

fn picker_modal(title: Str, rows: [Str], footer: Str, width: Int) view::View {
  PickerModal{title: title, rows: rows, footer: footer, width: width}
}

struct StatePicker {
  picker: state::StatePicker,
}

impl view::View for StatePicker {
  fn init(ctx: view::Context) {}
  fn handle_event(ctx: view::Context, mut event: view::Event) {}

  fn render(mut frame: view::Frame) {
    mut rows: [Str] = []

    for s, i in self.picker.states {
      let sid = decode::run(s, decode::field("id", decode::string)).expect("Missing state.id")
      let sname = decode::run(s, decode::field("name", decode::string)).expect("Missing state.name")
      let cursor_mark = match i == self.picker.cursor {
        true => "▸",
        false => " ",
      }
      let current_suffix = match sid == self.picker.current_state_id {
        true => "  (current)",
        false => "",
      }
      rows.push(" {cursor_mark} {sname}{current_suffix}")
    }

    picker_modal(
      " Status — {self.picker.issue_identifier} ({self.picker.team_name}) ",
      rows,
      " ↑↓ select  ↵ confirm  Esc cancel ",
      50,
    ).render(frame)
  }
}

fn state_picker(picker: state::StatePicker) view::View {
  StatePicker{picker: picker}
}

struct CyclePicker {
  picker: state::CyclePicker,
}

impl view::View for CyclePicker {
  fn init(ctx: view::Context) {}
  fn handle_event(ctx: view::Context, mut event: view::Event) {}

  fn render(mut frame: view::Frame) {
    let raw_w = match frame.width() > 80 {
      true => 70,
      false => match frame.width() > 60 {
        true => 60,
        false => frame.width() - 4,
      },
    }
    let w = match raw_w < 20 {
      true => frame.width(),
      false => raw_w,
    }
    let inner_w = w - 2
    let row_count = self.picker.cycles.size() + 1
    mut rows: [Str] = []

    for r in 0..(row_count - 1) {
      let cursor_mark = match r == self.picker.cursor {
        true => "▸",
        false => " ",
      }
      mut label = ""
      mut date_str = ""
      if r == 0 {
        let suffix = match self.picker.current_cycle_id.is_empty() {
          true => "  (current)",
          false => "",
        }
        label = "(no cycle){suffix}"
      } else {
        let c = self.picker.cycles.at(r - 1)
        let number = decode::run(c, decode::field("number", decode::int))
          .expect("Missing cycle.number")
        let cid = decode::run(c, decode::field("id", decode::string))
          .expect("Missing cycle.id")
        let name_opt = decode::run(c, decode::field("name", decode::nullable(decode::string)))
          .expect("Missing cycle.name")
        let starts_opt = decode::run(c, decode::field("startsAt", decode::nullable(decode::string)))
          .expect("Missing cycle.startsAt")
        let base = match name_opt {
          n => n,
          _ => "Cycle {number}",
        }
        let suffix = match cid == self.picker.current_cycle_id {
          true => "  (current)",
          false => "",
        }
        label = "{base}{suffix}"
        date_str = match starts_opt {
          s => text::format_date(s),
          _ => "",
        }
      }

      let prefix = " {cursor_mark} {label}"
      let date_width = frame.rendered_width(date_str)
      let prefix_w = inner_w - date_width - 1
      let prefix_text = fit_width(frame, prefix, prefix_w)
      rows.push("{prefix_text}{date_str} ")
    }

    picker_modal(
      " Cycle — {self.picker.issue_identifier} ({self.picker.team_name}) ",
      rows,
      " ↑↓ select  ↵ confirm  Esc cancel ",
      w,
    ).render(frame)
  }
}

fn cycle_picker(picker: state::CyclePicker) view::View {
  CyclePicker{picker: picker}
}
