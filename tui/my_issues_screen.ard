use ard/async
use ard/decode
use ard/duration
use ard/maybe
use ard/testing

use tinear/models/issues
use tinear/tui/api
use tinear/tui/core/rect
use tinear/tui/core/view
use tinear/tui/issue_card
use tinear/tui/picker_modal
use tinear/tui/state
use tinear/tui/text
use tinear/vaxis

// Stateful My Issues screen for the next TUI.
//
// Owns fetching + loading/error/board cursor state. Rendering is copied from
// the original board view, adapted to draw through core::Frame instead of
// directly through the root vaxis window.
struct MyIssuesScreen {
  store: issues::IssuesStore,
  col: Int,
  row: Int,
  scroll: Int,
  loading: Bool,
  error: Str?,
  state_picker: state::StatePicker?,
  cycle_picker: state::CyclePicker?,
  active: Bool,
}

fn new(api_key: Str) MyIssuesScreen {
  MyIssuesScreen{
    store: issues::new(api_key),
    col: 0,
    row: 0,
    scroll: 0,
    loading: false,
    error: maybe::none(),
    state_picker: maybe::none(),
    cycle_picker: maybe::none(),
    active: false,
  }
}

let refresh_event = "my_issues.refresh"

fn register_refresh_timer(ctx: view::Context) {
  let event = refresh_event
  async::start(fn() {
    while {
      async::sleep(duration::from_minutes(5))
      ctx.post(event)
    }
  })
}

fn board_column_gap() Int { 3 }

fn board_column_width(screen_w: Int, col_count: Int) Int {
  match col_count == 0 {
    true => 30,
    false => {
      let gap = board_column_gap()
      let available = screen_w
      let computed = (available - ((col_count - 1) * gap)) / col_count
      match computed < 22 {
        true => 22,
        false => match computed > 50 {
          true => 50,
          false => computed,
        },
      }
    },
  }
}

fn board_visible_count(screen_w: Int, col_count: Int) Int {
  match col_count == 0 {
    true => 0,
    false => {
      let col_w = board_column_width(screen_w, col_count)
      let gap = board_column_gap()
      let per_col = col_w + gap
      let computed = (screen_w + gap) / per_col
      match computed > col_count {
        true => col_count,
        false => match computed < 1 {
          true => 1,
          false => computed,
        },
      }
    },
  }
}

fn repeat(ch: Str, count: Int) Str {
  mut out = ""
  if count > 0 {
    for i in 0..(count - 1) {
      out =+ ch
    }
  }
  out
}

fn visible_scroll(scroll: Int, selected: Int, visible_count: Int, col_count: Int) Int {
  let safe_visible = match visible_count < 1 {
    true => 1,
    false => visible_count,
  }
  let max_scroll = match col_count > safe_visible {
    true => col_count - safe_visible,
    false => 0,
  }
  let clamped = match scroll > max_scroll {
    true => max_scroll,
    false => match scroll < 0 {
      true => 0,
      false => scroll,
    },
  }

  let with_selected = match selected < clamped {
    true => selected,
    false => match selected >= clamped + safe_visible {
      true => selected - safe_visible + 1,
      false => clamped,
    },
  }

  match with_selected > max_scroll {
    true => max_scroll,
    false => match with_selected < 0 {
      true => 0,
      false => with_selected,
    },
  }
}

test fn test_visible_scroll_keeps_initial_columns_still() Void!Str {
  testing::assert(visible_scroll(0, 0, 3, 6) == 0, "selected first column should not scroll")
  testing::assert(visible_scroll(0, 2, 3, 6) == 0, "selected last visible column should not scroll")
}

test fn test_visible_scroll_moves_right_when_selected_overflows() Void!Str {
  testing::assert(visible_scroll(0, 3, 3, 6) == 1, "selected one past right edge should scroll right")
  testing::assert(visible_scroll(0, 5, 3, 6) == 3, "selected final column should clamp at max scroll")
}

test fn test_visible_scroll_moves_left_when_selected_before_scroll() Void!Str {
  testing::assert(visible_scroll(3, 2, 3, 6) == 2, "selected before left edge should scroll left")
  testing::assert(visible_scroll(3, 0, 3, 6) == 0, "selected first column should scroll to start")
}

impl MyIssuesScreen {
  fn selected_issue() Dynamic? {
    match self.store.columns.size() == 0 {
      true => maybe::none(),
      false => {
        let col = self.store.columns.at(self.col)
        match col.issues.size() == 0 {
          true => maybe::none(),
          false => maybe::some(col.issues.at(self.row)),
        }
      },
    }
  }

  fn mut open_state_picker() {
    match self.selected_issue() {
      issue => {
        match api::open_state_picker(self.store.api_key, issue, true, 0) {
          ok(p) => { self.state_picker = maybe::some(p) },
          err(_) => (),
        }
      },
      _ => (),
    }
  }

  fn mut open_cycle_picker() {
    match self.selected_issue() {
      issue => {
        match api::open_cycle_picker(self.store.api_key, issue, true, 0) {
          ok(p) => { self.cycle_picker = maybe::some(p) },
          err(_) => (),
        }
      },
      _ => (),
    }
  }

  fn mut clamp_cursor() {
    match self.store.columns.size() == 0 {
      true => {
        self.col = 0
        self.row = 0
        self.scroll = 0
      },
      false => {
        if self.col < 0 {
          self.col = 0
        }
        if self.col >= self.store.columns.size() {
          self.col = self.store.columns.size() - 1
        }
        let col_size = self.store.columns.at(self.col).issues.size()
        if col_size == 0 {
          self.row = 0
        } else {
          if self.row < 0 {
            self.row = 0
          }
          if self.row >= col_size {
            self.row = col_size - 1
          }
        }
      },
    }
  }

  fn mut refresh(ctx: view::Context) {
    self.loading = true
    self.error = maybe::none()
    ctx.redraw()

    match self.store.load() {
      ok(_) => self.clamp_cursor(),
      err(e) => { self.error = maybe::some(e) },
    }

    self.loading = false
    ctx.redraw()
  }

  fn mut move_left() {
    if self.col > 0 {
      self.col = self.col - 1
      self.clamp_cursor()
      if self.col < self.scroll {
        self.scroll = self.col
      }
    }
  }

  fn mut move_right() {
    if self.col + 1 < self.store.columns.size() {
      self.col = self.col + 1
      self.clamp_cursor()
    }
  }

  fn mut confirm_state_picker(ctx: view::Context, p: state::StatePicker) {
    let target = p.states.at(p.cursor)
    let new_state_id = decode::run(target, decode::field("id", decode::string))
      .expect("Missing state.id")
    if new_state_id == p.current_state_id {
      self.state_picker = maybe::none()
    } else {
      match api::update_issue_state(self.store.api_key, p.issue_id, new_state_id) {
        ok(_) => {
          self.state_picker = maybe::none()
          self.refresh(ctx)
        },
        err(_) => (),
      }
    }
  }

  fn mut handle_state_picker_key(ctx: view::Context, key: vaxis::KeyEvent) {
    match self.state_picker {
      picker => {
        mut p = picker
        match key.name {
          "Escape" => { self.state_picker = maybe::none() },
          "Up" => {
            if p.cursor > 0 {
              p.cursor = p.cursor - 1
              self.state_picker = maybe::some(p)
            }
          },
          "k" => {
            if p.cursor > 0 {
              p.cursor = p.cursor - 1
              self.state_picker = maybe::some(p)
            }
          },
          "Down" => {
            if p.cursor < p.states.size() - 1 {
              p.cursor = p.cursor + 1
              self.state_picker = maybe::some(p)
            }
          },
          "j" => {
            if p.cursor < p.states.size() - 1 {
              p.cursor = p.cursor + 1
              self.state_picker = maybe::some(p)
            }
          },
          "Enter" => self.confirm_state_picker(ctx, p),
          "Space" => self.confirm_state_picker(ctx, p),
          _ => (),
        }
      },
      _ => (),
    }
  }

  fn mut confirm_cycle_picker(ctx: view::Context, p: state::CyclePicker) {
    let target_cycle_id = match p.cursor == 0 {
      true => "",
      false => {
        let c = p.cycles.at(p.cursor - 1)
        decode::run(c, decode::field("id", decode::string)).expect("Missing cycle.id")
      },
    }
    if target_cycle_id == p.current_cycle_id {
      self.cycle_picker = maybe::none()
    } else {
      match api::update_issue_cycle(self.store.api_key, p.issue_id, target_cycle_id) {
        ok(_) => {
          self.cycle_picker = maybe::none()
          self.refresh(ctx)
        },
        err(_) => (),
      }
    }
  }

  fn mut handle_cycle_picker_key(ctx: view::Context, key: vaxis::KeyEvent) {
    match self.cycle_picker {
      picker => {
        mut p = picker
        let row_count = p.cycles.size() + 1
        match key.name {
          "Escape" => { self.cycle_picker = maybe::none() },
          "Up" => {
            if p.cursor > 0 {
              p.cursor = p.cursor - 1
              self.cycle_picker = maybe::some(p)
            }
          },
          "k" => {
            if p.cursor > 0 {
              p.cursor = p.cursor - 1
              self.cycle_picker = maybe::some(p)
            }
          },
          "Down" => {
            if p.cursor < row_count - 1 {
              p.cursor = p.cursor + 1
              self.cycle_picker = maybe::some(p)
            }
          },
          "j" => {
            if p.cursor < row_count - 1 {
              p.cursor = p.cursor + 1
              self.cycle_picker = maybe::some(p)
            }
          },
          "Enter" => self.confirm_cycle_picker(ctx, p),
          "Space" => self.confirm_cycle_picker(ctx, p),
          _ => (),
        }
      },
      _ => (),
    }
  }

  fn mut handle_key(ctx: view::Context, key: vaxis::KeyEvent) {
    if self.state_picker.is_some() {
      self.handle_state_picker_key(ctx, key)
    } else if self.cycle_picker.is_some() {
      self.handle_cycle_picker_key(ctx, key)
    } else {
      match key.name {
      "Up" => {
        if self.row > 0 {
          self.row = self.row - 1
        }
      },
      "k" => {
        if self.row > 0 {
          self.row = self.row - 1
        }
      },
      "Down" => {
        if self.store.columns.size() > 0 {
          let col_size = self.store.columns.at(self.col).issues.size()
          if self.row < col_size - 1 {
            self.row = self.row + 1
          }
        }
      },
      "j" => {
        if self.store.columns.size() > 0 {
          let col_size = self.store.columns.at(self.col).issues.size()
          if self.row < col_size - 1 {
            self.row = self.row + 1
          }
        }
      },
      "Left" => self.move_left(),
      "h" => self.move_left(),
      "Right" => self.move_right(),
      "l" => self.move_right(),
        "r" => self.refresh(ctx),
        "s" => self.open_state_picker(),
        "y" => self.open_cycle_picker(),
        _ => (),
      }
    }
  }
}

impl view::View for MyIssuesScreen {
  fn mut init(ctx: view::Context) {
    register_refresh_timer(ctx)
    self.refresh(ctx)
  }

  fn mut handle_event(ctx: view::Context, mut event: view::Event) {
    match event.raw {
      KeyEvent(key) => {
        if self.active {
          self.handle_key(ctx, key)
        }
      }
      CustomEvent(e) => {
        if e.name == refresh_event {
          self.refresh(ctx)
        }
      },
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    match self.loading {
      true => frame.draw_text(0, 0, "Loading my issues…"),
      false => {
        match self.error {
          _err => frame.draw_styled(0, 0, "Unable to load my issues", 1, -1, false, false, false, false, false),
          _ => {
            match self.store.columns.size() == 0 {
              true => frame.draw_text(0, 0, "No issues assigned to you."),
              false => {
                let col_count = self.store.columns.size()
                let col_w = board_column_width(frame.width(), col_count)
                let gap = board_column_gap()
                let visible_count = board_visible_count(frame.width(), col_count)

                let scroll = visible_scroll(self.scroll, self.col, visible_count, col_count)
                let end_excl = match scroll + visible_count > col_count {
                  true => col_count,
                  false => scroll + visible_count,
                }

                mut x = 0
                for col, col_idx in self.store.columns {
                  if col_idx >= scroll and col_idx < end_excl {
                    let suffix = match col.state_type == "completed" {
                      true => " · last 10",
                      false => "",
                    }
                    let header = "{col.name} ({col.issues.size()}){suffix}"
                    frame.draw_text(x, 0, text::truncate_with_ellipsis(header, col_w))
                    frame.draw_text(x, 1, repeat("─", col_w - 1))

                    mut card_y = 3
                    let last_idx = col.issues.size() - 1
                    for issue, card_idx in col.issues {
                      if card_y + 1 < frame.height() {
                        let is_last = card_idx == last_idx
                        let is_selected = col_idx == self.col and card_idx == self.row
                        let area = rect::Rect{x: x, y: card_y, w: col_w, h: frame.height() - card_y}
                        mut card_frame = view::sub(frame, area)
                        issue_card::new(issue, is_selected, is_last).render(card_frame)
                        let drawn = card_frame.dimensions()
                        card_y = card_y + drawn.y + drawn.h
                      }
                    }

                    x = x + col_w + gap
                  }
                }

                if scroll > 0 {
                  frame.draw_text(0, 0, "‹")
                }
                if end_excl < col_count {
                  frame.draw_text(frame.width() - 1, 0, "›")
                }
              },
            }
          },
        }
      },
    }

    match self.state_picker {
      p => picker_modal::state_picker(p).render(frame),
      _ => (),
    }
    match self.cycle_picker {
      p => picker_modal::cycle_picker(p).render(frame),
      _ => (),
    }
  }
}
