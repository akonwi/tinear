use ard/decode
use ard/testing

use tinear/models/issues
use tinear/tui/core/rect
use tinear/tui/core/view
use tinear/tui/issue_card
use tinear/vaxis

private extern fn test_vaxis() vaxis::Vaxis = "TestVaxisNil"
private extern fn test_window(width: Int, height: Int) vaxis::Window = "TestWindow"
private extern fn test_line(y: Int) Str = "TestLine"
private extern fn test_cell_reverse(x: Int, y: Int) Bool = "TestCellReverse"

fn test_frame(width: Int, height: Int) view::Frame {
  let vx = test_vaxis()
  let ctx = view::context(vx)
  view::Frame{vx: vx, window: test_window(width, height), tree: ctx.tree, node_id: ctx.node_id, extent: rect::Rect{x: 0, y: 0, w: 0, h: 0}}
}

fn test_issue(title: Str) issues::Issue {
  let raw = decode::from_json(
    "\{\"id\":\"issue-1\",\"identifier\":\"AKO-123\",\"title\":\"{title}\",\"description\":null,\"priority\":2,\"state\":\{\"id\":\"state-1\",\"name\":\"Started\",\"type\":\"started\",\"position\":1.0\},\"team\":\{\"id\":\"team-1\",\"name\":\"Core\",\"key\":\"AKO\"\},\"project\":null,\"assignee\":null,\"cycle\":null\}",
  ).expect("parse test issue")
  issues::decode_issue(raw)
}

test fn test_issue_card_renders_identifier_priority_and_title() Void!Str {
  mut frame = test_frame(20, 6)

  issue_card::new(test_issue("Fix login bug"), false, true).render(frame)

  try testing::assert(test_line(0).starts_with(" ↑ AKO-123"), "expected issue header, got '{test_line(0)}'")
  testing::assert(test_line(1).starts_with("   Fix login bug"), "expected indented title, got '{test_line(1)}'")
}

test fn test_issue_card_selected_reverses_full_card_area() Void!Str {
  mut frame = test_frame(20, 6)

  issue_card::new(test_issue("Fix login bug"), true, true).render(frame)

  try testing::assert(test_line(0).starts_with("▸↑ AKO-123"), "expected selected cursor in header")
  try testing::assert(test_cell_reverse(0, 0), "selected header should be reversed")
  testing::assert(test_cell_reverse(19, 0), "selected card should reverse full row width")
}

test fn test_issue_card_non_last_renders_divider() Void!Str {
  mut frame = test_frame(12, 6)

  issue_card::new(test_issue("Bug"), false, false).render(frame)

  testing::assert(test_line(2).starts_with("━━━━━━━━━━━"), "non-last card should render divider, got '{test_line(2)}'")
}
