use tinear/models/issues
use tinear/tui/picker
use tinear/tui/state

fn sort_states(states: [issues::WorkflowState]) [issues::WorkflowState] {
  let n = states.size()
  if n < 2 {
    states
  } else {
    mut result = states
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        let ra = state::state_type_rank(a.state_type)
        let rb = state::state_type_rank(b.state_type)
        let swap = match ra == rb {
          true => a.position > b.position,
          false => ra > rb,
        }
        if swap {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

fn sort_cycles(cycles: [issues::Cycle]) [issues::Cycle] {
  let n = cycles.size()
  if n < 2 {
    cycles
  } else {
    mut result = cycles
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        if a.number < b.number {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

fn cycle_label(cycle: issues::Cycle) Str {
  match cycle.name.is_empty() {
    true => "Cycle {cycle.number}",
    false => cycle.name,
  }
}

fn state_props(api_key: Str, issue: issues::Issue) picker::Props!Str {
  let states = sort_states(try issues::load_team_states(api_key, issue.team_id))
  mut options: [picker::Option] = []
  for s in states {
    let current = s.id == issue.state_id
    options.push(picker::Option{id: s.id, label: s.name, current: current})
  }
  Result::ok(picker::Props{
    title: "Status — {issue.identifier} ({issue.team_name})",
    options: options,
    inititial_id: issue.state_id,
    width: 50,
  })
}

fn cycle_props(api_key: Str, issue: issues::Issue) picker::Props!Str {
  let result = try issues::load_team_cycles(api_key, issue.team_id)

  mut filtered: [issues::Cycle] = []
  match result.active_cycle_number {
    active_n => {
      for c in result.cycles {
        if c.number <= active_n + 1 or c.id == issue.cycle_id {
          filtered.push(c)
        }
      }
    },
    _ => { filtered = result.cycles },
  }

  let cycles = sort_cycles(filtered)
  mut options = [picker::Option{id: "", label: "(no cycle)", current: issue.cycle_id.is_empty()}]
  for c in cycles {
    let current = c.id == issue.cycle_id
    options.push(picker::Option{id: c.id, label: cycle_label(c), current: current})
  }

  Result::ok(picker::Props{
    title: "Cycle — {issue.identifier} ({issue.team_name})",
    options: options,
    inititial_id: issue.cycle_id,
    width: 60,
  })
}
