use cooper
use cooper/animation
use cooper/ui
use tinear/tui/scheduler
use tinear/tui/theme as tinear_theme

enum Variant {
  info,
  success,
  error,
}

struct Entry {
  id: Int,
  root: mut ui::Box,
  timeline: mut animation::Timeline,
  cancel_expiry: fn(),
}

struct ToastHost {
  root: mut ui::Box,
  entries: [Entry],
  next_id: Int,
  disposed: Bool,
  hidden_style: ui::Style,
  visible_style: ui::Style,
  palette: tinear_theme::Theme,
  schedule: scheduler::Schedule,
  context: mut cooper::Runtime,
}

private fn root_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    position: ui::Position::absolute,
    right: ui::cells(1),
    bottom: ui::cells(2),
    width: ui::cells(52),
    max_height: ui::percent(80.0),
    flex_direction: ui::FlexDirection::column,
    align_items: ui::Align::end,
    justify_content: ui::Justify::end,
    gap: ui::cells(1),
    overflow: ui::Overflow::hidden,
    z_index: 900,
  )
}

fn new(ctx: mut cooper::Runtime, palette: tinear_theme::Theme, schedule: scheduler::Schedule) mut ToastHost {
  let hidden_style = root_style(ui::Display::none)
  let visible_style = root_style(ui::Display::flex)
  let root = ui::box(ctx, styles: hidden_style)
  (mut ToastHost{
    root: root,
    entries: [],
    next_id: 0,
    disposed: false,
    hidden_style: hidden_style,
    visible_style: visible_style,
    palette: palette,
    schedule: schedule,
    context: ctx,
  })
}

private fn toast_width(ctx: mut cooper::Runtime, title: Str, description: Str) Int {
  mut content_width = ctx.measure_text(title)
  if not description.is_empty() {
    let description_width = ctx.measure_text(description)
    if description_width > content_width {
      content_width = description_width
    }
  }
  let measured = content_width + 6
  match measured > 52 {
    true => 52,
    false => measured,
  }
}

private fn entrance_duration(ttl_ms: Int) Int {
  let requested = ttl_ms / 20
  if requested < 1 {
    1
  } else if requested > 250 {
    250
  } else {
    requested
  }
}

impl ToastHost {
  private fn mut remove(id: Int) Bool {
    if self.disposed {
      false
    } else {
      let remaining = mut List::new<Entry>()
      mut removed = false
      for entry in self.entries {
        if entry.id == id {
          entry.cancel_expiry()
          entry.timeline.destroy()
          let _ = self.root.remove(entry.root)
          entry.root.destroy(recursive: true)
          removed = true
        } else {
          remaining.push(entry)
        }
      }
      self.entries = remaining.@
      if self.entries.size() == 0 {
        self.root.set_style(self.hidden_style)
      }
      removed
    }
  }

  fn mut show(title: Str, description: Str?, variant: Variant, ttl_ms: Int) Int {
    if self.disposed {
      panic("cannot show a toast on a disposed host")
    }
    if ttl_ms < 0 {
      panic("toast TTL must be non-negative")
    }

    let detail = description.or("")
    self.next_id =+ 1
    let id = self.next_id
    let marker = match variant {
      Variant::info => "•",
      Variant::success => "✓",
      Variant::error => "!",
    }
    let marker_color = match variant {
      Variant::info => self.palette.accent,
      Variant::success => self.palette.success,
      Variant::error => self.palette.danger,
    }
    let target_width = toast_width(self.context, title, detail)
    let content_height = match detail.is_empty() {
      true => 1,
      false => 2,
    }
    let toast = ui::box(
      self.context,
      styles: ui::style(
        background: self.palette.background,
        border: ui::Border::rounded,
        border_color: marker_color,
        position: ui::Position::relative,
        left: ui::cells(target_width),
        width: ui::cells(target_width),
        height: ui::cells(content_height + 2),
        flex_direction: ui::FlexDirection::row,
        align_items: ui::Align::start,
        flex_shrink: 0.0,
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
        overflow: ui::Overflow::hidden,
      ),
    )
    toast.add(
      ui::text(
        self.context,
        content: marker,
        selectable: false,
        styles: ui::style(width: ui::cells(2), height: ui::cells(1), flex_shrink: 0.0),
        text_style: ui::text_style(foreground: marker_color, bold: true),
      ),
    )
    let content = ui::box(
      self.context,
      styles: ui::style(
        width: ui::fit_content(),
        max_width: ui::cells(46),
        height: ui::cells(content_height),
        flex_direction: ui::FlexDirection::column,
      ),
    )
    content.add(
      ui::text(
        self.context,
        content: title,
        wrap: ui::TextWrap::none,
        overflow: ui::TextOverflow::ellipsis,
        styles: ui::style(
          width: ui::fit_content(),
          max_width: ui::cells(46),
          height: ui::cells(1),
        ),
        text_style: ui::text_style(bold: true),
      ),
    )
    if not detail.is_empty() {
      content.add(
        ui::text(
          self.context,
          content: detail,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(
            width: ui::fit_content(),
            max_width: ui::cells(46),
            height: ui::cells(1),
          ),
          text_style: ui::text_style(dim: true),
        ),
      )
    }
    toast.add(content)

    let timeline = self.context.timeline(entrance_duration(ttl_ms))
    timeline.add(
      timeline.duration(),
      fn(frame: animation::Frame) {
        let applied = mut toast.style()
        applied.left = ui::cells(animation::lerp_int(target_width, 0, frame.progress))
        toast.set_style(applied.@)
      },
      ease: animation::out_quad,
    )
    let cancel_expiry = self.schedule(ttl_ms, fn() {
      let _ = self.remove(id)
    })
    self.entries.push(
      Entry{
        id: id,
        root: toast,
        timeline: timeline,
        cancel_expiry: cancel_expiry,
      },
    )
    self.root.add(toast)
    self.root.set_style(self.visible_style)
    let _ = timeline.play()
    id
  }

  fn mut dismiss(id: Int) Bool {
    self.remove(id)
  }

  fn mut dispose() {
    if not self.disposed {
      let entries = self.entries
      self.entries = []
      self.disposed = true
      for entry in entries {
        entry.cancel_expiry()
        entry.timeline.destroy()
        let _ = self.root.remove(entry.root)
        entry.root.destroy(recursive: true)
      }
      self.root.set_style(self.hidden_style)
    }
  }
}
