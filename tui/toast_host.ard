use cooper
use cooper/animation
use cooper/cui
use cooper/cui/renderer
use cooper/ui
use tinear/tui/scheduler
use tinear/tui/theme as tinear_theme

enum Variant {
  info,
  success,
  error,
}

// Immutable per-toast presentation data computed at show time so component
// rendering stays deterministic and effect-free.
struct Entry {
  id: Int,
  title: Str,
  detail: Str,
  marker: Str,
  color: ui::Color,
  background: ui::Color,
  width: Int,
  ttl_ms: Int,
}

struct Model {
  entries: [Entry],
}

struct Timer {
  id: Int,
  cancel: fn(),
}

struct ToastHost {
  model: mut Model,
  cui: renderer::Renderer,
  timers: [Timer],
  next_id: Int,
  disposed: Bool,
  palette: tinear_theme::Theme,
  schedule: scheduler::Schedule,
  context: mut cooper::Runtime,
}

private fn root_style(display: ui::Display) ui::Style {
  ui::style(
    display: display,
    position: ui::Position::absolute,
    right: ui::cells(1),
    bottom: ui::cells(2),
    width: ui::cells(52),
    max_height: ui::percent(80.0),
    flex_direction: ui::FlexDirection::column,
    align_items: ui::Align::end,
    justify_content: ui::Justify::end,
    gap: ui::cells(1),
    overflow: ui::Overflow::hidden,
    z_index: 900,
  )
}

private fn toast_width(ctx: mut cooper::Runtime, title: Str, description: Str) Int {
  mut content_width = ctx.measure_text(title)
  if not description.is_empty() {
    let description_width = ctx.measure_text(description)
    if description_width > content_width {
      content_width = description_width
    }
  }
  let measured = content_width + 6
  match measured > 52 {
    true => 52,
    false => measured,
  }
}

private fn entrance_duration(ttl_ms: Int) Int {
  let requested = ttl_ms / 20
  if requested < 1 {
    1
  } else if requested > 250 {
    250
  } else {
    requested
  }
}

// One notification. The slide-in offset is component state driven by a
// mount-scoped animation; unmount cancels it automatically.
private struct ToastProps {
  entry: Entry,
}

private struct Toast {
  props: mut ToastProps,
  offset: Int,
}

private fn toast(props: mut ToastProps) mut Toast {
  (mut Toast{props: props, offset: props.entry.width})
}

impl cui::Lifecycle for Toast {
  fn mut mounted(ctx: cui::Context) {
    let width = self.props.entry.width
    let _ = ctx.animate(
      entrance_duration(self.props.entry.ttl_ms),
      fn(frame: animation::Frame) {
        self.offset = animation::lerp_int(width, 0, frame.progress)
      },
      ease: animation::out_quad,
    )
  }

  fn mut unmounting(ctx: cui::Context) {}
}

impl cui::Component for Toast {
  fn mut render() cui::View {
    let entry = self.props.entry

    let content_height = match entry.detail.is_empty() {
      true => 1,
      false => 2,
    }
    let children = mut List::new<cui::View>()
    children.push(
      cui::text(
        entry.title,
        wrap: ui::TextWrap::none,
        overflow: ui::TextOverflow::ellipsis,
        styles: ui::style(
          width: ui::fit_content(),
          max_width: ui::cells(46),
          height: ui::cells(1),
        ),
        text_style: ui::text_style(bold: true),
      ),
    )
    if not entry.detail.is_empty() {
      children.push(
        cui::text(
          entry.detail,
          wrap: ui::TextWrap::none,
          overflow: ui::TextOverflow::ellipsis,
          styles: ui::style(
            width: ui::fit_content(),
            max_width: ui::cells(46),
            height: ui::cells(1),
          ),
          text_style: ui::text_style(dim: true),
        ),
      )
    }
    cui::box(
      [
        cui::text(
          entry.marker,
          selectable: false,
          styles: ui::style(width: ui::cells(2), height: ui::cells(1), flex_shrink: 0.0),
          text_style: ui::text_style(foreground: entry.color, bold: true),
        ),
        cui::box(
          children.@,
          styles: ui::style(
            width: ui::fit_content(),
            max_width: ui::cells(46),
            height: ui::cells(content_height),
            flex_direction: ui::FlexDirection::column,
          ),
        ),
      ],
      styles: ui::style(
        background: entry.background,
        border: ui::Border::rounded,
        border_color: entry.color,
        position: ui::Position::relative,
        left: ui::cells(self.offset),
        width: ui::cells(entry.width),
        height: ui::cells(content_height + 2),
        flex_direction: ui::FlexDirection::row,
        align_items: ui::Align::start,
        flex_shrink: 0.0,
        padding: ui::Edges{
          top: ui::cells(0),
          right: ui::cells(1),
          bottom: ui::cells(0),
          left: ui::cells(1),
        },
        overflow: ui::Overflow::hidden,
      ),
    )
  }
}

// The overlay stack. Data lives in the shared Model owned by the facade;
// this component only describes it.
private struct HostProps {
  model: mut Model,
}

private struct Host {
  props: mut HostProps,
}

private fn host(props: mut HostProps) mut Host {
  (mut Host{props: props})
}

impl cui::Component for Host {
  fn mut render() cui::View {
    let entries = self.props.model.entries
    let children = mut List::new<cui::View>()
    for entry in entries {
      children.push(cui::child(toast, ToastProps{entry: entry}, key: "toast-{entry.id}"))
    }
    let display = match entries.size() == 0 {
      true => ui::Display::none,
      false => ui::Display::flex,
    }
    cui::box(children.@, styles: root_style(display))
  }
}

fn new(
  ctx: mut cooper::Runtime,
  root: mut cooper::Root,
  palette: tinear_theme::Theme,
  schedule: scheduler::Schedule,
) mut ToastHost {
  let model = mut Model{entries: []}
  let mounted = renderer::mount(ctx, root, cui::child(host, HostProps{model: model}))
  (mut ToastHost{
    model: model,
    cui: mounted,
    timers: [],
    next_id: 0,
    disposed: false,
    palette: palette,
    schedule: schedule,
    context: ctx,
  })
}

impl ToastHost {
  private fn mut remove(id: Int) Bool {
    if self.disposed {
      false
    } else {
      let remaining = mut List::new<Entry>()
      mut removed = false
      for entry in self.model.entries {
        if entry.id == id {
          removed = true
        } else {
          remaining.push(entry)
        }
      }
      if removed {
        let timers = mut List::new<Timer>()
        for timer in self.timers {
          if timer.id == id {
            (timer.cancel)()
          } else {
            timers.push(timer)
          }
        }
        self.timers = timers.@
        self.cui.update(fn() {
          self.model.entries = remaining.@
        })
      }
      removed
    }
  }

  fn mut show(title: Str, description: Str?, variant: Variant, ttl_ms: Int) Int {
    if self.disposed {
      panic("cannot show a toast on a disposed host")
    }
    if ttl_ms < 0 {
      panic("toast TTL must be non-negative")
    }

    let detail = description.or("")
    self.next_id =+ 1
    let id = self.next_id
    let marker = match variant {
      Variant::info => "•",
      Variant::success => "✓",
      Variant::error => "!",
    }
    let marker_color = match variant {
      Variant::info => self.palette.accent,
      Variant::success => self.palette.success,
      Variant::error => self.palette.danger,
    }
    let entry = Entry{
      id: id,
      title: title,
      detail: detail,
      marker: marker,
      color: marker_color,
      background: self.palette.background,
      width: toast_width(self.context, title, detail),
      ttl_ms: ttl_ms,
    }
    let cancel_expiry = self.schedule(ttl_ms, fn() {
      let _ = self.remove(id)
    })
    self.timers.push(Timer{id: id, cancel: cancel_expiry})
    self.cui.update(fn() {
      self.model.entries.push(entry)
    })
    id
  }

  fn mut dismiss(id: Int) Bool {
    self.remove(id)
  }

  fn mut dispose() {
    if not self.disposed {
      self.disposed = true
      let timers = self.timers
      self.timers = []
      for timer in timers {
        (timer.cancel)()
      }
      self.model.entries = []
      self.cui.destroy()
    }
  }
}
