use ard/decode
use ard/maybe

use tinear/models/inbox
use tinear/tui/api
use tinear/tui/core/view
use tinear/tui/decode as decode_utils
use tinear/tui/text
use tinear/vaxis

// Stateful Inbox screen for the next TUI.
//
// Owns fetching + loading/error/list/cursor state. The app owns one concrete
// InboxScreen field, forwards inbox-specific events to it, and renders it as
// the body for the Inbox tab.
struct InboxScreen {
  vx: vaxis::Vaxis,
  api_key: Str,
  store: inbox::Store,
  items: [Dynamic],
  cursor: Int,
  loading: Bool,
  error: Str?,
}

fn new(vx: vaxis::Vaxis, api_key: Str) InboxScreen {
  let items: [Dynamic] = []
  InboxScreen{
    vx: vx,
    api_key: api_key,
    store: inbox::new(api_key),
    items: items,
    cursor: 0,
    loading: false,
    error: maybe::none(),
  }
}

fn format_type(n_type: Str) Str {
  match n_type {
    "issueAssignedToYou" => "assigned",
    "issueNewComment" => "commented",
    "issueCommentMention" => "mentioned",
    "issueMention" => "mentioned",
    "issueCommentReaction" => "reacted",
    "issueEmojiReaction" => "reacted",
    "issueStatusChanged" => "changed status",
    "issueThreadResolved" => "resolved",
    "issueUnassignedFromYou" => "unassigned",
    "pullRequestApproved" => "approved",
    "pullRequestChangesRequested" => "requested changes",
    "pullRequestChecksFailed" => "checks failed",
    "pullRequestComment" => "commented",
    "pullRequestCommented" => "commented",
    "pullRequestCommentMention" => "mentioned",
    "pullRequestMention" => "mentioned",
    "pullRequestReviewRequested" => "requested review",
    "pullRequestReviewRerequested" => "re-requested review",
    "pullRequestRemovedFromMergeQueue" => "removed from queue",
    _ => n_type,
  }
}

fn is_pr_type(n_type: Str) Bool {
  n_type.starts_with("pullRequest")
}

struct IdTitle {
  id: Str,
  title: Str,
}

fn notif_id_and_title(notif: Dynamic, n_type: Str) IdTitle {
  match is_pr_type(n_type) {
    true => {
      let pr_obj = decode_utils::optional_field(notif, "pullRequest")
      let id = match pr_obj {
        pr => {
          let num = decode::run(pr, decode::field("number", decode::int)).expect("Missing PR number")
          "PR #{num.to_str()}"
        },
        _ => "—",
      }
      let title = match pr_obj {
        pr => decode::run(pr, decode::field("title", decode::string)).expect("Missing PR title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
    false => {
      let issue_obj = decode_utils::optional_field(notif, "issue")
      let id = match issue_obj {
        iss => decode::run(iss, decode::field("identifier", decode::string)).expect("Missing issue identifier"),
        _ => "—",
      }
      let title = match issue_obj {
        iss => decode::run(iss, decode::field("title", decode::string)).expect("Missing issue title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
  }
}

fn row_text(notif: Dynamic, idx: Int, cursor: Int) Str {
  let n_type = decode::run(notif, decode::field("type", decode::string)).expect("Missing type")
  let type_label = format_type(n_type)

  let actor_obj = decode_utils::optional_field(notif, "actor")
  let actor_name = match actor_obj {
    act => decode_utils::user_display_name(act),
    _ => "—",
  }

  let info = notif_id_and_title(notif, n_type)
  let cursor_mark = match idx == cursor {
    true => "▸",
    false => " ",
  }

  let id_part = text::pad_str(info.id, 10)
  "{cursor_mark} {id_part} {actor_name} {type_label}  {info.title}"
}

fn visible_start(cursor: Int, height: Int) Int {
  match height <= 0 {
    true => 0,
    false => {
      match cursor < height {
        true => 0,
        false => cursor - height + 1,
      }
    },
  }
}

impl InboxScreen {
  fn mut refresh() {
    self.loading = true
    self.error = maybe::none()
    vaxis::post(self.vx, vaxis::RedrawEvent{})

    match self.store.load() {
      ok => (),
      err => {
        self.error = maybe::some(err)
      }
    }

    self.loading = false
    vaxis::post(self.vx, vaxis::RedrawEvent{})
  }


  fn mut handle_key(key: vaxis::KeyEvent) {
    match key.name {
      "Up" => {
        if self.cursor > 0 {
          self.cursor = self.cursor - 1
        }
      },
      "Down" => {
        if self.cursor + 1 < self.items.size() {
          self.cursor = self.cursor + 1
        }
      },
      "r" => self.refresh(),
      _ => (),
    }
  }

  fn mut handle_event(event: vaxis::Event) {
    match event {
      KeyEvent(key) => self.handle_key(key),
      _ => (),
    }
  }
}

impl view::View for InboxScreen {
  fn mut init() {
    self.refresh()
  }

  fn mut handle_event(event: vaxis::Event) {
    match event {
      KeyEvent(key) => self.handle_key(key),
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    match self.loading {
      true => frame.draw_text(0, 0, "Loading inbox…"),
      false => {
        match self.error {
          _err => frame.draw_styled(0, 0, "Unable to load inbox", 1, -1, false, false, false, false, false),
          _ => {
            match self.items.size() == 0 {
              true => frame.draw_text(0, 0, "Inbox empty"),
              false => {
                let height = frame.height()
                let start = visible_start(self.cursor, height)
                mut row = 0
                for notif, idx in self.items {
                  if idx >= start and row < height {
                    let line = text::truncate_with_ellipsis(row_text(notif, idx, self.cursor), frame.width())
                    let selected = idx == self.cursor
                    frame.draw_styled(0, row, line, -1, -1, false, false, false, false, selected)
                    row = row + 1
                  }
                }
              },
            }
          },
        }
      },
    }
  }
}
