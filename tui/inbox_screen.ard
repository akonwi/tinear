use ard/async
use ard/duration
use ard/maybe

use tinear/models/inbox
use tinear/tui/core/view
use tinear/tui/text
use tinear/vaxis

// Stateful Inbox screen for the next TUI.
//
// Owns fetching + loading/error/list/cursor state. The app owns one concrete
// InboxScreen field, forwards inbox-specific events to it, and renders it as
// the body for the Inbox tab.
struct InboxScreen {
  api_key: Str,
  store: inbox::InboxStore,
  cursor: Int,
  loading: Bool,
  error: Str?,
}

fn new(api_key: Str) InboxScreen {
  InboxScreen{
    api_key: api_key,
    store: inbox::new(api_key),
    cursor: 0,
    loading: false,
    error: maybe::none(),
  }
}

let refresh_event = "inbox.refresh"

fn register_refresh_timer(ctx: view::Context) {
  let event = refresh_event
  async::start(fn() {
    while {
      async::sleep(duration::from_minutes(5))
      ctx.post(event)
    }
  })
}

fn visible_start(cursor: Int, height: Int) Int {
  match height <= 0 {
    true => 0,
    false => {
      match cursor < height {
        true => 0,
        false => cursor - height + 1,
      }
    },
  }
}

impl InboxScreen {
  fn mut refresh(ctx: view::Context) {
    self.loading = true
    self.error = maybe::none()
    ctx.redraw()

    match self.store.load() {
      ok => (),
      err => {
        self.error = maybe::some(err)
      }
    }

    self.loading = false
    ctx.redraw()
  }


  fn mut handle_key(ctx: view::Context, key: vaxis::KeyEvent) {
    match key.name {
      "Up" => {
        if self.cursor > 0 {
          self.cursor = self.cursor - 1
        }
      },
      "Down" => {
        if self.cursor + 1 < self.store.items.size() {
          self.cursor = self.cursor + 1
        }
      },
      "r" => self.refresh(ctx),
      _ => (),
    }
  }

  fn mut handle_event(ctx: view::Context, event: vaxis::Event) {
    match event {
      KeyEvent(key) => self.handle_key(ctx, key),
      _ => (),
    }
  }
}

impl view::View for InboxScreen {
  fn mut init(ctx: view::Context) {
    register_refresh_timer(ctx)
    self.refresh(ctx)
  }

  fn mut handle_event(ctx: view::Context, event: vaxis::Event) {
    match event {
      KeyEvent(key) => self.handle_key(ctx, key),
      CustomEvent(e) => {
        if e.name == refresh_event {
          self.refresh(ctx)
        }
      },
      _ => (),
    }
  }

  fn render(mut frame: view::Frame) {
    match self.loading {
      true => frame.draw_text(0, 0, "Loading inbox…"),
      false => {
        match self.error {
          _err => frame.draw_styled(0, 0, "Unable to load inbox", 1, -1, false, false, false, false, false),
          _ => {
            match self.store.items.size() == 0 {
              true => {
                let msg = "Inbox empty"
                let raw_x = (frame.width() - frame.rendered_width(msg)) / 2
                let x = match raw_x < 0 {
                  true => 0,
                  false => raw_x,
                }
                let raw_y = frame.height() / 2
                let y = match raw_y < 0 {
                  true => 0,
                  false => raw_y,
                }
                frame.draw_text(x, y, msg)
              },
              false => {
                let height = frame.height()
                let start = visible_start(self.cursor, height)
                mut row = 0
                for notif, idx in self.store.items {
                  if idx >= start and row < height {
                    let line = text::truncate_with_ellipsis(notif.draw(idx, self.cursor), frame.width())
                    let selected = idx == self.cursor
                    frame.draw_styled(0, row, line, -1, -1, false, false, false, false, selected)
                    row = row + 1
                  }
                }
              },
            }
          },
        }
      },
    }
  }
}
