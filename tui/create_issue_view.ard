use ard/async

use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi
use tinear/models/issues
use tinear/tui/hints_bar
use tinear/tui/modal
use tinear/tui/picker
use tinear/tui/toast

// Issue-creation flow, opened with `c` from the shell.
//
// One modal whose body is a single Stateful state machine:
//
//   loading teams -> (one team) ------------> form
//                 -> (many teams) team pick -> form
//
// Scoping the whole flow to one widget lifecycle is what makes the
// async safe: the teams fetch and the create mutation both re-enter
// through ffi::Dispatch on THIS widget's ctx, so if the user dismissed
// the modal (disposing the ctx) a late completion is a no-op — it can
// never reopen the flow or close somebody else's modal.
//
// Escape is swallowed while the create request is in flight (the modal
// can't be dismissed out from under a pending mutation), so the
// success path's notify/on_created/close always refer to this modal.

let STAGE_LOADING: Int = 0
let STAGE_PICK_TEAM: Int = 1
let STAGE_FORM: Int = 2

struct Flow {
  started: Bool,
  stage: Int,
  teams: [issues::Team],
  // Set when the team is chosen (or when there's only one).
  team: issues::Team?,
  title: Str,
  description: Str,
  sending: Bool,
  error: Str,
}

// ── Async work (all scoped to the flow widget's ctx) ─────────────────

fn load_teams(
  c: mut ffi::StateCtx,
  api_key: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  close: fn(),
) {
  async::start(fn() {
    let result = issues::fetch_teams(api_key)
    // Dispatch on the flow ctx: if the modal was dismissed while
    // fetching, this is a no-op and nothing reopens.
    ffi::Dispatch(c, fn() {
      match result {
        ok(teams) => {
          match {
            teams.size() == 0 => {
              notify("New issue", "No teams found in this workspace", toast::ToastVariant::error)
              close()
            },
            teams.size() == 1 => {
              ffi::Update<Flow>(c, fn(s: mut Flow) {
                s.teams = teams
                s.team = teams.at(0)
                s.stage = STAGE_FORM
              })
            },
            _ => {
              ffi::Update<Flow>(c, fn(s: mut Flow) {
                s.teams = teams
                s.stage = STAGE_PICK_TEAM
              })
            },
          }
        },
        err(e) => {
          notify("New issue", e, toast::ToastVariant::error)
          close()
        },
      }
    })
  })
}

fn submit(
  c: mut ffi::StateCtx,
  api_key: Str,
  notify: fn(Str, Str, toast::ToastVariant),
  on_created: fn(Str),
  close: fn(),
) {
  let current = ffi::StateValue<Flow>(c)
  let title = current.title.trim()
  match {
    current.sending => (),
    current.team.is_none() => (),
    title.is_empty() => {
      ffi::Update<Flow>(c, fn(s: mut Flow) {
        s.error = "Title is required"
      })
    },
    _ => {
      let team = current.team.expect("guarded above")
      let description = current.description
      ffi::Update<Flow>(c, fn(s: mut Flow) {
        s.sending = true
        s.error = ""
      })
      async::start(fn() {
        let result = issues::create_issue(api_key, team.id, title, description)
        // Same lifecycle scoping as load_teams: Esc is swallowed
        // while sending, so a live ctx here means this modal is
        // still the active one.
        ffi::Dispatch(c, fn() {
          match result {
            ok(identifier) => {
              notify("Issue created", identifier, toast::ToastVariant::success)
              on_created(identifier)
              close()
            },
            err(e) => {
              ffi::Update<Flow>(c, fn(s: mut Flow) {
                s.sending = false
                s.error = e
              })
            },
          }
        })
      })
    },
  }
}

// ── Stage bodies ─────────────────────────────────────────────────────

fn loading_body(theme: ui::Theme) ui::Widget {
  mut focus_node = ui::FocusNode{}
  ui::Focus(
    mut focus_node,
    ui::SizedBox{
      Height: 3,
      Child: ui::Center(ui::Text{Value: "Loading teams…", Style: ui::Style{Foreground: theme.MutedForeground}}),
    },
  )
}

fn team_pick_body(c: mut ffi::StateCtx, flow: Flow) ui::Widget {
  let options: mut [picker::Option] = mut []
  for team in flow.teams {
    options.push(
      picker::Option{
        id: team.id,
        label: "{team.name} ({team.key})",
        current: false,
      },
    )
  }
  let teams = flow.teams
  // The embedded picker's `close` is a no-op: confirming advances the
  // flow to the form stage inside this same modal; Esc (dismissing the
  // whole modal) is handled by the flow's own dismiss action.
  picker::picker_body(
    picker::Props{
      key: "create-issue-team",
      title: "New issue",
      options: options.@,
      width: Maybe::new(),
      on_confirm: fn(picked: picker::Option) {
        mut chosen: issues::Team? = Maybe::new()
        for team in teams {
          if team.id == picked.id {
            chosen = Maybe::new(team)
          }
        }
        let chosen_snapshot = chosen
        ffi::Update<Flow>(c, fn(s: mut Flow) {
          s.team = chosen_snapshot
          s.stage = STAGE_FORM
        })
      },
    },
    fn() {},
  )
}

fn form_body(c: mut ffi::StateCtx, theme: ui::Theme, flow: Flow) ui::Widget {
  // Stable slots for error/sending so the widget shape doesn't change
  // across state transitions (reconciliation pitfall).
  let error_widget: ui::Widget = match flow.error.is_empty() {
    true => ui::SizedBox{},
    false => {
      ui::Padding(
        ui::Insets{Bottom: 1},
        ui::Text{Value: "⚠ {flow.error}", Style: ui::Style{Foreground: theme.DangerText}},
      )
    },
  }
  let sending_widget: ui::Widget = match flow.sending {
    true => {
      ui::Padding(
        ui::Insets{Top: 1},
        ui::Text{Value: "Creating…", Style: ui::Style{Foreground: theme.MutedForeground}},
      )
    },
    false => ui::SizedBox{},
  }
  
  mut body_children: [ui::Widget] = [
    error_widget,
    ui::Text{Value: "Title", Style: ui::Style{Foreground: theme.MutedForeground}},
    ui::FocusScope{
      AutoFocus: true,
      Child: ui::TextField{
        Value: flow.title,
        Placeholder: "Issue title…",
        MinWidth: 66,
        OnChanged: fn(ev: ui::EventContext, value: Str) {
          ffi::Update<Flow>(c, fn(s: mut Flow) {
            s.title = value
            s.error = ""
          })
        },
      },
    },
    ui::SizedBox{Height: 1},
    ui::Text{Value: "Description (markdown, optional)", Style: ui::Style{Foreground: theme.MutedForeground}},
    ui::TextArea{
      Value: flow.description,
      Placeholder: "Add details…",
      MinWidth: 66,
      MinHeight: 8,
      SoftWrap: true,
      OnChanged: fn(ev: ui::EventContext, value: Str) {
        ffi::Update<Flow>(c, fn(s: mut Flow) {
          s.description = value
        })
      },
    },
    sending_widget,
  ]
  ui::Flex{
    Axis: ui::Vertical,
    MainAxisSize: ui::MainAxisSizeMin,
    CrossAxisAlignment: ui::CrossAxisStretch,
    Children: body_children,
  }
}

// ── Frame assembly ───────────────────────────────────────────────────

fn stage_title(flow: Flow) Str {
  match flow.stage == STAGE_FORM {
    true => {
      match flow.team {
        team => "New issue — {team.name}",
        _ => "New issue",
      }
    },
    false => "New issue",
  }
}

fn stage_hints(flow: Flow) [hints_bar::Hint] {
  match flow.stage {
    1 => {
      [
        hints_bar::Hint{key: "↑↓", label: "select"},
        hints_bar::Hint{key: "↵", label: "confirm"},
        hints_bar::Hint{key: "Esc", label: "cancel"},
      ]
    },
    2 => {
      [
        hints_bar::Hint{key: "Tab", label: "next field"},
        hints_bar::Hint{key: "Ctrl+↵", label: "create"},
        hints_bar::Hint{key: "Esc", label: "cancel"},
      ]
    },
    _ => [hints_bar::Hint{key: "Esc", label: "cancel"}],
  }
}

fn stage_width(flow: Flow) Int {
  match flow.stage == STAGE_FORM {
    true => 70,
    false => 50,
  }
}

// Modal builder for the whole flow. Hand to show_modal.
fn flow_builder(api_key: Str, notify: fn(Str, Str, toast::ToastVariant), on_created: fn(Str)) fn(ui::Theme, fn()) ui::Widget {
  fn(theme: ui::Theme, close: fn()) ui::Widget {
    ffi::Stateful{
      Key: "create_issue.flow",
      Init: fn() Any {
        Flow{
          started: false,
          stage: STAGE_LOADING,
          teams: [],
          team: Maybe::new(),
          title: "",
          description: "",
          sending: false,
          error: "",
        }
      },
      Build: fn(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
        let s = ffi::StateRef<Flow>(c)
        if not s.started {
          s.started = true
          load_teams(c, api_key, notify, close)
        }
        let flow = ffi::StateValue<Flow>(c)
        
        let body: ui::Widget = match flow.stage {
          1 => team_pick_body(c, flow),
          2 => form_body(c, theme, flow),
          _ => loading_body(theme),
        }
        
        // Dismiss (Esc) is intercepted here, before the modal frame's
        // handler: swallowed while a create is in flight so the flow
        // ctx stays alive until the mutation resolves.
        let guarded = ui::Actions{
          Bindings: [
            "vaxis.dismiss": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
              match ffi::StateValue<Flow>(c).sending {
                true => ui::EventHandled,
                false => {
                  close()
                  ui::EventHandled
                },
              }
            },
            "create_issue.submit": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
              match ffi::StateValue<Flow>(c).stage == STAGE_FORM {
                true => {
                  submit(c, api_key, notify, on_created, close)
                  ui::EventHandled
                },
                false => ui::EventIgnored,
              }
            },
          ],
          Child: ui::Shortcuts{
            Bindings: [
              "Ctrl+Enter": ffi::Intent("create_issue.submit"),
              "Ctrl+m": ffi::Intent("create_issue.submit"),
              "Ctrl+j": ffi::Intent("create_issue.submit"),
            ],
            Child: body,
          },
        }
        
        modal::show_modal(
          theme,
          stage_title(flow),
          guarded,
          hints_bar::row(theme, stage_hints(flow)),
          Maybe::new(stage_width(flow)),
          fn(ev: ui::EventContext) {
            if not ffi::StateValue<Flow>(c).sending {
              close()
            }
          },
        )
      },
    }
  }
}

// Entry point.
fn open(
  api_key: Str,
  show_modal: fn(fn(ui::Theme, fn()) ui::Widget),
  close_modal: fn(),
  notify: fn(Str, Str, toast::ToastVariant),
  on_created: fn(Str),
) {
  show_modal(flow_builder(api_key, notify, on_created))
}
