use decode
use go:encoding/json
use go:io
use go:net/http
use go:strings
use go:time

let MAX_RESPONSE_BYTES: Int = 4 * 1024 * 1024

private fn error_message(error: Error) Str {
  error.error()
}

// Shared GraphQL client for the Linear API.
//
// Linear auth header is `Authorization: <raw key>` — no `Bearer` prefix.

private fn post(api_key: Str, body: Str) Str!Str {
  let req = try http::NewRequest(
    "POST",
    "https://api.linear.app/graphql",
    strings::NewReader(body),
  ).map_err(error_message)
  req.Header.Set("Content-Type", "application/json")
  req.Header.Set("Authorization", api_key)

  let client = mut http::Client{Timeout: 30 * time::Second}
  let res = try client.Do(req).map_err(error_message)
  defer res.Body.Close()

  let limited = io::LimitReader(res.Body, Int64::from(MAX_RESPONSE_BYTES + 1))
  mut bytes = try io::ReadAll(limited).map_err(error_message)
  if bytes.size() > MAX_RESPONSE_BYTES {
    Result::err("Linear response exceeded {MAX_RESPONSE_BYTES} bytes")
  } else {
    let text = Str::from(bytes)
    match res.StatusCode >= 200 and res.StatusCode < 300 {
      true => Result::ok(text),
      false => Result::err("HTTP {res.StatusCode}: {text}"),
    }
  }
}

fn extract_data(res_body: Str) Any!Str {
  let parsed = try decode::from_json(res_body)

  // Check for GraphQL errors — if "errors" field exists, report it
  match decode::run(parsed, decode::field("errors", decode::any)) {
    ok(errs) => {
      mut encoded = json::Marshal(errs).expect("encode errors")
      Result::err("GraphQL error: {Str::from(encoded)}")
    },
    err(_) => {
      match decode::run(parsed, decode::field("data", decode::any)) {
        ok(data) => Result::ok(data),
        err(e) => Result::err("extract data: {e.to_str()}"),
      }
    },
  }
}

fn send_query(api_key: Str, body: Str) Any!Str {
  let res_body = try post(api_key, body)
  extract_data(res_body)
}

fn graphql(api_key: Str, query: Str) Any!Str {
  mut encoded = json::Marshal(["query": query]).expect("encode body")
  send_query(api_key, Str::from(encoded))
}

// Encode untrusted strings before interpolating them into GraphQL source.
fn string_literal(value: Str) Str {
  mut encoded = json::Marshal(value).expect("encode GraphQL string")
  Str::from(encoded)
}

fn nullable_string_literal(value: Str) Str {
  match value.is_empty() {
    true => "null",
    false => string_literal(value),
  }
}
