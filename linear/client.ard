use ard/decode
use ard/dynamic
use ard/http
use ard/json
use ard/maybe

fn send_query(api_key: Str, body: Str) Dynamic!Str {
  let req = http::Request{
    method: http::Method::Post,
    url: "https://api.linear.app/graphql",
    headers: ["Content-Type": "application/json", "Authorization": api_key],
    body: maybe::some(dynamic::from_str(body)),
  }

  let res = try http::send(req, 30)

  match res.is_ok() {
    false => Result::err("HTTP {res.status}: {res.body}"),
    true => {
      let data = decode::from_json(res.body).expect("parse API response")
      let result = decode::run(data, decode::field("data", decode::dynamic)).expect("extract data")

      // Check for GraphQL errors — if "errors" field exists, report it
      match decode::run(data, decode::field("errors", decode::dynamic)) {
        ok(errs) => {
          let err_str = json::encode(errs).expect("encode")
          Result::err("GraphQL error: {err_str}")
        },
        err(_) => Result::ok(result),
      }
    },
  }
}

fn graphql(api_key: Str, query: Str) Dynamic!Str {
  let body = json::encode(["query": query]).expect("encode body")
  send_query(api_key, body)
}
