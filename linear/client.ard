use go:encoding/json
use go:io
use go:net/http
use go:strings
use go:time

use tinear/decode

// Shared GraphQL client for the Linear API.
//
// Linear auth header is `Authorization: <raw key>` — no `Bearer` prefix.

private fn post(api_key: Str, body: Str) Str!Str {
  let req = try http::NewRequest("POST", "https://api.linear.app/graphql", strings::NewReader(body))
  req.Header.Set("Content-Type", "application/json")
  req.Header.Set("Authorization", api_key)

  mut client = http::Client{Timeout: 30 * time::Second}
  let res = try client.Do(req)
  defer res.Body.Close()

  mut bytes = try io::ReadAll(res.Body)
  let text = Str::from(bytes)

  match res.StatusCode >= 200 and res.StatusCode < 300 {
    true => Result::ok(text),
    false => Result::err("HTTP {res.StatusCode}: {text}"),
  }
}

private fn extract_data(res_body: Str) Any!Str {
  let parsed = try decode::from_json(res_body)

  // Check for GraphQL errors — if "errors" field exists, report it
  match decode::run(parsed, decode::field("errors", decode::any)) {
    ok(errs) => {
      mut encoded = json::Marshal(errs).expect("encode errors")
      Result::err("GraphQL error: {Str::from(encoded)}")
    },
    err(_) => {
      match decode::run(parsed, decode::field("data", decode::any)) {
        ok(data) => Result::ok(data),
        err(e) => Result::err("extract data: {e.to_str()}"),
      }
    },
  }
}

fn send_query(api_key: Str, body: Str) Any!Str {
  let res_body = try post(api_key, body)
  extract_data(res_body)
}

fn graphql(api_key: Str, query: Str) Any!Str {
  mut encoded = json::Marshal(["query": query]).expect("encode body")
  send_query(api_key, Str::from(encoded))
}
