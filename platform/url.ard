use cooper

fn is_supported(target: Str) Bool {
  target.starts_with("https://") or target.starts_with("http://")
}

// Targets are restricted to web URLs before reaching the platform opener.
fn open_with(target: Str, opener: fn(Str) Void!Error) Void!Error {
  match is_supported(target) {
    true => opener(target),
    false => Result::err(Error::new("unsupported URL scheme: {target}")),
  }
}

fn open(ctx: mut cooper::Runtime, target: Str) Void!Error {
  open_with(target, fn(url: Str) Void!Error {
    ctx.open_url(url)
  })
}
