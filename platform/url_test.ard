use ard/testing

use tinear/platform/url

test fn url_launcher_accepts_only_web_targets() Void!Str {
  try testing::assert(url::is_supported("https://linear.app/issue/AKO-1"), "https should be supported")
  try testing::assert(url::is_supported("http://localhost:3000"), "http should be supported")
  try testing::assert(
    not url::is_supported("-malicious-option"),
    "option-shaped target should be rejected",
  )
  testing::assert(not url::is_supported("file:///tmp/secret"), "non-web scheme should be rejected")
}

test fn url_launcher_rejects_unsupported_target_before_opening() Void!Str {
  mut opened = 0
  let result = url::open_with("javascript:alert(1)", fn(target: Str) Void!Error {
    opened =+ 1
    Result::ok(())
  })
  try testing::assert(result.is_err(), "unsupported scheme should fail")
  testing::assert(opened == 0, "unsupported target should not reach the platform opener")
}

test fn url_launcher_passes_web_targets_to_the_platform_opener() Void!Str {
  mut received = ""
  let result = url::open_with("https://linear.app/issue/AKO-1", fn(target: Str) Void!Error {
    received = target
    Result::ok(())
  })
  try testing::assert(result.is_ok(), "web target should open")
  testing::assert(received == "https://linear.app/issue/AKO-1", "opener should receive the target")
}
