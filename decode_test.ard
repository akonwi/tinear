use ard/testing
use tinear/decode

test fn parses_scalars() Void!Str {
  let data = decode::from_json("\{\"name\": \"Ada\", \"age\": 36, \"score\": 9.5, \"active\": true\}").expect("parse")

  let name = decode::run(data, decode::field("name", decode::string)).expect("name")
  try testing::assert(name == "Ada", "name should decode")

  let age = decode::run(data, decode::field("age", decode::int)).expect("age")
  try testing::assert(age == 36, "age should decode as Int")

  let score = decode::run(data, decode::field("score", decode::float)).expect("score")
  try testing::assert(score == 9.5, "score should decode as Float64")

  let active = decode::run(data, decode::field("active", decode::boolean)).expect("active")
  try testing::assert(active, "active should decode as Bool")
  testing::pass()
}

test fn rejects_non_integral_numbers() Void!Str {
  let data = decode::from_json("9.5").expect("parse")
  match decode::run(data, decode::int) {
    ok => testing::fail("9.5 should not decode as Int"),
    err(e) => testing::assert(e.expected == "an integer", "unexpected error: {e.to_str()}"),
  }
}

test fn decodes_lists() Void!Str {
  let data = decode::from_json("[1, 2, 3]").expect("parse")
  let nums = decode::run(data, decode::list(decode::int)).expect("list")
  try testing::assert(nums.size() == 3, "list size")
  testing::assert(nums.at(2).expect("bounds") == 3, "list order")
}

test fn nullable_maps_null_to_none() Void!Str {
  let data = decode::from_json("\{\"title\": null\}").expect("parse")
  let title = decode::run(data, decode::field("title", decode::nullable(decode::string))).expect("decode")
  try testing::assert(title.is_none(), "null should be none")

  let data2 = decode::from_json("\{\"title\": \"hi\"\}").expect("parse")
  let title2 = decode::run(data2, decode::field("title", decode::nullable(decode::string))).expect("decode")
  testing::assert(title2.or("") == "hi", "present value should be some")
}

test fn path_walks_nested_objects() Void!Str {
  let data = decode::from_json("\{\"issue\": \{\"state\": \{\"name\": \"Done\"\}\}\}").expect("parse")
  let state = decode::run(data, decode::path(["issue", "state", "name"], decode::string)).expect("path")
  testing::assert(state == "Done", "path should walk nested objects")
}

test fn errors_carry_paths() Void!Str {
  let data = decode::from_json("\{\"issue\": \{\"state\": 5\}\}").expect("parse")
  match decode::run(data, decode::path(["issue", "state"], decode::string)) {
    ok => testing::fail("should not decode"),
    err(e) => testing::assert(
      e.to_str() == "expected a string at issue.state",
      "unexpected error: {e.to_str()}",
    ),
  }
}

test fn missing_field_reports_name() Void!Str {
  let data = decode::from_json("\{\}").expect("parse")
  match decode::run(data, decode::field("id", decode::string)) {
    ok => testing::fail("should not decode"),
    err(e) => testing::assert(
      e.to_str() == "expected a value at id",
      "unexpected error: {e.to_str()}",
    ),
  }
}
