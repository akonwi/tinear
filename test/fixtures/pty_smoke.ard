use cooper
use cooper/cui
use cooper/ui
use go:strings
use tinear/models/cache
use tinear/models/shell as shell_model
use tinear/models/tabs
use tinear/tui/application_shell
use tinear/tui/screen_route
use tinear/tui/tab_shell
use tinear/tui/theme

private struct BasicProps {
  label: Str,
  route: mut screen_route::Route,
}

private struct Basic {
  props: mut BasicProps,
  panel: mut cui::BoxRef,
}

private fn basic(props: mut BasicProps) mut Basic {
  (mut Basic{props: props, panel: cui::box_ref()})
}

impl cui::Lifecycle for Basic {
  fn mut mounted(ctx: cui::Context) {
    self.props.route.focus = fn() {
      self.panel.focus(ctx)
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    self.props.route.clear()
  }
}

impl cui::Component for Basic {
  fn mut render() cui::View {
    cui::box(
      [cui::text(self.props.label, selectable: true)],
      on_key: fn(received: mut cooper::KeyEvent, context: cui::Context) {},
      ref: self.panel,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

private fn basic_screen(ctx: mut cooper::Runtime, label: Str) tab_shell::Screen {
  let route = screen_route::new()
  tab_shell::screen(
    view: cui::child(basic, BasicProps{label: label, route: route}),
    focus: fn() {
      route.focus()
    },
    handle_key: fn(received: mut cooper::KeyEvent) Bool {
      false
    },
    dispose: fn() {},
  )
}

// Controlled state for the PTY fixture's editable row.
private struct InboxState {
  value: Str,
  editor: mut cui::TextAreaRef,
  route: mut screen_route::Route,
}

private struct InboxProps {
  state: mut InboxState,
}

private struct InboxView {
  props: mut InboxProps,
}

private fn inbox_view(props: mut InboxProps) mut InboxView {
  (mut InboxView{props: props})
}

impl cui::Lifecycle for InboxView {
  fn mut mounted(ctx: cui::Context) {
    self.props.state.route.focus = fn() {
      self.props.state.editor.focus(ctx)
    }
  }

  fn mut unmounting(ctx: cui::Context) {
    self.props.state.route.clear()
  }
}

impl cui::Component for InboxView {
  fn mut render() cui::View {
    let state = self.props.state
    let rows = mut List::new<cui::View>()
    mut index = 0
    while index < 20 {
      rows.push(cui::text("scroll row {index}", selectable: true))
      index =+ 1
    }
    cui::box(
      [
        cui::text("COPY-ME", selectable: true),
        cui::text_area(
          state.value,
          placeholder: "Paste here…",
          ref: state.editor,
          on_input: fn(value: Str, context: cui::Context) {
            state.value = value
          },
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(3), flex_shrink: 0.0),
        ),
        cui::text("value: {strings::ReplaceAll(state.value, "\n", "↵")}", selectable: false),
        cui::scroll_box(
          rows.@,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(5), flex_shrink: 0.0),
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

private fn inbox_screen(ctx: mut cooper::Runtime) tab_shell::Screen {
  let state = mut InboxState{
    value: "",
    editor: cui::text_area_ref(),
    route: screen_route::new(),
  }
  tab_shell::screen(
    view: cui::child(inbox_view, InboxProps{state: state}, key: "pty-inbox"),
    focus: fn() {
      state.route.focus()
    },
    handle_key: fn(received: mut cooper::KeyEvent) Bool {
      false
    },
    dispose: fn() {},
  )
}

fn main() {
  let application = cooper::app(exit_on_ctrl_c: false).expect("create Tinear PTY fixture")
  defer application.destroy()
  let ctx = application.context
  let palette = theme::new()
  let shell_host = application_shell::new(
    ctx,
    application.root,
    palette,
    fn(milliseconds: Int, action: fn()) fn() {
      fn() {}
    },
  )
  let restored = tabs::doc_tab("restored", "Restored doc")
  cache::save_logged_in(
    cache::LoggedInCache{tab_index: 2, tabs: [restored]},
  ).expect("seed shell cache")
  let restored_model = shell_model::restore(cache::load_logged_in())
  let shell_commands = tab_shell::commands()
  let shell_view = tab_shell::view(
    tab_shell::Props{
      context: ctx,
      palette: palette,
      initial_model: restored_model,
      inbox: inbox_screen(ctx),
      board: basic_screen(ctx, "BOARD BODY"),
      make_dynamic: fn(reference: tabs::TabRef) tab_shell::Screen {
        basic_screen(ctx, "RESTORED DETAIL {reference.title}")
      },
      persist: fn(value: cache::LoggedInCache) {},
      on_dispose: fn() {},
      on_search: fn() {},
      on_create: fn() {},
      commands: shell_commands,
    },
  )
  shell_host.set_view(shell_view)

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("c", ctrl: true) {
      shell_host.dispose()
      application.destroy()
      received.prevent_default()
      received.stop_propagation()
    } else {
      let handled = shell_host.handle_key(received, application.selection())
      if (not handled) and not shell_host.modal.is_open() {
        let _ = shell_commands.handle_key(received)
      }
    }
  })
  application.run().expect("run Tinear PTY fixture")
}
