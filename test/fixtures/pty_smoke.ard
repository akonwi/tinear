use cooper
use cooper/cui
use cooper/ui
use go:strings
use tinear/models/cache
use tinear/models/shell as shell_model
use tinear/models/tabs
use tinear/tui/application_shell
use tinear/tui/shell_controller
use tinear/tui/theme

private fn basic_screen(ctx: mut cooper::Runtime, label: Str) shell_controller::Screen {
  let panel = cui::box_ref()
  shell_controller::declarative_screen(
    view: cui::box(
      [cui::text(label, selectable: true)],
      on_key: fn(received: mut cooper::KeyEvent, context: cui::Context) {},
      ref: panel,
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
    ),
    focus: fn() {
      match panel.current {
        found => {
          let _ = found.focus()
        },
        _ => (),
      }
    },
    handle_key: fn(received: mut cooper::KeyEvent) Bool {
      false
    },
    dispose: fn() {},
  )
}

// Controlled state for the PTY fixture's editable row.
private struct InboxState {
  value: Str,
  editor: mut cui::TextAreaRef,
}

private struct InboxProps {
  state: mut InboxState,
}

private struct InboxView {
  props: mut InboxProps,
}

private fn inbox_view(props: mut InboxProps) mut InboxView {
  (mut InboxView{props: props})
}

impl cui::Component for InboxView {
  fn mut render() cui::View {
    let state = self.props.state
    let rows = mut List::new<cui::View>()
    mut index = 0
    while index < 20 {
      rows.push(cui::text("scroll row {index}", selectable: true))
      index =+ 1
    }
    cui::box(
      [
        cui::text("COPY-ME", selectable: true),
        cui::text_area(
          state.value,
          placeholder: "Paste here…",
          ref: state.editor,
          on_input: fn(value: Str, context: cui::Context) {
            state.value = value
          },
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(3), flex_shrink: 0.0),
        ),
        cui::text(
          "value: {strings::ReplaceAll(state.value, "\n", "↵")}",
          selectable: false,
        ),
        cui::scroll_box(
          rows.@,
          styles: ui::style(width: ui::percent(100.0), height: ui::cells(5), flex_shrink: 0.0),
        ),
      ],
      styles: ui::style(
        width: ui::percent(100.0),
        height: ui::percent(100.0),
        flex_direction: ui::FlexDirection::column,
      ),
    )
  }
}

private fn inbox_screen(ctx: mut cooper::Runtime) shell_controller::Screen {
  let state = mut InboxState{value: "", editor: cui::text_area_ref()}
  shell_controller::declarative_screen(
    view: cui::child(inbox_view, InboxProps{state: state}, key: "pty-inbox"),
    focus: fn() {
      match state.editor.current {
        found => {
          let _ = found.focus()
        },
        _ => (),
      }
    },
    handle_key: fn(received: mut cooper::KeyEvent) Bool {
      false
    },
    dispose: fn() {},
  )
}

fn main() {
  let application = cooper::app(exit_on_ctrl_c: false).expect("create Tinear PTY fixture")
  defer application.destroy()
  let ctx = application.context
  let palette = theme::new()
  let shell_host = application_shell::new(ctx, application.root, palette, fn(milliseconds: Int, action: fn()) fn() {
    fn() {}
  })
  let restored = tabs::doc_tab("restored", "Restored doc")
  cache::save_logged_in(
    cache::LoggedInCache{tab_index: 2, tabs: [restored]},
  ).expect("seed shell cache")
  let restored_model = shell_model::restore(cache::load_logged_in())
  let controller = shell_controller::new(
    ctx,
    palette,
    restored_model,
    inbox_screen(ctx),
    basic_screen(ctx, "BOARD BODY"),
    fn(reference: tabs::TabRef) shell_controller::Screen {
      basic_screen(ctx, "RESTORED DETAIL {reference.title}")
    },
    fn(value: cache::LoggedInCache) {},
    fn() {},
    fn() {},
    fn() {},
  )
  shell_host.set_view(
    shell_controller::view(controller),
    dispose: fn() {
      controller.dispose()
    },
  )

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("c", ctrl: true) {
      shell_host.dispose()
      application.destroy()
      received.prevent_default()
      received.stop_propagation()
    } else {
      let handled = shell_host.handle_key(received, application.selection())
      if (not handled) and not shell_host.modal.is_open() {
        let _ = controller.handle_key(received)
      }
    }
  })
  application.run().expect("run Tinear PTY fixture")
}
