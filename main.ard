use ard/argv
use ard/io
use ard/list as List

use tinear/commands/core_demo
use tinear/commands/login
use tinear/commands/tui
use tinear/util

// Trait-impl visibility workaround: the Go codegen for cross-module
// trait dispatch only sees impls reachable from the entry module's
// import set. Importing view impls here so the dispatcher in
// commands/core_demo (and any future framework user) can find them.
// Revisit when the dev compiler's impl lookup walks the call site's
// transitive imports instead.
use tinear/tui/core/text
use tinear/tui/core/box

fn main() {
  let args = argv::load()
  let rest = List::drop(from: args.arguments, till: 1)

  match args.arguments.size() {
    0 => tui::run(rest),
    _ => {
      let cmd = args.arguments.at(0)
      match cmd {
        "help" => util::print_usage(),
        "login" => login::run(rest),
        "core-demo" => core_demo::run(),
        _ => {
          io::print("Unknown command: {cmd}")
          io::print("")
          util::print_usage()
        },
      }
    },
  }
}
