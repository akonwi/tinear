use go:go.rockorager.dev/vaxis/ui
use go:tinear/ffi

use tinear/config
use tinear/tui/welcome_screen

struct AppState {
  api_key: Str,
}

impl AppState {
  fn has_auth() Bool { not self.api_key.is_empty() }
}

fn set_api_key(c: mut ffi::StateCtx, api_key: Str) {
  let state = ffi::StateRef<AppState>(c)
  state.api_key = api_key
  ffi::MarkDirty(c)
}

// Placeholder for the logged-in shell until that slice is rebuilt.
fn logged_in_placeholder() ui::Widget {
  ui::Text{Value: "Logged in. The shell returns in the next slice."}
}

fn body(c: mut ffi::StateCtx, ctx: ui::BuildContext) ui::Widget {
  let theme = ui::MustDepend<ui::Theme>(ctx)
  let model = ffi::StateValue<AppState>(c)
  let content = match model.has_auth() {
    true => logged_in_placeholder(),
    false => welcome_screen::new(fn(api_key: Str) {
      set_api_key(c, api_key)
    }),
  }
  let centered = ui::Center(ui::Padding(ui::Symmetric(0, 1), content))
  ui::DecoratedBox(
    ui::Decoration{Style: ui::Style{Foreground: theme.Foreground, Background: theme.Background}},
    centered,
  )
}

fn root() ui::Widget {
  ui::Actions{
    Bindings: [
      "tinear.quit": fn(ev: ui::EventContext, intent: ui::Intent) ui::EventResult {
        ev.Quit()
        ui::EventHandled
      },
    ],
    // Quit on Ctrl+Q. Ctrl+C is intentionally left free so vaxis's
    // SelectionArea can claim it for copy-selection-to-clipboard when
    // the detail panes return.
    Child: ui::Shortcuts{
      Bindings: ["Ctrl+q": ffi::Intent("tinear.quit")],
      Child: ffi::Stateful{
        Init: fn() Any {
          match config::load() {
            ok(cfg) => AppState{api_key: cfg.api_key},
            err(_) => AppState{api_key: ""},
          }
        },
        Build: body,
      },
    },
  }
}

fn main() {
  // No explicit theme: vaxis derives one from the terminal's own
  // colors (OSC 10/11 foreground and background, OSC 4 palette).
  ui::Run(root()).expect("Failed to start UI")
}
