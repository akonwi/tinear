use vaxis/ui

use tinear/config
use tinear/tui/logged_in_screen
use tinear/tui/welcome_screen

struct AppState {
  api_key: Str,
}

impl AppState {
  fn has_auth() Bool { not self.api_key.is_empty() }
}

fn body(ctx: ui::BuildContext, state: ui::State<AppState>) ui::Widget {
  let theme = ui::must_have_theme(ctx)
  let model = state.value()
  let content = match model.has_auth() {
    true => logged_in_screen::new(),
    false => welcome_screen::new(fn(api_key: Str) {
      state.set(fn(mut s: AppState) { s.api_key = api_key })
    }),
  }
  ui::decorated_box(
    ui::center(ui::padding(1, content)),
    fg: theme.foreground,
    bg: theme.background,
  )
}

fn root() ui::Widget {
  ui::shortcuts(
    ui::actions(
      ui::focus(
        ui::stateful(
          key: "tinear",
          init: fn(_ctx: ui::BuildContext) AppState {
            match config::load() {
              ok(cfg) => AppState{ api_key: cfg.api_key },
              err(_) => AppState{ api_key: "" },
            }
          },
          build: body,
        ),
      ),
      [
        ui::action("tinear.quit", fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
          ui::quit(ctx)
          ui::EventResult::handled
        }),
      ],
    ),
    ["Ctrl+c": "tinear.quit"],
  )
}

fn main() Void {
  ui::run(root(), ui::default_theme_set())
}
