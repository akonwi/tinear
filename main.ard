// `use ard/async` is required at the entry module — without it,
// async::sleep calls in sub-modules misroute through the project-FFI
// lowering path. See akonwi/ard#163. Once that lands this line can
// be removed.
use ard/async
use ard/argv
use ard/io
use ard/list as List

use linear-cli/commands/login
use linear-cli/commands/tui
use linear-cli/util

fn main() {
  let args = argv::load()
  let rest = List::drop(from: args.arguments, till: 1)

  match args.arguments.size() {
    0 => tui::run(rest),
    _ => {
      let cmd = args.arguments.at(0)
      match cmd {
        "help" => util::print_usage(),
        "login" => login::run(rest),
        _ => {
          io::print("Unknown command: {cmd}")
          io::print("")
          util::print_usage()
        },
      }
    },
  }
}
