use tinear/tui/toast_host
use tinear/tui/welcome_controller

private struct ActiveRoute {
  handle: fn(mut event::KeyEvent) Bool,
}

private struct ShellActions {
  open_issue: fn(Str),
  open_doc: fn(tabs::TabRef),
  open_picker: fn(issue_field_picker_controller::Field, issues::Issue),
  retitle_doc: fn(tabs::TabRef, Str),
  focus_shell: fn(),
}

private struct DetailActions {
  open_picker: fn(issue_field_picker_controller::Field, issues::Issue),
  open_comment: fn(issues::Issue, Str, Str),
  edit_description: fn(issues::Issue),
}

private fn placeholder_screen(ctx: mut context::Context, title: Str, message: Str) shell_controller::Screen {
  let root = box::new(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      padding: style::edges(style::cells(1)),
      flex_direction: style::FlexDirection::column,
      gap: style::cells(1),
    ),
  )
  root.set_focusable(true)
  root.add(text::new(ctx, content: title, text_style: text::style(bold: true)))
  root.add(text::new(ctx, content: message, text_style: text::style(dim: true)))
  shell_controller::Screen{
    root: root,
    focus: fn() {
      let _ = root.focus()
    },
    handle_key: fn(received: mut event::KeyEvent) Bool {
      false
    },
    dispose: fn() {},
  }
}

private fn document_detail_screen(
  ctx: mut context::Context,
  palette: theme::Theme,
  api_key: Str,
  reference: tabs::TabRef,
  application_shell: mut application_shell::ApplicationShell,
  on_title: fn(Str),
) shell_controller::Screen {
  let detail = document_detail_controller::new(
    ctx,
    palette,
    reference.id,
    reference.title,
    document_detail_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    on_title,
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  detail.start()
  detail.screen()
}

private fn issue_detail_screen(
  ctx: mut context::Context,
  palette: theme::Theme,
  api_key: Str,
  identifier: Str,
  application_shell: mut application_shell::ApplicationShell,
) shell_controller::Screen {
  let actions = mut DetailActions{
    open_picker: fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {},
    open_comment: fn(issue: issues::Issue, parent_id: Str, author: Str) {},
    edit_description: fn(issue: issues::Issue) {},
  }
  let detail = issue_detail_controller::new(
    ctx,
    palette,
    identifier,
    issue_detail_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
      actions.open_picker(field, issue)
    },
    fn(issue: issues::Issue, parent_id: Str, author: Str) {
      actions.open_comment(issue, parent_id, author)
    },
    fn(issue: issues::Issue) {
      actions.edit_description(issue)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let field_pickers = issue_field_picker_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_fields_service::live(ctx, api_key),
    fn() {
      detail.focus()
    },
    fn() {
      detail.refresh(true)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let editor = issue_editor_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_edit_service::live(ctx, api_key),
    fn() {
      detail.focus()
    },
    fn(comment_id: Str, should_focus: Bool) {
      detail.comments_changed(comment_id, should_focus)
    },
    fn(description: Str) {
      detail.description_changed(description)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  actions.open_picker = fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
    field_pickers.open(field, issue)
  }
  actions.open_comment = fn(issue: issues::Issue, parent_id: Str, author: Str) {
    editor.open_comment(issue, parent_id, author)
  }
  actions.edit_description = fn(issue: issues::Issue) {
    editor.open_description(issue)
  }
  detail.start()
  detail.screen(fn() {
    editor.dispose()
    field_pickers.dispose()
  })
}

private fn show_logged_in(
  ctx: mut context::Context,
  palette: theme::Theme,
  api_key: Str,
  application_shell: mut application_shell::ApplicationShell,
  active_route: mut ActiveRoute,
) {
  let writer = cache_writer::live(ctx)
  let model = shell_model::restore(cache::load_logged_in())
  let actions = mut ShellActions{
    open_issue: fn(identifier: Str) {},
    open_doc: fn(reference: tabs::TabRef) {},
    open_picker: fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {},
    retitle_doc: fn(reference: tabs::TabRef, title: Str) {},
    focus_shell: fn() {},
  }
  let inbox = inbox_controller::new(
    ctx,
    palette,
    inbox_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(identifier: Str) {
      actions.open_issue(identifier)
    },
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let board = board_controller::new(
    ctx,
    palette,
    board_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(identifier: Str) {
      actions.open_issue(identifier)
    },
    fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
      actions.open_picker(field, issue)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let field_pickers = issue_field_picker_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_fields_service::live(ctx, api_key),
    fn() {
      board.focus()
    },
    fn() {
      board.refresh(true)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  actions.open_picker = fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
    field_pickers.open(field, issue)
  }
  let creation = issue_creation_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_creation_service::live(ctx, api_key),
    fn() {
      actions.focus_shell()
    },
    fn(title: Str, message: Str, success: Bool) {
      let variant = match success {
        true => toast_host::Variant::success,
        false => toast_host::Variant::error,
      }
      let _ = application_shell.toasts.show(title, message, variant, 4000)
    },
    fn(identifier: Str) {
      actions.open_issue(identifier)
    },
  )
  let search = search_controller::new(
    application_shell.modal,
    palette,
    search_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn() {
      actions.focus_shell()
    },
    fn(issue: issues::Issue) {
      actions.open_issue(issue.identifier)
    },
    fn(document: documents::DocMeta) {
      actions.open_doc(tabs::doc_tab(document.slug_id, document.title))
    },
  )
  let controller = shell_controller::new(
    ctx,
    palette,
    model,
    inbox.screen(),
    board.screen(),
    fn(reference: tabs::TabRef) shell_controller::Screen {
      match reference.kind {
        tabs::Kind::issue => issue_detail_screen(ctx, palette, api_key, reference.id, application_shell),
        tabs::Kind::doc => {
          document_detail_screen(
            ctx,
            palette,
            api_key,
            reference,
            application_shell,
            fn(title: Str) {
              actions.retitle_doc(reference, title)
            },
          )
        },
      }
    },
    fn(snapshot: cache::LoggedInCache) {
      writer.persist(snapshot)
    },
    fn() {
      creation.dispose()
      search.dispose()
      field_pickers.dispose()
      writer.dispose()
    },
    fn() {
      search.open(ctx)
    },
    fn() {
      creation.open()
    },
  )
  application_shell.set_screen(controller.root, fn() {
    controller.dispose()
  })
  actions.open_issue = fn(identifier: Str) {
    controller.open(tabs::issue_tab(identifier))
  }
  actions.open_doc = fn(reference: tabs::TabRef) {
    controller.open(reference)
  }
  actions.focus_shell = fn() {
    controller.focus_active()
  }
  actions.retitle_doc = fn(reference: tabs::TabRef, title: Str) {
    controller.retitle(reference, title)
  }
  active_route.handle = fn(received: mut event::KeyEvent) Bool {
    controller.handle_key(received)
  }
  inbox.start()
  board.start()
  controller.focus_active()
}

fn main() {
  let application = app::new(exit_on_ctrl_c: false).expect("create tinear")
  defer application.destroy()
  let ctx = application.context
  let palette = theme::new()
  let application_shell = application_shell::new(ctx, palette, scheduler::for_context(ctx))
  let active_route = mut ActiveRoute{handle: fn(received: mut event::KeyEvent) Bool {
    false
  }}
  application.root.add(application_shell.root)

  let configured = match config::load() {
    ok(value) => value,
    err(_) => config::Config{api_key: ""},
  }
  match configured.has_auth() {
    true => show_logged_in(ctx, palette, configured.api_key, application_shell, active_route),
    false => {
      let welcome = welcome_controller::new(ctx, palette, auth::live(ctx), fn(api_key: Str) {
        show_logged_in(ctx, palette, api_key, application_shell, active_route)
      })
      application_shell.set_screen(welcome.root, fn() {
        welcome.dispose()
      })
      let _ = welcome.focus()
    },
  }

  let _ = application.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type != event::KeyEventType::release and received.matches("c", ctrl: true) {
      application_shell.dispose()
      application.destroy()
      received.prevent_default()
      received.stop_propagation()
    } else {
      let handled = application_shell.handle_key(received, application.selection())
      if (not handled) and not application_shell.modal.is_open() {
        let _ = active_route.handle(received)
      }
    }
  })

  application.run().expect("run tinear")
}
