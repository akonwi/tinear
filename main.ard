use cooper
use tinear/config
use tinear/events
use tinear/models/cache
use tinear/models/documents
use tinear/models/issues
use tinear/models/shell as shell_model
use tinear/models/tabs
use tinear/platform/url
use tinear/services/auth
use tinear/services/board_service
use tinear/services/cache_writer
use tinear/services/document_detail_service
use tinear/services/inbox_service
use tinear/services/issue_creation_service
use tinear/services/issue_detail_service
use tinear/services/issue_edit_service
use tinear/services/issue_fields_service
use tinear/services/search_service
use tinear/tui/application_shell
use tinear/tui/board_screen
use tinear/tui/document_detail
use tinear/tui/inbox_screen
use tinear/tui/issue_creation_controller
use tinear/tui/issue_detail
use tinear/tui/issue_editor_controller
use tinear/tui/issue_field_picker_controller
use tinear/tui/scheduler
use tinear/tui/search_controller
use tinear/tui/tab_shell
use tinear/tui/theme
use tinear/tui/toast_host
use tinear/tui/welcome_controller

private struct ActiveRoute {
  handle: fn(mut cooper::KeyEvent) Bool,
}

private struct PickerAction {
  open: fn(issue_field_picker_controller::Field, issues::Issue),
}

private fn document_detail_screen(
  ctx: mut cooper::Runtime,
  palette: theme::Theme,
  api_key: Str,
  reference: tabs::TabRef,
  application_shell: mut application_shell::ApplicationShell,
  on_title: fn(Str),
) tab_shell::Screen {
  let detail = document_detail::new(
    ctx,
    palette,
    reference.id,
    reference.title,
    document_detail_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    on_title,
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  detail
}

private fn issue_detail_screen(
  ctx: mut cooper::Runtime,
  palette: theme::Theme,
  api_key: Str,
  identifier: Str,
  application_shell: mut application_shell::ApplicationShell,
  hub: mut events::Bus<events::Event>,
) tab_shell::Screen {
  let commands = issue_detail::commands()
  let field_pickers = issue_field_picker_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_fields_service::live(ctx, api_key),
    fn() {
      commands.route.focus()
    },
    fn(changed: issues::Issue) {
      // The bus fans this back to us (and every other stale view).
      hub.publish(events::issue_changed(changed.id, changed.identifier))
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let editor = issue_editor_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_edit_service::live(ctx, api_key),
    fn() {
      commands.route.focus()
    },
    fn(comment_id: Str, should_focus: Bool) {
      commands.comments_changed(comment_id, should_focus)
    },
    fn(description: Str) {
      commands.description_changed(description)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  let detail = issue_detail::new(
    ctx,
    palette,
    identifier,
    issue_detail_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
      field_pickers.open(field, issue)
    },
    fn(issue: issues::Issue, parent_id: Str, author: Str) {
      editor.open_comment(issue, parent_id, author)
    },
    fn(issue: issues::Issue) {
      editor.open_description(issue)
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
    commands: commands,
    hub: hub,
  )
  tab_shell::screen(detail.view, detail.focus, detail.handle_key, fn() {
    editor.dispose()
    field_pickers.dispose()
  })
}

private fn show_logged_in(
  ctx: mut cooper::Runtime,
  palette: theme::Theme,
  api_key: Str,
  application_shell: mut application_shell::ApplicationShell,
  active_route: mut ActiveRoute,
) {
  let writer = cache_writer::live(ctx)
  let hub = events::new<events::Event>()
  let model = shell_model::restore(cache::load_logged_in())
  let shell_commands = tab_shell::commands()
  let picker_action = mut PickerAction{open: fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {}}
  let inbox = inbox_screen::new(
    ctx,
    palette,
    inbox_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(identifier: Str) {
      shell_commands.open(tabs::issue_tab(identifier))
    },
    fn(target: Str) {
      match url::open(ctx, target) {
        ok(_) => (),
        err(error) => {
          let _ = application_shell.toasts.show(
            "Couldn't open URL",
            error.error(),
            toast_host::Variant::error,
            4000,
          )
        },
      }
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
    hub: hub,
  )
  let board = board_screen::new(
    ctx,
    palette,
    board_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn(identifier: Str) {
      shell_commands.open(tabs::issue_tab(identifier))
    },
    fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
      picker_action.open(field, issue)
    },
    fn(moved: issues::Issue) {
      hub.publish(events::issue_changed(moved.id, moved.identifier))
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
    hub: hub,
  )
  let field_pickers = issue_field_picker_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_fields_service::live(ctx, api_key),
    fn() {
      board.focus()
    },
    fn(changed: issues::Issue) {
      hub.publish(events::issue_changed(changed.id, changed.identifier))
    },
    fn(title: Str, message: Str) {
      let _ = application_shell.toasts.show(title, message, toast_host::Variant::error, 4000)
    },
  )
  picker_action.open = fn(field: issue_field_picker_controller::Field, issue: issues::Issue) {
    field_pickers.open(field, issue)
  }
  let creation = issue_creation_controller::new(
    ctx,
    application_shell.modal,
    palette,
    issue_creation_service::live(ctx, api_key),
    fn() {
      shell_commands.focus_active()
    },
    fn(title: Str, message: Str, success: Bool) {
      let variant = match success {
        true => toast_host::Variant::success,
        false => toast_host::Variant::error,
      }
      let _ = application_shell.toasts.show(title, message, variant, 4000)
    },
    fn(identifier: Str) {
      hub.publish(events::issue_created(identifier))
      shell_commands.open(tabs::issue_tab(identifier))
    },
  )
  let search = search_controller::new(
    application_shell.modal,
    palette,
    search_service::live(ctx, api_key),
    scheduler::for_context(ctx),
    fn() {
      shell_commands.focus_active()
    },
    fn(issue: issues::Issue) {
      shell_commands.open(tabs::issue_tab(issue.identifier))
    },
    fn(document: documents::DocMeta) {
      shell_commands.open(tabs::doc_tab(document.slug_id, document.title))
    },
  )
  let shell_view = tab_shell::view(
    tab_shell::Props{
      context: ctx,
      palette: palette,
      initial_model: model,
      inbox: inbox,
      board: board,
      make_dynamic: fn(reference: tabs::TabRef) tab_shell::Screen {
        match reference.kind {
          tabs::Kind::issue => {
            issue_detail_screen(ctx, palette, api_key, reference.id, application_shell, hub)
          },
          tabs::Kind::doc => {
            document_detail_screen(ctx, palette, api_key, reference, application_shell, fn(title: Str) {
              shell_commands.retitle(reference, title)
            })
          },
        }
      },
      persist: fn(snapshot: cache::LoggedInCache) {
        writer.persist(snapshot)
      },
      on_dispose: fn() {
        creation.dispose()
        search.dispose()
        field_pickers.dispose()
        writer.dispose()
      },
      on_search: fn() {
        search.open(ctx)
      },
      on_create: fn() {
        creation.open()
      },
      commands: shell_commands,
    },
  )
  application_shell.set_view(shell_view)
  active_route.handle = fn(received: mut cooper::KeyEvent) Bool {
    shell_commands.handle_key(received)
  }
}

fn main() {
  let application = cooper::app(exit_on_ctrl_c: false).expect("create tinear")
  defer application.destroy()
  let ctx = application.context
  let palette = theme::new()
  let application_shell = application_shell::new(
    ctx,
    application.root,
    palette,
    scheduler::for_context(ctx),
  )
  let active_route = mut ActiveRoute{handle: fn(received: mut cooper::KeyEvent) Bool {
    false
  }}

  let configured = match config::load() {
    ok(value) => value,
    err(_) => config::Config{api_key: ""},
  }
  match configured.has_auth() {
    true => show_logged_in(ctx, palette, configured.api_key, application_shell, active_route),
    false => {
      application_shell.set_view(
        welcome_controller::view(palette, auth::live(ctx), fn(api_key: Str) {
          show_logged_in(ctx, palette, api_key, application_shell, active_route)
        }),
      )
    },
  }

  let _ = application.on_key(fn(received: mut cooper::KeyEvent) {
    if received.event_type != cooper::KeyEventType::release and received.matches("c", ctrl: true) {
      application_shell.dispose()
      application.destroy()
      received.prevent_default()
      received.stop_propagation()
    } else {
      let handled = application_shell.handle_key(received, application.selection())
      if (not handled) and not application_shell.modal.is_open() {
        let _ = active_route.handle(received)
      }
    }
  })

  application.run().expect("run tinear")
}
