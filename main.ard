use cooper/app
use cooper/event
use cooper/style
use cooper/ui

fn main() {
  let application = app::new().expect("create tinear")
  let ctx = application.context

  let screen = ui::box(
    ctx,
    styles: style::new(
      width: style::percent(100.0),
      height: style::percent(100.0),
      padding: style::edges(style::cells(1)),
      flex_direction: style::FlexDirection::column,
      gap: style::cells(1),
    ),
  )
  screen.add(ui::text(ctx, content: "tinear", text_style: ui::text_style(bold: true)))
  screen.add(ui::text(ctx, content: "Cooper rewrite in progress"))
  screen.add(ui::text(ctx, content: "q quit", text_style: ui::text_style(dim: true)))
  application.root.add(screen)

  let _ = application.on_key(fn(received: mut event::KeyEvent) {
    if received.event_type != event::KeyEventType::release and received.matches("q") {
      application.destroy()
    }
  })

  application.run().expect("run tinear")
}
