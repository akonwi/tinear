use ard/decode
use ard/maybe

use tinear/tui/api
use tinear/tui/decode as decode_utils
use tinear/tui/state

extern fn normalize_text(value: Str) Str = "tinear.NormalizeLinearText"

// Typed issue model used by the TUI.
struct Issue {
  id: Str,
  identifier: Str,
  title: Str,
  description: Str?,
  priority: Int?,
  state_id: Str,
  state_name: Str,
  state_type: Str,
  state_position: Float,
  team_id: Str,
  team_name: Str,
  team_key: Str,
  project_name: Str,
  assignee_name: Str,
  cycle_id: Str,
  cycle_label: Str,
}

// A column on the My Issues board: a workflow state name + the issues currently
// in it. Unlike the legacy app's `tui/state::BoardColumn`, issues are decoded
// into typed `Issue` structs.
struct BoardColumn {
  name: Str,
  state_type: Str,
  position: Float,
  issues: [Issue],
}

struct Comment {
  id: Str,
  author: Str,
  created_at: Str,
  body: Str,
}

fn optional_str(data: Dynamic, name: Str, fallback: Str) Str {
  match decode_utils::optional_field(data, name) {
    v => decode::run(v, decode::string).expect("field not string"),
    _ => fallback,
  }
}

fn nullable_str(data: Dynamic, name: Str) Str? {
  decode::run(data, decode::field(name, decode::nullable(decode::string)))
    .expect("nullable string field missing")
}

fn normalize_nullable_str(value: Str?) Str? {
  match value {
    v => maybe::some(normalize_text(v)),
    _ => maybe::none(),
  }
}

fn nullable_int(data: Dynamic, name: Str) Int? {
  decode::run(data, decode::field(name, decode::nullable(decode::int)))
    .expect("nullable int field missing")
}

fn nested_str(data: Dynamic, name: Str, nested: Str, fallback: Str) Str {
  match decode_utils::optional_field(data, name) {
    obj => optional_str(obj, nested, fallback),
    _ => fallback,
  }
}

fn user_display_name_opt(data: Dynamic, name: Str) Str {
  match decode_utils::optional_field(data, name) {
    user => decode_utils::user_display_name(user),
    _ => "—",
  }
}

fn cycle_id(raw: Dynamic) Str {
  match decode_utils::optional_field(raw, "cycle") {
    cycle => optional_str(cycle, "id", ""),
    _ => "",
  }
}

fn cycle_label(raw: Dynamic) Str {
  match decode_utils::optional_field(raw, "cycle") {
    cycle => {
      let number = decode::run(cycle, decode::field("number", decode::int))
        .expect("Missing cycle.number")
      let name = decode::run(cycle, decode::field("name", decode::nullable(decode::string)))
        .expect("Missing cycle.name")
      match name {
        n => normalize_text(n),
        _ => "Cycle {number}",
      }
    },
    _ => "—",
  }
}

fn decode_issue(raw: Dynamic) Issue {
  let state = decode::run(raw, decode::field("state", decode::dynamic)).expect("Missing state")
  let team = decode::run(raw, decode::field("team", decode::dynamic)).expect("Missing team")
  Issue{
    id: decode::run(raw, decode::field("id", decode::string)).expect("Missing issue.id"),
    identifier: decode::run(raw, decode::field("identifier", decode::string)).expect("Missing issue.identifier"),
    title: normalize_text(decode::run(raw, decode::field("title", decode::string)).expect("Missing issue.title")),
    description: normalize_nullable_str(nullable_str(raw, "description")),
    priority: nullable_int(raw, "priority"),
    state_id: decode::run(state, decode::field("id", decode::string)).expect("Missing state.id"),
    state_name: normalize_text(decode::run(state, decode::field("name", decode::string)).expect("Missing state.name")),
    state_type: decode::run(state, decode::field("type", decode::string)).expect("Missing state.type"),
    state_position: decode::run(state, decode::field("position", decode::float)).expect("Missing state.position"),
    team_id: decode::run(team, decode::field("id", decode::string)).expect("Missing team.id"),
    team_name: normalize_text(decode::run(team, decode::field("name", decode::string)).expect("Missing team.name")),
    team_key: decode::run(team, decode::field("key", decode::string)).expect("Missing team.key"),
    project_name: normalize_text(nested_str(raw, "project", "name", "—")),
    assignee_name: normalize_text(user_display_name_opt(raw, "assignee")),
    cycle_id: cycle_id(raw),
    cycle_label: cycle_label(raw),
  }
}

fn decode_column(raw: state::BoardColumn) BoardColumn {
  mut issues: [Issue] = []
  for issue in raw.issues {
    issues.push(decode_issue(issue))
  }
  BoardColumn{
    name: normalize_text(raw.name),
    state_type: raw.state_type,
    position: raw.position,
    issues: issues,
  }
}

fn decode_comment(raw: Dynamic) Comment {
  let user = decode::run(raw, decode::field("user", decode::dynamic)).expect("Missing comment.user")
  Comment{
    id: decode::run(raw, decode::field("id", decode::string)).expect("Missing comment.id"),
    author: decode_utils::user_display_name(user),
    created_at: decode::run(raw, decode::field("createdAt", decode::string)).expect("Missing comment.createdAt"),
    body: normalize_text(decode::run(raw, decode::field("body", decode::string)).expect("Missing comment.body")),
  }
}

fn load_comments(api_key: Str, issue_id: Str) [Comment]!Str {
  let raw_comments = try api::fetch_issue_comments(api_key, issue_id)
  mut comments: [Comment] = []
  for raw in raw_comments {
    comments.push(decode_comment(raw))
  }
  Result::ok(comments)
}

fn load_issue(api_key: Str, issue_id: Str) Issue!Str {
  let raw = try api::fetch_single_issue(api_key, issue_id)
  Result::ok(decode_issue(raw))
}

fn load(api_key: Str) [BoardColumn]!Str {
  let viewer = try api::fetch_viewer(api_key)
  let viewer_id = decode::run(viewer, decode::field("id", decode::string))
    .expect("Missing viewer id")
  let raw_columns = try api::fetch_board(api_key, viewer_id)
  mut columns: [BoardColumn] = []
  for col in raw_columns {
    columns.push(decode_column(col))
  }
  Result::ok(columns)
}
