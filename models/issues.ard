use decode
use tinear/linear/client
use tinear/models/issue_state as state

fn replace_common_mojibake(value: Str) Str {
  mut normalized = value
  // UTF-8 punctuation decoded as Windows-1252/C1 controls.
  normalized = normalized.replace_all("â\u0080\u0094", "-")
  normalized = normalized.replace_all("â\u0080\u0093", "-")
  normalized = normalized.replace_all("â\u0080\u0098", "'")
  normalized = normalized.replace_all("â\u0080\u0099", "'")
  normalized = normalized.replace_all("â\u0080\u009c", "\"")
  normalized = normalized.replace_all("â\u0080\u009d", "\"")
  normalized = normalized.replace_all("â\u0080¦", "...")
  normalized = normalized.replace_all("â\u0080¢", "*")

  // Same mojibake after further Windows-1252-ish display/clipboard conversion.
  normalized = normalized.replace_all("â€”", "-")
  normalized = normalized.replace_all("â€“", "-")
  normalized = normalized.replace_all("â€˜", "'")
  normalized = normalized.replace_all("â€™", "'")
  normalized = normalized.replace_all("â€œ", "\"")
  normalized = normalized.replace_all("â€�", "\"")
  normalized = normalized.replace_all("â€¦", "...")
  normalized = normalized.replace_all("â€¢", "*")

  // macOS/NS-style mojibake variants.
  normalized = normalized.replace_all("‚Äî", "-")
  normalized = normalized.replace_all("‚Äì", "-")
  normalized = normalized.replace_all("‚Äò", "'")
  normalized = normalized.replace_all("‚Äô", "'")
  normalized = normalized.replace_all("‚Äú", "\"")
  normalized = normalized.replace_all("‚Äù", "\"")
  normalized = normalized.replace_all("‚Ä¶", "...")
  normalized = normalized.replace_all("‚Ä¢", "*")

  normalized.replace_all("\u00a0", " ")
}

fn normalize_degraded_mojibake(value: Str) Str {
  mut normalized = ""
  for ch in value {
    match ch {
      'Â' => (),
      '�' => (),
      '¢' => { normalized = normalized + "-" },
      'â' => { normalized = normalized + "-" },
      _ => { normalized = normalized + ch.to_str() },
    }
  }
  normalized
}

fn normalize_text(value: Str) Str {
  normalize_degraded_mojibake(replace_common_mojibake(value))
}

// Typed issue model shared by the retained controllers.
struct Issue {
  id: Str,
  identifier: Str,
  title: Str,
  description: Str?,
  priority: Int?,
  state_id: Str,
  state_name: Str,
  state_type: Str,
  state_position: Float64,
  team_id: Str,
  team_name: Str,
  team_key: Str,
  project_id: Str,
  project_name: Str,
  assignee_id: Str,
  assignee_name: Str,
  cycle_id: Str,
  cycle_label: Str,
  url: Str,
}

// A column on the My Issues board: a workflow state name + the issues currently
// in it. Issues are decoded into typed `Issue` structs at this model boundary.
struct BoardColumn {
  raw_state_name: Str,
  name: Str,
  state_type: Str,
  position: Float64,
  issues: [Issue],
}

private struct DecodedBoardIssue {
  issue: Issue,
  raw_state_name: Str,
}

struct Comment {
  id: Str,
  author: Str,
  created_at: Str,
  body: Str,
  // Parent comment id for replies; empty for top-level comments.
  // Linear threads are one level deep (replies can't have replies).
  parent_id: Str,
  // Display depth computed by thread_comments: 0 top-level, 1 reply.
  depth: Int,
}

struct WorkflowState {
  id: Str,
  raw_name: Str,
  name: Str,
  state_type: Str,
  position: Float64,
}

struct Cycle {
  id: Str,
  number: Int,
  name: Str,
  starts_at: Str,
}

struct TeamCyclesResult {
  active_cycle_number: Int?,
  cycles: [Cycle],
}

fn optional_str(data: Any, name: Str, fallback: Str) Str {
  match decode::run(data, decode::field(name, decode::nullable(decode::string))) {
    ok(value) => {
      match value {
        v => v,
        _ => fallback,
      }
    },
    err(_) => fallback,
  }
}

fn normalize_nullable_str(value: Str?) Str? {
  match value {
    v => Maybe::new(normalize_text(v)),
    _ => Maybe::new(),
  }
}

fn nested_str(data: Any, name: Str, nested: Str, fallback: Str) Str {
  match decode::run(data, decode::path([name, nested], decode::nullable(decode::string))) {
    ok(value) => {
      match value {
        v => v,
        _ => fallback,
      }
    },
    err(_) => fallback,
  }
}

// Comment authors are not always users: integration comments (GitHub
// sync, Slack, OAuth apps) have user: null and a botActor instead, and
// deleted users can be missing fields. Never panic — walk the
// fallbacks and settle on a dash. (Fixes #16.)
fn comment_author(raw: Any) Str {
  let user_display = nested_str(raw, "user", "displayName", "")
  match user_display.is_empty() {
    false => user_display,
    true => {
      let user_name = nested_str(raw, "user", "name", "")
      match user_name.is_empty() {
        false => user_name,
        true => {
          let bot_name = nested_str(raw, "botActor", "name", "")
          match bot_name.is_empty() {
            false => bot_name,
            true => "—",
          }
        },
      }
    },
  }
}

fn user_display_name_opt(data: Any, name: Str) Str {
  let display_name = nested_str(data, name, "displayName", "")
  match display_name.is_empty() {
    true => nested_str(data, name, "name", "—"),
    false => display_name,
  }
}

fn cycle_id(raw: Any) Str {
  nested_str(raw, "cycle", "id", "")
}

fn cycle_label(raw: Any) Str {
  let number = match decode::run(raw, decode::path(["cycle", "number"], decode::nullable(decode::int))) {
    ok(value) => value,
    err(_) => Maybe::new(),
  }
  match number {
    n => {
      let name = nested_str(raw, "cycle", "name", "")
      match name.is_empty() {
        true => "Cycle {n}",
        false => normalize_text(name),
      }
    },
    _ => "—",
  }
}

private fn validate_issue_identity(id: Str, identifier: Str) Void!Str {
  match id.trim().is_empty() or identifier.trim().is_empty() {
    true => Result::err("Issue search identity cannot be empty"),
    false => Result::ok(()),
  }
}

fn decode_issue(raw: Any) Issue!Str {
  let state = try decode::run(raw, decode::field("state", decode::any)) -> error { Result::err(error.to_str()) }
  let team = try decode::run(raw, decode::field("team", decode::any)) -> error { Result::err(error.to_str()) }
  let id = try decode::run(raw, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let identifier = try decode::run(raw, decode::field("identifier", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let title = try decode::run(raw, decode::field("title", decode::string)) -> error {
    Result::err(error.to_str())
  }
  try validate_issue_identity(id, identifier)
  let description = try decode::run(raw, decode::field("description", decode::nullable(decode::string))) -> error {
    Result::err(error.to_str())
  }
  let priority = try decode::run(raw, decode::field("priority", decode::nullable(decode::int))) -> error {
    Result::err(error.to_str())
  }
  let state_id = try decode::run(state, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let state_name = try decode::run(state, decode::field("name", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let state_type = try decode::run(state, decode::field("type", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let state_position = try decode::run(state, decode::field("position", decode::float)) -> error {
    Result::err(error.to_str())
  }
  let team_id = try decode::run(team, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let team_name = try decode::run(team, decode::field("name", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let team_key = try decode::run(team, decode::field("key", decode::string)) -> error { Result::err(error.to_str()) }
  Result::ok(
    Issue{
      id: id,
      identifier: identifier,
      title: normalize_text(title),
      description: normalize_nullable_str(description),
      priority: priority,
      state_id: state_id,
      state_name: normalize_text(state_name),
      state_type: state_type,
      state_position: state_position,
      team_id: team_id,
      team_name: normalize_text(team_name),
      team_key: team_key,
      project_id: nested_str(raw, "project", "id", ""),
      project_name: normalize_text(nested_str(raw, "project", "name", "—")),
      assignee_id: nested_str(raw, "assignee", "id", ""),
      assignee_name: normalize_text(user_display_name_opt(raw, "assignee")),
      cycle_id: cycle_id(raw),
      cycle_label: cycle_label(raw),
      url: optional_str(raw, "url", ""),
    },
  )
}

fn decode_comment(raw: Any) Comment!Str {
  let id = try decode::run(raw, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let created_at = try decode::run(raw, decode::field("createdAt", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let body = try decode::run(raw, decode::field("body", decode::string)) -> error { Result::err(error.to_str()) }
  Result::ok(
    Comment{
      id: id,
      author: normalize_text(comment_author(raw)),
      created_at: created_at,
      body: normalize_text(body),
      parent_id: nested_str(raw, "parent", "id", ""),
      depth: 0,
    },
  )
}

// Arrange comments into threaded display order: each top-level comment
// (in its original relative order) followed by its replies (in theirs),
// with depth set for indentation. Replies whose parent isn't present
// (deleted, or beyond the fetch page) degrade to top-level.
fn thread_comments(comments: [Comment]) [Comment] {
  let present: mut [Str: Bool] = mut [:]
  for comment in comments {
    present.set(comment.id, true)
  }
  let ordered: mut [Comment] = mut []
  for comment in comments {
    let is_reply = (not comment.parent_id.is_empty()) and present.get(comment.parent_id).or(false)
    if not is_reply {
      ordered.push(comment)
      for candidate in comments {
        if candidate.parent_id == comment.id {
          let reply = mut candidate
          reply.depth = 1
          ordered.push(reply.@)
        }
      }
    }
  }
  ordered.@
}

fn decode_workflow_state(raw: Any) WorkflowState!Str {
  let id = try decode::run(raw, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let name = try decode::run(raw, decode::field("name", decode::string)) -> error { Result::err(error.to_str()) }
  let state_type = try decode::run(raw, decode::field("type", decode::string)) -> error { Result::err(error.to_str()) }
  let position = try decode::run(raw, decode::field("position", decode::float)) -> error {
    Result::err(error.to_str())
  }
  Result::ok(
    WorkflowState{
      id: id,
      raw_name: name,
      name: normalize_text(name),
      state_type: state_type,
      position: position,
    },
  )
}

fn decode_cycle(raw: Any) Cycle!Str {
  let id = try decode::run(raw, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let number = try decode::run(raw, decode::field("number", decode::int)) -> error { Result::err(error.to_str()) }
  let name = try decode::run(raw, decode::field("name", decode::nullable(decode::string))) -> error {
    Result::err(error.to_str())
  }
  Result::ok(
    Cycle{
      id: id,
      number: number,
      name: match name {
        n => normalize_text(n),
        _ => "",
      },
      starts_at: optional_str(raw, "startsAt", ""),
    },
  )
}

fn decode_viewer_id(data: Any) Str!Str {
  decode::run(
    data,
    decode::path(["viewer", "id"], decode::string),
  ).map_err(fn(error) {
    error.to_str()
  })
}

fn fetch_viewer_id(api_key: Str) Str!Str {
  let data = try client::graphql(api_key, `query {{ viewer {{ id name displayName email }} }}`)
  decode_viewer_id(data)
}

fn update_state(api_key: Str, issue_id: Str, state_id: Str) Void!Str {
  let mutation = `mutation {{ issueUpdate(id: {client::string_literal(issue_id)}, input: {{ stateId: {client::string_literal(state_id)} }}) {{ success }} }}`
  let data = try client::graphql(api_key, mutation)
  let success = try decode::run(data, decode::path(["issueUpdate", "success"], decode::boolean)) -> error {
    Result::err(error.to_str())
  }
  match success {
    true => Result::ok(()),
    false => Result::err("issueUpdate returned success=false"),
  }
}

fn update_cycle(api_key: Str, issue_id: Str, cycle_id: Str) Void!Str {
  let cycle_value = client::nullable_string_literal(cycle_id)
  let mutation = `mutation {{ issueUpdate(id: {client::string_literal(issue_id)}, input: {{ cycleId: {cycle_value} }}) {{ success }} }}`
  let data = try client::graphql(api_key, mutation)
  let success = try decode::run(data, decode::path(["issueUpdate", "success"], decode::boolean)) -> error {
    Result::err(error.to_str())
  }
  match success {
    true => Result::ok(()),
    false => Result::err("issueUpdate returned success=false"),
  }
}

// Empty parent_id posts a top-level comment; otherwise a threaded
// reply. Linear threads are one level deep, so parent_id must be a
// top-level comment's id.
fn create_comment(api_key: Str, issue_id: Str, body: Str, parent_id: Str) Str!Str {
  mut input = "issueId: {client::string_literal(issue_id)}, body: {client::string_literal(body)}"
  if not parent_id.is_empty() {
    input = "{input}, parentId: {client::string_literal(parent_id)}"
  }
  let mutation = `mutation {{ commentCreate(input: {{ {input} }}) {{ success comment {{ id }} }} }}`
  let data = try client::graphql(api_key, mutation)
  let success = try decode::run(data, decode::path(["commentCreate", "success"], decode::boolean)) -> error {
    Result::err(error.to_str())
  }
  match success {
    true => {
      // The mutation already landed when success=true. A missing ID must not
      // turn that success into a retryable failure and duplicate the comment.
      let comment_id = decode::run(
        data,
        decode::path(["commentCreate", "comment", "id"], decode::string),
      ).or("")
      Result::ok(comment_id)
    },
    false => Result::err("commentCreate returned success=false"),
  }
}

fn fetch_issue_comments(api_key: Str, issue_id: Str) [Any]!Str {
  let query = `query {{ issue(id: {client::string_literal(issue_id)}) {{ comments(first: 50) {{ nodes {{ id body createdAt parent {{ id }} user {{ name displayName }} botActor {{ name }} }} }} }} }}`
  let data = try client::graphql(api_key, query)
  let nodes = try decode::run(data, decode::path(["issue", "comments", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  Result::ok(nodes)
}

fn fetch_team_states(api_key: Str, team_id: Str) [Any]!Str {
  let query = `query {{ team(id: {client::string_literal(team_id)}) {{ states {{ nodes {{ id name type position }} }} }} }}`
  let data = try client::graphql(api_key, query)
  let nodes = try decode::run(data, decode::path(["team", "states", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  Result::ok(nodes)
}

fn fetch_team_cycles(api_key: Str, team_id: Str) TeamCyclesResult!Str {
  let query = `query {{ team(id: {client::string_literal(team_id)}) {{ activeCycle {{ number }} cycles(first: 50) {{ nodes {{ id number name startsAt }} }} }} }}`
  let data = try client::graphql(api_key, query)
  let team_obj = try decode::run(data, decode::field("team", decode::any)) -> error { Result::err(error.to_str()) }
  let nodes = try decode::run(team_obj, decode::path(["cycles", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }

  let active_number = match decode::run(team_obj, decode::path(["activeCycle", "number"], decode::nullable(decode::int))) {
    ok(value) => value,
    err(_) => Maybe::new(),
  }

  let cycles: mut [Cycle] = mut []
  for raw in nodes {
    cycles.push(try decode_cycle(raw))
  }
  Result::ok(TeamCyclesResult{active_cycle_number: active_number, cycles: cycles.@})
}

fn issue_fields() Str {
  `id identifier title description priority state {{ id name type position }} team {{ id name key }} project {{ id name }} assignee {{ id name displayName }} cycle {{ id number name }} url`
}

fn fetch_single_issue(api_key: Str, issue_id: Str) Any!Str {
  let query = `query {{ issue(id: {client::string_literal(issue_id)}) {{ {issue_fields()} }} }}`
  let data = try client::graphql(api_key, query)
  let issue = try decode::run(data, decode::field("issue", decode::any)) -> error { Result::err(error.to_str()) }
  Result::ok(issue)
}

fn fetch_issue_search(api_key: Str, term: Str) [Any]!Str {
  let query = `query {{ searchIssues(term: {client::string_literal(term)}, first: 20) {{ nodes {{ {issue_fields()} }} }} }}`
  let data = try client::graphql(api_key, query)
  let nodes = try decode::run(data, decode::path(["searchIssues", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  Result::ok(nodes)
}

fn sort_columns_by_position(cols: [BoardColumn]) [BoardColumn] {
  let n = cols.size()
  if n < 2 {
    cols
  } else {
    let result = mut cols
    for i in 0..n - 2 {
      for j in 0..n - 2 - i {
        let a = result.at(j).expect("bounds checked")
        let b = result.at(j + 1).expect("bounds checked")
        let ra = state::state_type_rank(a.state_type)
        let rb = state::state_type_rank(b.state_type)
        let swap = match ra == rb {
          true => a.position > b.position,
          false => ra > rb,
        }
        if swap {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result.@
  }
}

fn fetch_board(api_key: Str, my_id: Str) [BoardColumn]!Str {
  let viewer_id = client::string_literal(my_id)
  let query = `
    query {{
      issues(
        first: 200
        filter: {{
          assignee: {{ id: {{ eq: {viewer_id} }} }}
          state: {{ type: {{ nin: ["canceled"] }} }}
        }}
      ) {{
        nodes {{
          {issue_fields()}
        }}
      }}
    }}
    `
  let data = try client::graphql(api_key, query)
  decode_board(data)
}

fn decode_board(data: Any) [BoardColumn]!Str {
  let raw_issues = try decode::run(data, decode::path(["issues", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  let decoded_issues = mut List::new<DecodedBoardIssue>()
  for raw in raw_issues {
    let raw_state_name = try decode::run(raw, decode::path(["state", "name"], decode::string)) -> error {
      Result::err(error.to_str())
    }
    decoded_issues.push(
      DecodedBoardIssue{issue: try decode_issue(raw), raw_state_name: raw_state_name},
    )
  }
  let all_issues = decoded_issues.@

  let state_names: mut [Str] = mut []
  let state_types: mut [Str] = mut []
  let state_positions: mut [Float64] = mut []
  for decoded in all_issues {
    if not state::is_hidden_state(decoded.raw_state_name) {
      mut seen = false
      for existing in state_names {
        if existing == decoded.raw_state_name {
          seen = true
        }
      }
      if not seen {
        state_names.push(decoded.raw_state_name)
        state_types.push(decoded.issue.state_type)
        state_positions.push(decoded.issue.state_position)
      }
    }
  }

  let columns: mut [BoardColumn] = mut []
  for sname, idx in state_names {
    let is_completed = state_types.at(idx).expect("parallel list") == "completed"
    let cap = match is_completed {
      true => 10,
      false => 200,
    }
    let col_issues: mut [Issue] = mut []
    mut count = 0
    for decoded in all_issues {
      if decoded.raw_state_name == sname and count < cap {
        col_issues.push(decoded.issue)
        count = count + 1
      }
    }
    columns.push(
      BoardColumn{
        raw_state_name: sname,
        name: normalize_text(sname),
        state_type: state_types.at(idx).expect("parallel list"),
        position: state_positions.at(idx).expect("parallel list"),
        issues: col_issues.@,
      },
    )
  }

  Result::ok(sort_columns_by_position(columns.@))
}

fn load_comments(api_key: Str, issue_id: Str) [Comment]!Str {
  let raw_comments = try fetch_issue_comments(api_key, issue_id)
  let comments: mut [Comment] = mut []
  for raw in raw_comments {
    comments.push(try decode_comment(raw))
  }
  Result::ok(thread_comments(comments.@))
}

fn load_team_states(api_key: Str, team_id: Str) [WorkflowState]!Str {
  let raw_states = try fetch_team_states(api_key, team_id)
  let states: mut [WorkflowState] = mut []
  for raw in raw_states {
    states.push(try decode_workflow_state(raw))
  }
  Result::ok(states.@)
}

fn load_team_cycles(api_key: Str, team_id: Str) TeamCyclesResult!Str {
  fetch_team_cycles(api_key, team_id)
}

fn load_issue(api_key: Str, issue_id: Str) Issue!Str {
  let raw = try fetch_single_issue(api_key, issue_id)
  decode_issue(raw)
}

fn search(api_key: Str, term: Str) [Issue]!Str {
  let raw_issues = try fetch_issue_search(api_key, term)
  let results: mut [Issue] = mut []
  for raw in raw_issues {
    results.push(try decode_issue(raw))
  }
  Result::ok(results.@)
}

fn load(api_key: Str) [BoardColumn]!Str {
  let viewer_id = try fetch_viewer_id(api_key)
  fetch_board(api_key, viewer_id)
}

fn update_priority(api_key: Str, issue_id: Str, priority: Int) Void!Str {
  let mutation = `mutation {{ issueUpdate(id: {client::string_literal(issue_id)}, input: {{ priority: {priority} }}) {{ success }} }}`
  let data = try client::graphql(api_key, mutation)
  let success = try decode::run(data, decode::path(["issueUpdate", "success"], decode::boolean)) -> e {
    Result::err(e.to_str())
  }
  match success {
    true => Result::ok(()),
    false => Result::err("issueUpdate returned success=false"),
  }
}

// Empty assignee_id unassigns (GraphQL null).
