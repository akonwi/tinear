use ard/decode

use tinear/linear/client
use tinear/tui/decode as decode_utils
use tinear/tui/text

struct Item {
  notification_id: Str,
  notification_type: Str,
  type_label: Str,
  actor_name: Str,
  target_id: Str,
  title: Str,
}

fn format_type(n_type: Str) Str {
  match n_type {
    "issueAssignedToYou" => "assigned",
    "issueNewComment" => "commented",
    "issueCommentMention" => "mentioned",
    "issueMention" => "mentioned",
    "issueCommentReaction" => "reacted",
    "issueEmojiReaction" => "reacted",
    "issueStatusChanged" => "changed status",
    "issueThreadResolved" => "resolved",
    "issueUnassignedFromYou" => "unassigned",
    "pullRequestApproved" => "approved",
    "pullRequestChangesRequested" => "requested changes",
    "pullRequestChecksFailed" => "checks failed",
    "pullRequestComment" => "commented",
    "pullRequestCommented" => "commented",
    "pullRequestCommentMention" => "mentioned",
    "pullRequestMention" => "mentioned",
    "pullRequestReviewRequested" => "requested review",
    "pullRequestReviewRerequested" => "re-requested review",
    "pullRequestRemovedFromMergeQueue" => "removed from queue",
    _ => n_type,
  }
}

fn is_pr_type(n_type: Str) Bool {
  n_type.starts_with("pullRequest")
}

struct IdTitle {
  id: Str,
  title: Str,
}

private fn dynamic_id_and_title(notif: Dynamic, n_type: Str) IdTitle {
  match is_pr_type(n_type) {
    true => {
      let pr_obj = decode_utils::optional_field(notif, "pullRequest")
      let id = match pr_obj {
        pr => {
          let num = decode::run(pr, decode::field("number", decode::int)).expect("Missing PR number")
          "PR #{num.to_str()}"
        },
        _ => "—",
      }
      let title = match pr_obj {
        pr => decode::run(pr, decode::field("title", decode::string)).expect("Missing PR title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
    false => {
      let issue_obj = decode_utils::optional_field(notif, "issue")
      let id = match issue_obj {
        iss => {
          decode::run(iss, decode::field("identifier", decode::string)).expect("Missing issue identifier")
        },
        _ => "—",
      }
      let title = match issue_obj {
        iss => decode::run(iss, decode::field("title", decode::string)).expect("Missing issue title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
  }
}

fn decode_item(notif: Dynamic) Item {
  let notification_id = decode::run(notif, decode::field("id", decode::string)).expect("Missing notification id")
  let n_type = decode::run(notif, decode::field("type", decode::string)).expect("Missing notification type")
  let type_label = format_type(n_type)

  let actor_obj = decode_utils::optional_field(notif, "actor")
  let actor_name = match actor_obj {
    act => decode_utils::user_display_name(act),
    _ => "—",
  }

  let info = dynamic_id_and_title(notif, n_type)
  Item{
    notification_id: notification_id,
    notification_type: n_type,
    type_label: type_label,
    actor_name: actor_name,
    target_id: info.id,
    title: info.title,
  }
}

fn fetch_inbox(api_key: Str) [Dynamic]!Str {
  let query = "query \{ notifications(first: 50) \{ nodes \{ id type createdAt title subtitle url ... on IssueNotification \{ comment \{ id body createdAt user \{ name displayName \} \} issue \{ id identifier title description priority state \{ name \} team \{ name key \} project \{ name \} assignee \{ name displayName \} comments(first: 30) \{ nodes \{ id body createdAt user \{ name displayName \} \} \} history(first: 10) \{ nodes \{ id createdAt fromState \{ name \} toState \{ name \} \} \} \} \} ... on PullRequestNotification \{ pullRequestCommentId pullRequest \{ id number title url status sourceBranch targetBranch openedAt creator \{ name displayName \} \} \} actor \{ id name displayName \} \} \} \}"
  let data = try client::graphql(api_key, query)
  let nodes = decode::run(
    data,
    decode::path(["notifications", "nodes"], decode::list(decode::dynamic)),
  ).expect("Missing notifications nodes")
  Result::ok(nodes)
}

fn fetch_notification_detail(api_key: Str, notification_id: Str) Dynamic!Str {
  let query = "query \{ notification(id: \"{notification_id}\") \{ id type createdAt title subtitle url ... on IssueNotification \{ comment \{ id body createdAt user \{ name displayName \} \} issue \{ id identifier title url description priority state \{ name \} team \{ name key \} project \{ name \} assignee \{ name displayName \} comments(first: 30) \{ nodes \{ id body createdAt user \{ name displayName \} \} \} history(first: 10) \{ nodes \{ id createdAt fromState \{ name \} toState \{ name \} \} \} \} \} ... on PullRequestNotification \{ pullRequestCommentId pullRequest \{ id number title url status sourceBranch targetBranch openedAt creator \{ name displayName \} \} \} actor \{ id name displayName \} \} \}"
  let data = try client::graphql(api_key, query)
  let notification = decode::run(data, decode::field("notification", decode::dynamic)).expect("Missing notification")
  Result::ok(notification)
}

fn archive_notification(api_key: Str, id: Str) Void!Str {
  let mutation = "mutation \{ notificationArchive(id: \"{id}\") \{ success \} \}"
  let _ = try client::graphql(api_key, mutation)
  Result::ok(())
}

fn load(api_key: Str) [Item]!Str {
  let nodes = try fetch_inbox(api_key)
  mut items: [Item] = []
  for node in nodes {
    items.push(decode_item(node))
  }
  Result::ok(items)
}

fn load_detail(api_key: Str, notification_id: Str) Dynamic!Str {
  fetch_notification_detail(api_key, notification_id)
}

fn archive(api_key: Str, notification_id: Str) Void!Str {
  archive_notification(api_key, notification_id)
}

impl Item {
  fn draw(idx: Int, cursor: Int) Str {
    let cursor_mark = match idx == cursor {
      true => "▸",
      false => " ",
    }

    let id_part = text::pad_str(self.target_id, 10)
    "{cursor_mark} {id_part} {self.actor_name} {self.type_label}  {self.title}"
  }
}
