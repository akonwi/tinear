use ard/fs
use ard/json
use ard/maybe

use tinear/config

// On-disk cache of UI state we want to survive across app launches.
// Currently scoped to the logged-in shell's tab layout so the user
// reopens to whatever they last had visible (active tab + the list
// of issue tabs they had open).
//
// Issue tabs are stored as identifiers (e.g. "CCA-1234"), not full
// Issue records: when the tab mounts on restore, the issue detail
// view fetches the issue itself, so we'd just be persisting stale
// metadata if we cached the full struct.

fn version() Int { 1 }

struct LoggedInCache {
  tab_index: Int,
  issue_tabs: [Str],
}

struct DataCache {
  version: Int,
  logged_in: LoggedInCache,
}

fn empty_logged_in() LoggedInCache {
  let empty: [Str] = []
  LoggedInCache{ tab_index: 0, issue_tabs: empty }
}

fn empty() DataCache {
  DataCache{ version: version(), logged_in: empty_logged_in() }
}

fn data_path() Str!Str {
  let dir = try config::get_config_dir()
  Result::ok("{dir}/data.json")
}

// Schema-version-aware decode. Anything that doesn't match the
// current version is treated as no cache — better to start fresh
// than to load incompatible data.
fn decode(content: Str) DataCache? {
  match json::parse<DataCache>(content) {
    ok(cache) => match cache.version == version() {
      true => maybe::some(cache),
      false => maybe::none(),
    },
    err(_) => maybe::none(),
  }
}

fn encode(cache: DataCache) Str!Str {
  mut normalized = cache
  normalized.version = version()
  json::encode(normalized)
}

fn load() DataCache? {
  match data_path() {
    ok(path) => {
      match fs::read(path) {
        ok(content) => decode(content),
        err(_) => maybe::none(),
      }
    },
    err(_) => maybe::none(),
  }
}

fn save(cache: DataCache) Void!Str {
  let dir = try config::get_config_dir()
  if not fs::exists(dir) {
    try fs::create_dir(dir)
  }
  let content = try encode(cache)
  let path = try data_path()
  try fs::write(path, content)
  Result::ok(())
}

fn load_logged_in() LoggedInCache? {
  match load() {
    cache => maybe::some(cache.logged_in),
    _ => maybe::none(),
  }
}

// Persist just the logged-in slice. We don't currently have any
// other slices in the cache, but the wrapper keeps the door open
// for inbox / board state without breaking the file format.
fn save_logged_in(logged_in: LoggedInCache) Void!Str {
  mut cache = match load() {
    existing => existing,
    _ => empty(),
  }
  cache.logged_in = logged_in
  save(cache)
}
