use decode
use go:encoding/json
use go:os
use tinear/config
use tinear/models/tabs

// On-disk cache of UI state we want to survive across app launches.
// Currently scoped to the logged-in shell's tab layout so the user
// reopens to whatever they last had visible (active tab + the list
// of issue tabs they had open).
//
// Tabs are stored as TabRef identities (kind + id + label), not full
// records: when a tab mounts on restore, the detail view fetches its
// content itself, so we'd just be persisting stale metadata if we
// cached full structs. Kind is persisted as a stable string label,
// not the enum's numeric value.

fn version() Int {
  2
}

struct LoggedInCache {
  tab_index: Int,
  tabs: [tabs::TabRef],
}

struct DataCache {
  version: Int,
  logged_in: LoggedInCache,
}

fn empty_logged_in() LoggedInCache {
  let empty: [tabs::TabRef] = []
  LoggedInCache{tab_index: 0, tabs: empty}
}

fn empty() DataCache {
  DataCache{version: version(), logged_in: empty_logged_in()}
}

fn data_path() Str!Str {
  let dir = try config::get_config_dir()
  Result::ok("{dir}/data.json")
}

// Schema-version-aware decode. Anything that doesn't match the
// current version is treated as no cache — better to start fresh
// than to load incompatible data.
fn decode(content: Str) DataCache? {
  match parse(content) {
    ok(cache) => {
      match cache.version == version() {
        true => Maybe::new(cache),
        false => Maybe::new(),
      }
    },
    err(_) => Maybe::new(),
  }
}

// Serialized shape: TabRef.kind is written as its stable string label
// ("issue" / "doc"), never the enum's numeric value.
private struct TabRefDto {
  kind: Str,
  id: Str,
  title: Str,
}

private struct LoggedInDto {
  tab_index: Int,
  tabs: [TabRefDto],
}

private struct DataDto {
  version: Int,
  logged_in: LoggedInDto,
}

private fn decode_tab_ref(raw: Any) tabs::TabRef!decode::Err {
  let kind_name = try decode::run(raw, decode::field("kind", decode::string))
  let id = try decode::run(raw, decode::field("id", decode::string))
  let title = try decode::run(raw, decode::field("title", decode::string))
  match tabs::Kind::from(kind_name) {
    kind => {
      Result::ok(
        tabs::TabRef{
          kind: kind,
          id: id,
          title: title,
        },
      )
    },
    _ => Result::err(decode::Err{expected: "a known tab kind", path: ["kind"]}),
  }
}

private fn parse(content: Str) DataCache!Str {
  decode::unmarshal(
    content,
    decode_cache,
  ).map_err(fn(e) {
    e.error()
  })
}

private fn decode_cache(data: Any) DataCache!decode::Err {
  let parsed_version = try decode::run(data, decode::field("version", decode::int))
  let tab_index = try decode::run(data, decode::path(["logged_in", "tab_index"], decode::int))
  let tab_refs = try decode::run(data, decode::path(["logged_in", "tabs"], decode::list(decode_tab_ref)))
  Result::ok(
    DataCache{version: parsed_version, logged_in: LoggedInCache{tab_index: tab_index, tabs: tab_refs}},
  )
}

fn encode(cache: DataCache) Str!Str {
  let tab_dtos: mut [TabRefDto] = mut []
  for tab in cache.logged_in.tabs {
    tab_dtos.push(
      TabRefDto{
        kind: tab.kind.to_str(),
        id: tab.id,
        title: tab.title,
      },
    )
  }
  let dto = DataDto{
    version: version(),
    logged_in: LoggedInDto{tab_index: cache.logged_in.tab_index, tabs: tab_dtos.@},
  }
  mut bytes = try json::Marshal(dto)
  Result::ok(Str::from(bytes))
}

fn load() DataCache? {
  match data_path() {
    ok(path) => {
      match os::ReadFile(path) {
        ok(bytes) => {
          mut copy = bytes
          decode(Str::from(copy))
        },
        err(_) => Maybe::new(),
      }
    },
    err(_) => Maybe::new(),
  }
}

fn save(cache: DataCache) Void!Str {
  let dir = try config::get_config_dir()
  // 0o755: rwxr-xr-x. MkdirAll is a no-op when the directory exists.
  try os::MkdirAll(dir, 493)
  let content = try encode(cache)
  let path = try data_path()
  mut bytes = content.bytes()
  // 0o644: rw-r--r--
  try os::WriteFile(path, mut bytes, 420)
  Result::ok(())
}

fn load_logged_in() LoggedInCache? {
  match load() {
    cache => Maybe::new(cache.logged_in),
    _ => Maybe::new(),
  }
}

// Persist just the logged-in slice. We don't currently have any
// other slices in the cache, but the wrapper keeps the door open
// for inbox / board state without breaking the file format.
fn save_logged_in(logged_in: LoggedInCache) Void!Str {
  let base = match load() {
    existing => existing,
    _ => empty(),
  }
  let cache = mut base
  cache.logged_in = logged_in
  save(cache.@)
}
