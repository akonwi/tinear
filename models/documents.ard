use decode
use tinear/linear/client
use tinear/models/issues

// Linear documents: fetch + decode. Documents are effectively longer
// issue bodies — `content` is plain markdown text like
// `Issue.description` — so decoding mirrors `models/issues`.

// Listing/search node: everything but the content.
struct DocMeta {
  id: Str,
  slug_id: Str,
  title: Str,
  // Owning container, if any: project name, else initiative name, else "—".
  container: Str,
  creator: Str,
  updated_at: Str,
  url: Str,
}

// Full document, fetched per tab.
struct Doc {
  meta: DocMeta,
  content: Str?,
}

fn meta_fields() Str {
  `
    id
    slugId
    title
    updatedAt
    url
    project {{ name }}
    initiative {{ name }}
    creator {{ displayName name }}
    `
}

private fn validate_document_identity(id: Str, slug_id: Str) Void!Str {
  match id.trim().is_empty() or slug_id.trim().is_empty() {
    true => Result::err("Document search identity cannot be empty"),
    false => Result::ok(()),
  }
}

fn try_decode_meta(raw: Any) DocMeta!Str {
  let project = issues::nested_str(raw, "project", "name", "")
  let initiative = issues::nested_str(raw, "initiative", "name", "")
  let container = match project.is_empty() {
    false => project,
    true => {
      match initiative.is_empty() {
        false => initiative,
        true => "—",
      }
    },
  }
  let id = try decode::run(raw, decode::field("id", decode::string)) -> error { Result::err(error.to_str()) }
  let slug_id = try decode::run(raw, decode::field("slugId", decode::string)) -> error {
    Result::err(error.to_str())
  }
  let title = try decode::run(raw, decode::field("title", decode::string)) -> error {
    Result::err(error.to_str())
  }
  try validate_document_identity(id, slug_id)
  Result::ok(
    DocMeta{
      id: id,
      slug_id: slug_id,
      title: issues::normalize_text(title),
      container: issues::normalize_text(container),
      creator: issues::normalize_text(issues::user_display_name_opt(raw, "creator")),
      updated_at: issues::optional_str(raw, "updatedAt", ""),
      url: issues::optional_str(raw, "url", ""),
    },
  )
}

fn decode_meta(raw: Any) DocMeta {
  try_decode_meta(raw).expect("Malformed document metadata")
}

fn try_decode_doc(raw: Any) Doc!Str {
  let meta = try try_decode_meta(raw)
  let content = try decode::run(raw, decode::field("content", decode::nullable(decode::string))) -> error {
    Result::err(error.to_str())
  }
  Result::ok(Doc{meta: meta, content: issues::normalize_nullable_str(content)})
}

fn decode_doc(raw: Any) Doc {
  try_decode_doc(raw).expect("Malformed document")
}

// Most recently updated documents across the workspace.
fn fetch_recent(api_key: Str, limit: Int) [DocMeta]!Str {
  let query = `query {{ documents(first: {limit}, orderBy: updatedAt) {{ nodes {{ {meta_fields()} }} }} }}`
  let data = try client::graphql(api_key, query)
  let nodes = try decode::run(data, decode::path(["documents", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  let out: mut [DocMeta] = mut []
  for node in nodes {
    out.push(try try_decode_meta(node))
  }
  Result::ok(out.@)
}

// Full-text search over documents.
fn search(api_key: Str, term: Str) [DocMeta]!Str {
  let query = `query {{ searchDocuments(term: {client::string_literal(term)}, first: 20) {{ nodes {{ {meta_fields()} }} }} }}`
  let data = try client::graphql(api_key, query)
  let nodes = try decode::run(data, decode::path(["searchDocuments", "nodes"], decode::list(decode::any))) -> error {
    Result::err(error.to_str())
  }
  let out: mut [DocMeta] = mut []
  for node in nodes {
    out.push(try try_decode_meta(node))
  }
  Result::ok(out.@)
}

// Fetch one document with content. `document(id:)` accepts the slugId.
// The id is JSON-encoded so a hand-edited cache can't break the query.
fn fetch_single(api_key: Str, slug_id: Str) Doc!Str {
  let query = `query {{ document(id: {client::string_literal(slug_id)}) {{ {meta_fields()} content }} }}`
  let data = try client::graphql(api_key, query)
  let raw = try decode::run(data, decode::field("document", decode::any)) -> error {
    Result::err(error.to_str())
  }
  try_decode_doc(raw)
}
