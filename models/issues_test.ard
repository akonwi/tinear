use ard/testing

use decode
use tinear/models/issues

fn issue_json_with_title(title: Str, description: Str) Str {
  `{{"id":"issue-1","identifier":"AKO-123","title":"{title}","description":{description},"priority":2,"state":{{"id":"state-1","name":"In Progress","type":"started","position":1.0}},"team":{{"id":"team-1","name":"Core","key":"AKO"}},"project":null,"assignee":null,"cycle":null}}`
}

fn issue_json(description: Str) Str {
  issue_json_with_title("Title â\u0080\u0094 quoted â\u0080\u009ctextâ\u0080\u009d", description)
}

test fn test_decode_issue_normalizes_mojibake_text() Void!Str {
  let raw = decode::from_json(
    issue_json(
      "\"clean completions â\u0080\u0094 no workflow code runs â\u0080\u009cinsideâ\u0080\u009dâ\u0080¦\"",
    ),
  ).expect("parse issue")
  let issue = issues::decode_issue(raw)
  
  try testing::assert(
    issue.title == "Title - quoted \"text\"",
    "title should normalize mojibake punctuation",
  )
  match issue.description {
    desc => {
      testing::assert(
        desc == "clean completions - no workflow code runs \"inside\"...",
        "description should normalize mojibake punctuation",
      )
    },
    _ => testing::assert(false, "description should be present"),
  }
}

test fn test_decode_issue_normalizes_windows_1252_mojibake_text() Void!Str {
  let raw = decode::from_json(
    issue_json_with_title(
      "Title â€” quoted â€œtextâ€�",
      "\"body â€“ with â€™ apostrophe â€¦\"",
    ),
  ).expect("parse issue")
  let issue = issues::decode_issue(raw)
  
  try testing::assert(
    issue.title == "Title - quoted \"text\"",
    "title should normalize Windows-1252 mojibake",
  )
  match issue.description {
    desc => {
      testing::assert(
        desc == "body - with ' apostrophe ...",
        "description should normalize Windows-1252 mojibake",
      )
    },
    _ => testing::assert(false, "description should be present"),
  }
}

test fn test_decode_issue_normalizes_degraded_cent_mojibake_in_description() Void!Str {
  let raw = decode::from_json(
    issue_json_with_title("Title", "\"being undeliverable ÂÂ¢ÂÂ Iterable rejected it\""),
  ).expect("parse issue")
  let issue = issues::decode_issue(raw)
  
  match issue.description {
    desc => {
      testing::assert(
        desc == "being undeliverable - Iterable rejected it",
        "degraded cent mojibake should normalize to dash regardless of padding count",
      )
    },
    _ => testing::assert(false, "description should be present"),
  }
}

test fn test_decode_issue_normalizes_bare_mojibake_dash_in_title() Void!Str {
  let raw = decode::from_json(
    issue_json_with_title("ProcessWorkflowReconciler â scheduled workflow", "null"),
  ).expect("parse issue")
  // The board query can return a degraded mojibake variant where the bytes
  // after `â` have already been stripped before rendering.
  let issue = issues::decode_issue(raw)
  
  testing::assert(
    issue.title == "ProcessWorkflowReconciler - scheduled workflow",
    "bare mojibake dash should normalize in title",
  )
}

test fn test_decode_issue_normalizes_card_metadata_fields() Void!Str {
  let raw = decode::from_json(
    "{{\"id\":\"issue-1\",\"identifier\":\"AKO-123\",\"title\":\"Title\",\"description\":null,\"priority\":2,\"state\":{{\"id\":\"state-1\",\"name\":\"In Progress â\u0080\u0094 Review\",\"type\":\"started\",\"position\":1.0}},\"team\":{{\"id\":\"team-1\",\"name\":\"Core â\u0080\u009cPlatformâ\u0080\u009d\",\"key\":\"AKO\"}},\"project\":{{\"name\":\"Auth â\u0080\u0093 Infra\"}},\"assignee\":{{\"name\":\"Jane\",\"displayName\":\"Jane â\u0080\u0099 Doe\"}},\"cycle\":{{\"id\":\"cycle-1\",\"number\":12,\"name\":\"Cycle â\u0080\u0094 12\"}}}}",
  ).expect("parse issue")
  let issue = issues::decode_issue(raw)
  
  try testing::assert(issue.state_name == "In Progress - Review", "state should normalize")
  try testing::assert(issue.team_name == "Core \"Platform\"", "team should normalize")
  try testing::assert(issue.project_name == "Auth - Infra", "project should normalize")
  try testing::assert(issue.assignee_name == "Jane ' Doe", "assignee should normalize")
  testing::assert(issue.cycle_label == "Cycle - 12", "cycle should normalize")
}

test fn test_decode_comment_normalizes_mojibake_body() Void!Str {
  let raw = decode::from_json(
    "{{\"id\":\"comment-1\",\"body\":\"one â\u0080\u0093 two â\u0080\u0099 three\",\"createdAt\":\"2026-01-02T03:04:05.000Z\",\"user\":{{\"name\":\"Jane\",\"displayName\":\"Jane\"}}}}",
  ).expect("parse comment")
  let comment = issues::decode_comment(raw)
  
  testing::assert(
    comment.body == "one - two ' three",
    "comment body should normalize mojibake punctuation",
  )
}

fn comment(id: Str, parent_id: Str) issues::Comment {
  issues::Comment{
    id: id,
    author: "a",
    created_at: "",
    body: "b",
    parent_id: parent_id,
    depth: 0,
  }
}

test fn thread_comments_groups_replies_under_parents() Void!Str {
  // Input order: c1, c2, r2 (reply to c2), r1 (reply to c1)
  let ordered = issues::thread_comments(
    [comment("c1", ""), comment("c2", ""), comment("r2", "c2"), comment("r1", "c1")],
  )
  try testing::assert(ordered.size() == 4, "all comments kept")
  try testing::assert(ordered.at(0).expect("bounds").id == "c1", "first top-level first")
  try testing::assert(ordered.at(1).expect("bounds").id == "r1", "c1's reply follows it")
  try testing::assert(ordered.at(1).expect("bounds").depth == 1, "reply gets depth 1")
  try testing::assert(ordered.at(2).expect("bounds").id == "c2", "second top-level next")
  try testing::assert(ordered.at(3).expect("bounds").id == "r2", "c2's reply last")
  testing::assert(ordered.at(0).expect("bounds").depth == 0, "top-level stays depth 0")
}

test fn thread_comments_orphan_reply_degrades_to_top_level() Void!Str {
  let ordered = issues::thread_comments([comment("r", "gone"), comment("c", "")])
  try testing::assert(ordered.size() == 2, "orphan kept")
  try testing::assert(ordered.at(0).expect("bounds").id == "r", "orphan stays in position")
  testing::assert(ordered.at(0).expect("bounds").depth == 0, "orphan renders top-level")
}

test fn thread_comments_multiple_replies_keep_order() Void!Str {
  let ordered = issues::thread_comments([comment("c", ""), comment("r1", "c"), comment("r2", "c")])
  try testing::assert(ordered.at(1).expect("bounds").id == "r1", "replies keep original order")
  testing::assert(ordered.at(2).expect("bounds").id == "r2", "replies keep original order")
}

test fn decode_comment_handles_bot_and_missing_authors() Void!Str {
  // Integration comment: user is null, botActor carries the name.
  let bot = decode::from_json(
    "{{\"id\": \"c1\", \"body\": \"synced\", \"createdAt\": \"2026-01-01\", \"parent\": null, \"user\": null, \"botActor\": {{\"name\": \"GitHub\"}}}}",
  ).expect("parse")
  try testing::assert(issues::decode_comment(bot).author == "GitHub", "bot comments use botActor name")
  
  // Deleted user: object present but empty-ish.
  let ghost = decode::from_json(
    "{{\"id\": \"c2\", \"body\": \"x\", \"createdAt\": \"2026-01-01\", \"parent\": null, \"user\": {{\"displayName\": \"\"}}, \"botActor\": null}}",
  ).expect("parse")
  try testing::assert(issues::decode_comment(ghost).author == "—", "missing names fall back to a dash")
  
  // Normal user still resolves displayName first.
  let human = decode::from_json(
    "{{\"id\": \"c3\", \"body\": \"x\", \"createdAt\": \"2026-01-01\", \"parent\": null, \"user\": {{\"name\": \"Full Name\", \"displayName\": \"shortname\"}}, \"botActor\": null}}",
  ).expect("parse")
  testing::assert(issues::decode_comment(human).author == "shortname", "displayName preferred")
}
