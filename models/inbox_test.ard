use ard/testing

use decode
use tinear/models/inbox

test fn decode_issue_notification_uses_issue_destination() Void!Str {
  let raw = try decode::from_json(
    "{{\"id\":\"notification-1\",\"type\":\"issueNewComment\",\"url\":\"https://linear.app/issue/AKO-1\",\"actor\":{{\"name\":\"Full Name\",\"displayName\":\"shortname\"}},\"issue\":{{\"identifier\":\"AKO-1\",\"title\":\"Fix login\"}}}}",
  )
  let item = try inbox::decode_item(raw)
  try testing::assert(item.target_id == "AKO-1", "issue identifier should be the destination")
  try testing::assert(item.title == "Fix login", "issue title should decode")
  try testing::assert(item.actor_name == "shortname", "display name should be preferred")
  try testing::assert(item.type_label == "commented", "notification type should be formatted")
  testing::assert(
    item.url == "https://linear.app/issue/AKO-1",
    "issue notification URL should decode",
  )
}

test fn required_notification_fields_fail_without_panicking() Void!Str {
  let missing_type = try decode::from_json("{{\"id\":\"notification-1\"}}")
  try testing::assert(inbox::decode_item(missing_type).is_err(), "missing type should fail item decode")
  testing::assert(
    inbox::decode_detail(missing_type).is_err(),
    "missing type should fail detail decode",
  )
}

test fn archive_result_requires_explicit_success() Void!Str {
  let accepted = try decode::from_json("{{\"notificationArchive\":{{\"success\":true}}}}")
  try inbox::decode_archive_result(accepted)

  let rejected = try decode::from_json("{{\"notificationArchive\":{{\"success\":false}}}}")
  try testing::assert(inbox::decode_archive_result(rejected).is_err(), "success=false should fail")

  let malformed = try decode::from_json("{{\"notificationArchive\":{{}}}}")
  testing::assert(inbox::decode_archive_result(malformed).is_err(), "missing success should fail")
}

test fn decode_pull_request_notification_prefers_provider_url() Void!Str {
  let raw = try decode::from_json(
    "{{\"id\":\"notification-2\",\"type\":\"pullRequestApproved\",\"url\":\"https://linear.app/review/2\",\"actor\":null,\"pullRequest\":{{\"number\":42,\"title\":\"Ship it\",\"url\":\"https://github.com/acme/repo/pull/42\"}}}}",
  )
  let item = try inbox::decode_item(raw)
  try testing::assert(item.target_id == "PR #42", "pull request number should be formatted")
  try testing::assert(item.actor_name == "—", "missing actor should use a dash")
  try testing::assert(item.type_label == "approved", "pull request type should be formatted")
  testing::assert(
    item.url == "https://github.com/acme/repo/pull/42",
    "provider URL should win over Linear's review URL",
  )
}
