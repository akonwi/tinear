use ard/testing

use tinear/models/cache
use tinear/models/shell
use tinear/models/tabs

private fn model(tab_index: Int, identifiers: [Str]) shell::Model {
  let references = mut List::new<tabs::TabRef>()
  for identifier in identifiers {
    references.push(tabs::issue_tab(identifier))
  }
  shell::Model{tab_index: tab_index, tabs: references.@}
}

test fn shell_clamps_tab_selection_boundaries() Void!Str {
  try testing::assert(shell::clamp_tab_index(-1, 3) == 0, "negative indexes should clamp to Inbox")
  try testing::assert(shell::clamp_tab_index(1, 3) == 1, "in-range indexes should remain unchanged")
  testing::assert(
    shell::clamp_tab_index(9, 3) == 2,
    "overflow indexes should clamp to the last tab",
  )
}

test fn shell_cycles_across_fixed_and_dynamic_tabs() Void!Str {
  try testing::assert(shell::total_tabs(model(0, ["CCA-1"])) == 3, "two fixed tabs plus one dynamic tab")
  try testing::assert(shell::cycle_next(model(2, ["CCA-1"])) == 0, "next should wrap to Inbox")
  testing::assert(
    shell::cycle_previous(model(0, ["CCA-1"])) == 2,
    "previous should wrap to last tab",
  )
}

test fn shell_opens_and_reuses_tabs_by_kind_and_id() Void!Str {
  let opened = shell::open(model(0, []), tabs::issue_tab("CCA-9"))
  try testing::assert(opened.tabs.size() == 1, "new tab should append")
  try testing::assert(opened.tab_index == 2, "new tab should be selected")
  let reused = shell::open(
    shell::open(model(0, []), tabs::issue_tab("CCA-9")),
    tabs::issue_tab("CCA-9"),
  )
  try testing::assert(reused.tabs.size() == 1, "existing tab should not duplicate")
  let distinct = shell::open(reused, tabs::doc_tab("CCA-9", "A document"))
  testing::assert(distinct.tabs.size() == 2, "same id with a different kind should be distinct")
}

test fn shell_closes_dynamic_tab_back_to_board() Void!Str {
  let closed = shell::close_current(model(3, ["CCA-9", "CCA-10"]))
  try testing::assert(closed.tabs.size() == 1, "selected tab should be removed")
  try testing::assert(closed.tabs.at(0).expect("remaining").id == "CCA-9", "other tab should remain")
  testing::assert(closed.tab_index == 1, "selection should return to My Issues")
}

test fn shell_closes_inactive_tab_without_changing_active_identity() Void!Str {
  let initial = model(4, ["CCA-9", "CCA-10", "CCA-11"])
  let closed_before = shell::close(initial, tabs::issue_tab("CCA-9"))
  try testing::assert(
    closed_before.tab_index == 3,
    "selection index should shift with the retained active tab",
  )
  try testing::assert(
    shell::selected_dynamic(closed_before).expect("active tab").id == "CCA-11",
    "closing an earlier tab should preserve the active identity",
  )
  let closed_after = shell::close(closed_before, tabs::issue_tab("CCA-10"))
  try testing::assert(closed_after.tab_index == 2, "remaining active tab should stay selected")
  testing::assert(
    shell::selected_dynamic(closed_after).expect("active tab").id == "CCA-11",
    "closing an inactive tab should not return to the board",
  )
}

test fn shell_retitle_updates_only_matching_identity() Void!Str {
  let initial = shell::open(
    shell::open(model(0, []), tabs::doc_tab("doc-1", "Loading…")),
    tabs::issue_tab("CCA-9"),
  )
  let renamed = shell::retitle(initial, tabs::doc_tab("doc-1", "ignored"), "Real title")
  try testing::assert(renamed.tabs.at(0).expect("doc").title == "Real title", "document should retitle")
  try testing::assert(renamed.tabs.at(1).expect("issue").title == "CCA-9", "issue should be untouched")
  try testing::assert(
    shell::title(renamed, tabs::doc_tab("doc-1", "probe")).or("") == "Real title",
    "title lookup should use identity",
  )
  testing::assert(
    shell::title(renamed, tabs::issue_tab("doc-1")).is_none(),
    "kind should participate in identity",
  )
}

test fn shell_restore_deduplicates_and_rejects_empty_tab_identities() Void!Str {
  let restored = shell::restore(
    cache::LoggedInCache{
      tab_index: 3,
      tabs: [tabs::issue_tab("CCA-1"), tabs::issue_tab("CCA-1"), tabs::doc_tab("", "Invalid")],
    },
  )
  try testing::assert(restored.tabs.size() == 1, "duplicate and empty identities should be removed")
  try testing::assert(restored.tabs.at(0).expect("tab").id == "CCA-1", "valid tab should remain")
  testing::assert(restored.tab_index == 2, "selection should follow the deduplicated identity")
}

test fn shell_restores_and_clamps_cached_selection() Void!Str {
  let restored = shell::restore(
    cache::LoggedInCache{tab_index: 99, tabs: [tabs::issue_tab("CCA-1")]},
  )
  try testing::assert(restored.tab_index == 2, "cached index should clamp to available tabs")
  let snapshot = shell::snapshot(restored)
  try testing::assert(snapshot.tab_index == 2, "snapshot should preserve active index")
  testing::assert(snapshot.tabs.size() == 1, "snapshot should preserve dynamic tabs")
}
