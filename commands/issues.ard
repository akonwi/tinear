use ard/io
use ard/json
use ard/decode
use ard/maybe
use linear-cli/linear/client
use linear-cli/util

fn build_filter_part(team_key: Str?, status: Str?) Str {
  let team_part = match team_key {
    key => "team: \{ key: \{ eq: \"{key}\" \} \}",
    _ => "",
  }
  let status_part = match status {
    s => "state: \{ name: \{ eq: \"{s}\" \} \}",
    _ => "",
  }

  match team_part.is_empty() and status_part.is_empty() {
    true => "",
    false => {
      let sep = match not team_part.is_empty() and not status_part.is_empty() {
        true => ", ",
        false => "",
      }
      ", filter: \{ {team_part}{sep}{status_part} \}"
    },
  }
}

fn run(args: [Str]) {
  let api_key = util::get_api_key().expect("Failed to load API key")
  let json_mode = util::has_flag(args, "--json")
  let team_filter = util::flag_value(args, "--team")
  let status_filter = util::flag_value(args, "--status")

  let filter_str = build_filter_part(team_filter, status_filter)

  let query = "query \{ issues(first: 50{filter_str}) \{ nodes \{ id identifier title state \{ name \} team \{ name key \} assignee \{ name \} priority \} \} \}"

  let data = client::graphql(api_key, query).expect("Failed to query issues")
  let nodes = decode::run(data, decode::path(["issues", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing 'issues.nodes' in response")

  if json_mode {
    io::print(json::encode(nodes).expect("encode JSON"))
  } else {
    for node in nodes {
      let identifier = decode::run(node, decode::field("identifier", decode::string)).expect("Missing 'identifier'")
      let title = decode::run(node, decode::field("title", decode::string)).expect("Missing 'title'")

      let state_obj = decode::run(node, decode::field("state", decode::nullable(decode::dynamic)))
        .expect("Missing 'state'")
      let state = match state_obj {
        s => {
          let name = decode::run(s, decode::field("name", decode::string)).expect("Missing 'state.name'")
          maybe::some(name)
        },
        _ => maybe::none(),
      }

      let assignee_obj = decode::run(node, decode::field("assignee", decode::nullable(decode::dynamic)))
        .expect("Missing 'assignee'")
      let assignee = match assignee_obj {
        a => {
          let name = decode::run(a, decode::field("name", decode::string)).expect("Missing 'assignee.name'")
          maybe::some(name)
        },
        _ => maybe::none(),
      }

      let state_str = match state {
        s => s,
        _ => "-",
      }
      let assignee_str = match assignee {
        a => a,
        _ => "-",
      }
      io::print("{identifier}  {title}  [{state_str}]  {assignee_str}")
    }
  }
}
