use ard/decode
use ard/io

use tinear/config
use tinear/linear/client

fn require_non_empty(s: Str, msg: Str) Str!Str {
  match s.is_empty() {
    false => Result::ok(s),
    true => Result::err(msg),
  }
}

fn fetch_user(api_key: Str) Dynamic!Str {
  client::graphql(api_key, "query \{ viewer \{ id name displayName email \} \}")
}

fn user_display_name(user: Dynamic) Str {
  let display_name = decode::run(
    user,
    decode::nullable(decode::field("displayName", decode::string)),
  ).expect("optional user.displayName invalid")
  match display_name {
    value => match value.is_empty() {
      true => decode::run(user, decode::field("name", decode::string)).expect("Missing user.name"),
      false => value,
    },
    _ => decode::run(user, decode::field("name", decode::string)).expect("Missing user.name"),
  }
}

fn login(api_key: Str) Dynamic!Str {
  match fetch_user(api_key) {
    ok(data) => {
      let config_path = try config::write(api_key)
      Result::ok(data)
    },
    err(e) => Result::err("Invalid API key: {e}"),
  }
}

fn run_inner(args: [Str]) Void!Str {
  io::print("Linear CLI Login")
  io::print("")
  io::print("Get your API key from Linear Settings -> API -> Personal API keys.")
  io::print("")

  io::print("Enter your API key:")
  let raw_key = try io::read_line()
  let api_key = try require_non_empty(raw_key, "API key cannot be empty")

  io::print("Validating...")

  login(
    api_key,
  ).and_then(
    fn(data) {
      let viewer = decode::run(data, decode::field("viewer", decode::dynamic)).expect("Missing viewer")
      let name = user_display_name(viewer)
      let email = decode::run(viewer, decode::field("email", decode::string)).expect("Missing email")

      io::print("")
      io::print("Logged in as {name} <{email}>")
      Result::ok(())
    },
  )
}

fn run(args: [Str]) {
  match run_inner(args) {
    ok(_) => (),
    err(e) => io::print("Error: {e}"),
  }
}
