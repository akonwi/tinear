use ard/io
use ard/json
use ard/decode
use ard/maybe
use linear-cli/linear/client
use linear-cli/util

fn require_team(opt: Str?, key: Str) Str!Str {
  match opt {
    id => Result::ok(id),
    _ => Result::err("Team with key '" + key + "' not found"),
  }
}

fn lookup_team_id(api_key: Str, key: Str) Str? {
  let data = client::graphql(
    api_key,
    "query \{ teams \{ nodes \{ id key \} \} \}",
  ).expect("Failed to query teams")

  let nodes = decode::run(data, decode::path(["teams", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing 'teams.nodes'")

  mut found: Str? = maybe::none()
  for node in nodes {
    if found.is_none() {
      let node_key = decode::run(node, decode::field("key", decode::string)).expect("Missing 'key'")
      if node_key == key {
        let node_id = decode::run(node, decode::field("id", decode::string)).expect("Missing 'id'")
        found = maybe::some(node_id)
      }
    }
  }
  found
}

fn run_inner(args: [Str]) Void!Str {
  let api_key = util::get_api_key().expect("Failed to load API key")

  let title = try util::require_opt(util::flag_value(args, "--title"), "--title is required")
  let team_key = try util::require_opt(util::flag_value(args, "--team"), "--team is required")
  let description = util::flag_value(args, "--description")

  let team_id = try require_team(lookup_team_id(api_key, team_key), team_key)

  let desc_part = match description {
    d => ", description: \"{d}\"",
    _ => "",
  }

  let mutation = "mutation \{ issueCreate(input: \{ teamId: \"{team_id}\", title: \"{title}\"{desc_part} \}) \{ success issue \{ id identifier title \} \} \}"

  let data = client::graphql(api_key, mutation).expect("Failed to create issue")
  let result = decode::run(data, decode::field("issueCreate", decode::dynamic))
    .expect("Missing 'issueCreate' in response")

  let success = decode::run(result, decode::field("success", decode::bool)).expect("Missing 'success'")
  let issue = decode::run(result, decode::field("issue", decode::dynamic)).expect("Missing 'issue'")

  match success {
    true => {
      let identifier = decode::run(issue, decode::field("identifier", decode::string)).expect("Missing 'identifier'")
      let issue_title = decode::run(issue, decode::field("title", decode::string)).expect("Missing 'title'")
      io::print("Created: {identifier} - {issue_title}")
      Result::ok(())
    },
    false => Result::err("Failed to create issue"),
  }
}

fn run(args: [Str]) {
  let usage = "Usage: linear-cli create-issue --team <key> --title <title> [--description <desc>]"
  match run_inner(args) {
    ok(_) => (),
    err(e) => {
      io::print("Error: {e}")
      io::print(usage)
    },
  }
}
