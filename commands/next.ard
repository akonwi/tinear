use ard/maybe

use tinear/tui/core/box
use tinear/tui/core/stack
use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/tui/tab_bar
use tinear/tui/welcome_screen
use tinear/util
use tinear/vaxis

// Framework demo / sketch toward a v2 UI.
//
// Renders the entire screen inside a single fullscreen Box. Inside:
// a tab bar pinned at the top, the items list filling the middle,
// and a keybinding hint bar pinned at the bottom — all expressed
// via stack::vsplit's constraint-based layout.

struct App {
  api_key: Str?,
  tabs: tab_bar::TabBar,
  welcome: welcome_screen::WelcomeScreen,
}

fn App::new(api_key: Str?) App {
  App{
    api_key: api_key,
    tabs: tab_bar::new(["Inbox", "My Issues"]),
    welcome: welcome_screen::new(),
  }
}

fn key_hints(labels: [Str]) view::View {
  mut children: [view::View] = []

  for label, idx in labels {
    if idx > 0 {
      children.push(stack::Spacer::h(2))
    }
    children.push(text::new(label))
  }

  stack::hstack(children)
}

impl App {
  fn authed_screen() view::View {
    let items = stack::vstack(
      [
        text::new("AKO-123  Fix login bug"),
        text::new("AKO-124  Add dark mode"),
        text::new("AKO-125  Update README"),
      ],
    )

    let hints = key_hints(["↑↓ select", "↵ open"])

    // Screen layout: tabs fixed at top, items fill the middle, hints
    // fixed at the bottom. A one-row spacer below the tabs gives the
    // body a bit of breathing room.
    stack::vsplit(
      [
        stack::fixed(self.tabs, 1),
        stack::fixed(stack::Spacer::v(1), 1),
        stack::fill(items, 1),
        stack::fixed(hints, 1),
      ],
    )
  }

  fn render(mut frame: view::Frame) {
    let screen = match self.api_key {
      _key => self.authed_screen(),
      _ => self.welcome,
    }

    let root = box::new(
      screen,
      style::Style{
        padding: style::Padding::x(1),
        width: frame.width(),
        height: frame.height(),
      },
    )

    root.render(frame)
  }

  fn mut handle_event(event: vaxis::Event) {
    match self.api_key {
      _key => {
        match event {
          KeyEvent(key) => self.tabs.handle_key(key),
          _ => (),
        }
      },
      _ => self.welcome.handle_event(event),
    }
  }
}

fn run() {
  let api_key = match util::get_api_key() {
    ok(key) => maybe::some(key),
    err(_) => maybe::none(),
  }
  let vx = vaxis::new("tinear next").expect("vaxis::new")

  mut app = App::new(api_key)
  mut running = true

  while running {
    mut frame = view::root(vx)
    vaxis::hide_cursor(vx)
    frame.clear()
    app.render(frame)
    frame.flush()
    let event = vaxis::next_event(vx).expect("vaxis::next_event")
    match event {
      KeyEvent(key) => {
        match key.text {
          "Ctrl+c" => { running = false },
          _ => app.handle_event(event),
        }
      },
      _ => app.handle_event(event),
    }
  }

  vaxis::close(vx).expect("vaxis::close")
}
