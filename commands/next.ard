use ard/io

use tinear/commands/login
use tinear/config
use tinear/tui/logged_in_screen
use tinear/tui/ui
use tinear/tui/welcome_screen

fn app_content(cfg: config::Config) ui::Widget {
  let initial_auth = cfg.has_auth()
  ui::stateful(fn(state: ui::State) ui::Widget {
    let authed = match state.get_bool("authed") {
      true => true,
      false => initial_auth,
    }
    let state_api_key = state.get_str("api_key")
    let api_key = match state_api_key {
      "" => cfg.api_key,
      _ => state_api_key,
    }
    match authed {
      true => logged_in_screen::new(api_key),
      false => welcome_screen::new(state, fn(api_key: Str) Bool {
        match login::login(api_key) {
          ok(_) => true,
          err(_) => false,
        }
      }),
    }
  })
}

fn root(cfg: config::Config) ui::Widget {
  let quit_intent = "tinear.quit"
  ui::actions(
    child: ui::shortcuts(
      child: ui::padding_horizontal(1, app_content(cfg)),
      bindings: [
        "q": quit_intent,
        "Ctrl+c": quit_intent,
      ],
    ),
    bindings: [
      quit_intent: fn(ctx: ui::EventContext, _intent: Str) ui::EventResult {
        ui::quit(ctx)
        ui::EventResult::handled
      },
    ],
  )
}

fn run() {
  let cfg = try config::load() -> err { io::print("Unable to load config: {err}") }
  try ui::run(root(cfg)) -> err { io::print("Unable to run next UI: {err}") }
}
