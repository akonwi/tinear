use ard/io

use tinear/config
use tinear/tui/tabbed_screen
use tinear/tui/core/box
use tinear/tui/core/style
use tinear/tui/core/view
use tinear/tui/key_debug_toast
use tinear/tui/welcome_screen
use tinear/vaxis

// Framework demo / sketch toward a v2 UI.
//
// Renders the entire screen inside a single fullscreen Box. Inside:
// a tab bar pinned at the top, the items list filling the middle,
// and a keybinding hint bar pinned at the bottom — all expressed
// via stack::vsplit's constraint-based layout.

struct App {
  vx: vaxis::Vaxis,
  config: config::Config,
  screen: mut view::View,
  key_debug: key_debug_toast::KeyDebugToast,
}

fn App::new(vx: vaxis::Vaxis, config: config::Config) App {
  mut screen: view::View = view::Empty{}
  App{
    vx: vx,
    config: config,
    screen: screen,
    key_debug: key_debug_toast::new(),
  }
}

impl App {
  fn mut init(ctx: view::Context) {
    match self.config.has_auth() {
      true => {
        self.screen = tabbed_screen::new(self.config.api_key)
        ctx.add_child(self.screen)
      },
      false => {
        self.screen = welcome_screen::new()
        ctx.add_child(self.screen)
      },
    }
  }

  fn render(mut frame: view::Frame) {
    let root_style = style::Style{
      padding: style::Padding::x(1),
      width: frame.width(),
      height: frame.height(),
    }

    box::new(self.screen, root_style).render(frame)
    self.key_debug.render(frame)
  }

  fn mut handle_event(ctx: view::Context, event: vaxis::Event) {
    mut debug_event = view::event(event)
    self.key_debug.handle_event(ctx, mut debug_event)
    ctx.dispatch_event(event)
  }
}

fn run() {
  let config = try config::load() -> err { io::print("Unable to load config: {err}") }
  let vx = vaxis::new("tinear next").expect("vaxis::new")

  mut app = App::new(vx, config)
  let ctx = view::context(vx)
  app.init(ctx)
  mut running = true

  while running {
    mut frame = view::root(ctx)
    vaxis::hide_cursor(vx)
    frame.clear()
    app.render(frame)
    frame.flush()
    let event = vaxis::next_event(vx)
    match event {
      KeyEvent(key) => {
        if key.ctrl and key.name == "c" {
          running = false
        } else {
          app.handle_event(ctx, event)
        }
      },
      RedrawEvent => {
        // fixme: shouldn't be doing this on every redraw. eventually use a specific event
        match config::load() {
          ok(cfg) => {
            let had_auth = app.config.has_auth()
            app.config = cfg
            if not had_auth and app.config.has_auth() {
              app.init(ctx)
            }
          },
          err(_) => (),
        }
      },
      _ => app.handle_event(ctx, event),
    }
  }

  vaxis::close(vx).expect("vaxis::close")
}
