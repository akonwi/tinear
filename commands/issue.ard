use ard/io
use ard/json
use ard/decode
use ard/maybe
use linear-cli/linear/client
use linear-cli/util

fn run_inner(args: [Str]) Void!Str {
  let issue_id = try util::require_opt(util::positional_arg(args), "issue ID is required")

  let api_key = util::get_api_key().expect("Failed to load API key")
  let json_mode = util::has_flag(args, "--json")

  let query = "query \{ issue(id: \"{issue_id}\") \{ id identifier title description state \{ id name type \} team \{ id name key \} project \{ id name \} assignee \{ id name email \} priority labels \{ nodes \{ name \} \} url \} \}"

  let data = client::graphql(api_key, query).expect("Failed to query issue")
  let issue = decode::run(data, decode::field("issue", decode::dynamic))
    .expect("Missing 'issue' in response")

  let identifier = decode::run(issue, decode::field("identifier", decode::string)).expect("Missing 'identifier'")
  let title = decode::run(issue, decode::field("title", decode::string)).expect("Missing 'title'")
  let desc = decode::run(issue, decode::field("description", decode::nullable(decode::string)))
    .expect("Missing 'description'")
  let state_obj = decode::run(issue, decode::field("state", decode::nullable(decode::dynamic)))
    .expect("Missing 'state'")
  let state = match state_obj {
    s => {
      let name = decode::run(s, decode::field("name", decode::string)).expect("Missing 'state.name'")
      maybe::some(name)
    },
    _ => maybe::none(),
  }

  let team_obj = decode::run(issue, decode::field("team", decode::nullable(decode::dynamic)))
    .expect("Missing 'team'")
  let team = match team_obj {
    t => {
      let name = decode::run(t, decode::field("name", decode::string)).expect("Missing 'team.name'")
      maybe::some(name)
    },
    _ => maybe::none(),
  }

  let project_obj = decode::run(issue, decode::field("project", decode::nullable(decode::dynamic)))
    .expect("Missing 'project'")
  let project = match project_obj {
    p => {
      let name = decode::run(p, decode::field("name", decode::string)).expect("Missing 'project.name'")
      maybe::some(name)
    },
    _ => maybe::none(),
  }

  let assignee_obj = decode::run(issue, decode::field("assignee", decode::nullable(decode::dynamic)))
    .expect("Missing 'assignee'")
  let assignee = match assignee_obj {
    a => {
      let name = decode::run(a, decode::field("name", decode::string)).expect("Missing 'assignee.name'")
      maybe::some(name)
    },
    _ => maybe::none(),
  }
  let priority = decode::run(issue, decode::field("priority", decode::nullable(decode::int)))
    .expect("Missing 'priority'")
  let url = decode::run(issue, decode::field("url", decode::nullable(decode::string)))
    .expect("Missing 'url'")

  let labels_obj = decode::run(issue, decode::field("labels", decode::nullable(decode::dynamic)))
    .expect("Missing 'labels'")
  let labels_dyn = match labels_obj {
    l => {
      let nodes = decode::run(l, decode::field("nodes", decode::nullable(decode::list(decode::dynamic))))
        .expect("Missing 'labels.nodes'")
      nodes
    },
    _ => maybe::none(),
  }
  let labels_str = match labels_dyn {
    nodes => {
      mut names: [Str] = []
      for n in nodes {
        let name = decode::run(n, decode::field("name", decode::string)).expect("Missing label name")
        names.push(name)
      }
      util::join_strs(names, ", ")
    },
    _ => "-",
  }

  if json_mode {
    io::print(json::encode(issue).expect("encode JSON"))
  } else {
    io::print("{identifier}: {title}")
    io::print("")

    let state_str = match state {
      s => s,
      _ => "-",
    }
    io::print("  Status:     {state_str}")
    let team_str = match team {
      t => t,
      _ => "-",
    }
    io::print("  Team:       {team_str}")
    let project_str = match project {
      p => p,
      _ => "-",
    }
    io::print("  Project:    {project_str}")
    let assignee_str = match assignee {
      a => a,
      _ => "-",
    }
    io::print("  Assignee:   {assignee_str}")
    let priority_str = match priority {
      p => p.to_str(),
      _ => "-",
    }
    io::print("  Priority:   {priority_str}")
    io::print("  Labels:     {labels_str}")
    let url_str = match url {
      u => u,
      _ => "-",
    }
    io::print("  URL:        {url_str}")

    match desc {
      d => {
        io::print("")
        io::print("  Description:")
        io::print("  {d}")
      },
      _ => (),
    }
  }

  Result::ok(())
}

fn run(args: [Str]) {
  match run_inner(args) {
    ok(_) => (),
    err(e) => io::print("Error: {e}"),
  }
}
