use ard/io
use ard/json
use ard/decode
use ard/maybe
use linear-cli/linear/client
use linear-cli/util

fn find_matching_state(states: [Dynamic], name: Str) Str!Str {
  mut found: Str? = maybe::none()
  for state in states {
    if found.is_none() {
      let state_name = decode::run(state, decode::field("name", decode::string)).expect("Missing 'name'")
      if state_name == name {
        let state_id = decode::run(state, decode::field("id", decode::string)).expect("Missing 'id'")
        found = maybe::some(state_id)
      }
    }
  }
  match found {
    id => Result::ok(id),
    _ => {
      io::print("Status '{name}' not found. Available statuses:")
      for state in states {
        let sname = decode::run(state, decode::field("name", decode::string)).expect("Missing 'name'")
        io::print("  {sname}")
      }
      Result::err("Status '{name}' not found")
    },
  }
}

fn run_inner(args: [Str]) Void!Str {
  let issue_id = try util::require_opt(util::positional_arg(args), "issue ID is required")
  let status_name = try util::require_opt(util::flag_value(args, "--status"), "--status is required")
  let api_key = util::get_api_key().expect("Failed to load API key")

  // Get the issue to find its team
  let issue_query = "query \{ issue(id: \"{issue_id}\") \{ id team \{ id \} \} \}"
  let issue_data = client::graphql(api_key, issue_query).expect("Failed to query issue")

  let issue = decode::run(issue_data, decode::field("issue", decode::dynamic))
    .expect("Issue not found")

  let team_id = decode::run(issue, decode::path(["team", "id"], decode::string))
    .expect("Missing team on issue")

  // Get the team's states
  let states_query = "query \{ team(id: \"{team_id}\") \{ states \{ nodes \{ id name \} \} \} \}"
  let states_data = client::graphql(api_key, states_query).expect("Failed to query team states")

  let state_nodes = decode::run(states_data, decode::path(["team", "states", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing team states")

  // Find the state ID by name
  let state_id = try find_matching_state(state_nodes, status_name)

  // Execute the mutation
  let mutation = "mutation \{ issueUpdate(id: \"{issue_id}\", input: \{ stateId: \"{state_id}\" \}) \{ success issue \{ id identifier \} \} \}"
  let mut_data = client::graphql(api_key, mutation).expect("Failed to update issue")

  let result = decode::run(mut_data, decode::field("issueUpdate", decode::dynamic))
    .expect("Missing 'issueUpdate' in response")

  let success = decode::run(result, decode::field("success", decode::bool))
    .expect("Missing 'success'")

  match success {
    true => {
      io::print("Updated {issue_id} -> {status_name}")
      Result::ok(())
    },
    false => Result::err("Failed to update issue status"),
  }
}

fn run(args: [Str]) {
  let usage = "Usage: linear-cli update-issue <id> --status <name>"
  match run_inner(args) {
    ok(_) => (),
    err(e) => {
      io::print("Error: {e}")
      io::print(usage)
    },
  }
}
