use tinear/tui/core/box
use tinear/tui/core/rect
use tinear/tui/core/stack
use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/tui/tab_bar
use tinear/vaxis

// Framework demo / sketch toward a v2 UI.
//
// Renders the entire screen inside a single fullscreen Box. Inside:
// a tab bar, a one-row gap, then a list of issue rows. The
// keybinding hint bar is rendered separately into a sub-frame
// pinned to the bottom row of the viewport — a deliberate
// workaround until VStack grows a flex/grow Spacer that can claim
// remaining space.
//
// Exercises Text (with styling), Box (explicit-sized), VStack,
// HStack, Spacer, and direct sub-frame composition.

fn run() {
  let vx = vaxis::new("tinear core demo").expect("vaxis::new")
  mut frame = view::root(vx)
  let term_w = frame.width()
  let term_h = frame.height()

  let tabs = tab_bar::tab_bar(["Inbox", "My Issues"], active: 0)

  let items = stack::vstack([
    text::new("AKO-123  Fix login bug"),
    text::new("AKO-124  Add dark mode"),
    text::new("AKO-125  Update README"),
  ])

  let hints = stack::hstack([
    text::new("↑↓ select"),
    text::new("  ·  "),
    text::new("↵ open"),
    text::new("  ·  "),
    text::new("q quit"),
  ])

  // Top-and-middle of the screen — laid out top-down in the Box.
  let upper = stack::vstack([
    tabs,
    stack::Spacer::v(1),
    items,
  ])

  let demo = box::new(
    upper,
    style::Style{
      padding: style::Padding::x(1),
      width: term_w,
      height: term_h,
    },
  )

  frame.clear()
  demo.render(frame)

  // Hint bar pinned to the bottom row of the viewport. Sub-frame
  // matches the Box's horizontal padding (x: 1, w: term_w - 2) so
  // the hints align with the content above.
  let hint_area = rect::Rect{x: 1, y: term_h - 1, w: term_w - 2, h: 1}
  mut hint_sub = view::sub(frame, hint_area)
  hints.render(hint_sub)

  frame.flush()

  let _ = vaxis::next_event(vx)
  vaxis::close(vx).expect("vaxis::close")
}
