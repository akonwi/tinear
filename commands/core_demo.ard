use tinear/tui/core/box
use tinear/tui/core/stack
use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/vaxis

// Framework demo / sketch toward a v2 UI.
//
// Composes the primitives currently in `tui/core/`:
//   - Text (atom)
//   - Box  (decoration wrapper with optional border / title / padding)
//   - VStack, HStack (fit-content layouts)
//
// Renders a small mock inbox panel above an HStack of keyboard
// hints. As real screens get ported, this file will gradually grow
// into the v2 entry surface rather than be deleted.

fn run() {
  let vx = vaxis::new("tinear core demo").expect("vaxis::new")

  // ---- Inbox panel ------------------------------------------------
  //
  // ┌ Inbox ──────────────────────────┐
  // │ AKO-123  Fix login bug          │
  // │ AKO-124  Add dark mode          │
  // │ AKO-125  Update README          │
  // └─────────────────────────────────┘

  let items = stack::vstack([
    text::new("AKO-123  Fix login bug"),
    text::new("AKO-124  Add dark mode"),
    text::new("AKO-125  Update README"),
  ])

  let inbox_title = box::new(
    text::new("Inbox"),
    style::Style{padding: style::Padding::x(1)},
  )

  let inbox = box::new(
    items,
    style::Style{
      border: style::BorderStyle::Single,
      padding: style::Padding::x(1),
      border_title: inbox_title,
    },
  )

  // ---- Hint bar ---------------------------------------------------
  //
  //   ↑↓ select · ↵ open · q quit

  let hints = stack::hstack([
    text::new("↑↓ select"),
    text::new("  ·  "),
    text::new("↵ open"),
    text::new("  ·  "),
    text::new("q quit"),
  ])

  // ---- Compose screen ---------------------------------------------

  let screen = stack::vstack([
    inbox,
    stack::Spacer::v(1),
    hints,
  ])

  mut frame = view::root(vx)
  frame.clear()
  screen.render(frame)
  frame.flush()

  let _ = vaxis::next_event(vx)
  vaxis::close(vx).expect("vaxis::close")
}
