use tinear/tui/core/style
use tinear/tui/core/text
use tinear/tui/core/view
use tinear/vaxis

// Temporary demo for tui/core/ Style + Text.
// TODO: remove once the framework is wired into real screens.

fn run() {
  let vx = vaxis::new("tinear core demo").expect("vaxis::new")

  // The title is itself a view — here a padded text — so its
  // breathing room around "Demo" comes from explicit padding
  // rather than baked-in spaces.
  let title = style::styled(
    text::new("Demo"),
    style::Style{padding: style::Padding::x(1)},
  )

  let demo_style = style::Style{
    border: style::BorderStyle::Single,
    padding: style::Padding::all(1),
    border_title: title,
  }

  let demo = style::styled(text::new("Hello, framework!"), demo_style)

  mut frame = view::root(vx)
  frame.clear()
  demo.render(frame)
  frame.flush()

  let _ = vaxis::next_event(vx)
  vaxis::close(vx).expect("vaxis::close")
}
