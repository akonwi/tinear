use ard/io
use ard/json
use ard/decode
use ard/maybe
use linear-cli/linear/client
use linear-cli/util

fn run(args: [Str]) {
  let api_key = util::get_api_key().expect("Failed to load API key")
  let json_mode = util::has_flag(args, "--json")

  // Get current user ID
  let viewer_data = client::graphql(
    api_key,
    "query \{ viewer \{ id \} \}",
  ).expect("Failed to query viewer")

  let my_id = decode::run(viewer_data, decode::path(["viewer", "id"], decode::string))
    .expect("Missing viewer id")

  // Query issues assigned to me that aren't completed or canceled
  let query = "query \{ issues(first: 50, filter: \{ assignee: \{ id: \{ eq: \"{my_id}\" \} \}, state: \{ type: \{ nin: [\"completed\", \"canceled\"] \} \} \}) \{ nodes \{ id identifier title state \{ name type \} team \{ name key \} project \{ name \} priority \} \} \}"

  let data = client::graphql(api_key, query).expect("Failed to query my issues")
  let nodes = decode::run(data, decode::path(["issues", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing 'issues.nodes' in response")

  if json_mode {
    io::print(json::encode(nodes).expect("encode JSON"))
  } else {
    for node in nodes {
      let identifier = decode::run(node, decode::field("identifier", decode::string)).expect("Missing 'identifier'")
      let title = decode::run(node, decode::field("title", decode::string)).expect("Missing 'title'")

      let state_obj = decode::run(node, decode::field("state", decode::nullable(decode::dynamic)))
        .expect("Missing 'state'")
      let state = match state_obj {
        s => {
          let name = decode::run(s, decode::field("name", decode::string)).expect("Missing 'state.name'")
          maybe::some(name)
        },
        _ => maybe::none(),
      }

      let team_obj = decode::run(node, decode::field("team", decode::nullable(decode::dynamic)))
        .expect("Missing 'team'")
      let team = match team_obj {
        t => {
          let name = decode::run(t, decode::field("name", decode::string)).expect("Missing 'team.name'")
          maybe::some(name)
        },
        _ => maybe::none(),
      }

      let project_obj = decode::run(node, decode::field("project", decode::nullable(decode::dynamic)))
        .expect("Missing 'project'")
      let project = match project_obj {
        p => {
          let name = decode::run(p, decode::field("name", decode::string)).expect("Missing 'project.name'")
          maybe::some(name)
        },
        _ => maybe::none(),
      }

      let state_str = match state {
        s => s,
        _ => "-",
      }
      let team_str = match team {
        t => t,
        _ => "-",
      }
      let project_str = match project {
        p => p,
        _ => "-",
      }
      io::print("{identifier}  {title}  [{state_str}]  {team_str}  {project_str}")
    }
  }
}
