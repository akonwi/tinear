use ard/io
use ard/json
use ard/decode
use linear-cli/linear/client
use linear-cli/util

fn run(args: [Str]) {
  let api_key = util::get_api_key().expect("Failed to load API key. Set it in ~/.linear-cli/config")
  let json_mode = util::has_flag(args, "--json")

  let data = client::graphql(
    api_key,
    "query \{ viewer \{ id name email \} \}",
  ).expect("Failed to query viewer")

  let viewer = decode::run(data, decode::field("viewer", decode::dynamic)).expect("Missing 'viewer' in response")
  let id = decode::run(viewer, decode::field("id", decode::string)).expect("Missing 'id' in viewer")
  let name = decode::run(viewer, decode::field("name", decode::string)).expect("Missing 'name' in viewer")
  let email = decode::run(viewer, decode::field("email", decode::string)).expect("Missing 'email' in viewer")

  if json_mode {
    let obj = Dynamic::object([
      "id": Dynamic::from_str(id),
      "name": Dynamic::from_str(name),
      "email": Dynamic::from_str(email),
    ])
    io::print(json::encode(obj).expect("encode JSON"))
  } else {
    io::print("{name} <{email}>")
  }
}
