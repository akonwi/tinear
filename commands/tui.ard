use ard/decode
use ard/list as List
use ard/maybe

use linear-cli/linear/client
use linear-cli/os
use linear-cli/util
use linear-cli/vaxis

fn truncate(s: Str, max: Int) Str {
  mut result = s
  while result.size() > max {
    result = vaxis::text_backspace(result)
  }
  result
}

fn truncate_with_ellipsis(s: Str, max: Int) Str {
  match s.size() <= max {
    true => s,
    false => truncate(s, max - 1) + "…",
  }
}

// A scrollable list-of-lines viewport with a vertical scrollbar on
// the right edge. The caller wraps content into `lines` and tracks
// `scroll` (the index of the top visible line).
//
// The rightmost column of `width` is reserved for the scrollbar even
// when no overflow is present, so the layout stays stable.
struct Scrollview {
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  lines: [Str],
  scroll: Int,
}

impl Scrollview {
  // Maximum valid scroll offset given current size of `lines`.
  fn max_scroll() Int {
    match self.lines.size() > self.height {
      true => self.lines.size() - self.height,
      false => 0,
    }
  }

  // Returns `self.scroll` clamped into [0, max_scroll()]. Used so
  // callers can set scroll to large/negative values and the renderer
  // still does the right thing.
  fn clamped_scroll() Int {
    let max = self.max_scroll()
    match self.scroll > max {
      true => max,
      false => match self.scroll < 0 {
        true => 0,
        false => self.scroll,
      },
    }
  }

  fn draw(vx: vaxis::Vaxis) {
    let scroll = self.clamped_scroll()
    let content_w = self.width - 1
    let end = match scroll + self.height > self.lines.size() {
      true => self.lines.size(),
      false => scroll + self.height,
    }
    for line, idx in self.lines {
      if idx >= scroll and idx < end {
        let display = truncate_with_ellipsis(line, content_w)
        vaxis::draw_text(vx, self.x, self.y + (idx - scroll), display)
      }
    }
    if self.lines.size() > self.height {
      let bar_x = self.x + self.width - 1
      // Track
      for r in 0..(self.height - 1) {
        vaxis::draw_text(vx, bar_x, self.y + r, "│")
      }
      // Thumb size, proportional to viewport / total.
      let total = self.lines.size()
      let raw_thumb = (self.height * self.height) / total
      let thumb_h = match raw_thumb < 1 {
        true => 1,
        false => raw_thumb,
      }
      // Thumb position, proportional to scroll / max_scroll.
      let max_thumb_pos = self.height - thumb_h
      let max_s = self.max_scroll()
      let thumb_pos = match max_s == 0 {
        true => 0,
        false => (scroll * max_thumb_pos) / max_s,
      }
      for r in 0..(thumb_h - 1) {
        vaxis::draw_text(vx, bar_x, self.y + thumb_pos + r, "█")
      }
    }
  }
}

// A list view for items rendered at a fixed height each, with a
// cursor that can be moved by the caller. Used for the issue tab's
// comments section. Items render via draw_comment (so a comment is
// header line + truncated body + blank line = 3 rows).
struct CommentListView {
  x: Int,
  y: Int,
  width: Int,
  height: Int,
  comments: [Dynamic],
  cursor: Int,
  top: Int,
}

// CommentListView impl block lives below `draw_comment` so the
// renderer can refer to it.

struct BoardColumn {
  name: Str,
  state_type: Str,
  position: Float,
  issues: [Dynamic],
}

// An open issue detail tab. Comments are fetched on-demand when the
// tab is opened (see fetch_issue_comments).
//
// Navigation model: two sections (description=0, comments=1). When
// `focused` is false, the section cursor highlights one of them and
// arrows switch between sections. When `focused` is true, arrows
// scroll/move within the focused section. Escape pops focus or
// closes the tab.
struct IssueTab {
  issue: Dynamic,
  comments: [Dynamic],
  section: Int,
  focused: Bool,
  // Persistent scroll state for the Description section. The
  // scrollview's layout and lines get refreshed each draw; only its
  // .scroll field meaningfully persists across frames.
  desc_sv: Scrollview,
  // Persistent state for the Comments section. As with desc_sv,
  // layout/comments are reset each draw; .cursor and .top persist.
  cmt_lv: CommentListView,
}

// A title wrapped to at most two lines. line2 is "" when the whole
// title fit on one line.
struct TitleLines {
  line1: Str,
  line2: Str,
}

// Modal picker for changing an issue's workflow state. While present
// on AppState.state_picker, arrow keys drive the picker and the
// underlying tab keys are blocked.
//
// `from_board = true` means the picker was opened from the board
// (cursor at columns[board_col].issues[board_row]). On confirm we
// refresh the board. Otherwise it was opened from an issue tab and
// `tab_idx` says which entry in issue_tabs to refresh.
struct StatePicker {
  issue_id: Str,
  issue_identifier: Str,
  current_state_id: Str,
  team_name: Str,
  states: [Dynamic],
  cursor: Int,
  from_board: Bool,
  tab_idx: Int,
}


struct AppState {
  api_key: Str,
  vx: vaxis::Vaxis,
  notifications: [Dynamic],
  columns: [BoardColumn],
  cursor: Int,
  comment_cursor: Int,
  board_col: Int,
  board_row: Int,
  board_scroll: Int,
  // Tabs beyond the two fixed ones (Inbox, My Issues). Each entry is
  // an open issue tab. The tab name shown in the tab bar is the
  // issue's identifier.
  issue_tabs: [IssueTab],
  viewer_name: Str,
  viewer_email: Str,

  running: Bool,
  tabs: [Str],
  active_tab: Int,
  detail_mode: Bool,
  // When set, the status picker is open and overlays everything else.
  // Closed by Esc or by confirming a selection.
  state_picker: StatePicker?,
}

fn format_type(n_type: Str) Str {
  match n_type {
    "issueAssignedToYou" => "assigned",
    "issueNewComment" => "commented",
    "issueCommentMention" => "mentioned",
    "issueMention" => "mentioned",
    "issueCommentReaction" => "reacted",
    "issueEmojiReaction" => "reacted",
    "issueStatusChanged" => "changed status",
    "issueThreadResolved" => "resolved",
    "issueUnassignedFromYou" => "unassigned",
    "pullRequestApproved" => "approved",
    "pullRequestChangesRequested" => "requested changes",
    "pullRequestChecksFailed" => "checks failed",
    "pullRequestComment" => "commented",
    "pullRequestCommented" => "commented",
    "pullRequestCommentMention" => "mentioned",
    "pullRequestMention" => "mentioned",
    "pullRequestReviewRequested" => "requested review",
    "pullRequestReviewRerequested" => "re-requested review",
    "pullRequestRemovedFromMergeQueue" => "removed from queue",
    _ => n_type,
  }
}

fn pad_str(s: Str, width: Int) Str {
  let len = s.size()
  match len >= width {
    true => s,
    false => {
      mut result = s
      let pads = width - len - 1
      for i in 0..pads {
        result =+ " "
      }
      result
    },
  }
}

// Display-width-aware padding. Uses vaxis's rendered_width which
// counts grapheme cells (not bytes), so strings containing multi-byte
// runes like — or ▸ pad correctly. Use this whenever the result is
// composed into a fixed-width slot, like a modal interior.
fn pad_str_display(vx: vaxis::Vaxis, s: Str, width: Int) Str {
  let len = vaxis::rendered_width(vx, s)
  match len >= width {
    true => s,
    false => {
      mut result = s
      let pads = width - len - 1
      for i in 0..pads {
        result =+ " "
      }
      result
    },
  }
}

// Display-width-aware truncation.
fn truncate_display(vx: vaxis::Vaxis, s: Str, max: Int) Str {
  mut result = s
  while vaxis::rendered_width(vx, result) > max {
    result = vaxis::text_backspace(result)
  }
  result
}

fn truncate_with_ellipsis_display(vx: vaxis::Vaxis, s: Str, max: Int) Str {
  match vaxis::rendered_width(vx, s) <= max {
    true => s,
    false => truncate_display(vx, s, max - 1) + "…",
  }
}


// Wraps a title onto at most two lines of `width` characters each.
// Breaks at the last word boundary inside the first line when
// possible, otherwise hard-breaks at exactly `width`. The second line
// is truncated with an ellipsis if the remainder doesn't fit.
// Wraps a single logical line (no embedded newlines) into one or more
// strings of at most `width` characters. Breaks at the last space
// within the window when possible, otherwise hard-breaks at `width`.
fn wrap_line(s: Str, width: Int) [Str] {
  mut lines: [Str] = []
  mut remainder = s
  while remainder.size() > width {
    mut last_space = -1
    mut i = 0
    for c in remainder {
      if i < width and c == " " {
        last_space = i
      }
      i = i + 1
    }
    let break_at = match last_space >= 0 {
      true => last_space,
      false => width,
    }
    let skip_break = last_space >= 0

    mut line = ""
    mut new_remainder = ""
    mut idx = 0
    for c in remainder {
      if idx < break_at {
        line = line + c
      } else if idx == break_at and skip_break {
        ()
      } else {
        new_remainder = new_remainder + c
      }
      idx = idx + 1
    }
    lines.push(line)
    remainder = new_remainder
  }
  if (not remainder.is_empty()) or lines.size() == 0 {
    lines.push(remainder)
  }
  lines
}

// Wraps multi-line text to fit within `width` columns. Preserves
// explicit newlines in the input and word-wraps each segment.
fn wrap_text(s: Str, width: Int) [Str] {
  mut segments: [Str] = []
  mut current = ""
  for c in s {
    if c == "\n" {
      segments.push(current)
      current = ""
      ()
    } else {
      current = current + c
      ()
    }
  }
  segments.push(current)

  mut out: [Str] = []
  for seg in segments {
    let lines = wrap_line(seg, width)
    for line in lines {
      out.push(line)
    }
  }
  out
}


fn wrap_title(title: Str, width: Int) TitleLines {
  match title.size() <= width {
    true => TitleLines{ line1: title, line2: "" },
    false => {
      // First pass: find the last space within [0, width) so we can
      // break at a word boundary.
      mut last_space = -1
      mut i = 0
      for c in title {
        if i < width and c == " " {
          last_space = i
        }
        i = i + 1
      }

      // Use the word boundary if we found one; otherwise hard break.
      let break_at = match last_space >= 0 {
        true => last_space,
        false => width,
      }
      let skip_break_char = last_space >= 0

      // Second pass: distribute chars between the two lines.
      mut line1 = ""
      mut line2 = ""
      mut idx = 0
      for c in title {
        if idx < break_at {
          line1 = line1 + c
        } else if idx == break_at and skip_break_char {
          // skip the breaking space
        } else {
          line2 = line2 + c
        }
        idx = idx + 1
      }

      TitleLines{
        line1: line1,
        line2: truncate_with_ellipsis(line2, width),
      }
    },
  }
}

fn first_n(s: Str, n: Int) Str {
  truncate(s, n)
}

fn format_date(iso: Str) Str {
  // "2026-05-26T20:17:01.313Z" -> "2026-05-26"
  first_n(iso, 10)
}

fn term_height(vx: vaxis::Vaxis) Int {
  let win = vaxis::root(vx)
  vaxis::window_height(win)
}

fn status_bar_y(vx: vaxis::Vaxis) Int {
  let h = term_height(vx)
  h - 1
}

fn content_height(vx: vaxis::Vaxis) Int {
  term_height(vx) - 4
}

// Archive (delete from inbox) a single notification.
fn archive_notification(api_key: Str, id: Str) Void!Str {
  let mutation = "mutation \{ notificationArchive(id: \"{id}\") \{ success \} \}"
  let _ = try client::graphql(api_key, mutation)
  Result::ok(())
}

// Workflow rank for a Linear state type. Lower is earlier in the flow.
// We sort columns primarily by this so cross-team merged states land
// in a predictable order regardless of which team's position came
// first.
fn state_type_rank(state_type: Str) Int {
  match state_type {
    "triage" => 0,
    "backlog" => 1,
    "unstarted" => 2,
    "started" => 3,
    "completed" => 4,
    _ => 5,
  }
}

// Sort board columns by workflow type, then by position within type.
fn sort_columns_by_position(cols: [BoardColumn]) [BoardColumn] {
  let n = cols.size()
  if n < 2 {
    cols
  } else {
    mut result = cols
    // Bubble sort — fine for the handful of states a team has.
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        let ra = state_type_rank(a.state_type)
        let rb = state_type_rank(b.state_type)
        let swap = match ra == rb {
          true => a.position > b.position,
          false => ra > rb,
        }
        if swap {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

// State names to exclude from the board view. These are typically
// dead-end states whose issues shouldn't clutter the active workflow.
fn is_hidden_state(name: Str) Bool {
  name == "Duplicate"
}

// Build the board: issues assigned to me grouped by workflow state.
// Excludes canceled states. Caps `completed` columns to the first 10
// issues returned by the API.
fn fetch_board(api_key: Str, my_id: Str) [BoardColumn]!Str {
  let query = "query \{ issues(first: 200, filter: \{ assignee: \{ id: \{ eq: \"{my_id}\" \} \}, state: \{ type: \{ nin: [\"canceled\"] \} \} \}) \{ nodes \{ id identifier title description priority state \{ id name type position \} team \{ id name key \} project \{ name \} assignee \{ name \} \} \} \}"
  let data = try client::graphql(api_key, query)
  let issues = decode::run(data, decode::path(["issues", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing issues.nodes")

  // First pass: collect unique state names. Each team has its own set
  // of workflow states, but states with the same name across teams
  // (e.g. "Backlog") should share a column. Type and position come
  // from the first state encountered for that name.
  mut state_names: [Str] = []
  mut state_types: [Str] = []
  mut state_positions: [Float] = []
  for issue in issues {
    let state = decode::run(issue, decode::field("state", decode::dynamic)).expect("Missing state")
    let sname = decode::run(state, decode::field("name", decode::string)).expect("Missing state.name")
    if (not is_hidden_state(sname)) {
      mut seen = false
      for existing in state_names {
        if existing == sname {
          seen = true
        }
      }
      if (not seen) {
        state_names.push(sname)
        state_types.push(decode::run(state, decode::field("type", decode::string)).expect("Missing state.type"))
        state_positions.push(decode::run(state, decode::field("position", decode::float)).expect("Missing state.position"))
      }
    }
  }

  // Second pass: build columns, filtering issues into the right one
  // and capping completed at 10.
  mut columns: [BoardColumn] = []
  for sname, idx in state_names {
    let is_completed = state_types.at(idx) == "completed"
    let cap = match is_completed {
      true => 10,
      false => 200,
    }
    mut col_issues: [Dynamic] = []
    mut count = 0
    for issue in issues {
      let iss_name = decode::run(issue, decode::path(["state", "name"], decode::string))
        .expect("Missing state.name on issue")
      if iss_name == sname and count < cap {
        col_issues.push(issue)
        count = count + 1
      }
    }
    columns.push(BoardColumn{
      name: sname,
      state_type: state_types.at(idx),
      position: state_positions.at(idx),
      issues: col_issues,
    })
  }

  Result::ok(sort_columns_by_position(columns))
}

// Fetch comments for a specific issue by id. Returns them ordered by
// createdAt ascending (oldest first), which is how Linear's API
// returns them by default.
fn fetch_issue_comments(api_key: Str, issue_id: Str) [Dynamic]!Str {
  let query = "query \{ issue(id: \"{issue_id}\") \{ comments(first: 50) \{ nodes \{ id body createdAt user \{ name \} \} \} \} \}"
  let data = try client::graphql(api_key, query)
  let nodes = decode::run(data, decode::path(["issue", "comments", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing issue.comments.nodes")
  Result::ok(nodes)
}

// Workflow states for a team, used by the status picker.
fn fetch_team_states(api_key: Str, team_id: Str) [Dynamic]!Str {
  let query = "query \{ team(id: \"{team_id}\") \{ states \{ nodes \{ id name type position \} \} \} \}"
  let data = try client::graphql(api_key, query)
  let nodes = decode::run(data, decode::path(["team", "states", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing team.states.nodes")
  Result::ok(nodes)
}

// Mutation: move an issue to a different workflow state. Returns Ok
// when the API reported success.
fn update_issue_state(api_key: Str, issue_id: Str, state_id: Str) Void!Str {
  let mutation = "mutation \{ issueUpdate(id: \"{issue_id}\", input: \{ stateId: \"{state_id}\" \}) \{ success \} \}"
  let data = try client::graphql(api_key, mutation)
  let success = decode::run(data, decode::path(["issueUpdate", "success"], decode::bool))
    .expect("Missing issueUpdate.success")
  match success {
    true => Result::ok(()),
    false => Result::err("issueUpdate returned success=false"),
  }
}

// Refetch a single issue with the same shape as fetch_board, so the
// caller can drop the updated Dynamic into the existing UI state.
fn fetch_single_issue(api_key: Str, issue_id: Str) Dynamic!Str {
  let query = "query \{ issue(id: \"{issue_id}\") \{ id identifier title description priority state \{ id name type position \} team \{ id name key \} project \{ name \} assignee \{ name \} \} \}"
  let data = try client::graphql(api_key, query)
  let issue = decode::run(data, decode::field("issue", decode::dynamic))
    .expect("Missing issue")
  Result::ok(issue)
}

// Sort states for the picker: by workflow type rank, then position.
// Reuses state_type_rank used by the board.
fn sort_states_for_picker(states: [Dynamic]) [Dynamic] {
  let n = states.size()
  if n < 2 {
    states
  } else {
    mut result = states
    for i in 0..(n - 2) {
      for j in 0..(n - 2 - i) {
        let a = result.at(j)
        let b = result.at(j + 1)
        let ta = decode::run(a, decode::field("type", decode::string)).expect("Missing type")
        let tb = decode::run(b, decode::field("type", decode::string)).expect("Missing type")
        let pa = decode::run(a, decode::field("position", decode::float)).expect("Missing position")
        let pb = decode::run(b, decode::field("position", decode::float)).expect("Missing position")
        let ra = state_type_rank(ta)
        let rb = state_type_rank(tb)
        let swap = match ra == rb {
          true => pa > pb,
          false => ra > rb,
        }
        if swap {
          result.set(j, b)
          result.set(j + 1, a)
        }
      }
    }
    result
  }
}

// Construct a StatePicker for the given issue. Fetches the team's
// states, sorts them by workflow rank + position, and positions the
// cursor on the issue's current state.
fn open_state_picker(api_key: Str, issue: Dynamic, from_board: Bool, tab_idx: Int) StatePicker!Str {
  let issue_id = decode::run(issue, decode::field("id", decode::string)).expect("Missing id")
  let identifier = decode::run(issue, decode::field("identifier", decode::string)).expect("Missing identifier")
  let state = decode::run(issue, decode::field("state", decode::dynamic)).expect("Missing state")
  let current_state_id = decode::run(state, decode::field("id", decode::string)).expect("Missing state.id")
  let team = decode::run(issue, decode::field("team", decode::dynamic)).expect("Missing team")
  let team_id = decode::run(team, decode::field("id", decode::string)).expect("Missing team.id")
  let team_name = decode::run(team, decode::field("name", decode::string)).expect("Missing team.name")

  let raw_states = try fetch_team_states(api_key, team_id)
  let states = sort_states_for_picker(raw_states)

  // Default cursor to the current state, if it's in the list.
  mut cur = 0
  for s, i in states {
    let sid = decode::run(s, decode::field("id", decode::string)).expect("Missing id")
    if sid == current_state_id {
      cur = i
    }
  }

  Result::ok(StatePicker{
    issue_id: issue_id,
    issue_identifier: identifier,
    current_state_id: current_state_id,
    team_name: team_name,
    states: states,
    cursor: cur,
    from_board: from_board,
    tab_idx: tab_idx,
  })
}

// Reconstruct a picker with a new cursor index. Used by the input
// handler since Ard structs are immutable.
fn picker_with_cursor(p: StatePicker, c: Int) StatePicker {
  StatePicker{
    issue_id: p.issue_id,
    issue_identifier: p.issue_identifier,
    current_state_id: p.current_state_id,
    team_name: p.team_name,
    states: p.states,
    cursor: c,
    from_board: p.from_board,
    tab_idx: p.tab_idx,
  }
}

fn fetch_inbox(api_key: Str) [Dynamic]!Str {
  let query = "query \{ notifications(first: 50) \{ nodes \{ id type createdAt title subtitle url ... on IssueNotification \{ comment \{ id body createdAt user \{ name \} \} issue \{ id identifier title description priority state \{ name \} team \{ name key \} project \{ name \} assignee \{ name \} comments(first: 30) \{ nodes \{ id body createdAt user \{ name \} \} \} history(first: 10) \{ nodes \{ id createdAt fromState \{ name \} toState \{ name \} \} \} \} \} ... on PullRequestNotification \{ pullRequestCommentId pullRequest \{ id number title url status sourceBranch targetBranch openedAt creator \{ name \} \} \} actor \{ id name \} \} \} \}"
  let data = try client::graphql(api_key, query)
  let nodes = decode::run(data, decode::path(["notifications", "nodes"], decode::list(decode::dynamic)))
    .expect("Missing notifications nodes")
  Result::ok(nodes)
}

// Returns the named field as an Option<Dynamic>. Treats both a missing
// field (e.g. a GraphQL inline fragment that didn't match) and an
// explicit null value as None. Use this in place of
// `decode::field(name, decode::nullable(...))` whenever the field may
// be absent from the JSON.
fn optional_field(data: Dynamic, name: Str) Dynamic? {
  match decode::run(data, decode::field(name, decode::dynamic)) {
    ok(v) => {
      match decode::is_void(v) {
        true => maybe::none(),
        false => maybe::some(v),
      }
    },
    err(_) => maybe::none(),
  }
}

fn is_comment_type(n_type: Str) Bool {
  n_type == "issueNewComment" or n_type == "issueCommentMention" or n_type == "issueCommentReaction"
}

fn is_pr_type(n_type: Str) Bool {
  n_type.starts_with("pullRequest")
}

fn is_pr_comment_type(n_type: Str) Bool {
  n_type == "pullRequestComment" or n_type == "pullRequestCommented" or n_type == "pullRequestCommentMention"
}

struct StatusTransition {
  from: Str,
  to: Str,
}

// Find the most recent status transition from the issue's history.
// Returns empty strings if none is recorded.
fn last_status_transition(notif: Dynamic) StatusTransition {
  let issue_obj = optional_field(notif, "issue")
  let entries: [Dynamic] = match issue_obj {
    iss => {
      let nodes_res = decode::run(iss, decode::path(["history", "nodes"], decode::list(decode::dynamic)))
      match nodes_res {
        ok(nodes) => nodes,
        err(_) => {
          let empty: [Dynamic] = []
          empty
        },
      }
    },
    _ => {
      let empty: [Dynamic] = []
      empty
    },
  }

  // history(first: N) returns most-recent-first; first entry with both
  // fromState and toState is our transition.
  mut from_name = ""
  mut to_name = ""
  for entry in entries {
    if from_name.is_empty() {
      let from_obj = optional_field(entry, "fromState")
      let to_obj = optional_field(entry, "toState")
      let f = match from_obj {
        v => decode::run(v, decode::field("name", decode::string)).expect("Missing fromState.name"),
        _ => "",
      }
      let t = match to_obj {
        v => decode::run(v, decode::field("name", decode::string)).expect("Missing toState.name"),
        _ => "",
      }
      if not f.is_empty() and not t.is_empty() {
        from_name = f
        to_name = t
      }
    }
  }
  StatusTransition{from: from_name, to: to_name}
}

fn notif_comments(notif: Dynamic) [Dynamic] {
  let empty: [Dynamic] = []
  let issue_obj = optional_field(notif, "issue")
  match issue_obj {
    iss => {
      let nodes_res = decode::run(iss, decode::path(["comments", "nodes"], decode::list(decode::dynamic)))
      match nodes_res {
        ok(nodes) => nodes,
        err(_) => empty,
      }
    },
    _ => empty,
  }
}

fn trigger_comment_index(notif: Dynamic) Int {
  let trigger_obj = optional_field(notif, "comment")
  let trigger_id = match trigger_obj {
    c => decode::run(c, decode::field("id", decode::string)).expect("Missing comment id"),
    _ => "",
  }
  mut found = 0
  for c, idx in notif_comments(notif) {
    let cid = decode::run(c, decode::field("id", decode::string)).expect("Missing comment id")
    if cid == trigger_id {
      found = idx
    }
  }
  found
}

fn fetch_viewer(api_key: Str) Dynamic!Str {
  let data = try client::graphql(api_key, "query \{ viewer \{ id name email \} \}")
  let viewer = decode::run(data, decode::field("viewer", decode::dynamic)).expect("Missing viewer")
  Result::ok(viewer)
}

// Visual width of one tab label, including its surrounding spaces or
// brackets. " name " and "[name]" are both name.size() + 2 cells.
fn tab_width(name: Str) Int {
  name.size() + 2
}

fn draw_tab_bar(vx: vaxis::Vaxis, tabs: [Str], active: Int) Void {
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)

  if tabs.size() > 0 {
    // Total width if every tab were rendered starting at col 1.
    mut total = 0
    for t in tabs {
      total = total + tab_width(t)
    }

    let fits_clean = total <= term_w - 1

    // Compute the leftmost visible tab so the active one stays in view.
    // When scrolling we reserve col 0 for `‹` and col term_w-1 for `›`,
    // so usable width drops to term_w - 3.
    mut scroll = 0
    if (not fits_clean) {
      let avail = term_w - 3
      mut sum_to_active = 0
      for t, idx in tabs {
        if idx <= active {
          sum_to_active = sum_to_active + tab_width(t)
        }
      }
      mut sum = sum_to_active
      while sum > avail and scroll < active {
        sum = sum - tab_width(tabs.at(scroll))
        scroll = scroll + 1
      }
    }

    let start_x = match (not fits_clean) and scroll > 0 {
      true => 2,
      false => 1,
    }
    let max_x = match fits_clean {
      true => term_w,
      false => term_w - 1,
    }

    // Render tabs from `scroll`, stopping when the next one wouldn't fit.
    mut x = start_x
    mut last_rendered = scroll - 1
    mut n = scroll
    while n < tabs.size() {
      let t = tabs.at(n)
      let w = tab_width(t)
      if x + w > max_x {
        break
      }
      if n == active {
        vaxis::draw_text(vx, x, 0, "[" + t + "]")
      } else {
        vaxis::draw_text(vx, x, 0, " " + t + " ")
      }
      x = x + w
      last_rendered = n
      n = n + 1
    }

    // Overflow indicators.
    if (not fits_clean) and scroll > 0 {
      vaxis::draw_text(vx, 0, 0, "‹")
    }
    if (not fits_clean) and last_rendered < tabs.size() - 1 {
      vaxis::draw_text(vx, term_w - 1, 0, "›")
    }
  }

  // Separator line below the tab bar.
  mut sep = ""
  for i in 0..(term_w - 1) {
    sep =+ "─"
  }
  vaxis::draw_text(vx, 0, 1, sep)
}

fn sidebar_width(vx: vaxis::Vaxis) Int {
  let win = vaxis::root(vx)
  let w = vaxis::window_width(win)
  let s = w * 35 / 100
  match s < 28 {
    true => 28,
    false => match s > 44 {
      true => 44,
      false => s,
    },
  }
}

struct IdTitle {
  id: Str,
  title: Str,
}

// For a notification, return its display identifier and title. PR
// notifications use #<number> and PR title; issue notifications use
// the issue identifier and issue title.
fn notif_id_and_title(notif: Dynamic, n_type: Str) IdTitle {
  match is_pr_type(n_type) {
    true => {
      let pr_obj = optional_field(notif, "pullRequest")
      let id = match pr_obj {
        pr => {
          let num = decode::run(pr, decode::field("number", decode::int)).expect("Missing PR number")
          "PR #{num.to_str()}"
        },
        _ => "—",
      }
      let title = match pr_obj {
        pr => decode::run(pr, decode::field("title", decode::string)).expect("Missing PR title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
    false => {
      let issue_obj = optional_field(notif, "issue")
      let id = match issue_obj {
        iss => decode::run(iss, decode::field("identifier", decode::string)).expect("Missing issue identifier"),
        _ => "—",
      }
      let title = match issue_obj {
        iss => decode::run(iss, decode::field("title", decode::string)).expect("Missing issue title"),
        _ => "",
      }
      IdTitle{id: id, title: title}
    },
  }
}

fn draw_card_row(vx: vaxis::Vaxis, notif: Dynamic, idx: Int, cursor: Int, width: Int) Void {
  let n_type = decode::run(notif, decode::field("type", decode::string)).expect("Missing type")
  let type_label = format_type(n_type)

  let actor_obj = optional_field(notif, "actor")
  let actor_name = match actor_obj {
    act => decode::run(act, decode::field("name", decode::string)).expect("Missing actor name"),
    _ => "—",
  }

  let info = notif_id_and_title(notif, n_type)

  let cursor_mark = match idx == cursor {
    true => "▸",
    false => " ",
  }

  let id_part = pad_str(info.id, 10)
  let line = "{cursor_mark} {id_part} {actor_name} {type_label}  {info.title}"
  let row = 2 + idx
  vaxis::draw_text(vx, 1, row, truncate_with_ellipsis(line, width))
}

fn priority_label(p: Int?) Str {
  match p {
    n => {
      match n {
        1 => "Urgent",
        2 => "High",
        3 => "Medium",
        4 => "Low",
        _ => "—",
      }
    },
    _ => "—",
  }
}

// Single-character priority glyph for compact card rendering. Returns
// a space when priority is None or 0 (no priority), so all glyphs
// occupy the same visual column.
fn priority_glyph(p: Int?) Str {
  match p {
    n => {
      match n {
        1 => "!",
        2 => "↑",
        3 => "~",
        4 => "↓",
        _ => " ",
      }
    },
    _ => " ",
  }
}

fn draw_label_row(vx: vaxis::Vaxis, x: Int, y: Int, label: Str, value: Str) Void {
  vaxis::draw_text(vx, x, y, pad_str(label, 10) + value)
}
fn draw_pr_detail_panel(vx: vaxis::Vaxis, notif: Dynamic, x: Int, panel_width: Int) Void {
  let n_type = decode::run(notif, decode::field("type", decode::string)).expect("Missing type")
  let type_label = format_type(n_type)

  let actor_obj = optional_field(notif, "actor")
  let actor_name = match actor_obj {
    act => decode::run(act, decode::field("name", decode::string)).expect("Missing actor name"),
    _ => "—",
  }

  let created = decode::run(notif, decode::field("createdAt", decode::nullable(decode::string)))
    .expect("Missing createdAt")
  let created_str = match created {
    t => format_date(t),
    _ => "",
  }

  let pr_obj = optional_field(notif, "pullRequest")

  let pr_number = match pr_obj {
    pr => decode::run(pr, decode::field("number", decode::int)).expect("Missing PR number"),
    _ => 0,
  }
  let pr_title = match pr_obj {
    pr => decode::run(pr, decode::field("title", decode::string)).expect("Missing PR title"),
    _ => "",
  }
  let pr_status = match pr_obj {
    pr => decode::run(pr, decode::field("status", decode::string)).expect("Missing PR status"),
    _ => "—",
  }
  let pr_source = match pr_obj {
    pr => decode::run(pr, decode::field("sourceBranch", decode::string)).expect("Missing source branch"),
    _ => "—",
  }
  let pr_target = match pr_obj {
    pr => decode::run(pr, decode::field("targetBranch", decode::string)).expect("Missing target branch"),
    _ => "—",
  }
  let pr_opened = match pr_obj {
    pr => format_date(decode::run(pr, decode::field("openedAt", decode::string)).expect("Missing openedAt")),
    _ => "—",
  }
  let pr_creator = match pr_obj {
    pr => {
      let creator_obj = optional_field(pr, "creator")
      match creator_obj {
        c => decode::run(c, decode::field("name", decode::string)).expect("Missing creator name"),
        _ => "—",
      }
    },
    _ => "—",
  }

  // Header: PR #number — title
  let id_str = "PR #{pr_number.to_str()}"
  let header_title = truncate_with_ellipsis(pr_title, panel_width - id_str.size() - 3)
  let header = "{id_str} — {header_title}"
  vaxis::draw_text(vx, x, 2, header)

  // Separator under header
  mut sep = ""
  for i in 0..(panel_width - 1) {
    sep =+ "─"
  }
  vaxis::draw_text(vx, x, 3, sep)

  // PR details block
  draw_label_row(vx, x, 5, "Status",   pr_status)
  draw_label_row(vx, x, 6, "Branch",   "{pr_source} → {pr_target}")
  draw_label_row(vx, x, 7, "Author",   pr_creator)
  draw_label_row(vx, x, 8, "Opened",   pr_opened)

  // Latest event
  let content_y = 10
  let section_title = match is_pr_comment_type(n_type) {
    true => "Comment",
    false => "Latest event",
  }
  vaxis::draw_text(vx, x, content_y, section_title)
  mut sep2 = ""
  for i in 0..(panel_width - 1) {
    sep2 =+ "─"
  }
  vaxis::draw_text(vx, x, content_y + 1, sep2)

  vaxis::draw_text(vx, x + 2, content_y + 3, "{actor_name} · {created_str}")

  if is_pr_comment_type(n_type) {
    // Linear stores a short preview of the comment in `subtitle`.
    let subtitle = decode::run(notif, decode::field("subtitle", decode::nullable(decode::string)))
      .expect("Missing subtitle")
    let body = match subtitle {
      s => s,
      _ => "(comment body not available)",
    }
    let body_truncated = truncate_with_ellipsis(body, panel_width - 3)
    vaxis::draw_text(vx, x + 2, content_y + 5, body_truncated)
  } else {
    vaxis::draw_text(vx, x + 2, content_y + 4, type_label)
  }

}


fn draw_comment(vx: vaxis::Vaxis, comment: Dynamic, x: Int, y: Int, panel_width: Int, is_cursor: Bool, is_trigger: Bool) Int {
  let body = decode::run(comment, decode::field("body", decode::string)).expect("Missing body")
  let created = decode::run(comment, decode::field("createdAt", decode::nullable(decode::string)))
    .expect("Missing createdAt")
  let user_obj = optional_field(comment, "user")
  let user_name = match user_obj {
    u => decode::run(u, decode::field("name", decode::string)).expect("Missing user name"),
    _ => "—",
  }
  let date_str = match created {
    t => format_date(t),
    _ => "",
  }

  let cursor_mark = match is_cursor {
    true => "▸",
    false => " ",
  }
  let trigger_mark = match is_trigger {
    true => "*",
    false => " ",
  }
  let head = "{cursor_mark}{trigger_mark} {user_name} · {date_str}"
  vaxis::draw_text(vx, x, y, head)
  let body_truncated = truncate_with_ellipsis(body, panel_width - 4)
  vaxis::draw_text(vx, x + 3, y + 1, body_truncated)
  y + 3
}

impl CommentListView {
  // Fixed rows per item in the list. Header + body + blank.
  fn item_height() Int { 3 }

  // How many items can fit in the view.
  fn visible_count() Int {
    self.height / 3
  }

  // The largest valid `top` value: how far we can scroll while
  // keeping at least one item visible.
  fn max_top() Int {
    let vc = self.visible_count()
    match self.comments.size() > vc {
      true => self.comments.size() - vc,
      false => 0,
    }
  }

  // Returns `top` adjusted to keep the cursor visible, then clamped
  // into [0, max_top()]. Callers may set any value for `top`; the
  // renderer goes through this so it does the right thing.
  fn effective_top() Int {
    let vc = self.visible_count()
    let raw = match self.cursor < self.top {
      true => self.cursor,
      false => match self.cursor >= self.top + vc {
        true => self.cursor - vc + 1,
        false => self.top,
      },
    }
    let mt = self.max_top()
    match raw > mt {
      true => mt,
      false => match raw < 0 {
        true => 0,
        false => raw,
      },
    }
  }

  // Render visible comments. The `focused` flag controls whether the
  // selected comment shows its cursor marker.
  fn draw(vx: vaxis::Vaxis, focused: Bool) Void {
    if self.comments.size() == 0 {
      ()
    } else {
      let vc = self.visible_count()
      let top = self.effective_top()
      let end_excl = match top + vc > self.comments.size() {
        true => self.comments.size(),
        false => top + vc,
      }
      mut row_y = self.y
      for c, idx in self.comments {
        if idx >= top and idx < end_excl {
          let is_cursor = focused and idx == self.cursor
          draw_comment(vx, c, self.x, row_y, self.width, is_cursor, false)
          row_y = row_y + 3
        }
      }
      // Overflow indicators on the right-hand column.
      let arrow_x = self.x + self.width - 1
      if top > 0 {
        vaxis::draw_text(vx, arrow_x, self.y, "↑")
      }
      if end_excl < self.comments.size() {
        vaxis::draw_text(vx, arrow_x, self.y + self.height - 1, "↓")
      }
    }
  }
}

fn draw_detail_panel(vx: vaxis::Vaxis, notif: Dynamic, x: Int, panel_width: Int, comment_cursor: Int) Void {
  let n_type = decode::run(notif, decode::field("type", decode::string)).expect("Missing type")

  let trigger_comment_obj = optional_field(notif, "comment")
  let trigger_comment_id = match trigger_comment_obj {
    c => decode::run(c, decode::field("id", decode::string)).expect("Missing comment id"),
    _ => "",
  }

  let issue_obj = optional_field(notif, "issue")
  let issue_id = match issue_obj {
    iss => decode::run(iss, decode::field("identifier", decode::string)).expect("Missing issue identifier"),
    _ => "—",
  }
  let issue_title = match issue_obj {
    iss => decode::run(iss, decode::field("title", decode::string)).expect("Missing issue title"),
    _ => "",
  }
  let description = match issue_obj {
    iss => decode::run(iss, decode::field("description", decode::nullable(decode::string)))
      .expect("Missing description"),
    _ => maybe::none(),
  }
  let priority = match issue_obj {
    iss => decode::run(iss, decode::field("priority", decode::nullable(decode::int)))
      .expect("Missing priority"),
    _ => maybe::none(),
  }

  let state_obj = match issue_obj {
    iss => optional_field(iss, "state"),
    _ => maybe::none(),
  }
  let state_name = match state_obj {
    s => decode::run(s, decode::field("name", decode::string)).expect("Missing state name"),
    _ => "—",
  }

  let team_obj = match issue_obj {
    iss => optional_field(iss, "team"),
    _ => maybe::none(),
  }
  let team_name = match team_obj {
    t => decode::run(t, decode::field("name", decode::string)).expect("Missing team name"),
    _ => "—",
  }

  let project_obj = match issue_obj {
    iss => optional_field(iss, "project"),
    _ => maybe::none(),
  }
  let project_name = match project_obj {
    p => decode::run(p, decode::field("name", decode::string)).expect("Missing project name"),
    _ => "—",
  }

  let assignee_obj = match issue_obj {
    iss => optional_field(iss, "assignee"),
    _ => maybe::none(),
  }
  let assignee_name = match assignee_obj {
    a => decode::run(a, decode::field("name", decode::string)).expect("Missing assignee name"),
    _ => "—",
  }

  // Header: identifier — title
  let header_title = truncate_with_ellipsis(issue_title, panel_width - issue_id.size() - 3)
  let header = "{issue_id} — {header_title}"
  vaxis::draw_text(vx, x, 2, header)

  // Separator under header
  mut sep = ""
  for i in 0..(panel_width - 1) {
    sep =+ "─"
  }
  vaxis::draw_text(vx, x, 3, sep)

  // Issue details block
  draw_label_row(vx, x, 5, "Status",   state_name)
  draw_label_row(vx, x, 6, "Team",     team_name)
  draw_label_row(vx, x, 7, "Project",  project_name)
  draw_label_row(vx, x, 8, "Assignee", assignee_name)
  draw_label_row(vx, x, 9, "Priority", priority_label(priority))

  // Comments thread (for comment-type notifications) or Description
  let content_y = 11
  let max_y = status_bar_y(vx) - 1

  if is_comment_type(n_type) {
    vaxis::draw_text(vx, x, content_y, "Comments")
    mut sep2 = ""
    for i in 0..(panel_width - 1) {
      sep2 =+ "─"
    }
    vaxis::draw_text(vx, x, content_y + 1, sep2)

    let empty: [Dynamic] = []
    let comments = match issue_obj {
      iss => {
        let nodes_res = decode::run(iss, decode::path(["comments", "nodes"], decode::list(decode::dynamic)))
        match nodes_res {
          ok(nodes) => nodes,
          err(_) => empty,
        }
      },
      _ => empty,
    }

    mut y = content_y + 3
    for c, idx in comments {
      if y + 2 < max_y {
        let cid = decode::run(c, decode::field("id", decode::string)).expect("Missing comment id")
        let is_trigger = cid == trigger_comment_id
        let is_cursor = idx == comment_cursor
        y = draw_comment(vx, c, x, y, panel_width, is_cursor, is_trigger)
      }
    }
  } else if n_type == "issueStatusChanged" {
    vaxis::draw_text(vx, x, content_y, "Status change")
    mut sep3 = ""
    for i in 0..(panel_width - 1) {
      sep3 =+ "─"
    }
    vaxis::draw_text(vx, x, content_y + 1, sep3)

    let trans = last_status_transition(notif)
    if trans.from.is_empty() {
      vaxis::draw_text(vx, x + 2, content_y + 3, "(no transition recorded)")
    } else {
      vaxis::draw_text(vx, x + 2, content_y + 3, "{trans.from}  →  {trans.to}")
    }
  } else {
    match description {
      desc => {
        vaxis::draw_text(vx, x, content_y, "Description")
        let desc_truncated = truncate_with_ellipsis(desc, panel_width - 3)
        vaxis::draw_text(vx, x + 2, content_y + 1, desc_truncated)
      },
      _ => (),
    }
  }

}

// Render an issue detail tab. The issue data is what the board query
// returned; comments were fetched separately when the tab was opened.
fn draw_issue_tab(state: AppState, tab: IssueTab) Void {
  let vx = state.vx
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)
  let panel_x = 1
  let panel_width = term_w - 2
  let issue = tab.issue

  let issue_id = decode::run(issue, decode::field("identifier", decode::string)).expect("Missing identifier")
  let issue_title = decode::run(issue, decode::field("title", decode::string)).expect("Missing title")

  let description = decode::run(issue, decode::field("description", decode::nullable(decode::string)))
    .expect("Missing description")
  let priority = decode::run(issue, decode::field("priority", decode::nullable(decode::int)))
    .expect("Missing priority")

  let state_obj = optional_field(issue, "state")
  let state_name = match state_obj {
    s => decode::run(s, decode::field("name", decode::string)).expect("Missing state name"),
    _ => "—",
  }

  let team_obj = optional_field(issue, "team")
  let team_name = match team_obj {
    t => decode::run(t, decode::field("name", decode::string)).expect("Missing team name"),
    _ => "—",
  }

  let project_obj = optional_field(issue, "project")
  let project_name = match project_obj {
    p => decode::run(p, decode::field("name", decode::string)).expect("Missing project name"),
    _ => "—",
  }

  let assignee_obj = optional_field(issue, "assignee")
  let assignee_name = match assignee_obj {
    a => decode::run(a, decode::field("name", decode::string)).expect("Missing assignee name"),
    _ => "—",
  }

  // Header: identifier — title
  let header_title = truncate_with_ellipsis(issue_title, panel_width - issue_id.size() - 3)
  vaxis::draw_text(vx, panel_x, 2, "{issue_id} — {header_title}")

  // Separator under header
  mut sep = ""
  for i in 0..(panel_width - 1) {
    sep =+ "─"
  }
  vaxis::draw_text(vx, panel_x, 3, sep)

  // Issue details block
  draw_label_row(vx, panel_x, 5, "Status",   state_name)
  draw_label_row(vx, panel_x, 6, "Team",     team_name)
  draw_label_row(vx, panel_x, 7, "Project",  project_name)
  draw_label_row(vx, panel_x, 8, "Assignee", assignee_name)
  draw_label_row(vx, panel_x, 9, "Priority", priority_label(priority))

  // Sections (Description, Comments) share the space ~50/50 when both
  // are present; otherwise the present one takes the full remaining
  // area before being truncated with an ellipsis.
  let sb_y = status_bar_y(vx)
  let max_y = sb_y - 1
  let desc_start = 11
  let desc_body_start = desc_start + 2
  let available = max_y - desc_body_start
  let half = available / 2
  let max_desc_lines = match tab.comments.size() == 0 {
    true => available,
    false => match half < 4 {
      true => available,
      false => half,
    },
  }

  // ---- Description section ----
  let desc_highlighted = tab.section == 0
  let desc_focused = desc_highlighted and tab.focused
  let desc_header = match desc_highlighted {
    true => "[Description]",
    false => "Description",
  }
  let desc_underline_char = match desc_focused {
    true => "━",
    false => "─",
  }
  vaxis::draw_text(vx, panel_x, desc_start, desc_header)
  mut desc_div = ""
  for i in 0..(panel_width - 1) {
    desc_div =+ desc_underline_char
  }
  vaxis::draw_text(vx, panel_x, desc_start + 1, desc_div)

  mut next_y = desc_body_start
  match description {
    desc => {
      // Construct a fresh Scrollview per frame, populating .scroll
      // from the tab's persistent state. Key handlers update
      // tab.desc_sv.scroll directly; we read it here.
      let wrapped = wrap_text(desc, panel_width - 3)
      let init_scroll = match desc_focused {
        true => tab.desc_sv.scroll,
        false => 0,
      }
      let sv = Scrollview{
        x: panel_x + 2,
        y: desc_body_start,
        width: panel_width - 2,
        height: max_desc_lines,
        lines: wrapped,
        scroll: init_scroll,
      }
      sv.draw(vx)
      next_y = desc_body_start + max_desc_lines + 1
    },
    _ => {
      vaxis::draw_text(vx, panel_x + 2, desc_body_start, "(no description)")
      next_y = desc_body_start + 2
    },
  }

  // ---- Comments section ----
  if next_y + 2 < max_y {
    let comments_highlighted = tab.section == 1
    let comments_focused = comments_highlighted and tab.focused
    let count_label = match tab.comments.size() == 0 {
      true => "Comments (none)",
      false => "Comments ({tab.comments.size()})",
    }
    let comments_header = match comments_highlighted {
      true => "[{count_label}]",
      false => count_label,
    }
    let comments_underline_char = match comments_focused {
      true => "━",
      false => "─",
    }
    vaxis::draw_text(vx, panel_x, next_y, comments_header)
    mut cm_div = ""
    for i in 0..(panel_width - 1) {
      cm_div =+ comments_underline_char
    }
    vaxis::draw_text(vx, panel_x, next_y + 1, cm_div)

    if tab.comments.size() == 0 {
      vaxis::draw_text(vx, panel_x + 2, next_y + 3, "(no comments)")
    } else {
      // Build a fresh list view with current layout + comments, but
      // copy cursor/top from the persisted state.
      let body_y = next_y + 3
      let body_h = max_y - body_y
      let lv = CommentListView{
        x: panel_x,
        y: body_y,
        width: panel_width,
        height: body_h,
        comments: tab.comments,
        cursor: tab.cmt_lv.cursor,
        top: tab.cmt_lv.top,
      }
      lv.draw(vx, comments_focused)
    }
  }

  // Contextual status bar
  let hint = match tab.focused {
    true => match tab.section == 0 {
      true => "↑↓ scroll · g/G top/bottom · Esc back",
      false => "↑↓ comment · g/G first/last · Esc back",
    },
    false => "↑↓ section · ↵ focus · s status · Esc close tab · Tab switch",
  }
  vaxis::draw_text(vx, 1, sb_y, hint)
}

// Gap between adjacent board columns, in cells.
fn board_column_gap() Int { 3 }

// Computes the column width that best fits all `col_count` columns in
// the current terminal width. Clamped to a sane range so columns
// don't get too cramped on narrow terminals or absurdly wide on
// ultrawide ones.
fn board_column_width(vx: vaxis::Vaxis, col_count: Int) Int {
  match col_count == 0 {
    true => 30,
    false => {
      let win = vaxis::root(vx)
      let term_w = vaxis::window_width(win)
      let gap = board_column_gap()
      let left_padding = 1
      let available = term_w - left_padding
      let computed = (available - ((col_count - 1) * gap)) / col_count
      match computed < 22 {
        true => 22,
        false => match computed > 50 {
          true => 50,
          false => computed,
        },
      }
    },
  }
}

// Draws a single card in one of the board columns. Returns the y
// position where the *next* card (or divider) should start.
//
// Layout depends on title length:
//   <cursor><glyph> <identifier>
//   <indent><title-line-1>
//   <indent><title-line-2>          ← only if title wraps
//   <heavy-divider>                 ← only if not the last card
//   <blank>                         ← only if not the last card
fn draw_board_card(
  vx: vaxis::Vaxis,
  issue: Dynamic,
  x: Int,
  y: Int,
  col_w: Int,
  is_selected: Bool,
  is_last: Bool,
) Int {
  let identifier = decode::run(issue, decode::field("identifier", decode::string))
    .expect("Missing identifier")
  let title = decode::run(issue, decode::field("title", decode::string))
    .expect("Missing title")
  let priority = decode::run(issue, decode::field("priority", decode::nullable(decode::int)))
    .expect("Missing priority")

  let cursor = match is_selected {
    true => "▸",
    false => " ",
  }
  let glyph = priority_glyph(priority)

  // Line 1: "<cursor><glyph> <identifier>"  (3-char prefix before id)
  let header = "{cursor}{glyph} {identifier}"
  vaxis::draw_text(vx, x, y, truncate_with_ellipsis(header, col_w))

  // Title lines: aligned under the identifier, up to 2 lines.
  let title_indent = 3
  let title_w = col_w - title_indent
  let wrapped = wrap_title(title, title_w)
  vaxis::draw_text(vx, x + title_indent, y + 1, wrapped.line1)

  let has_line2 = not wrapped.line2.is_empty()
  if has_line2 {
    vaxis::draw_text(vx, x + title_indent, y + 2, wrapped.line2)
  }

  // Position right after the title block.
  let divider_y = match has_line2 {
    true => y + 3,
    false => y + 2,
  }

  // Divider + blank between cards (skip after the last one).
  mut next_y = divider_y
  if (not is_last) {
    mut divider = ""
    for i in 0..(col_w - 2) {
      divider =+ "━"
    }
    vaxis::draw_text(vx, x, divider_y, divider)
    next_y = divider_y + 2
  }
  next_y
}

// How many board columns fit on the current terminal width given the
// total column count. Each column takes `col_w + gap` except the last
// (which doesn't need a trailing gap).
fn board_visible_count(vx: vaxis::Vaxis, col_count: Int) Int {
  match col_count == 0 {
    true => 0,
    false => {
      let col_w = board_column_width(vx, col_count)
      let gap = board_column_gap()
      let win = vaxis::root(vx)
      let term_w = vaxis::window_width(win)
      let available = term_w - 1
      let per_col = col_w + gap
      let computed = (available + gap) / per_col
      match computed > col_count {
        true => col_count,
        false => match computed < 1 {
          true => 1,
          false => computed,
        },
      }
    },
  }
}

fn draw_board_content(state: AppState) Void {
  let vx = state.vx
  let sb_y = status_bar_y(vx)
  let content_bottom = sb_y - 1

  if state.columns.size() == 0 {
    vaxis::draw_text(vx, 1, 3, "No issues assigned to you.")
    vaxis::draw_text(vx, 1, sb_y, "Tab switch · r refresh")
  } else {
    let col_count = state.columns.size()
    let col_w = board_column_width(vx, col_count)
    let gap = board_column_gap()
    let visible_count = board_visible_count(vx, col_count)

    // Clamp scroll to a valid range in case state is stale (e.g. after
    // a resize or refresh).
    let max_scroll = match col_count > visible_count {
      true => col_count - visible_count,
      false => 0,
    }
    let scroll = match state.board_scroll > max_scroll {
      true => max_scroll,
      false => match state.board_scroll < 0 {
        true => 0,
        false => state.board_scroll,
      },
    }
    let end_excl = match scroll + visible_count > col_count {
      true => col_count,
      false => scroll + visible_count,
    }

    mut x = 1
    for col, col_idx in state.columns {
      if col_idx >= scroll and col_idx < end_excl {
        // Header: name + count, with "· last 10" for completed columns.
        let suffix = match col.state_type == "completed" {
          true => " · last 10",
          false => "",
        }
        let header = "{col.name} ({col.issues.size()}){suffix}"
        vaxis::draw_text(vx, x, 3, truncate_with_ellipsis(header, col_w))

        // Divider under header.
        mut header_div = ""
        for i in 0..(col_w - 2) {
          header_div =+ "─"
        }
        vaxis::draw_text(vx, x, 4, header_div)

        // Cards in this column.
        mut card_y = 6
        let last_idx = col.issues.size() - 1
        for issue, card_idx in col.issues {
          if card_y + 1 < content_bottom {
            let is_last = card_idx == last_idx
            let is_selected = col_idx == state.board_col and card_idx == state.board_row
            card_y = draw_board_card(vx, issue, x, card_y, col_w, is_selected, is_last)
          }
        }

        x = x + col_w + gap
      }
    }

    // Scroll indicators on the header row.
    if scroll > 0 {
      vaxis::draw_text(vx, 0, 3, "‹")
    }
    if end_excl < col_count {
      let win = vaxis::root(vx)
      let term_w = vaxis::window_width(win)
      vaxis::draw_text(vx, term_w - 1, 3, "›")
    }

    vaxis::draw_text(vx, 1, sb_y, "↑↓ · ← → · ↵ open · s status · r refresh")
  }
}

fn draw_inbox_content(state: AppState) Void {
  let vx = state.vx
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)

  if state.detail_mode {
    // Split layout: sidebar + detail
    let s_w = sidebar_width(vx)
    let divider_x = s_w + 1
    let detail_x = s_w + 3
    let detail_w = term_w - detail_x - 1

    // Sidebar: notification cards (truncated to fit)
    let max_rows = content_height(vx) - 4
    for notif, idx in state.notifications {
      if idx >= max_rows {
        break
      }
      draw_card_row(vx, notif, idx, state.cursor, s_w - 2)
    }

    // Vertical divider
    let div_y_start = 2
    let div_y_end = status_bar_y(vx) - 1
    for row in div_y_start..div_y_end {
      vaxis::draw_text(vx, divider_x, row, "│")
    }

    // Detail panel
    let selected = state.notifications.at(state.cursor)
    let sel_type = decode::run(selected, decode::field("type", decode::string)).expect("Missing type")
    if is_pr_type(sel_type) {
      draw_pr_detail_panel(vx, selected, detail_x, detail_w)
    } else {
      draw_detail_panel(vx, selected, detail_x, detail_w, state.comment_cursor)
    }

    // Status bar
    let sb_y = status_bar_y(vx)
    let hints = match is_pr_comment_type(sel_type) {
      true => "↑↓ · ↵ select · Esc back · ⌫ delete · o open · r refresh",
      false => "↑↓ · ↵ select · Esc back · ⌫ delete · r refresh",
    }
    vaxis::draw_text(vx, 1, sb_y, hints)
  } else {
    // Full-width list
    let max_rows = content_height(vx) - 4
    for notif, idx in state.notifications {
      if idx >= max_rows {
        break
      }
      draw_card_row(vx, notif, idx, state.cursor, term_w - 2)
    }

    // Status bar
    let sb_y = status_bar_y(vx)
    vaxis::draw_text(vx, 1, sb_y, "↑↓ · ↵ select · Tab · ⌫ delete · r refresh")
  }
}

// Render the status picker modal centered on screen. Drawn last so it
// sits on top of the underlying tab. The interior is filled with
// spaces so the tab content doesn't leak through.
fn draw_state_picker(vx: vaxis::Vaxis, picker: StatePicker) Void {
  let win = vaxis::root(vx)
  let term_w = vaxis::window_width(win)
  let term_h = vaxis::window_height(win)

  let w = 50
  let states_count = picker.states.size()
  // top + header + sep + states + footer + bottom
  let h = states_count + 5
  let x = (term_w - w) / 2
  let y = (term_h - h) / 2

  // Top border
  mut top = "┌"
  for i in 0..(w - 3) {
    top =+ "─"
  }
  top =+ "┐"
  vaxis::draw_text(vx, x, y, top)

  // Header row
  let header = " Status — {picker.issue_identifier} ({picker.team_name}) "
  let header_padded = pad_str_display(vx, truncate_with_ellipsis_display(vx, header, w - 2), w - 2)
  vaxis::draw_text(vx, x, y + 1, "│{header_padded}│")

  // Separator
  mut sep = "├"
  for i in 0..(w - 3) {
    sep =+ "─"
  }
  sep =+ "┤"
  vaxis::draw_text(vx, x, y + 2, sep)

  // State rows
  for s, i in picker.states {
    let sid = decode::run(s, decode::field("id", decode::string)).expect("Missing state.id")
    let sname = decode::run(s, decode::field("name", decode::string)).expect("Missing state.name")
    let cursor_mark = match i == picker.cursor {
      true => "▸",
      false => " ",
    }
    let current_suffix = match sid == picker.current_state_id {
      true => "  (current)",
      false => "",
    }
    let content = " {cursor_mark} {sname}{current_suffix}"
    let padded = pad_str_display(vx, truncate_with_ellipsis_display(vx, content, w - 2), w - 2)
    vaxis::draw_text(vx, x, y + 3 + i, "│{padded}│")
  }

  // Footer with key hints
  let footer = " ↑↓ select  ↵ confirm  Esc cancel "
  let footer_padded = pad_str_display(vx, truncate_with_ellipsis_display(vx, footer, w - 2), w - 2)
  vaxis::draw_text(vx, x, y + 3 + states_count, "│{footer_padded}│")

  // Bottom border
  mut bot = "└"
  for i in 0..(w - 3) {
    bot =+ "─"
  }
  bot =+ "┘"
  vaxis::draw_text(vx, x, y + 3 + states_count + 1, bot)
}

fn draw_screen(state: AppState) Void {
  let vx = state.vx
  vaxis::clear(vx)

  draw_tab_bar(vx, state.tabs, state.active_tab)

  if state.active_tab == 0 {
    draw_inbox_content(state)
  } else if state.active_tab == 1 {
    draw_board_content(state)
  } else {
    // Issue detail tab: active_tab - 2 indexes into issue_tabs.
    let idx = state.active_tab - 2
    if idx < state.issue_tabs.size() {
      draw_issue_tab(state, state.issue_tabs.at(idx))
    }
  }

  // Overlay the status picker on top of whatever the active tab drew.
  match state.state_picker {
    p => draw_state_picker(state.vx, p),
    _ => (),
  }

  vaxis::render(vx).expect("render")
}

fn run_loop(api_key: Str, vx: vaxis::Vaxis) Void!Str {
  let viewer = try fetch_viewer(api_key)
  let viewer_id = decode::run(viewer, decode::field("id", decode::string)).expect("Missing id")
  let name = decode::run(viewer, decode::field("name", decode::string)).expect("Missing name")
  let email = decode::run(viewer, decode::field("email", decode::string)).expect("Missing email")

  let initial_notifs = try fetch_inbox(api_key)
  // Board fetch is best-effort; if it fails we still want the inbox.
  let initial_columns: [BoardColumn] = match fetch_board(api_key, viewer_id) {
    ok(cols) => cols,
    err(_) => [],
  }
  mut notifs = initial_notifs
  mut columns = initial_columns
  mut cursor = 0
  mut comment_cursor = 0
  mut board_col = 0
  mut board_row = 0
  mut board_scroll = 0
  mut issue_tabs: [IssueTab] = []
  mut detail_mode = false
  mut active_tab = 0
  mut state_picker: StatePicker? = maybe::none()
  mut running = true

  while running {
    // Build the visible tabs list: two fixed + one per open issue tab.
    mut tabs = ["Inbox", "My Issues"]
    for it in issue_tabs {
      let id = decode::run(it.issue, decode::field("identifier", decode::string)).expect("Missing identifier")
      tabs.push(id)
    }
    let state = AppState{
      api_key: api_key,
      vx: vx,
      notifications: notifs,
      columns: columns,
      cursor: cursor,
      comment_cursor: comment_cursor,
      board_col: board_col,
      board_row: board_row,
      board_scroll: board_scroll,
      issue_tabs: issue_tabs,
      viewer_name: name,
      viewer_email: email,

      running: running,
      tabs: tabs,
      active_tab: active_tab,
      detail_mode: detail_mode,
      state_picker: state_picker,
    }
    draw_screen(state)

    let event = try vaxis::next_event(vx)

    match event {
      QuitEvent(_) => {
        running = false
      },
      ResizeEvent(_) => (),
      RedrawEvent(_) => (),
      FocusEvent(_) => (),
      PasteEvent(_) => (),
      MouseEvent(_) => (),
      KeyEvent(k) => {
        if k.ctrl and k.name == "c" {
          running = false
        } else if state_picker.is_some() {
          // PICKER MODE — intercepts everything until closed.
          match state_picker {
            picker => {
              if k.name == "Escape" {
                state_picker = maybe::none()
              } else if k.name == "Up" or k.name == "k" {
                if picker.cursor > 0 {
                  state_picker = maybe::some(picker_with_cursor(picker, picker.cursor - 1))
                }
              } else if k.name == "Down" or k.name == "j" {
                if picker.cursor < picker.states.size() - 1 {
                  state_picker = maybe::some(picker_with_cursor(picker, picker.cursor + 1))
                }
              } else if k.name == "Enter" or k.name == "Space" {
                let target = picker.states.at(picker.cursor)
                let new_state_id = decode::run(target, decode::field("id", decode::string))
                  .expect("Missing state.id")
                if new_state_id == picker.current_state_id {
                  // No change — just close.
                  state_picker = maybe::none()
                } else {
                  match update_issue_state(api_key, picker.issue_id, new_state_id) {
                    ok(_) => {
                      // Refresh whichever view triggered the picker.
                      if picker.from_board {
                        match fetch_board(api_key, viewer_id) {
                          ok(cols) => {
                            columns = cols
                            // Clamp board cursor in case the issue
                            // moved to a column at a different
                            // position.
                            if board_col >= columns.size() {
                              board_col = match columns.size() == 0 {
                                true => 0,
                                false => columns.size() - 1,
                              }
                            }
                            if columns.size() > 0 {
                              let col_size = columns.at(board_col).issues.size()
                              if board_row >= col_size {
                                board_row = match col_size == 0 {
                                  true => 0,
                                  false => col_size - 1,
                                }
                              }
                            }
                            ()
                          },
                          err(_) => (),
                        }
                      } else {
                        if picker.tab_idx < issue_tabs.size() {
                          match fetch_single_issue(api_key, picker.issue_id) {
                            ok(updated) => {
                              let tab = issue_tabs.at(picker.tab_idx)
                              issue_tabs.set(picker.tab_idx, IssueTab{
                                issue: updated,
                                comments: tab.comments,
                                section: tab.section,
                                focused: tab.focused,
                                desc_sv: tab.desc_sv,
                                cmt_lv: tab.cmt_lv,
                              })
                              ()
                            },
                            err(_) => (),
                          }
                        }
                      }
                      state_picker = maybe::none()
                      ()
                    },
                    err(_) => (),
                  }
                }
              } else {
                ()
              }
            },
            _ => (),
          }
        } else if k.name == "Tab" {
          let last = tabs.size() - 1
          if k.shift {
            active_tab = match active_tab == 0 {
              true => last,
              false => active_tab - 1,
            }
          } else {
            active_tab = match active_tab == last {
              true => 0,
              false => active_tab + 1,
            }
          }
          detail_mode = false
        } else if active_tab == 1 {
          // BOARD tab
          if k.name == "r" {
            match fetch_board(api_key, viewer_id) {
              ok(cols) => {
                columns = cols
                board_col = 0
                board_row = 0
                board_scroll = 0
                ()
              },
              err(_) => (),
            }
          } else if k.name == "Up" or k.name == "k" {
            if board_row > 0 {
              board_row = board_row - 1
            }
          } else if k.name == "Down" or k.name == "j" {
            if columns.size() > 0 {
              let col_size = columns.at(board_col).issues.size()
              if board_row < col_size - 1 {
                board_row = board_row + 1
              }
            }
          } else if k.name == "Left" or k.name == "h" {
            if board_col > 0 {
              board_col = board_col - 1
              // Clamp row to the new column's size.
              let new_size = columns.at(board_col).issues.size()
              if board_row >= new_size {
                board_row = new_size - 1
              }
              // Scroll left if cursor went off the left edge.
              if board_col < board_scroll {
                board_scroll = board_col
              }
            }
          } else if k.name == "Right" or k.name == "l" {
            if board_col < columns.size() - 1 {
              board_col = board_col + 1
              let new_size = columns.at(board_col).issues.size()
              if board_row >= new_size {
                board_row = new_size - 1
              }
              // Scroll right if cursor went off the right edge.
              let visible = board_visible_count(vx, columns.size())
              if board_col >= board_scroll + visible {
                board_scroll = board_col - visible + 1
              }
            }
          } else if k.name == "Enter" or k.name == "Space" {
            if columns.size() > 0 {
              let col = columns.at(board_col)
              if col.issues.size() > 0 {
                let selected = col.issues.at(board_row)
                let sel_id = decode::run(selected, decode::field("identifier", decode::string))
                  .expect("Missing identifier")
                let sel_uid = decode::run(selected, decode::field("id", decode::string))
                  .expect("Missing id")
                // Focus existing tab if this issue is already open.
                mut existing = -1
                for it, i in issue_tabs {
                  let tid = decode::run(it.issue, decode::field("identifier", decode::string))
                    .expect("Missing identifier")
                  if tid == sel_id and existing == -1 {
                    existing = i
                  }
                }
                if existing >= 0 {
                  active_tab = 2 + existing
                  ()
                } else {
                  // Fetch comments on demand; best-effort.
                  let comments: [Dynamic] = match fetch_issue_comments(api_key, sel_uid) {
                    ok(cs) => cs,
                    err(_) => [],
                  }
                  issue_tabs.push(IssueTab{
                    issue: selected,
                    comments: comments,
                    section: 0,
                    focused: false,
                    desc_sv: Scrollview{
                      x: 0, y: 0, width: 0, height: 0,
                      lines: [],
                      scroll: 0,
                    },
                    cmt_lv: CommentListView{
                      x: 0, y: 0, width: 0, height: 0,
                      comments: comments,
                      cursor: 0,
                      top: 0,
                    },
                  })
                  active_tab = 2 + issue_tabs.size() - 1
                  ()
                }
              }
            }
          } else if k.name == "s" {
            // Open the status picker for the selected card.
            if columns.size() > 0 {
              let col = columns.at(board_col)
              if col.issues.size() > 0 {
                let selected = col.issues.at(board_row)
                match open_state_picker(api_key, selected, true, 0) {
                  ok(p) => {
                    state_picker = maybe::some(p)
                    ()
                  },
                  err(_) => (),
                }
              }
            }
          } else {
            ()
          }
        } else if active_tab >= 2 {
          // ISSUE TAB
          let idx = active_tab - 2
          let current = issue_tabs.at(idx)
          if k.name == "Escape" {
            if current.focused {
              issue_tabs.set(idx, IssueTab{
                issue: current.issue,
                comments: current.comments,
                section: current.section,
                focused: false,
                desc_sv: current.desc_sv,
                cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
              })
              ()
            } else {
              mut remaining: [IssueTab] = []
              for it, i in issue_tabs {
                if not (i == idx) {
                  remaining.push(it)
                }
              }
              issue_tabs = remaining
              active_tab = match active_tab > 0 {
                true => active_tab - 1,
                false => 0,
              }
              ()
            }
          } else if (k.name == "Enter" or k.name == "Space") and (not current.focused) {
            issue_tabs.set(idx, IssueTab{
              issue: current.issue,
              comments: current.comments,
              section: current.section,
              focused: true,
              desc_sv: current.desc_sv,
              cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
            })
            ()
          } else if k.name == "Up" or k.name == "k" {
            if current.focused {
              if current.section == 0 {
                let new_sv = Scrollview{
                  x: current.desc_sv.x,
                  y: current.desc_sv.y,
                  width: current.desc_sv.width,
                  height: current.desc_sv.height,
                  lines: current.desc_sv.lines,
                  scroll: current.desc_sv.scroll - 1,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: new_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              } else {
                let new_cursor = match current.cmt_lv.cursor > 0 {
                  true => current.cmt_lv.cursor - 1,
                  false => 0,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: new_cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              }
            } else {
              if current.section > 0 {
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: 0,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              }
            }
          } else if k.name == "Down" or k.name == "j" {
            if current.focused {
              if current.section == 0 {
                let new_sv = Scrollview{
                  x: current.desc_sv.x,
                  y: current.desc_sv.y,
                  width: current.desc_sv.width,
                  height: current.desc_sv.height,
                  lines: current.desc_sv.lines,
                  scroll: current.desc_sv.scroll + 1,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: new_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              } else {
                let last = current.comments.size() - 1
                let new_cursor = match current.cmt_lv.cursor < last {
                  true => current.cmt_lv.cursor + 1,
                  false => last,
                }
                let clamped = match new_cursor < 0 {
                  true => 0,
                  false => new_cursor,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: clamped,
                  top: current.cmt_lv.top,
                },
                })
                ()
              }
            } else {
              if current.section < 1 {
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: 1,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              }
            }
          } else if k.name == "g" and current.focused {
            if k.shift {
              if current.section == 0 {
                let new_sv = Scrollview{
                  x: current.desc_sv.x,
                  y: current.desc_sv.y,
                  width: current.desc_sv.width,
                  height: current.desc_sv.height,
                  lines: current.desc_sv.lines,
                  scroll: 999999,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: new_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              } else {
                let last = current.comments.size() - 1
                let clamped = match last < 0 {
                  true => 0,
                  false => last,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: clamped,
                  top: current.cmt_lv.top,
                },
                })
                ()
              }
            } else {
              if current.section == 0 {
                let new_sv = Scrollview{
                  x: current.desc_sv.x,
                  y: current.desc_sv.y,
                  width: current.desc_sv.width,
                  height: current.desc_sv.height,
                  lines: current.desc_sv.lines,
                  scroll: 0,
                }
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: new_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              } else {
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: current.comments,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: 0,
                  top: 0,
                },
                })
                ()
              }
            }
          } else if k.name == "r" {
            let issue_uid = decode::run(current.issue, decode::field("id", decode::string))
              .expect("Missing id")
            match fetch_issue_comments(api_key, issue_uid) {
              ok(cs) => {
                issue_tabs.set(idx, IssueTab{
                  issue: current.issue,
                  comments: cs,
                  section: current.section,
                  focused: current.focused,
                  desc_sv: current.desc_sv,
                  cmt_lv: CommentListView{
                  x: current.cmt_lv.x,
                  y: current.cmt_lv.y,
                  width: current.cmt_lv.width,
                  height: current.cmt_lv.height,
                  comments: current.cmt_lv.comments,
                  cursor: current.cmt_lv.cursor,
                  top: current.cmt_lv.top,
                },
                })
                ()
              },
              err(_) => (),
            }
          } else if k.name == "s" and (not current.focused) {
            // Open the status picker for this tab's issue.
            match open_state_picker(api_key, current.issue, false, idx) {
              ok(p) => {
                state_picker = maybe::some(p)
                ()
              },
              err(_) => (),
            }
          } else {
            ()
          }
        } else if k.name == "r" {
          match fetch_inbox(api_key) {
            ok(nodes) => {
              notifs = nodes
              cursor = 0
              comment_cursor = 0
              detail_mode = false
              ()
            },
            err(e) => {
              ()
            },
          }
        } else if k.name == "Enter" or k.name == "Space" {
          detail_mode = true
          comment_cursor = trigger_comment_index(notifs.at(cursor))
        } else if k.name == "Escape" {
          detail_mode = false
        } else if k.name == "BackSpace" {
          if notifs.size() > 0 {
            let target = notifs.at(cursor)
            let target_id = decode::run(target, decode::field("id", decode::string))
              .expect("Missing id")
            match archive_notification(api_key, target_id) {
              ok(_) => {
                notifs = List::keep(notifs, fn(n: Dynamic) Bool {
                  let nid = decode::run(n, decode::field("id", decode::string)).expect("Missing id")
                  not (nid == target_id)
                })
                if cursor >= notifs.size() {
                  if notifs.size() > 0 {
                    cursor = notifs.size() - 1
                  } else {
                    cursor = 0
                  }
                }
                detail_mode = false
                comment_cursor = 0
              },
              err(_) => (),
            }
          }
        } else if k.name == "o" and detail_mode {
          let selected = notifs.at(cursor)
          let sel_type = decode::run(selected, decode::field("type", decode::string)).expect("Missing type")
          if is_pr_comment_type(sel_type) {
            // Build the GitHub comment permalink from the PR URL and
            // comment id, since Linear's notification.url just points
            // back to the Linear inbox.
            let pr_obj = optional_field(selected, "pullRequest")
            let pr_url = match pr_obj {
              pr => decode::run(pr, decode::field("url", decode::string)).expect("Missing PR url"),
              _ => "",
            }
            let cid_opt = decode::run(selected, decode::field("pullRequestCommentId", decode::nullable(decode::string)))
              .expect("Missing pullRequestCommentId")
            let cid = match cid_opt {
              c => c,
              _ => "",
            }
            let target = match pr_url.is_empty() {
              true => "",
              false => match cid.is_empty() {
                true => pr_url,
                false => "{pr_url}#issuecomment-{cid}",
              },
            }
            if not target.is_empty() {
              let _ = os::open_url(target)
              ()
            }
          }
        } else if k.name == "Up" or k.name == "k" {
          if detail_mode {
            if comment_cursor > 0 {
              comment_cursor = comment_cursor - 1
            }
          } else {
            if cursor > 0 {
              cursor = cursor - 1
            }
          }
        } else if k.name == "Down" or k.name == "j" {
          if detail_mode {
            let max = notif_comments(notifs.at(cursor)).size() - 1
            if comment_cursor < max {
              comment_cursor = comment_cursor + 1
            }
          } else {
            let max = notifs.size() - 1
            if cursor < max {
              cursor = cursor + 1
            }
          }
        } else {
          ()
        }
      },
    }
  }

  Result::ok(())
}

fn run(args: [Str]) {
  let api_key = util::get_api_key().expect("Failed to load API key")
  let vx = vaxis::new("Linear CLI").expect("open terminal")
  run_loop(api_key, vx).expect("run TUI")
  vaxis::close(vx).expect("close terminal")
}
