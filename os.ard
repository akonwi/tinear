use go:tinear/ffi

private fn error_message(error: Error) Str {
  error.error()
}

// OS-level utilities backed by tinear's Go FFI package (ffi/host.go).

// Open a URL. Prefers terminal-browser (app mode, split pane beside
// tinear — chromeless, keys go to the page; requires a kitty-graphics
// terminal like Ghostty) and falls back to the system's default
// browser when terminal-browser isn't installed or the spawn fails.
fn open_url(url: Str) Void!Str {
  match ffi::LookPath("terminal-browser") {
    false => open_url_system(url),
    true => {
      let args: mut [Str] = mut ["open", url, "--split", "right", "--size", "0.55"]
      // --app-mode (chromeless, keys go to the page) arrived in newer
      // terminal-browser releases; probe the help text so older
      // installs still get the plain split instead of a silent
      // unknown-option failure.
      if supports_app_mode() {
        args.push("--app-mode")
      }
      match ffi::Spawn("terminal-browser", args) {
        ok(_) => Result::ok(()),
        err(_) => open_url_system(url),
      }
    },
  }
}

private fn supports_app_mode() Bool {
  let probe_args: mut [Str] = mut ["open", "--help"]
  match ffi::CmdOutput("terminal-browser", probe_args) {
    ok(help) => help.contains("--app-mode"),
    err(_) => false,
  }
}

// Launch the system's default handler for the given URL (browser for
// http(s), file viewer for file paths, etc.). Returns immediately; does
// not wait for the launched process to exit.
fn open_url_system(url: Str) Void!Str {
  ffi::OpenURL(url).map_err(error_message)
}
