use go:encoding/json
use go:os
use tinear/decode

struct Config {
  api_key: Str,
}

impl Config {
  fn has_auth() Bool {
    not self.api_key.is_empty()
  }
}

fn get_home_dir() Str!Str {
  match os::LookupEnv("HOME") {
    h => Result::ok(h),
    _ => Result::err("HOME is not set"),
  }
}

fn get_config_dir() Str!Str {
  let home = try get_home_dir()
  Result::ok("{home}/.tinear")
}

fn get_config_path() Str!Str {
  let dir = try get_config_dir()
  Result::ok("{dir}/config.json")
}

fn write(api_key: Str) Str!Str {
  let config_dir = try get_config_dir()
  // 0o755: rwxr-xr-x. MkdirAll is a no-op when the directory exists.
  try os::MkdirAll(config_dir, 493)

  let encoded = try json::Marshal(Config{api_key: api_key})
  let config_path = try get_config_path()
  // 0o600: rw------- — the config holds an API key.
  mut content = encoded
  try os::WriteFile(config_path, content, 384)

  Result::ok(config_path)
}

// Note: errors surface via map_err + plain try instead of `try ... -> catch`
// to avoid a Result-ABI miscompile (ard#282).
private fn describe(e: decode::Error) Str {
  "invalid config: {e.to_str()}"
}

fn parse(content: Str) Config!Str {
  let data = try decode::from_json(content)
  let api_key = try decode::run(data, decode::field("api_key", decode::string)).map_err(describe)
  Result::ok(Config{api_key: api_key})
}

fn load() Config!Str {
  // Try env var first
  match os::LookupEnv("LINEAR_API_KEY") {
    key => Result::ok(Config{api_key: key}),
    _ => {
      // Fall back to config file
      let config_path = try get_config_path()
      match os::ReadFile(config_path) {
        ok(bytes) => {
          mut copy = bytes
          parse(Str::from(copy))
        },
        err(_) => Result::ok(Config{api_key: ""}),
      }
    },
  }
}
