use ard/env
use ard/fs
use ard/json
use ard/maybe

struct Config {
  api_key: Str,
}

fn get_home() Str!Str {
  match env::get("HOME") {
    h => Result::ok(h),
    _ => Result::err("HOME is not set"),
  }
}

fn load() Config!Str {
  // Try env var first
  match env::get("LINEAR_API_KEY") {
    key => Result::ok(Config{api_key: key}),
    _ => {
      // Fall back to config file
      let home = try get_home()
      let config_path = "{home}/.tinear/config"
      let content = try fs::read(config_path)
      json::parse<Config>(content)
    },
  }
}
