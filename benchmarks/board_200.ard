use cooper/event
use cooper/testing
use go:fmt
use go:time
use tinear/models/issues
use tinear/services/board_service
use tinear/tui/board_controller
use tinear/tui/issue_field_picker_controller
use tinear/tui/theme

private fn issue(column: Int, row: Int) issues::Issue {
  issues::Issue{
    id: "issue-{column}-{row}",
    identifier: "AKO-{column * 20 + row + 1}",
    title: "Representative issue title for retained board card {row}",
    description: Maybe::new<Str>(),
    priority: row % 5,
    state_id: "state-{column}",
    state_name: "State {column}",
    state_type: "started",
    state_position: 0.0,
    team_id: "team-1",
    team_name: "Core",
    team_key: "AKO",
    project_id: "project-1",
    project_name: "Tinear",
    assignee_id: "user-1",
    assignee_name: "Alex",
    cycle_id: "cycle-1",
    cycle_label: "Cycle 1",
    url: "https://linear.app/AKO-{column * 20 + row + 1}",
  }
}

private fn board_data() [issues::BoardColumn] {
  let columns = mut List::new<issues::BoardColumn>()
  mut column_index = 0
  while column_index < 10 {
    let cards = mut List::new<issues::Issue>()
    mut row = 0
    while row < 20 {
      cards.push(issue(column_index, row))
      row =+ 1
    }
    columns.push(
      issues::BoardColumn{
        name: "State {column_index}",
        state_type: "started",
        position: 0.0,
        issues: cards.@,
      },
    )
    column_index =+ 1
  }
  columns.@
}

private fn key(name: Str) mut event::KeyEvent {
  event::key(
    name,
    "",
    event::KeyEventType::press,
    event::Modifiers{
      shift: false,
      ctrl: false,
      alt: false,
      super: false,
    },
  )
}

fn main() {
  let data = board_data()
  let application = testing::new(120, 36)
  let started = time::Now()
  let controller = board_controller::new(
    application.context,
    theme::new(),
    board_service::Service{
      load: fn(cancellation: Receiver<Bool>, completion: fn([issues::BoardColumn]!Str)) {
        completion(Result::ok(data))
      },
    },
    fn(milliseconds: Int, action: fn()) fn() {
      fn() {}
    },
    fn(identifier: Str) {},
    fn(field: issue_field_picker_controller::Field, selected: issues::Issue) {},
    fn(title: Str, message: Str) {},
  )
  application.root.add(controller.root)
  controller.start()
  let construction = time::Since(started)

  let initial_started = time::Now()
  application.render()
  let initial_render = time::Since(initial_started)

  let navigation_started = time::Now()
  mut step = 0
  while step < 100 {
    let phase = step % 40
    let navigation_key = match {
      phase < 19 => "down",
      phase == 19 => "right",
      phase < 39 => "up",
      _ => "right",
    }
    let _ = controller.handle_key(key(navigation_key))
    application.render()
    step =+ 1
  }
  let navigation = time::Since(navigation_started)

  let resize_started = time::Now()
  application.resize(60, 20)
  application.render()
  let narrow_resize = time::Since(resize_started)

  mut retained_cards = 0
  for column in controller.column_records {
    retained_cards = retained_cards + column.cards.size()
  }
  fmt::Printf(
    "issues=200 columns=10 retained_cards=%d construct_us=%d initial_render_us=%d navigation_avg_us=%d narrow_resize_us=%d\n",
    retained_cards,
    construction.Microseconds(),
    initial_render.Microseconds(),
    navigation.Microseconds() / 100,
    narrow_resize.Microseconds(),
  )
  controller.dispose()
  application.destroy()
}
