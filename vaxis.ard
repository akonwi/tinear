extern type Vaxis = "*vaxis.Vaxis"
extern type Window = "vaxis.Window"

extern fn new(title: Str) Vaxis!Str = "New"

extern fn close(vx: Vaxis) Void!Str = "Close"

extern fn clear(vx: Vaxis) Void = "Clear"

extern fn render(vx: Vaxis) Void!Str = "Render"

extern fn refresh(vx: Vaxis) Void = "Refresh"

extern fn bell(vx: Vaxis) Void = "Bell"

extern fn set_title(vx: Vaxis, title: Str) Void = "SetTitle"

extern fn hide_cursor(vx: Vaxis) Void = "HideCursor"

extern fn show_cursor(vx: Vaxis, x: Int, y: Int) Void = "ShowCursor"

extern fn suspend(vx: Vaxis) Void!Str = "Suspend"

extern fn resume(vx: Vaxis) Void!Str = "Resume"

extern fn terminal_id(vx: Vaxis) Str = "TerminalID"

extern fn rendered_width(vx: Vaxis, text: Str) Int = "RenderedWidth"

extern fn can_rgb(vx: Vaxis) Bool = "CanRGB"

extern fn can_sixel(vx: Vaxis) Bool = "CanSixel"

extern fn can_kitty_graphics(vx: Vaxis) Bool = "CanKittyGraphics"

extern fn can_unicode_core(vx: Vaxis) Bool = "CanUnicodeCore"

extern fn can_display_graphics(vx: Vaxis) Bool = "CanDisplayGraphics"

extern fn notify(vx: Vaxis, title: Str, body: Str) Void = "Notify"

extern fn clipboard_push(vx: Vaxis, text: Str) Void = "ClipboardPush"

// ---- Events ---------------------------------------------------------

// Key press event. `name` is the plain key name without modifier
// prefixes, taken from vaxis.Key.String() with modifiers cleared.
// Examples: "Escape", "Enter", "Up", "Tab", "Space", "BackSpace",
// "a", "F1".
struct KeyEvent {
  name: Str,
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
  meta: Bool,
}

// Mouse event. `button` is one of: "left", "middle", "right", "none",
// "wheel_up", "wheel_down", "wheel_left", "wheel_right".
// `kind` is one of: "press", "release", "motion".
struct MouseEvent {
  col: Int,
  row: Int,
  button: Str,
  kind: Str,
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
}

// Terminal was resized. cols/rows are the new dimensions in cells.
struct ResizeEvent {
  cols: Int,
  rows: Int,
}

// Terminal gained or lost focus. focused = true means FocusIn.
struct FocusEvent {
  focused: Bool,
}

// Bracketed-paste boundary. started = true marks the beginning of a
// paste; false marks the end. Keys within a paste arrive as KeyEvent.
struct PasteEvent {
  started: Bool,
}

// Vaxis asked the app to redraw (e.g. after a SyncFunc).
struct RedrawEvent {}

// Application is shutting down.
struct QuitEvent {}

type Event = KeyEvent | MouseEvent | ResizeEvent | FocusEvent | PasteEvent | RedrawEvent | QuitEvent

// Opaque handle to a single vaxis event. Constructed by `read_event`,
// passed back into the accessor functions to extract its fields.
// Backed by the underlying `vaxis.Event` interface; accessors
// type-assert to the concrete variant.
private extern type RawEvent = "vaxis.Event"

extern fn read_event(vx: Vaxis) RawEvent!Str = "ReadEvent"
extern fn event_kind(e: RawEvent) Str = "EventKind"

extern fn event_key_name(e: RawEvent) Str = "EventKeyName"
extern fn event_key_ctrl(e: RawEvent) Bool = "EventKeyCtrl"
extern fn event_key_shift(e: RawEvent) Bool = "EventKeyShift"
extern fn event_key_alt(e: RawEvent) Bool = "EventKeyAlt"
extern fn event_key_meta(e: RawEvent) Bool = "EventKeyMeta"

extern fn event_mouse_col(e: RawEvent) Int = "EventMouseCol"
extern fn event_mouse_row(e: RawEvent) Int = "EventMouseRow"
extern fn event_mouse_button(e: RawEvent) Str = "EventMouseButton"
extern fn event_mouse_kind(e: RawEvent) Str = "EventMouseKind"
extern fn event_mouse_ctrl(e: RawEvent) Bool = "EventMouseCtrl"
extern fn event_mouse_shift(e: RawEvent) Bool = "EventMouseShift"
extern fn event_mouse_alt(e: RawEvent) Bool = "EventMouseAlt"

extern fn event_resize_cols(e: RawEvent) Int = "EventResizeCols"
extern fn event_resize_rows(e: RawEvent) Int = "EventResizeRows"

extern fn event_focus_focused(e: RawEvent) Bool = "EventFocusFocused"
extern fn event_paste_started(e: RawEvent) Bool = "EventPasteStarted"

// Blocking call: read the next event from the terminal and return it
// as one of the Event variants.
fn next_event(vx: Vaxis) Event!Str {
  let raw = try read_event(vx)
  let kind = event_kind(raw)
  match kind {
    "key" => {
      let ev: Event = KeyEvent{
        name: event_key_name(raw),
        ctrl: event_key_ctrl(raw),
        shift: event_key_shift(raw),
        alt: event_key_alt(raw),
        meta: event_key_meta(raw),
      }
      Result::ok(ev)
    },
    "mouse" => {
      let ev: Event = MouseEvent{
        col: event_mouse_col(raw),
        row: event_mouse_row(raw),
        button: event_mouse_button(raw),
        kind: event_mouse_kind(raw),
        ctrl: event_mouse_ctrl(raw),
        shift: event_mouse_shift(raw),
        alt: event_mouse_alt(raw),
      }
      Result::ok(ev)
    },
    "resize" => {
      let ev: Event = ResizeEvent{
        cols: event_resize_cols(raw),
        rows: event_resize_rows(raw),
      }
      Result::ok(ev)
    },
    "focus" => {
      let ev: Event = FocusEvent{focused: event_focus_focused(raw)}
      Result::ok(ev)
    },
    "paste" => {
      let ev: Event = PasteEvent{started: event_paste_started(raw)}
      Result::ok(ev)
    },
    "redraw" => {
      let ev: Event = RedrawEvent{}
      Result::ok(ev)
    },
    "quit" => {
      let ev: Event = QuitEvent{}
      Result::ok(ev)
    },
    _ => Result::err("unknown event kind: {kind}"),
  }
}

