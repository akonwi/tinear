// ---- Events ---------------------------------------------------------

// Opaque handle to a single vaxis event. Constructed by `read_event`,
// passed back into the accessor functions to extract its fields.
// Backed by the underlying vaxis.Event interface; accessors
// type-assert to the concrete variant.
private extern type RawEvent

extern fn event_key_pretty(e: RawEvent) Str = "EventKeyPretty"

// Key press event. `name` is the plain key name without modifier
// prefixes, taken from vaxis.Key.String() with modifiers cleared.
// Examples: "Escape", "Enter", "Up", "Tab", "Space", "BackSpace",
// "a", "F1".
//
// `text` is the rendered text the key would insert into a text
// buffer, accounting for shift, keyboard layout, and IME. Empty for
// non-textual keys (Enter, arrows, function keys, control combos).
// Prefer `text` when implementing text inputs so you don't have to
// uppercase/layout-translate characters yourself.

struct KeyEvent {
  raw: RawEvent,
  name: Str,
  text: Str,
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
  meta: Bool,
}

impl KeyEvent {
  fn pretty() Str {
    event_key_pretty(self.raw)
  }
}

// Mouse event. `button` is one of: "left", "middle", "right", "none",
// "wheel_up", "wheel_down", "wheel_left", "wheel_right".
// `kind` is one of: "press", "release", "motion".
struct MouseEvent {
  col: Int,
  row: Int,
  button: Str,
  kind: Str,
  ctrl: Bool,
  shift: Bool,
  alt: Bool,
}

// Terminal was resized. cols/rows are the new dimensions in cells.
// x_pixel/y_pixel are the terminal dimensions in pixels (0 if unknown).
struct ResizeEvent {
  cols: Int,
  rows: Int,
  x_pixel: Int,
  y_pixel: Int,
}

// Terminal gained or lost focus. focused = true means FocusIn.
struct FocusEvent {
  focused: Bool,
}

// Pasted text captured from a bracketed-paste sequence.
struct PasteEvent {
  content: Str,
}

// Vaxis asked the app to redraw (e.g. after a SyncFunc or posted wakeup).
struct RedrawEvent {}

// Terminal color theme changed. dark = true for dark mode, false for light.
struct ColorThemeEvent {
  dark: Bool,
}

// Application is shutting down.
struct QuitEvent {}

type Event =
  | KeyEvent
  | MouseEvent
  | ResizeEvent
  | FocusEvent
  | PasteEvent
  | RedrawEvent
  | ColorThemeEvent
  | QuitEvent

extern fn read_event(vx: Vaxis) RawEvent = "ReadEvent"

private extern fn post_key_event(vx: Vaxis, raw: RawEvent) Void = "PostKeyEvent"
private extern fn post_mouse_event(vx: Vaxis, col: Int, row: Int, button: Str, kind: Str, ctrl: Bool, shift: Bool, alt: Bool) Void = "PostMouseEvent"
private extern fn post_resize_event(vx: Vaxis, cols: Int, rows: Int, x_pixel: Int, y_pixel: Int) Void = "PostResizeEvent"
private extern fn post_focus_event(vx: Vaxis, focused: Bool) Void = "PostFocusEvent"
private extern fn post_paste_event(vx: Vaxis, content: Str) Void = "PostPasteEvent"
private extern fn post_redraw_event(vx: Vaxis) Void = "PostRedrawEvent"
private extern fn post_color_theme_event(vx: Vaxis, dark: Bool) Void = "PostColorThemeEvent"
private extern fn post_quit_event(vx: Vaxis) Void = "PostQuitEvent"

private extern fn is_key_event(e: RawEvent) Bool = "IsKeyEvent"
private extern fn is_mouse_event(e: RawEvent) Bool = "IsMouseEvent"
private extern fn is_resize_event(e: RawEvent) Bool = "IsResizeEvent"
private extern fn is_focus_event(e: RawEvent) Bool = "IsFocusEvent"
private extern fn is_paste_event(e: RawEvent) Bool = "IsPasteEvent"
private extern fn is_redraw_event(e: RawEvent) Bool = "IsRedrawEvent"
private extern fn is_color_theme_event(e: RawEvent) Bool = "IsColorThemeEvent"
private extern fn is_quit_event(e: RawEvent) Bool = "IsQuitEvent"

extern fn event_key_name(e: RawEvent) Str = "EventKeyName"
extern fn event_key_text(e: RawEvent) Str = "EventKeyText"
extern fn event_key_ctrl(e: RawEvent) Bool = "EventKeyCtrl"
extern fn event_key_shift(e: RawEvent) Bool = "EventKeyShift"
extern fn event_key_alt(e: RawEvent) Bool = "EventKeyAlt"
extern fn event_key_meta(e: RawEvent) Bool = "EventKeyMeta"

extern fn event_mouse_col(e: RawEvent) Int = "EventMouseCol"
extern fn event_mouse_row(e: RawEvent) Int = "EventMouseRow"
extern fn event_mouse_button(e: RawEvent) Str = "EventMouseButton"
extern fn event_mouse_kind(e: RawEvent) Str = "EventMouseKind"
extern fn event_mouse_ctrl(e: RawEvent) Bool = "EventMouseCtrl"
extern fn event_mouse_shift(e: RawEvent) Bool = "EventMouseShift"
extern fn event_mouse_alt(e: RawEvent) Bool = "EventMouseAlt"

extern fn event_resize_cols(e: RawEvent) Int = "EventResizeCols"
extern fn event_resize_rows(e: RawEvent) Int = "EventResizeRows"
extern fn event_resize_x_pixel(e: RawEvent) Int = "EventResizeXPixel"
extern fn event_resize_y_pixel(e: RawEvent) Int = "EventResizeYPixel"

extern fn event_color_theme_dark(e: RawEvent) Bool = "EventColorThemeDark"

extern fn event_focus_focused(e: RawEvent) Bool = "EventFocusFocused"

extern fn event_paste_started(e: RawEvent) Bool = "EventPasteStarted"
extern fn event_paste_content(e: RawEvent) Str = "EventPasteContent"

// Enqueue an event into vaxis's event loop. This is the Ard-side
// escape hatch for waking the main loop from callbacks/fibers.
fn post(vx: Vaxis, event: Event) {
  match event {
    KeyEvent(e) => post_key_event(vx, e.raw),
    MouseEvent(e) => post_mouse_event(vx, e.col, e.row, e.button, e.kind, e.ctrl, e.shift, e.alt),
    ResizeEvent(e) => post_resize_event(vx, e.cols, e.rows, e.x_pixel, e.y_pixel),
    FocusEvent(e) => post_focus_event(vx, e.focused),
    PasteEvent(e) => post_paste_event(vx, e.content),
    RedrawEvent(_) => post_redraw_event(vx),
    ColorThemeEvent(e) => post_color_theme_event(vx, e.dark),
    QuitEvent(_) => post_quit_event(vx),
  }
}

// Blocking call: read the next event from the terminal and return it
// as one of the Event variants.
fn next_event(vx: Vaxis) Event!Str {
  let raw = read_event(vx)
  match {
    is_key_event(raw) => {
      Result::ok(
        KeyEvent{
          raw: raw,
          name: event_key_name(raw),
          text: event_key_text(raw),
          ctrl: event_key_ctrl(raw),
          shift: event_key_shift(raw),
          alt: event_key_alt(raw),
          meta: event_key_meta(raw),
        },
      )
    },
    is_mouse_event(raw) => {
      Result::ok(
        MouseEvent{
          col: event_mouse_col(raw),
          row: event_mouse_row(raw),
          button: event_mouse_button(raw),
          kind: event_mouse_kind(raw),
          ctrl: event_mouse_ctrl(raw),
          shift: event_mouse_shift(raw),
          alt: event_mouse_alt(raw),
        },
      )
    },
    is_resize_event(raw) => {
      Result::ok(
        ResizeEvent{
          cols: event_resize_cols(raw),
          rows: event_resize_rows(raw),
          x_pixel: event_resize_x_pixel(raw),
          y_pixel: event_resize_y_pixel(raw),
        },
      )
    },
    is_focus_event(raw) => Result::ok(FocusEvent{focused: event_focus_focused(raw)}),
    is_paste_event(raw) => Result::ok(PasteEvent{content: event_paste_content(raw)}),
    is_redraw_event(raw) => Result::ok(RedrawEvent{}),
    is_color_theme_event(raw) => Result::ok(ColorThemeEvent{dark: event_color_theme_dark(raw)}),
    is_quit_event(raw) => Result::ok(QuitEvent{}),
    _ => Result::err("unknown vaxis event"),
  }
}

extern fn root(vx: Vaxis) Window = "Root"

extern fn window(vx: Vaxis, x: Int, y: Int, width: Int, height: Int) Window = "RootWindow"

