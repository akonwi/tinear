// Render `text` as an OSC 8 clickable hyperlink pointing at `url`.
// Renders an underline so the link is visually distinct. Terminals
// without OSC 8 support just render the underlined text.
extern fn window_draw_link(win: Window, x: Int, y: Int, text: Str, url: Str) Void = "WindowDrawLink"

extern fn text_backspace(text: Str) Str = "TextBackspace"
